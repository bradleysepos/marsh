                    raw_tag = substr(truncated, pos, tag_end)
                    pos += tag_end
                    inner = substr(raw_tag, 2, length(raw_tag) - 2)
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", inner)
                    closing = 0
                    if (substr(inner, 1, 1) == "/") {
                        closing = 1
                        inner = substr(inner, 2)
                        gsub(/^[[:space:]]+/, "", inner)
                    }
                    self_closing = 0
                    if (inner ~ /\/[[:space:]]*$/) {
                        self_closing = 1
                        sub(/\/[[:space:]]*$/, "", inner)
                    }
                    split(inner, parts, /[[:space:]]+/)
                    tag_name = lower(parts[1])
                    if (tag_name == "") {
                        continue
                    }
                    if (closing) {
                        repaired = repaired "</" tag_name ">"
                        if (truncate_stack_len > 0 && truncate_stack[truncate_stack_len] == tag_name) {
                            delete truncate_stack[truncate_stack_len]
                            truncate_stack_len--
                        }
                    } else if (is_void_tag(tag_name) || self_closing) {
                        repaired = repaired "<" tag_name ">"
                    } else {
                        repaired = repaired "<" tag_name ">"
                        truncate_stack[++truncate_stack_len] = tag_name
                    }
                }
                sub(/<[^>]*$/, "", repaired)  # discard incomplete trailing tag fragment cut by truncation
                sub("[[:space:]" TRAILING_PUNCTUATION "]+$", "", repaired)
                trailing_close_tags = ""
                while (match(repaired, /<\/[A-Za-z][^>]*>$/)) {
                    trailing_close_tags = substr(repaired, RSTART, RLENGTH) trailing_close_tags
                    repaired = substr(repaired, 1, RSTART - 1)
                }
                sub("[[:space:]" TRAILING_PUNCTUATION "]+$", "", repaired)
                repaired = repaired trailing_close_tags "…"
                for (i = truncate_stack_len; i >= 1; i--) {
                    repaired = repaired "</" truncate_stack[i] ">"
                }
                return repaired
            }
            BEGIN {
                html = ""
                output = ""
                skip_tag = ""
                skip_depth = 0
                in_paragraph = 0
                paragraph_count = 0
                stop_processing = 0
            }
            {
                if (NR == 1) {
                    html = $0
                } else {
                    html = html "\n" $0
                }
            }
            END {
                position = 1
                while (position <= length(html) && !stop_processing) {
                    next_tag = index(substr(html, position), "<")
                    if (next_tag == 0) {
                        sanitize_text(substr(html, position))
                        break
                    }
                    if (next_tag > 1) {
                        sanitize_text(substr(html, position, next_tag - 1))
                        position += next_tag - 1
                    }
                    tag_end = index(substr(html, position), ">")
                    if (tag_end == 0) {
                        break
                    }
                    raw_tag = substr(html, position, tag_end)
                    position += tag_end
                    sanitize_tag(raw_tag)
                }
                if (in_paragraph) {
                    output = output "</p>"
                }
                if (MAX_CHARS > 0 && length(output) > MAX_CHARS) {
                    printf "%s", truncate_html(output, MAX_CHARS)
                } else {
                    printf "%s", output
                }
            }
            '
            ;;
        hash:md5)
            if [[ "${SYS_NAME}" =~ bsd|darwin ]]; then
                md5 -r | awk '{ print $1 }'
            else
                md5sum | awk '{ print $1 }'
            fi
            ;;
        headings:push)
            marsh_text_filter_headings push
            ;;
        headings:shift)
            marsh_text_filter_headings shift | marsh_text_filter newlines:trim
            ;;
        headings:remove)
            marsh_text_filter_headings remove | marsh_text_filter newlines:trim
            ;;
        items:append:*)
            APPEND="${OPTIONS[1]:-}"
            APPEND="${APPEND//\\/\\\\}"
            awk -v APPEND="${APPEND}" '{ print $0 APPEND }'
            ;;
        items:count)
            awk -v RS='\n' 'END { print NR }'
            ;;
        items:first)
            awk -v RS='\n' 'NR==1 { print; exit }'
            ;;
        items:join|items:join:*)
            # Joins lines using one or more delimiters.
            # If one delimiters is provided, it is used to join all lines.
            # If two delimiters are provided, the second is used where the input is a pair of lines.
            # If three delimiters are provided, the first is used to join all lines except the last pair,
            # which is joined using the third delimiters.
            # foo bar baz |  items:join:,                 ->  foo, bar, baz
            # foo bar baz | 'items:join:, : and '         ->  foo, bar, baz
            # foo bar     | 'items:join:, : and '         ->  foo and bar
            # foo bar baz | 'items:join:, : and :, and '  ->  foo, bar, and baz
            DELIM1="${OPTIONS[1]:-}"
            DELIM2="${OPTIONS[2]:-${DELIM1}}"
            DELIM3="${OPTIONS[3]:-${DELIM2}}"
            DELIM1="${DELIM1//\\/\\\\}"
            DELIM2="${DELIM2//\\/\\\\}"
            DELIM3="${DELIM3//\\/\\\\}"
            awk -v RS='\n' -v DELIM1="${DELIM1}" -v DELIM2="${DELIM2}" -v DELIM3="${DELIM3}" '
            {
                lines[NR] = $0
            }
            END {
                if (NR == 0) exit
                if (NR == 1) {
                    print lines[1]
                } else if (NR == 2) {
                    print lines[1] DELIM2 lines[2]
                } else {
                    for (i = 1; i <= NR; i++) {
                        if (i == 1) {
                            printf "%s", lines[i]
                        } else if (i == NR) {
                            printf "%s%s\n", DELIM3, lines[i]
                        } else {
                            printf "%s%s", DELIM1, lines[i]
                        }
