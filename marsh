# builds a document from a single file
function marsh_build_document {  # marsh_build_document site_output_root target_output_rel document markdown_command markdown_options_csv markdown_document_extensions_csv markdown_document_extensions_replacement remove_link_filenames_csv build_context_target_output_rel build_context_source_root
    local SITE_OUTPUT_ROOT TARGET_OUTPUT_REL DOCUMENT DOCUMENT_EXT DOCUMENT_DIR TEXT_TRANSFORM
    local MARKDOWN_COMMAND MARKDOWN_OPTIONS_CSV MARKDOWN_DOCUMENT_EXTENSIONS_CSV MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT REMOVE_LINK_FILENAMES_CSV
    local TARGET_OUTPUT_ROOT DOCUMENT_SOURCE_FILE DOCUMENT_SOURCE_DIR TARGET_SOURCE_ROOT ARCHIVE_SOURCE_FILE DOCUMENT_SITE_REL DOCUMENT_TEMP_ROOT DOCUMENT_META DOCUMENT_META_CACHE DOCUMENT_CONTENT DOCUMENT_IS_RENDERED_FILE DOCUMENT_OUTPUT_REL DOCUMENT_BASE_REL
    local DOCUMENT_ARTIFACT_ROOT DOCUMENT_ARTIFACT_CONTENT DOCUMENT_ARTIFACT_META_YAML DOCUMENT_ARTIFACT_META
    local DOCUMENT_CONTENT_READY
    local RESPONSIVE_PATHS RESPONSIVE_PATH
    local BUILD_CONTEXT_TARGET_OUTPUT_REL BUILD_CONTEXT_SOURCE_ROOT BUILD_CONTEXT_OUTPUT_ROOT

    # init
    SITE_OUTPUT_ROOT="${1:-.}"
    SITE_OUTPUT_ROOT="${SITE_OUTPUT_ROOT%/}"
    TARGET_OUTPUT_REL="${2:-.}"
    TARGET_OUTPUT_REL="${TARGET_OUTPUT_REL%/}"
    DOCUMENT="${3:-}"
    MARKDOWN_COMMAND="${4:-}"
    MARKDOWN_OPTIONS_CSV="${5:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_CSV="${6:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT="${7:-}"
    REMOVE_LINK_FILENAMES_CSV="${8:-}"
    BUILD_CONTEXT_TARGET_OUTPUT_REL="${9:-${TARGET_OUTPUT_REL}}"
    BUILD_CONTEXT_SOURCE_ROOT="${10:-}"
    [[ "${DOCUMENT}" == "" ]] && return 1
    [[ "${MARKDOWN_COMMAND}" == "" ]] && return 1
    [[ "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" == "" ]] && return 1
    BUILD_CONTEXT_TARGET_OUTPUT_REL="${BUILD_CONTEXT_TARGET_OUTPUT_REL%/}"
    BUILD_CONTEXT_TARGET_OUTPUT_REL="${BUILD_CONTEXT_TARGET_OUTPUT_REL:-.}"
    marsh_get_target_document_paths "${DOCUMENT}" "${SITE_OUTPUT_ROOT}" "${TARGET_OUTPUT_REL}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" "TARGET_OUTPUT_ROOT" "DOCUMENT_DIR" "DOCUMENT_EXT" "DOCUMENT_OUTPUT_REL" "DOCUMENT_SITE_REL" "DOCUMENT_BASE_REL" || return 1
    BUILD_CONTEXT_OUTPUT_ROOT=$(marsh_get_target_directory_path "${SITE_OUTPUT_ROOT}/${BUILD_CONTEXT_TARGET_OUTPUT_REL}") || return 1
    DOCUMENT_SOURCE_FILE=""
    TARGET_SOURCE_ROOT="${BUILD_CONTEXT_SOURCE_ROOT}"
    if [[ -f "${TARGET_SOURCE_ROOT}/${DOCUMENT}" ]] && [[ -r "${TARGET_SOURCE_ROOT}/${DOCUMENT}" ]]; then
        DOCUMENT_SOURCE_FILE="${TARGET_SOURCE_ROOT}/${DOCUMENT}"
    fi
    if [[ ! -f "${DOCUMENT_SOURCE_FILE}" ]] || [[ ! -r "${DOCUMENT_SOURCE_FILE}" ]]; then
        ARCHIVE_SOURCE_FILE=$(marsh_get_archive_temp_path "${BUILD_CONTEXT_OUTPUT_ROOT}" "${DOCUMENT_SITE_REL}" "source" 2>/dev/null) || ARCHIVE_SOURCE_FILE=""
        if [[ -f "${ARCHIVE_SOURCE_FILE}" ]] && [[ -r "${ARCHIVE_SOURCE_FILE}" ]]; then
            DOCUMENT_SOURCE_FILE="${ARCHIVE_SOURCE_FILE}"
        fi
    fi
    if [[ "${DOCUMENT_SOURCE_FILE}" == "" ]] && [[ "${TARGET_SOURCE_ROOT}" == "" ]]; then
        echo "Document source root not found for target: ${BUILD_CONTEXT_OUTPUT_ROOT}" >&2
        return 1
    fi
    marsh_get_document_artifacts "${BUILD_CONTEXT_OUTPUT_ROOT}" "${DOCUMENT}" "DOCUMENT_ARTIFACT_ROOT" "DOCUMENT_ARTIFACT_CONTENT" "DOCUMENT_ARTIFACT_META_YAML" "DOCUMENT_ARTIFACT_META" || return 1
    DOCUMENT_TEMP_ROOT="${DOCUMENT_ARTIFACT_ROOT}"
    DOCUMENT_META="${DOCUMENT_ARTIFACT_META_YAML}"
    DOCUMENT_META_CACHE="${DOCUMENT_ARTIFACT_META}"
    DOCUMENT_CONTENT="${DOCUMENT_ARTIFACT_CONTENT}"
    DOCUMENT_IS_RENDERED_FILE=$(marsh_get_document_temp_path "${BUILD_CONTEXT_OUTPUT_ROOT}" "${DOCUMENT}" "is-rendered") || return 1
    [[ -f "${DOCUMENT_SOURCE_FILE}" ]] && [[ -r "${DOCUMENT_SOURCE_FILE}" ]] || {
        if [[ "${TARGET_SOURCE_ROOT}" != "" ]]; then
            echo "Document source not found: ${TARGET_SOURCE_ROOT}/${DOCUMENT}" >&2
        else
            echo "Document source not found: ${DOCUMENT}" >&2
        fi
        return 1
    }
    DOCUMENT_SOURCE_DIR="${DOCUMENT_SOURCE_FILE%/*}"
    [[ "${DOCUMENT_SOURCE_DIR}" == "${DOCUMENT_SOURCE_FILE}" ]] && DOCUMENT_SOURCE_DIR='.'

    # normalize extensions
    if marsh_is_markdown_extension "${DOCUMENT_EXT}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}"; then
        DOCUMENT_EXT=".markdown"
    fi

    DOCUMENT_CONTENT_READY=false
    if [[ -f "${DOCUMENT_CONTENT}" ]] && [[ -r "${DOCUMENT_CONTENT}" ]]; then
        if [[ "${DOCUMENT_EXT}" == ".markdown" ]]; then
            [[ -f "${DOCUMENT_IS_RENDERED_FILE}" ]] && [[ -r "${DOCUMENT_IS_RENDERED_FILE}" ]] && DOCUMENT_CONTENT_READY=true
        else
            DOCUMENT_CONTENT_READY=true
        fi
    fi
    # reuse the current build-local artifact set when it already exists
    marsh_write_document_artifacts "${BUILD_CONTEXT_OUTPUT_ROOT}" "${DOCUMENT}" "${DOCUMENT_SOURCE_FILE}" || {
        echo "Unable to write document artifacts: ${DOCUMENT_SOURCE_FILE}" >&2
        return 1
    }

    if [[ "${DOCUMENT_EXT}" == ".markdown" ]] && [[ "${DOCUMENT_CONTENT_READY}" != true ]]; then
        # preprocess markdown to convert markdown links to html
        # preprocess markdown to add implicit figures
        # convert preprocessed markdown to html
        # unwrap figures (remove p tag)
        # process images with multiple resolution assets
        cp "${DOCUMENT_CONTENT}" "${DOCUMENT_CONTENT}.temp" || {
            echo "Unable to prepare document content: ${DOCUMENT_CONTENT}" >&2
            return 1
        }
        TEXT_TRANSFORM=
        if [[ "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" != "" ]]; then
            TEXT_TRANSFORM="links:replace-ext:${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}:${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}"
        fi
        if [[ "${REMOVE_LINK_FILENAMES_CSV}" != "" ]]; then
            [[ "${TEXT_TRANSFORM}" != "" ]] && TEXT_TRANSFORM+=" "
            TEXT_TRANSFORM+="links:remove-filenames:${REMOVE_LINK_FILENAMES_CSV}"
        fi
        RESPONSIVE_PATHS=$(
            while IFS= read -r RESPONSIVE_PATH; do
                RESPONSIVE_PATH=$(marsh_get_relative_path "${DOCUMENT_BASE_REL}" "${RESPONSIVE_PATH#${SITE_OUTPUT_ROOT}/}") || continue
                printf "%s\034" "${RESPONSIVE_PATH}"
            done < <(marsh_get_site_output_inventory "${SITE_OUTPUT_ROOT}" "${TARGET_OUTPUT_ROOT}" | grep -E "@[0-9]+((\.[0-9]+)?x|w)\.[^/]+$" | sort) || return 1
        ) || return 1
        <"${DOCUMENT_CONTENT}.temp" marsh_text_transform ${TEXT_TRANSFORM} | sed -E \
        -e 's|^!\[(.+)]\([ ]*([^ ]+)[ ]*"(.+)"[ ]*\)$|<figure>'$'\\\n''<a href="\2">'$'\\\n''<img src="\2" alt="\1" />'$'\\\n''</a>'$'\\\n''<figcaption>\3</figcaption>'$'\\\n''</figure>|' |
        marsh_process_markdown "${MARKDOWN_COMMAND}" "${MARKDOWN_OPTIONS_CSV}" |
        sed -E \
        -e 's|<p><figure>|<figure>|' \
        -e 's|</figure></p>|</figure>|' |
        marsh_process_responsive_images_tags "${RESPONSIVE_PATHS}" > "${DOCUMENT_CONTENT}" || {
            echo "Unable to process document markdown: ${DOCUMENT_SOURCE_FILE}" >&2
            rm -f "${DOCUMENT_CONTENT}.temp"
            return 1
        }
        rm -f "${DOCUMENT_CONTENT}.temp"

        # mark markdown content as rendered
        : > "${DOCUMENT_IS_RENDERED_FILE}" || {
            echo "Unable to mark document content as rendered: ${DOCUMENT_IS_RENDERED_FILE}" >&2
            return 1
        }
    fi

}

# builds a single document end-to-end, including template output where configured
function marsh_build_document_and_template {  # marsh_build_document_and_template site_output_root target_output_rel document sitemap sitemap_search templates_dir template log_level log_levels_csv markdown_command markdown_options_csv markdown_document_extensions_csv markdown_document_extensions_replacement remove_link_filenames_csv #template_overrides[@] template_overrides[@] template_assets_path build_context_target_output_rel build_context_source_root
    local SITE_OUTPUT_ROOT TARGET_OUTPUT_REL DOCUMENT SITEMAP SITEMAP_SEARCH TEMPLATES_DIR TEMPLATE LOG_LEVEL LOG_LEVELS_CSV
