        if [[ -f "${TEMPLATE_NOTICE_FILE}" ]] && [[ -r "${TEMPLATE_NOTICE_FILE}" ]]; then
            TEMPLATE_NOTICE_TEMPLATE=$(<"${TEMPLATE_NOTICE_FILE}")
        fi

        # page-relative template asset arrays for transform-aware tag replacement
        TEMPLATE_ASSET_TYPES=('FONTS' 'STYLES' 'SCRIPTS' 'IMAGES' 'AUDIO' 'VIDEO' 'DOCUMENTS' 'BINARIES' 'OTHER')
        TEMPLATE_TAG_ASSETS_FONTS=()
        TEMPLATE_TAG_ASSETS_STYLES=()
        TEMPLATE_TAG_ASSETS_SCRIPTS=()
        TEMPLATE_TAG_ASSETS_IMAGES=()
        TEMPLATE_TAG_ASSETS_AUDIO=()
        TEMPLATE_TAG_ASSETS_VIDEO=()
        TEMPLATE_TAG_ASSETS_DOCUMENTS=()
        TEMPLATE_TAG_ASSETS_BINARIES=()
        TEMPLATE_TAG_ASSETS_OTHER=()
        marsh_get_template_asset_output_paths \
            "${TARGET_OUTPUT_REL:-.}" \
