# builds a template and applies it to a document
function marsh_build_template {  # marsh_build_template site_output_root target_output_rel document sitemap_source sitemap_search templates_dir template log_level log_levels_csv markdown_command markdown_options_csv markdown_document_extensions_csv markdown_document_extensions_replacement remove_link_filenames_csv #template_overrides[@] template_overrides[@] template_assets_path build_context_target_output_rel build_context_source_root
    function process_conditionals {  # process_conditionals file tag list[@]
        local FILE TAG LIST_SEP LIST_RAW
        local FILE_TEMP
        FILE="${1:-}";       [[ "${FILE}" == "" ]] && return 1
        TAG="${2:-}";        [[ "${TAG}" == "" ]]  && return 1
        shift 2
        LIST_SEP=$(printf '\034')
        LIST_RAW=$(printf "%s${LIST_SEP}" "$@")
        LIST_RAW="${LIST_RAW%${LIST_SEP}}"
        FILE_TEMP="${FILE}.tempfile"
        awk -v tag="${TAG}" -v list_raw="${LIST_RAW}" -v list_sep="${LIST_SEP}" -v list_count_input="${#@}" '
            BEGIN {
                list_count = list_count_input + 0;
                if (list_count > 0) {
                    if (list_count == 1 && list_raw == "") {
                        allowed_items[1] = "";
                    } else {
                        split(list_raw, allowed_items, list_sep);
                    }
                    for (i = 1; i <= list_count; i++) {
                        allowed[allowed_items[i]] = 1;
                    }
                }
                supported["is"] = 1;
                supported["is not"] = 1;
                supported["equals"] = 1;
                supported["does not equal"] = 1;
                supported["contains"] = 1;
                supported["does not contain"] = 1;
                re_if = "^[ ]*\\{%[ ]*if[ ]+(.+)[ ]+\"([^\"]*)\"[ ]*%\\}[ ]*$";
                re_any_if = "^[ ]*\\{%[ ]*if[ ]+.+[ ]*%\\}[ ]*$";
                re_else = "^[ ]*\\{%[ ]*else[ ]*%\\}[ ]*$";
                re_endif = "^[ ]*\\{%[ ]*endif[ ]*%\\}[ ]*$";
            }
            function eval_condition(comp, cond_value) {
                if (comp == "contains") {
                    return (cond_value in allowed);
                }
                if (comp == "does not contain") {
                    return !(cond_value in allowed);
                }
                if (comp == "is" || comp == "equals") {
                    return (list_count == 1 && cond_value == allowed_items[1]);
                }
                if (comp == "is not" || comp == "does not equal") {
                    return (list_count == 1 && cond_value != allowed_items[1]);
                }
                return 0;
            }
            function should_emit() {
                return ((branch_matches && !in_else) || (!branch_matches && in_else));
            }
            !in_conditional {
                if ($0 ~ re_if) {
                    condition_line = $0;
                    sub(/^[ ]*\{%[ ]*if[ ]+/, "", condition_line);
                    sub(/[ ]*%\}[ ]*$/, "", condition_line);
                    cond_value = condition_line;
                    sub(/^[^"]*"/, "", cond_value);
                    sub(/".*$/, "", cond_value);
                    condition = condition_line;
                    sub(/[ ]+"[^"]*"[ ]*$/, "", condition);
                    sub(/[ ]+$/, "", condition);
                    line_tag = condition;
                    sub(/[ ].*$/, "", line_tag);
                    line_comparator = condition;
                    sub(/^[^ ]+[ ]+/, "", line_comparator);
                    if (line_tag == tag && (line_comparator in supported)) {
                        in_conditional = 1;
                        conditional_depth = 1;
                        branch_matches = eval_condition(line_comparator, cond_value);
                        in_else = 0;
                        next;
                    }
                }
                print;
                next;
            }
            {
                if ($0 ~ re_any_if) {
                    if (should_emit()) {
                        print;
                    }
                    conditional_depth++;
                    next;
                }
                if ($0 ~ re_else) {
                    if (conditional_depth == 1) {
                        in_else = 1;
                        next;
                    }
                    if (should_emit()) {
                        print;
                    }
                    next;
                }
                if ($0 ~ re_endif) {
                    if (conditional_depth == 1) {
                        in_conditional = 0;
                        conditional_depth = 0;
                        branch_matches = 0;
                        in_else = 0;
                        next;
                    }
                    if (should_emit()) {
                        print;
                    }
                    conditional_depth--;
                    next;
                }
                if (should_emit()) {
                    print;
                }
            }' "${FILE}" > "${FILE_TEMP}" || return 1
        mv "${FILE_TEMP}" "${FILE}"
    }

    function clean_conditionals {  # clean_conditionals file
        local FILE FILE_TEMP
        FILE="${1:-}"; [[ "${FILE}" == "" ]] && return 1
        FILE_TEMP=$(mktemp "${MARSH_TEMP}/conditional-XXXXXX") || return 1
        # remove unsupported conditionals
        cp "${FILE}" "${FILE_TEMP}"
        <"${FILE_TEMP}" awk '
            BEGIN {
                depth = 0;
                re_if = "^[ ]*\\{%[ ]*if[ ]+.+[ ]*%\\}[ ]*$";
                re_else = "^[ ]*\\{%[ ]*else[ ]*%\\}[ ]*$";
                re_endif = "^[ ]*\\{%[ ]*endif[ ]*%\\}[ ]*$";
            }
            {
                if (depth == 0 && $0 ~ re_if) {
                    depth = 1;
                    next;
                }
                if (depth == 0 && $0 ~ re_else) {
                    next;
                }
                if (depth > 0) {
                    if ($0 ~ re_if) {
                        depth++;
                    } else if ($0 ~ re_endif) {
                        depth--;
                    }
                    next;
                }
                print;
            }' > "${FILE}"
        return 0
    }

    function clear_subdocument_render_metadata_scope {  # clear_subdocument_render_metadata_scope metadata_vars
        local METADATA_VARS METADATA_VAR

        METADATA_VARS="${1:-}"

        if [[ "${METADATA_VARS}" != "" ]]; then
            while IFS= read -r METADATA_VAR; do
                [[ "${METADATA_VAR}" != "" ]] || continue
                unset "${METADATA_VAR}"
            done <<< "${METADATA_VARS}"
        fi
    }

    function get_partial_conditional_tags {  # get_partial_conditional_tags file
        local FILE CACHE_DIR CACHE_FILE CACHE_TEMP

        # init
        FILE="${1:-}"
        [[ "${FILE}" == "" ]] && return 1

        # create temporary directory
        CACHE_DIR="${MARSH_TEMP}/conditional-tag-cache"
        mkdir -p "${CACHE_DIR}" >/dev/null 2>&1 || {
            echo "Unable to create conditional tag cache directory: ${CACHE_DIR}" >&2
            return 1
        }

        # generate cache file path
        CACHE_FILE=$(marsh_get_cache_path "${CACHE_DIR}" ".tags" "${FILE}") || return 1

        # use existing cache if available
        if [[ -f "${CACHE_FILE}" ]] && [[ -r "${CACHE_FILE}" ]]; then
            cat "${CACHE_FILE}" || {
                echo "Unable to read conditional tag cache file: ${CACHE_FILE}" >&2
                return 1
            }
            return 0
        fi

        # no existing cache, proceed to generate it
        # acquire lock for cache file creation
        if ! marsh_lock_acquire "${CACHE_FILE}" 2>/dev/null; then
            # unable to acquire lock, likely due to another process generating the cache file
            # wait a while for the lock to be released and attempt to use the cache file if it exists
            if marsh_lock_wait "${CACHE_FILE}" 2>/dev/null; then
                # lock released, use existing cache if available
                if [[ -f "${CACHE_FILE}" ]] && [[ -r "${CACHE_FILE}" ]]; then
                    cat "${CACHE_FILE}" || {
                        echo "Unable to read conditional tag cache file: ${CACHE_FILE}" >&2
                        return 1
                    }
                    return 0
                else
                    # fail fast when the first writer releases the lock without publishing
                    # lock ownership is not retried because a write failure aborts the whole build
                    echo "Conditional tag cache file missing after lock wait: ${CACHE_FILE}" >&2
                    return 1
                fi
            else
                # error on timeout waiting for lock to be released
                echo "Unable to acquire conditional tag cache lock: ${CACHE_FILE}" >&2
                return 1
            fi
        else
            # lock acquired, proceed generating cache file
            # generate temporary cache file in lock directory
            CACHE_TEMP=$(marsh_lock_get_directory "${CACHE_FILE}")
            CACHE_TEMP="${CACHE_TEMP}/tempfile"
            touch "${CACHE_TEMP}" 2>/dev/null || {
                echo "Unable to create conditional tag cache temporary file: ${CACHE_TEMP}" >&2
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }

            # extract conditional tags from the partial template
            awk '$0 ~ /^[ ]*\{%[ ]*if[ ]+[^ ]+.*%\}[ ]*$/ {
                line = $0
                sub(/^[ ]*\{%[ ]*if[ ]+/, "", line)
                sub(/[ ].*$/, "", line)
                print line
            }' "${FILE}" | sort -u > "${CACHE_TEMP}" 2>/dev/null || {
                echo "Unable to write conditional tag cache temporary file: ${CACHE_TEMP}" >&2
                rm -f "${CACHE_TEMP}"
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }

            # move temporary cache file into place as shared cache file
            mv "${CACHE_TEMP}" "${CACHE_FILE}" 2>/dev/null || {
                echo "Unable to write conditional tag cache file: ${CACHE_FILE}" >&2
                rm -f "${CACHE_TEMP}"
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }

            # output shared cache file contents and release lock
            cat "${CACHE_FILE}" 2>/dev/null || {
                echo "Unable to read conditional tag cache file: ${CACHE_FILE}" >&2
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }
            marsh_lock_release "${CACHE_FILE}" || {
                echo "Unable to release conditional tag cache lock: ${CACHE_FILE}" >&2
                return 1
            }
            return 0
        fi
    }

    function get_processed_conditional_partial {  # get_processed_conditional_partial file prefix metadata_vars
        local FILE PREFIX METADATA_VARS TAGS TAG CACHE_DIR CACHE_FILE CACHE_TEMP
        local TAG_VAR TAG_TYPE CONDITIONAL_ITEM CONDITIONAL_VALUE CONDITIONAL_KEY OIFS
        local -a CONDITIONAL_VALUES

        FILE="${1:-}"
        PREFIX="${2:-}"
        METADATA_VARS="${3:-}"
        [[ "${FILE}" == "" ]] && return 1

        TAGS=$(get_partial_conditional_tags "${FILE}") || return 1
        [[ "${TAGS}" != "" ]] || {
            printf '%s\n' "${FILE}"
            return 0
        }

        CONDITIONAL_KEY=""
        while IFS= read -r TAG; do
            [[ "${TAG}" == "" ]] && continue
            TAG_VAR=""
            TAG_TYPE=""
            CONDITIONAL_VALUE=""
            marsh_resolve_render_template_tag "${TAG}" "${PREFIX}" "${METADATA_VARS}" "TAG_VAR" "TAG_TYPE" "CONDITIONAL_VALUE" 2>/dev/null || true
            if [[ "${TAG_TYPE}" == "array" ]]; then
                CONDITIONAL_VALUES=()
                while IFS= read -r CONDITIONAL_ITEM; do
                    CONDITIONAL_VALUES+=("${CONDITIONAL_ITEM}")
                done < <(marsh_get_flatarray_values "${TAG_VAR}")
                OIFS="${IFS}"
                IFS=$(printf '\034')
                CONDITIONAL_VALUE="${CONDITIONAL_VALUES[*]}"
                IFS="${OIFS}"
            elif [[ "${TAG_TYPE}" == "list" ]]; then
                CONDITIONAL_VALUES=()
                while IFS= read -r CONDITIONAL_ITEM; do
                    CONDITIONAL_VALUES+=("${CONDITIONAL_ITEM}")
                done <<< "${CONDITIONAL_VALUE}"
                OIFS="${IFS}"
                IFS=$(printf '\034')
                CONDITIONAL_VALUE="${CONDITIONAL_VALUES[*]}"
                IFS="${OIFS}"
            elif [[ "${TAG_TYPE}" == "string" ]]; then
                if [[ "${TAG_VAR}" != "" ]]; then
                    CONDITIONAL_VALUE="${!TAG_VAR:-}"
                fi
            else
                TAG_TYPE="unsupported"
            fi
            CONDITIONAL_KEY+="${TAG}"$'\034'"${TAG_TYPE}"$'\034'"${CONDITIONAL_VALUE}"$'\035'
        done <<< "${TAGS}"

        # create temporary directory
        CACHE_DIR="${MARSH_TEMP}/conditional-partial-cache"
        mkdir -p "${CACHE_DIR}" >/dev/null 2>&1 || {
            echo "Unable to create conditional partial cache directory: ${CACHE_DIR}" >&2
            return 1
        }

        # generate cache file path
        CACHE_FILE=$(marsh_get_cache_path "${CACHE_DIR}" ".partial" "$(printf '%s\034%s' "${FILE}" "${CONDITIONAL_KEY}")") || return 1

        # use existing cache if available
        if [[ -f "${CACHE_FILE}" ]] && [[ -r "${CACHE_FILE}" ]]; then
            printf '%s\n' "${CACHE_FILE}"
            return 0
        fi

        # no existing cache, proceed to generate it
        # acquire lock for cache file creation
        if ! marsh_lock_acquire "${CACHE_FILE}" 2>/dev/null; then
            # unable to acquire lock, likely due to another process generating the cache file
            # wait a while for the lock to be released and attempt to use the cache file if it exists
            if marsh_lock_wait "${CACHE_FILE}" 2>/dev/null; then
                # lock released, use existing cache if available
                if [[ -f "${CACHE_FILE}" ]] && [[ -r "${CACHE_FILE}" ]]; then
                    printf '%s\n' "${CACHE_FILE}"
                    return 0
                else
                    # fail fast when the first writer releases the lock without publishing
                    # lock ownership is not retried because a write failure aborts the whole build
                    echo "Conditional partial cache file missing after lock wait: ${CACHE_FILE}" >&2
                    return 1
                fi
            else
                # error on timeout waiting for lock to be released
                echo "Unable to acquire conditional partial cache lock: ${CACHE_FILE}" >&2
                return 1
            fi
        else
            # lock acquired, proceed generating cache file
            # generate temporary cache file in lock directory
            CACHE_TEMP=$(marsh_lock_get_directory "${CACHE_FILE}")
            CACHE_TEMP="${CACHE_TEMP}/tempfile"
            cp "${FILE}" "${CACHE_TEMP}" 2>/dev/null || {
                echo "Unable to create conditional partial cache temporary file: ${CACHE_TEMP}" >&2
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }

            # process conditionals for each tag in the partial
            # using metadata values from the template context
            while IFS= read -r TAG; do
                [[ "${TAG}" == "" ]] && continue
                TAG_VAR=""
                TAG_TYPE=""
                CONDITIONAL_VALUE=""
                marsh_resolve_render_template_tag "${TAG}" "${PREFIX}" "${METADATA_VARS}" "TAG_VAR" "TAG_TYPE" "CONDITIONAL_VALUE" 2>/dev/null || true
                if [[ "${TAG_TYPE}" == "array" ]]; then
                    CONDITIONAL_VALUES=()
                    while IFS= read -r CONDITIONAL_ITEM; do
                        CONDITIONAL_VALUES+=("${CONDITIONAL_ITEM}")
                    done < <(marsh_get_flatarray_values "${TAG_VAR}")
                    process_conditionals "${CACHE_TEMP}" "${TAG}" "${CONDITIONAL_VALUES[@]}" || {
                        echo "Unable to process conditional tag in partial: ${TAG} ${FILE}" >&2
                        rm -f "${CACHE_TEMP}"
                        marsh_lock_release "${CACHE_FILE}"
                        return 1
                    }
                elif [[ "${TAG_TYPE}" == "list" ]]; then
                    CONDITIONAL_VALUES=()
                    while IFS= read -r CONDITIONAL_ITEM; do
                        CONDITIONAL_VALUES+=("${CONDITIONAL_ITEM}")
                    done <<< "${CONDITIONAL_VALUE}"
                    process_conditionals "${CACHE_TEMP}" "${TAG}" "${CONDITIONAL_VALUES[@]}" || {
                        echo "Unable to process conditional tag in partial: ${TAG} ${FILE}" >&2
                        rm -f "${CACHE_TEMP}"
                        marsh_lock_release "${CACHE_FILE}"
                        return 1
                    }
                elif [[ "${TAG_TYPE}" == "string" ]]; then
                    if [[ "${TAG_VAR}" != "" ]]; then
                        CONDITIONAL_VALUE="${!TAG_VAR:-}"
                    fi
                    process_conditionals "${CACHE_TEMP}" "${TAG}" "${CONDITIONAL_VALUE}" || {
                        echo "Unable to process conditional tag in partial: ${TAG} ${FILE}" >&2
                        rm -f "${CACHE_TEMP}"
                        marsh_lock_release "${CACHE_FILE}"
                        return 1
                    }
                fi
            done <<< "${TAGS}"

            # clean any remaining unsupported conditional tags from the processed partial
            clean_conditionals "${CACHE_TEMP}" || {
                echo "Unable to clean conditional tags in partial: ${FILE}" >&2
                rm -f "${CACHE_TEMP}"
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }

            # move temporary cache file into place as shared cache file
            mv "${CACHE_TEMP}" "${CACHE_FILE}" 2>/dev/null || {
                echo "Unable to write conditional partial cache file: ${CACHE_FILE}" >&2
                rm -f "${CACHE_TEMP}"
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }

            # output shared cache file path and release lock
            printf '%s\n' "${CACHE_FILE}"
            marsh_lock_release "${CACHE_FILE}" || {
                echo "Unable to release conditional partial cache lock: ${CACHE_FILE}" >&2
                return 1
            }
            return 0
        fi
    }

    function replace_tags {  # replace_tags document prefix metadata_vars[@]
        local DOCUMENT PREFIX METADATA_VARS
        local TAG_FRAGMENT_UNQUOTED TAG_FRAGMENT_DOUBLE TAG_FRAGMENT_SINGLE TAG_FRAGMENT TAG_REGEX
        local REPLACEMENTS TAG_ESC TAG_NAME TAG_VAR TAG_TYPE TAG_ARRAY_VALUE TAG_VALUE TAG_TRANSFORM TAG_TRANSFORMS_TEXT
        local I SCRATCH_FILE
        local -a TAGS UNIQUE_TAGS TAG_TRANSFORMS TAG_VALUES

        # init
        DOCUMENT="${1:-}"
        PREFIX="${2:-}"
        METADATA_VARS="${3:-}"
        [[ "${DOCUMENT}" == "" ]] && return 1
        TAG_FRAGMENT_UNQUOTED='([^|}"'"'"' \\]|\\.)+'
        TAG_FRAGMENT_DOUBLE='"(\\.|[^"\\])*"'
        TAG_FRAGMENT_SINGLE="'(\\.|[^'\\])*'"
        TAG_FRAGMENT="(${TAG_FRAGMENT_UNQUOTED}|${TAG_FRAGMENT_DOUBLE}|${TAG_FRAGMENT_SINGLE})+"
        TAG_REGEX="\\{\\{[ ]*[a-z][a-z0-9.-]*([ ]*\\|[ ]*${TAG_FRAGMENT})*[ ]*\\}\\}"

        # find template tags
        TAGS=()
        while IFS= read -r TAG; do
            TAGS+=("${TAG}")
        done < <(<"${DOCUMENT}" grep -Eo "${TAG_REGEX}")
        [[ "${#TAGS[@]}" -eq 0 ]] && return 0
        UNIQUE_TAGS=()
        REPLACEMENTS=$(mktemp "${MARSH_TEMP}/template-tags-XXXXXX") || return 1

        # build single replacement script handling all unique tags
        for I in "${!TAGS[@]}"; do
            if marsh_in_array "${TAGS[$I]}" "${UNIQUE_TAGS[@]}"; then
                continue
            fi
            UNIQUE_TAGS+=("${TAGS[$I]}")
            TAG_ESC=$(printf '%s' "${TAGS[$I]}" | sed -e 's/[\\]/\\\\/g' -e 's/[][/.|$(){}?+*^]/\\&/g')
            TAG_NAME=""
            TAG_TRANSFORMS_TEXT=""
            marsh_parse_template_tag "${TAGS[$I]}" "TAG_NAME" "TAG_TRANSFORMS_TEXT" || {
                rm -f "${REPLACEMENTS}"
                return 1
            }
            # rebuild the transforms array from parser output
            TAG_TRANSFORMS=()
            while IFS= read -r TAG_TRANSFORM; do
                [[ "${TAG_TRANSFORM}" == "" ]] && continue
                TAG_TRANSFORMS+=("${TAG_TRANSFORM}")
            done <<< "${TAG_TRANSFORMS_TEXT}"
            TAG_VAR=""
            TAG_TYPE=""
            TAG_VALUE=""
            marsh_resolve_render_template_tag "${TAG_NAME}" "${PREFIX}" "${METADATA_VARS}" "TAG_VAR" "TAG_TYPE" "TAG_VALUE" 2>/dev/null || true
            if [[ "${TAG_TYPE}" != "" ]]; then
                if [[ "${TAG_TYPE}" == "array" ]]; then
                    TAG_VALUES=()
                    while IFS= read -r TAG_ARRAY_VALUE; do
                        TAG_VALUES+=("${TAG_ARRAY_VALUE}")
                    done < <(marsh_get_flatarray_values "${TAG_VAR}")
                    TAG_VALUE=$(printf '%s\n' "${TAG_VALUES[@]}")
                elif [[ "${TAG_TYPE}" == "list" ]]; then
                    TAG_VALUES=()
                    while IFS= read -r TAG_ARRAY_VALUE; do
                        TAG_VALUES+=("${TAG_ARRAY_VALUE}")
                    done <<< "${TAG_VALUE}"
                    TAG_VALUE=$(printf '%s\n' "${TAG_VALUES[@]}")
                elif [[ "${TAG_TYPE}" == "file" ]]; then
                    if [[ -f "${!TAG_VAR}" ]] && [[ -r "${!TAG_VAR}" ]]; then
                        TAG_VALUE=$(<"${!TAG_VAR}")
                    else
                        rm -f "${REPLACEMENTS}"
                        return 1
                    fi
                elif [[ "${TAG_TYPE}" == "string" ]]; then
                    if [[ "${TAG_VAR}" != "" ]]; then
                        TAG_VALUE="${!TAG_VAR}"
                    fi
                else
                    rm -f "${REPLACEMENTS}"
                    return 1
                fi
                TAG_VALUE=$(printf '%s' "${TAG_VALUE}" | marsh_text_transform "${TAG_TRANSFORMS[@]}" | marsh_escape_substitution)
                printf '/%s/s//%s/g\n' "${TAG_ESC}" "${TAG_VALUE:-}" >> "${REPLACEMENTS}" || {
                    rm -f "${REPLACEMENTS}"
                    return 1
                }
            else
                # ignore unknown tags
                :
            fi
        done

