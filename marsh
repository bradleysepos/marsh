                        ASSET_PATH="${ASSET%\?*}"
                        ASSET_QUERY="${ASSET#${ASSET_PATH}}"
                        ASSET_OUTPUT_PATH="${TEMPLATE_ASSET_OUTPUT_PATHS_SCRIPTS[$ASSET_INDEX]:-}"
                        [[ "${ASSET_OUTPUT_PATH}" != "" ]] || return 1
                        ASSET_HREF=$(marsh_get_relative_path "${DOCUMENT_BASE_REL}" "${ASSET_OUTPUT_PATH}") || return 1
                        TEMPLATE_TAG_ASSETS_SCRIPTS+=("${ASSET_HREF}${ASSET_QUERY}")
                    done
                    ;;
                IMAGES)
                    for ASSET_INDEX in "${!TEMPLATE_ASSETS_IMAGES[@]}"; do
                        ASSET="${TEMPLATE_ASSETS_IMAGES[$ASSET_INDEX]}"
                        ASSET_PATH="${ASSET%\?*}"
                        ASSET_QUERY="${ASSET#${ASSET_PATH}}"
                        ASSET_OUTPUT_PATH="${TEMPLATE_ASSET_OUTPUT_PATHS_IMAGES[$ASSET_INDEX]:-}"
                        [[ "${ASSET_OUTPUT_PATH}" != "" ]] || return 1
                        ASSET_HREF=$(marsh_get_relative_path "${DOCUMENT_BASE_REL}" "${ASSET_OUTPUT_PATH}") || return 1
                        TEMPLATE_TAG_ASSETS_IMAGES+=("${ASSET_HREF}${ASSET_QUERY}")
                    done
                    ;;
                AUDIO)
                    for ASSET_INDEX in "${!TEMPLATE_ASSETS_AUDIO[@]}"; do
                        ASSET="${TEMPLATE_ASSETS_AUDIO[$ASSET_INDEX]}"
                        ASSET_PATH="${ASSET%\?*}"
                        ASSET_QUERY="${ASSET#${ASSET_PATH}}"
                        ASSET_OUTPUT_PATH="${TEMPLATE_ASSET_OUTPUT_PATHS_AUDIO[$ASSET_INDEX]:-}"
                        [[ "${ASSET_OUTPUT_PATH}" != "" ]] || return 1
                        ASSET_HREF=$(marsh_get_relative_path "${DOCUMENT_BASE_REL}" "${ASSET_OUTPUT_PATH}") || return 1
                        TEMPLATE_TAG_ASSETS_AUDIO+=("${ASSET_HREF}${ASSET_QUERY}")
                    done
                    ;;
                VIDEO)
                    for ASSET_INDEX in "${!TEMPLATE_ASSETS_VIDEO[@]}"; do
                        ASSET="${TEMPLATE_ASSETS_VIDEO[$ASSET_INDEX]}"
                        ASSET_PATH="${ASSET%\?*}"
                        ASSET_QUERY="${ASSET#${ASSET_PATH}}"
                        ASSET_OUTPUT_PATH="${TEMPLATE_ASSET_OUTPUT_PATHS_VIDEO[$ASSET_INDEX]:-}"
                        [[ "${ASSET_OUTPUT_PATH}" != "" ]] || return 1
                        ASSET_HREF=$(marsh_get_relative_path "${DOCUMENT_BASE_REL}" "${ASSET_OUTPUT_PATH}") || return 1
                        TEMPLATE_TAG_ASSETS_VIDEO+=("${ASSET_HREF}${ASSET_QUERY}")
                    done
                    ;;
                DOCUMENTS)
                    for ASSET_INDEX in "${!TEMPLATE_ASSETS_DOCUMENTS[@]}"; do
                        ASSET="${TEMPLATE_ASSETS_DOCUMENTS[$ASSET_INDEX]}"
                        ASSET_PATH="${ASSET%\?*}"
                        ASSET_QUERY="${ASSET#${ASSET_PATH}}"
                        ASSET_OUTPUT_PATH="${TEMPLATE_ASSET_OUTPUT_PATHS_DOCUMENTS[$ASSET_INDEX]:-}"
                        [[ "${ASSET_OUTPUT_PATH}" != "" ]] || return 1
                        ASSET_HREF=$(marsh_get_relative_path "${DOCUMENT_BASE_REL}" "${ASSET_OUTPUT_PATH}") || return 1
                        TEMPLATE_TAG_ASSETS_DOCUMENTS+=("${ASSET_HREF}${ASSET_QUERY}")
                    done
                    ;;
                BINARIES)
                    for ASSET_INDEX in "${!TEMPLATE_ASSETS_BINARIES[@]}"; do
                        ASSET="${TEMPLATE_ASSETS_BINARIES[$ASSET_INDEX]}"
                        ASSET_PATH="${ASSET%\?*}"
                        ASSET_QUERY="${ASSET#${ASSET_PATH}}"
                        ASSET_OUTPUT_PATH="${TEMPLATE_ASSET_OUTPUT_PATHS_BINARIES[$ASSET_INDEX]:-}"
                        [[ "${ASSET_OUTPUT_PATH}" != "" ]] || return 1
                        ASSET_HREF=$(marsh_get_relative_path "${DOCUMENT_BASE_REL}" "${ASSET_OUTPUT_PATH}") || return 1
                        TEMPLATE_TAG_ASSETS_BINARIES+=("${ASSET_HREF}${ASSET_QUERY}")
                    done
                    ;;
                OTHER)
                    for ASSET_INDEX in "${!TEMPLATE_ASSETS_OTHER[@]}"; do
                        ASSET="${TEMPLATE_ASSETS_OTHER[$ASSET_INDEX]}"
                        ASSET_PATH="${ASSET%\?*}"
                        ASSET_QUERY="${ASSET#${ASSET_PATH}}"
                        ASSET_OUTPUT_PATH="${TEMPLATE_ASSET_OUTPUT_PATHS_OTHER[$ASSET_INDEX]:-}"
                        [[ "${ASSET_OUTPUT_PATH}" != "" ]] || return 1
                        ASSET_HREF=$(marsh_get_relative_path "${DOCUMENT_BASE_REL}" "${ASSET_OUTPUT_PATH}") || return 1
                        TEMPLATE_TAG_ASSETS_OTHER+=("${ASSET_HREF}${ASSET_QUERY}")
                    done
                    ;;
            esac
        done
        TEMPLATE_RENDER=$(printf '%s' "${TEMPLATE_RENDER}" | sed -E -e '/\{\{[ ]*template\.(head|body|document|header|footer|nav|notice)[ ]*\}\}/s///g')
        printf '%s\n' "${TEMPLATE_RENDER}" > "${DEST}" || {
            echo "Unable to write template output: ${DEST}" >&2
            return 1
        }

        # template tags
        replace_tags "${DEST}" "DOCUMENT_" "${DOCUMENT_META_VARS:-}"

        # subdocuments
        SUBDOCUMENTS=()
        SUBDOCUMENT_URIS=()
        SUBDOCUMENT_ABSPATHS=()
        SUBDOCUMENTS_MANIFEST=$(marsh_get_archive_temp_path "${BUILD_CONTEXT_OUTPUT_ROOT}" "${DOCUMENT_SITE_REL}" "subdocuments-manifest" 2>/dev/null) || SUBDOCUMENTS_MANIFEST=""
        if [[ -f "${SUBDOCUMENTS_MANIFEST}" ]] && [[ -r "${SUBDOCUMENTS_MANIFEST}" ]]; then
            SUBDOCUMENTS_LIST=$(<"${SUBDOCUMENTS_MANIFEST}")
            while IFS= read -r SUBDOCUMENT_RECORD; do
                [[ "${SUBDOCUMENT_RECORD}" == "" ]] && continue
                SUBDOCUMENT=""
                SUBDOCUMENT_URI_FROM_MANIFEST=""
                SUBDOCUMENT_ABSPATH_FROM_MANIFEST=""
                SUBDOCUMENT_RECORD_REST=""
                IFS=$'\037' read -r SUBDOCUMENT SUBDOCUMENT_URI_FROM_MANIFEST SUBDOCUMENT_ABSPATH_FROM_MANIFEST SUBDOCUMENT_RECORD_REST <<< "${SUBDOCUMENT_RECORD}"
                [[ "${SUBDOCUMENT}" != "" ]] || return 1
                [[ "${SUBDOCUMENT_RECORD_REST}" == "" ]] || return 1
                SUBDOCUMENTS+=("${SUBDOCUMENT}")
                SUBDOCUMENT_URIS+=("${SUBDOCUMENT_URI_FROM_MANIFEST}")
                SUBDOCUMENT_ABSPATHS+=("${SUBDOCUMENT_ABSPATH_FROM_MANIFEST}")
            done <<< "${SUBDOCUMENTS_LIST}"
        fi
        NUM_SUBDOCUMENTS="${#SUBDOCUMENTS[@]}"
        if [[ "${NUM_SUBDOCUMENTS}" -gt 0 ]]; then
            SUBDOCUMENTS_FILE=$(marsh_get_archive_temp_path "${BUILD_CONTEXT_OUTPUT_ROOT}" "${DOCUMENT_SITE_REL}" "subdocuments") || return 1
            mkdir -p "${SUBDOCUMENTS_FILE%/*}" >/dev/null 2>&1 || {
                echo "Unable to create subdocuments temp directory: ${SUBDOCUMENTS_FILE%/*}" >&2
                return 1
            }
            : > "${SUBDOCUMENTS_FILE}" || {
                echo "Unable to create subdocuments file: ${SUBDOCUMENTS_FILE}" >&2
                return 1
            }
            for J in "${!SUBDOCUMENTS[@]}"; do
                # derive one normalized logical site-relative id from the raw manifest up front
                # and reuse it for subsequent lookups and path reconstructions
                SUBDOCUMENT_SOURCE="${SUBDOCUMENTS[$J]}"
                SUBDOCUMENT_REL_TO_SITE=$(marsh_normalize_internal_path "${SUBDOCUMENT_SOURCE}" 2>/dev/null) || {
                    echo "Invalid subdocument id: ${SUBDOCUMENT_SOURCE}" >&2
                    return 1
                }
                [[ "${SUBDOCUMENT_REL_TO_SITE}" == "." ]] && {
                    echo "Invalid subdocument id: ${SUBDOCUMENT_SOURCE}" >&2
                    return 1
                }
                SUBDOCUMENT_CONTENT_FILE=""
                SUBDOCUMENT_META_FILE=""
                SUBDOCUMENT_IS_RENDERED_FILE=""
                SUBDOCUMENT_URI=""
                SUBDOCUMENT_ABSPATH=""
                SUBDOCUMENT_URI_FROM_MANIFEST="${SUBDOCUMENT_URIS[$J]:-}"
                SUBDOCUMENT_ABSPATH_FROM_MANIFEST="${SUBDOCUMENT_ABSPATHS[$J]:-}"
                clear_subdocument_render_metadata_scope "${SUBDOCUMENT_META_VARS:-}"
                SUBDOCUMENT_META_VARS=""
                SUBDOCUMENT_CONTENT_IS_RENDERED=false
                SUBDOCUMENT_CONTENT_USE_ONCE=false
                SUBDOCUMENT_CONTENT_FILE=$(marsh_get_document_temp_path "${BUILD_CONTEXT_OUTPUT_ROOT}" "${SUBDOCUMENT_REL_TO_SITE}" "content" 2>/dev/null) || SUBDOCUMENT_CONTENT_FILE=""
                SUBDOCUMENT_META_FILE=$(marsh_get_document_temp_path "${BUILD_CONTEXT_OUTPUT_ROOT}" "${SUBDOCUMENT_REL_TO_SITE}" "meta-yaml" 2>/dev/null) || SUBDOCUMENT_META_FILE=""
                SUBDOCUMENT_IS_RENDERED_FILE=$(marsh_get_document_temp_path "${BUILD_CONTEXT_OUTPUT_ROOT}" "${SUBDOCUMENT_REL_TO_SITE}" "is-rendered" 2>/dev/null) || SUBDOCUMENT_IS_RENDERED_FILE=""
                # document metadata
                if [[ -f "${SUBDOCUMENT_META_FILE}" ]] && [[ -r "${SUBDOCUMENT_META_FILE}" ]]; then
                    SUBDOCUMENT_META_ALLOW_RESERVED_PAGE_TAGS=false
                    while IFS= read -r SUBDOCUMENT_META_ASSIGNMENT || [[ "${SUBDOCUMENT_META_ASSIGNMENT}" != "" ]]; do
                        [[ "${SUBDOCUMENT_META_ASSIGNMENT}" != "" ]] || continue
                        SUBDOCUMENT_META_ENTRY_NAME=""
                        SUBDOCUMENT_META_ENTRY_TYPE=""
                        SUBDOCUMENT_META_ENTRY_VALUE=""
                        SUBDOCUMENT_META_ENTRY_INDEX=""
                        marsh_parse_document_metadata_assignment \
                            "${SUBDOCUMENT_META_ASSIGNMENT}" \
                            "SUBDOCUMENT_META_ENTRY_NAME" \
                            "SUBDOCUMENT_META_ENTRY_TYPE" \
                            "SUBDOCUMENT_META_ENTRY_VALUE" \
                            "SUBDOCUMENT_META_ENTRY_INDEX" || return 1
                        marsh_normalize_document_metadata_key "${SUBDOCUMENT_META_ENTRY_NAME}" "SUBDOCUMENT_META_NORMALIZED_KEY" || return 1
                        if marsh_is_reserved_document_template_tag "${SUBDOCUMENT_META_NORMALIZED_KEY}"; then
                            if marsh_is_reserved_archive_page_template_tag "${SUBDOCUMENT_META_NORMALIZED_KEY}"; then
                                [[ "${SUBDOCUMENT_META_ALLOW_RESERVED_PAGE_TAGS}" == true ]] || continue
                            else
                                continue
                            fi
                        fi
                        if [[ "${SUBDOCUMENT_META_ENTRY_TYPE}" == "list-item" ]]; then
                            SUBDOCUMENT_META_VAR_NAME="SUBDOCUMENT_${SUBDOCUMENT_META_ENTRY_NAME}_${SUBDOCUMENT_META_ENTRY_INDEX}"
                        else
                            SUBDOCUMENT_META_VAR_NAME="SUBDOCUMENT_${SUBDOCUMENT_META_ENTRY_NAME}"
                        fi
                        local "${SUBDOCUMENT_META_VAR_NAME}"
                        printf -v "${SUBDOCUMENT_META_VAR_NAME}" '%s' "${SUBDOCUMENT_META_ENTRY_VALUE}"
                        SUBDOCUMENT_META_VARS+="${SUBDOCUMENT_META_VAR_NAME}"$'\n'
                        if [[ "${SUBDOCUMENT_META_ENTRY_NAME}" == "Type" ]] && [[ "${SUBDOCUMENT_META_ENTRY_VALUE}" == "archive" ]]; then
                            SUBDOCUMENT_META_ALLOW_RESERVED_PAGE_TAGS=true
                        fi
                    done < <(marsh_get_document_metadata "${SUBDOCUMENT_META_FILE}" "") || {
                        echo "Unable to load cached metadata for subdocument: ${SUBDOCUMENT_META_FILE}" >&2
                        return 1
                    }
                    SUBDOCUMENT_META_VARS="${SUBDOCUMENT_META_VARS%$'\n'}"
                fi
                [[ -f "${SUBDOCUMENT_CONTENT_FILE}" ]] && [[ -r "${SUBDOCUMENT_CONTENT_FILE}" ]] || {
                    echo "Subdocument content not found: ${SUBDOCUMENT_REL_TO_SITE}" >&2
                    return 1
                }
                [[ "${SUBDOCUMENT_URI_FROM_MANIFEST:-}" != "" ]] && SUBDOCUMENT_URI="${SUBDOCUMENT_URI_FROM_MANIFEST}"
                [[ "${SUBDOCUMENT_ABSPATH_FROM_MANIFEST:-}" != "" ]] && SUBDOCUMENT_ABSPATH="${SUBDOCUMENT_ABSPATH_FROM_MANIFEST}"
                SUBDOCUMENT_OUTPUT_PATH="${SUBDOCUMENT_REL_TO_SITE}"
                SUBDOCUMENT_OUTPUT_EXT=$(marsh_get_extension "${SUBDOCUMENT_OUTPUT_PATH}")
                if marsh_is_markdown_extension "${SUBDOCUMENT_OUTPUT_EXT}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}"; then
                    SUBDOCUMENT_OUTPUT_PATH="${SUBDOCUMENT_OUTPUT_PATH%.*}${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}"
                    if [[ -f "${SUBDOCUMENT_IS_RENDERED_FILE}" ]] && [[ -r "${SUBDOCUMENT_IS_RENDERED_FILE}" ]]; then
                        # content is rendered already
                        SUBDOCUMENT_CONTENT_IS_RENDERED=true
                    fi
                fi
                SUBDOCUMENT_OUTPUT_PATH="${SUBDOCUMENT_OUTPUT_PATH#./}"
                SUBDOCUMENT_OUTPUT_PATH="${SUBDOCUMENT_OUTPUT_PATH#/}"
                if [[ "${SUBDOCUMENT_URI:-}" == "" ]]; then
                    SUBDOCUMENT_URI=$(marsh_get_absolute_output_path "${SUBDOCUMENT_OUTPUT_PATH}" "document" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
                fi
                SUBDOCUMENT_URI=$(marsh_normalize_path "${SUBDOCUMENT_URI}" "document" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
                SUBDOCUMENT_HREF=$(marsh_get_relative_path "${DOCUMENT_BASE_REL}" "${SUBDOCUMENT_OUTPUT_PATH}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
                # state
                # collect subdocument state values from flat metadata
                SUBDOCUMENT_State=()
                while IFS= read -r SUBDOCUMENT_STATE_VALUE; do
                    SUBDOCUMENT_State+=("${SUBDOCUMENT_STATE_VALUE}")
                done < <(marsh_get_flatarray_values "SUBDOCUMENT_State_")
                SUBDOCUMENT_TEMPLATE=$(<"${SUBDOCUMENT_CONTENT_FILE}")
                if [[ "${DOCUMENT_Type}" == "archive" ]]; then
                    # convert subdocument markdown to html only where necessary
                    if [[ "${SUBDOCUMENT_CONTENT_IS_RENDERED}" == true ]]; then
                        # reuse existing rendered temporary artifact
                        SUBDOCUMENT_CONTENT="${SUBDOCUMENT_CONTENT_FILE}"
                    else
                        # rendered temporary artifact does not exist
                        # fall back to creating it for one-time use in this archive context
                        SUBDOCUMENT_CONTENT_USE_ONCE=true
                        TEXT_TRANSFORM=
                        if [[ "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" != "" ]]; then
                            TEXT_TRANSFORM="links:replace-ext:${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}:${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}"
                        fi
                        if [[ "${REMOVE_LINK_FILENAMES_CSV}" != "" ]]; then
                            [[ "${TEXT_TRANSFORM}" != "" ]] && TEXT_TRANSFORM+=" "
                            TEXT_TRANSFORM+="links:remove-filenames:${REMOVE_LINK_FILENAMES_CSV}"
                        fi
                        SUBDOCUMENT_CONTENT=$(mktemp "${MARSH_TEMP}/subdocument-content-XXXXXX") || {
                            echo "Unable to create subdocument render file: ${MARSH_TEMP}/subdocument-content-XXXXXX" >&2
                            return 1
                        }
                        <"${SUBDOCUMENT_CONTENT_FILE}" marsh_text_transform ${TEXT_TRANSFORM} | marsh_process_markdown "${MARKDOWN_COMMAND}" "${MARKDOWN_OPTIONS_CSV}" > "${SUBDOCUMENT_CONTENT}" || {
                            echo "Unable to process subdocument markdown: ${SUBDOCUMENT_SOURCE}" >&2
                            rm -f "${SUBDOCUMENT_CONTENT}"
                            return 1
                        }
                    fi
                else
                    SUBDOCUMENT_CONTENT="${SUBDOCUMENT_CONTENT_FILE}"
                fi
                SUBDOCUMENT_CONTENT_ESC=$(<"${SUBDOCUMENT_CONTENT}" marsh_escape_substitution)
                SUBDOCUMENT_TEMPLATE="${TEMPLATE_DOCUMENT_TEMPLATE}"
                SUBDOCUMENT_RENDER=$(printf '%s' "${SUBDOCUMENT_TEMPLATE}" | sed -E \
                    -e "/\{\{[ ]*document\.content[ ]*\}\}/s//${SUBDOCUMENT_CONTENT_ESC}/g" \
                    -e 's/\{\{[ ]*subdocuments[ ]*\}\}//g')
                # template tags
                if [[ "${DOCUMENT_Type}" == "archive-json" ]] && [[ "${J}" -eq $((NUM_SUBDOCUMENTS - 1)) ]]; then
                    SUBDOCUMENT_RENDER=$(printf '%s' "${SUBDOCUMENT_RENDER}" | sed -E -e 's/\{\{[ ]*util.json-separator[ ]*\}\}//g')
                fi
                SUBDOCUMENT_RENDER_FILE=$(mktemp "${MARSH_TEMP}/subdocument-render-XXXXXX") || {
                    [[ "${SUBDOCUMENT_CONTENT_USE_ONCE}" == true ]] && rm -f "${SUBDOCUMENT_CONTENT}"
                    echo "Unable to create rendered subdocument file: ${MARSH_TEMP}/subdocument-render-XXXXXX" >&2
                    return 1
                }
                printf '%s\n' "${SUBDOCUMENT_RENDER}" > "${SUBDOCUMENT_RENDER_FILE}" || {
                    [[ "${SUBDOCUMENT_CONTENT_USE_ONCE}" == true ]] && rm -f "${SUBDOCUMENT_CONTENT}"
                    rm -f "${SUBDOCUMENT_RENDER_FILE}"
                    echo "Unable to write rendered subdocument: ${SUBDOCUMENT_SOURCE}" >&2
                    return 1
                }
                replace_tags "${SUBDOCUMENT_RENDER_FILE}" "SUBDOCUMENT_" "${SUBDOCUMENT_META_VARS:-}" || {
                    [[ "${SUBDOCUMENT_CONTENT_USE_ONCE}" == true ]] && rm -f "${SUBDOCUMENT_CONTENT}"
                    rm -f "${SUBDOCUMENT_RENDER_FILE}"
                    echo "Unable to replace tags in subdocument: ${SUBDOCUMENT_SOURCE}" >&2
                    return 1
                }
                # combine with previous subdocuments
                cat "${SUBDOCUMENT_RENDER_FILE}" >> "${SUBDOCUMENTS_FILE}"
                [[ "${SUBDOCUMENT_CONTENT_USE_ONCE}" == true ]] && rm -f "${SUBDOCUMENT_CONTENT}"
                rm -f "${SUBDOCUMENT_RENDER_FILE}"
            done
            awk -v subdocuments_file="${SUBDOCUMENTS_FILE}" '
            function emit_subdocuments(prefix, suffix, line, first, previous) {
                first = 1
                previous = ""
                while ((getline line < subdocuments_file) > 0) {
                    if (first) {
                        line = prefix line
                        first = 0
                    }
                    if (previous != "") {
                        print previous
                    }
                    previous = line
                }
                close(subdocuments_file)
                if (first) {
                    print prefix suffix
                } else {
                    print previous suffix
                }
            }
            {
                if (match($0, /\{\{[ ]*subdocuments[ ]*\}\}/)) {
                    emit_subdocuments(substr($0, 1, RSTART - 1), substr($0, RSTART + RLENGTH))
                } else {
                    print
                }
            }' "${DEST}" > "${DEST_SCRATCH}" || {
                rm -f "${DEST_SCRATCH}"
                return 1
            }
            mv "${DEST_SCRATCH}" "${DEST}" 2>/dev/null || {
                rm -f "${DEST_SCRATCH}"
                return 1
            }
        else
            <"${DEST}" sed -E -e 's/\{\{[ ]*subdocuments[ ]*\}\}//g' > "${DEST_SCRATCH}" || {
                rm -f "${DEST_SCRATCH}"
                return 1
            }
            mv "${DEST_SCRATCH}" "${DEST}" 2>/dev/null || {
                rm -f "${DEST_SCRATCH}"
                return 1
            }
        fi
    else
        cp "${DOCUMENT_CONTENT}" "${DEST}"
    fi  # TEMPLATE_DIR != "" else

    # smart comment tags
    <"${DEST}" sed -E \
    -e 's|<!--[ ]*([a-z]+)\.([^ ]*)([ ]+[^ ]+)[ ]*-->|<\1 class="\2"\3>|g' \
    -e 's|<!--[ ]*([a-z]+)\#([^ ]*)([ ]+[^ ]+)[ ]*-->|<\1 id="\2"\3>|g' \
    -e 's|<!--[ ]*([a-z]+)\.([^ ]*)[ ]*-->|<\1 class="\2">|g' \
    -e 's|<!--[ ]*([a-z]+)\#([^ ]*)[ ]*-->|<\1 id="\2">|g' \
    -e 's|<!--[ ]*\/([a-z]+)([.#])([^ ]*)[ ]*-->|</\1><!-- end \1\2\3 -->|g' \
    -e 's|<!--[ ]*\.([^ ]*)([ ]+[^ ]+)[ ]*-->|<div class="\1"\2>|g' \
    -e 's|<!--[ ]*\#([^ ]*)([ ]+[^ ]+)[ ]*-->|<div id="\1"\2>|g' \
    -e 's|<!--[ ]*\.([^ ]*)[ ]*-->|<div class="\1">|g' \
    -e 's|<!--[ ]*\#([^ ]*)[ ]*-->|<div id="\1">|g' \
    -e 's|<!--[ ]*\/([.#])([^ ]*)[ ]*-->|</div><!-- end div\1\2 -->|g' \
    > "${DEST_SCRATCH}" || {
        rm -f "${DEST_SCRATCH}"
        return 1
    }
    mv "${DEST_SCRATCH}" "${DEST}" 2>/dev/null || {
        rm -f "${DEST_SCRATCH}"
        return 1
    }

    # multiple classes foo.bar.baz to foo bar baz
    <"${DEST}" sed -E \
    -e ':a' -e 's|class="([^."]+)\.([^"]+)"|class="\1 \2"|g' -e 'ta' \
    > "${DEST_SCRATCH}" || {
        rm -f "${DEST_SCRATCH}"
        return 1
    }
    mv "${DEST_SCRATCH}" "${DEST}" 2>/dev/null || {
        rm -f "${DEST_SCRATCH}"
        return 1
    }

    # unwrap figures
    <"${DEST}" sed -E \
    -e 's|<p><figure>|<figure>|' \
    -e 's|</figure></p>|</figure>|' \
    > "${DEST_SCRATCH}" || {
        rm -f "${DEST_SCRATCH}"
        return 1
    }
    mv "${DEST_SCRATCH}" "${DEST}" 2>/dev/null || {
        rm -f "${DEST_SCRATCH}"
        return 1
    }

    # escape double quotes for JSON
    if [[ "${DOCUMENT_Type}" == "archive-json" ]]; then
        <"${DEST}" sed -E \
        -e ':a' -e 's|class="([^"]+)"|class=\\"\1\\"|g' -e 'ta' \
        > "${DEST_SCRATCH}" || {
            rm -f "${DEST_SCRATCH}"
            return 1
        }
        mv "${DEST_SCRATCH}" "${DEST}" 2>/dev/null || {
            rm -f "${DEST_SCRATCH}"
            return 1
        }
    fi

    if [[ "${DEST}" != "${DEST_FINAL}" ]]; then
        marsh_publish_processed_output "${DEST}" "${DEST_FINAL}" || return 1
    fi

    # path output at verbose level
    if marsh_should_log "verbose" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}"; then
        marsh_print_verbose_output_path "${DEST_PRINT}" || return 1
    fi
}

# copies template assets into the build output, resolving output paths relative to the target root
function marsh_copy_template_assets {  # marsh_copy_template_assets site_output_root target_output_rel log_level log_levels_csv templates_dir template #template_overrides[@] template_overrides[@] template_assets_path
    local SITE_OUTPUT_ROOT TARGET_OUTPUT_REL LOG_LEVEL LOG_LEVELS_CSV TEMPLATES_DIR TEMPLATE NUM_TEMPLATE_OVERRIDES TEMPLATE_ASSETS_PATH TEMPLATE_ASSETS
    local ASSET ASSET_PATH ASSET_OUTPUT_REL ASSET_SOURCE ASSET_DEST_PATH
    local CACHE_DIR CACHE_FILE
    local TEMPLATE_ASSET_RECORD TEMPLATE_ASSET_RECORD_REST
    local EXPECTED_MANIFEST CACHE_VALID
    local -a TEMPLATE_OVERRIDES TEMPLATE_ASSET_RECORDS

    # init
    SITE_OUTPUT_ROOT="${1:-}"
    TARGET_OUTPUT_REL="${2:-}"
    LOG_LEVEL="${3:-}"
    LOG_LEVELS_CSV="${4:-}"
    TEMPLATES_DIR="${5:-}"
    TEMPLATE="${6:-}"
    [[ "${SITE_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${TARGET_OUTPUT_REL}" == "" ]] && return 1
    [[ "${TEMPLATES_DIR}" == "" ]] && return 1
    [[ "${TEMPLATE}" == "" ]] && return 1
    shift 6
    NUM_TEMPLATE_OVERRIDES="${1:-0}"
    shift 1
    TEMPLATE_OVERRIDES=()
    while [[ "${NUM_TEMPLATE_OVERRIDES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        TEMPLATE_OVERRIDES+=("${1}")
        NUM_TEMPLATE_OVERRIDES=$((NUM_TEMPLATE_OVERRIDES - 1))
        shift 1
    done
    TEMPLATE_ASSETS_PATH="${1:-}"

    SITE_OUTPUT_ROOT="${SITE_OUTPUT_ROOT%/}"
    TARGET_OUTPUT_REL="${TARGET_OUTPUT_REL%/}"
    TEMPLATE_ASSETS_PATH="${TEMPLATE_ASSETS_PATH#./}"
    TEMPLATE_ASSETS_PATH="${TEMPLATE_ASSETS_PATH#/}"
    TEMPLATE_ASSETS_PATH="${TEMPLATE_ASSETS_PATH%/}"

    TEMPLATE_ASSETS=$(marsh_get_template_assets "${TEMPLATES_DIR}" "${TEMPLATE}" "${#TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_OVERRIDES[@]}") || return 1

    # create temporary directory
    CACHE_DIR="${MARSH_TEMP}/asset-copy-cache"
    mkdir -p "${CACHE_DIR}" >/dev/null 2>&1 || {
        echo "Unable to create asset copy cache directory: ${CACHE_DIR}" >&2
        return 1
    }

    # resolve asset output paths, skipping empty entries
    TEMPLATE_ASSET_RECORDS=()
    while IFS= read -r ASSET; do
        [[ "${ASSET}" == "" ]] && continue
        ASSET_PATH="${ASSET%\?*}"
        ASSET_OUTPUT_REL=$(marsh_resolve_template_asset_output_path "${TARGET_OUTPUT_REL:-.}" "${ASSET_PATH}" "${TEMPLATE_ASSETS_PATH}") || {
            echo "Invalid template asset output path: ${ASSET_PATH}" >&2
            return 1
        }
        ASSET_SOURCE="${TEMPLATES_DIR}/${TEMPLATE}/${ASSET_PATH}"
        ASSET_DEST_PATH="${SITE_OUTPUT_ROOT}/${ASSET_OUTPUT_REL}"
        marsh_validate_record_fields "template asset record" "${ASSET_SOURCE}" "${ASSET_DEST_PATH}" "${ASSET_OUTPUT_REL}" || return 1
        TEMPLATE_ASSET_RECORDS+=("$(printf '%s\037%s\037%s\n' "${ASSET_SOURCE}" "${ASSET_DEST_PATH}" "${ASSET_OUTPUT_REL}")")
    done <<< "${TEMPLATE_ASSETS}"
    [[ "${#TEMPLATE_ASSET_RECORDS[@]}" -gt 0 ]] || return 0

    # generate cache file path
    CACHE_FILE=$(marsh_get_cache_path "${CACHE_DIR}" ".manifest" "$({
        printf '%s\034%s\034%s\034%s\034%s\n' "${SITE_OUTPUT_ROOT}" "${TARGET_OUTPUT_REL}" "${TEMPLATES_DIR}" "${TEMPLATE}" "${TEMPLATE_ASSETS_PATH}"
        printf '%s\n' "${TEMPLATE_OVERRIDES[@]}"
    })") || return 1

    # validate existing cache and skip asset copying if all assets
    # are present at their expected output paths
    if [[ -f "${CACHE_FILE}" ]] && [[ -r "${CACHE_FILE}" ]]; then
        EXPECTED_MANIFEST=$(printf '%s\n' "${TEMPLATE_ASSET_RECORDS[@]}")
        if [[ "$(<"${CACHE_FILE}")" == "${EXPECTED_MANIFEST}" ]]; then
            CACHE_VALID=true
            while IFS= read -r TEMPLATE_ASSET_RECORD; do
                [[ "${TEMPLATE_ASSET_RECORD}" == "" ]] && continue
                IFS=$'\037' read -r ASSET_SOURCE ASSET_DEST_PATH ASSET_OUTPUT_REL TEMPLATE_ASSET_RECORD_REST <<< "${TEMPLATE_ASSET_RECORD}"
                if [[ "${ASSET_SOURCE}" == "" ]] || [[ "${ASSET_DEST_PATH}" == "" ]] || [[ "${ASSET_OUTPUT_REL}" == "" ]] || [[ "${TEMPLATE_ASSET_RECORD_REST}" != "" ]]; then
                    CACHE_VALID=false
                    break
                fi
                if [[ ! -e "${ASSET_DEST_PATH}" ]]; then
                    CACHE_VALID=false
                    break
                fi
            done < "${CACHE_FILE}"
        fi
    fi
    if [[ "${CACHE_VALID}" == true ]]; then
        return 0
    fi

    # cache is invalid or missing, copy assets and generate a new cache file
    for TEMPLATE_ASSET_RECORD in "${TEMPLATE_ASSET_RECORDS[@]}"; do
        [[ "${TEMPLATE_ASSET_RECORD}" == "" ]] && continue
        IFS=$'\037' read -r ASSET_SOURCE ASSET_DEST_PATH ASSET_OUTPUT_REL TEMPLATE_ASSET_RECORD_REST <<< "${TEMPLATE_ASSET_RECORD}"
        [[ "${ASSET_SOURCE}" != "" ]] || return 1
        [[ "${ASSET_DEST_PATH}" != "" ]] || return 1
        [[ "${ASSET_OUTPUT_REL}" != "" ]] || return 1
        [[ "${TEMPLATE_ASSET_RECORD_REST}" == "" ]] || return 1
        mkdir -p "${ASSET_DEST_PATH%/*}" || {
            echo "Unable to create asset path: ${ASSET_DEST_PATH%/*}" >&2
            return 1
        }
        rm -rf "${ASSET_DEST_PATH}" || {
            echo "Unable to replace asset path: ${ASSET_DEST_PATH}" >&2
            return 1
        }
        cp -R "${ASSET_SOURCE}" "${ASSET_DEST_PATH}" || {
            echo "Unable to copy asset: ${ASSET_SOURCE} -> ${ASSET_DEST_PATH}" >&2
            return 1
        }

        # path output at verbose level
        if marsh_should_log "verbose" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}"; then
            marsh_print_verbose_output_path "${ASSET_OUTPUT_REL}" || return 1
        fi
    done

    # write the generated asset copy cache file
    mkdir -p "${CACHE_FILE%/*}" >/dev/null 2>&1 || {
        echo "Unable to create asset copy cache directory: ${CACHE_FILE%/*}" >&2
        return 1
    }
    printf '%s\n' "${TEMPLATE_ASSET_RECORDS[@]}" > "${CACHE_FILE}" 2>/dev/null || {
        echo "Unable to write asset copy cache file: ${CACHE_FILE}" >&2
        rm -f "${CACHE_FILE}"
        return 1
    }
    return 0
}

# loads cached target-relative template asset output paths for one template context
function marsh_get_template_asset_output_paths {  # marsh_get_template_asset_output_paths target_output_rel templates_dir template #template_overrides[@] template_overrides[@] template_assets_path output_fonts_var output_styles_var output_scripts_var output_images_var output_audio_var output_video_var output_documents_var output_binaries_var output_other_var
    local TARGET_OUTPUT_REL TEMPLATES_DIR TEMPLATE NUM_TEMPLATE_OVERRIDES TEMPLATE_ASSETS_PATH
    local CACHE_DIR CACHE_FILE CACHE_TEMP TEMPLATE_PREFIX TEMPLATE_META TEMPLATE_METADATA_STATE_COUNT
    local OUTPUT_FONTS_VAR OUTPUT_STYLES_VAR OUTPUT_SCRIPTS_VAR OUTPUT_IMAGES_VAR OUTPUT_AUDIO_VAR OUTPUT_VIDEO_VAR OUTPUT_DOCUMENTS_VAR OUTPUT_BINARIES_VAR OUTPUT_OTHER_VAR
    local ASSET_TYPE ASSET_LISTS_TEXT_VAR ASSET ASSET_PATH ASSET_OUTPUT_PATH OUTPUT_LINE_TYPE OUTPUT_LINE_PATH
    local OUTPUT
    local TEMPLATE_ASSETS_FONTS_TEXT TEMPLATE_ASSETS_STYLES_TEXT TEMPLATE_ASSETS_SCRIPTS_TEXT TEMPLATE_ASSETS_IMAGES_TEXT
    local TEMPLATE_ASSETS_AUDIO_TEXT TEMPLATE_ASSETS_VIDEO_TEXT TEMPLATE_ASSETS_DOCUMENTS_TEXT TEMPLATE_ASSETS_BINARIES_TEXT TEMPLATE_ASSETS_OTHER_TEXT
    local OUTPUT_FONTS_TEXT OUTPUT_STYLES_TEXT OUTPUT_SCRIPTS_TEXT OUTPUT_IMAGES_TEXT OUTPUT_AUDIO_TEXT OUTPUT_VIDEO_TEXT OUTPUT_DOCUMENTS_TEXT OUTPUT_BINARIES_TEXT OUTPUT_OTHER_TEXT
    local -a TEMPLATE_OVERRIDES ASSET_TYPES

    # init
    TARGET_OUTPUT_REL="${1:-}"
    TEMPLATES_DIR="${2:-}"
    TEMPLATE="${3:-}"
    [[ "${TARGET_OUTPUT_REL}" == "" ]] && return 1
    [[ "${TEMPLATES_DIR}" == "" ]] && return 1
    [[ "${TEMPLATE}" == "" ]] && return 1
    shift 3
    NUM_TEMPLATE_OVERRIDES="${1:-0}"
    shift 1
    TEMPLATE_OVERRIDES=()
    while [[ "${NUM_TEMPLATE_OVERRIDES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        TEMPLATE_OVERRIDES+=("${1}")
        NUM_TEMPLATE_OVERRIDES=$((NUM_TEMPLATE_OVERRIDES - 1))
        shift 1
    done
    TEMPLATE_ASSETS_PATH="${1:-}"
    shift 1
    OUTPUT_FONTS_VAR="${1:-}"
    OUTPUT_STYLES_VAR="${2:-}"
    OUTPUT_SCRIPTS_VAR="${3:-}"
    OUTPUT_IMAGES_VAR="${4:-}"
    OUTPUT_AUDIO_VAR="${5:-}"
    OUTPUT_VIDEO_VAR="${6:-}"
    OUTPUT_DOCUMENTS_VAR="${7:-}"
    OUTPUT_BINARIES_VAR="${8:-}"
    OUTPUT_OTHER_VAR="${9:-}"
    [[ "${OUTPUT_FONTS_VAR}" != "" ]] || return 1
    [[ "${OUTPUT_STYLES_VAR}" != "" ]] || return 1
    [[ "${OUTPUT_SCRIPTS_VAR}" != "" ]] || return 1
    [[ "${OUTPUT_IMAGES_VAR}" != "" ]] || return 1
    [[ "${OUTPUT_AUDIO_VAR}" != "" ]] || return 1
    [[ "${OUTPUT_VIDEO_VAR}" != "" ]] || return 1
    [[ "${OUTPUT_DOCUMENTS_VAR}" != "" ]] || return 1
    [[ "${OUTPUT_BINARIES_VAR}" != "" ]] || return 1
    [[ "${OUTPUT_OTHER_VAR}" != "" ]] || return 1
    printf -v "${OUTPUT_FONTS_VAR}" '%s' ''
    printf -v "${OUTPUT_STYLES_VAR}" '%s' ''
    printf -v "${OUTPUT_SCRIPTS_VAR}" '%s' ''
    printf -v "${OUTPUT_IMAGES_VAR}" '%s' ''
    printf -v "${OUTPUT_AUDIO_VAR}" '%s' ''
    printf -v "${OUTPUT_VIDEO_VAR}" '%s' ''
    printf -v "${OUTPUT_DOCUMENTS_VAR}" '%s' ''
    printf -v "${OUTPUT_BINARIES_VAR}" '%s' ''
    printf -v "${OUTPUT_OTHER_VAR}" '%s' ''

    # normalize cache inputs so equivalent paths share one entry
    TARGET_OUTPUT_REL=$(marsh_normalize_internal_path "${TARGET_OUTPUT_REL}") || return 1
    TEMPLATE_ASSETS_PATH="${TEMPLATE_ASSETS_PATH#/}"
    if [[ "${TEMPLATE_ASSETS_PATH}" != "" ]]; then
        TEMPLATE_ASSETS_PATH=$(marsh_normalize_internal_path "${TEMPLATE_ASSETS_PATH}") || return 1
        [[ "${TEMPLATE_ASSETS_PATH}" == "." ]] && TEMPLATE_ASSETS_PATH=""
    fi

    # create temporary directory
    CACHE_DIR="${MARSH_TEMP}/template-asset-output-cache"
    mkdir -p "${CACHE_DIR}" >/dev/null 2>&1 || {
        echo "Unable to create template asset output cache directory: ${CACHE_DIR}" >&2
        return 1
    }

    # generate cache file path
    CACHE_FILE=$(marsh_get_cache_path "${CACHE_DIR}" ".paths" "$({
        printf '%s\034%s\034%s\034' "${TARGET_OUTPUT_REL}" "${TEMPLATES_DIR}/${TEMPLATE}" "${TEMPLATE_ASSETS_PATH}"
        printf '%s\034' "${TEMPLATE_OVERRIDES[@]}"
    })") || return 1

    # use existing cache if available
    if [[ ! -f "${CACHE_FILE}" ]] || [[ ! -r "${CACHE_FILE}" ]]; then
        # no existing cache, proceed to generate it
        # acquire lock for cache file creation
        if ! marsh_lock_acquire "${CACHE_FILE}" 2>/dev/null; then
            # unable to acquire lock, likely due to another process generating asset output paths
            # wait a while for the lock to be released and attempt to use the cache file if it exists
            if marsh_lock_wait "${CACHE_FILE}" 2>/dev/null; then
                # fail fast when the first writer releases the lock without publishing
                # lock ownership is not retried because a write failure aborts the whole build
                if [[ ! -f "${CACHE_FILE}" ]] || [[ ! -r "${CACHE_FILE}" ]]; then
                    echo "Template asset output cache file missing after lock wait: ${CACHE_FILE}" >&2
                    return 1
                fi
            else
                # error on timeout waiting for lock to be released
                echo "Unable to acquire template asset output cache lock: ${CACHE_FILE}" >&2
                return 1
            fi
        else
            # lock acquired, proceed generating and caching asset output paths
            # generate temporary cache file in lock directory
            CACHE_TEMP=$(marsh_lock_get_directory "${CACHE_FILE}")
            CACHE_TEMP="${CACHE_TEMP}/tempfile"
            touch "${CACHE_TEMP}" || {
                echo "Unable to create template asset output cache temporary file: ${CACHE_TEMP}" >&2
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }

            # load template metadata once before resolving each asset type
            TEMPLATE_PREFIX="TEMPLATE_"
            TEMPLATE_META=$(marsh_get_template_metadata "${TEMPLATE_PREFIX}" "${TEMPLATES_DIR}/${TEMPLATE}" "${#TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_OVERRIDES[@]}") || {
                echo "Unable to load template metadata: ${TEMPLATES_DIR}/${TEMPLATE}" >&2
                rm -f "${CACHE_TEMP}"
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }
            TEMPLATE_METADATA_STATE_COUNT=0
            marsh_load_template_metadata_state "${TEMPLATE_META}" "TEMPLATE_METADATA_STATE_" "TEMPLATE_METADATA_STATE_COUNT" || {
                rm -f "${CACHE_TEMP}"
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }
            marsh_load_template_asset_lists_from_metadata_state \
                "TEMPLATE_METADATA_STATE_" \
                "${TEMPLATE_METADATA_STATE_COUNT}" \
                "TEMPLATE_ASSETS_FONTS_TEXT" \
                "TEMPLATE_ASSETS_STYLES_TEXT" \
                "TEMPLATE_ASSETS_SCRIPTS_TEXT" \
                "TEMPLATE_ASSETS_IMAGES_TEXT" \
                "TEMPLATE_ASSETS_AUDIO_TEXT" \
                "TEMPLATE_ASSETS_VIDEO_TEXT" \
                "TEMPLATE_ASSETS_DOCUMENTS_TEXT" \
                "TEMPLATE_ASSETS_BINARIES_TEXT" \
                "TEMPLATE_ASSETS_OTHER_TEXT" || {
                rm -f "${CACHE_TEMP}"
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }

            # cache records so callers can rebuild arrays explicitly
            ASSET_TYPES=('FONTS' 'STYLES' 'SCRIPTS' 'IMAGES' 'AUDIO' 'VIDEO' 'DOCUMENTS' 'BINARIES' 'OTHER')
            OUTPUT=""
            for ASSET_TYPE in "${ASSET_TYPES[@]}"; do
                ASSET_LISTS_TEXT_VAR="TEMPLATE_ASSETS_${ASSET_TYPE}_TEXT"
                while IFS= read -r ASSET; do
                    [[ "${ASSET}" == "" ]] && continue
                    ASSET_PATH="${ASSET%\?*}"
                    ASSET_OUTPUT_PATH=$(marsh_resolve_template_asset_output_path "${TARGET_OUTPUT_REL}" "${ASSET_PATH}" "${TEMPLATE_ASSETS_PATH}") || {
                        echo "Unable to resolve template asset output path: ${ASSET_PATH}" >&2
                        rm -f "${CACHE_TEMP}"
                        marsh_lock_release "${CACHE_FILE}"
                        return 1
                    }
                    OUTPUT+="${ASSET_TYPE}"$'\t'"${ASSET_OUTPUT_PATH}"$'\n'
                done <<< "${!ASSET_LISTS_TEXT_VAR}"
            done
            printf '%s' "${OUTPUT}" > "${CACHE_TEMP}" || {
                echo "Unable to write template asset output cache file: ${CACHE_TEMP}" >&2
                rm -f "${CACHE_TEMP}"
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }

            # move temporary cache file into place as shared cache file
            mv "${CACHE_TEMP}" "${CACHE_FILE}" 2>/dev/null || {
                echo "Unable to write template asset output cache file: ${CACHE_FILE}" >&2
                rm -f "${CACHE_TEMP}"
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }

            marsh_lock_release "${CACHE_FILE}" || {
                echo "Unable to release template asset output cache lock: ${CACHE_FILE}" >&2
                return 1
            }
        fi
    fi

    OUTPUT_FONTS_TEXT=""
    OUTPUT_STYLES_TEXT=""
    OUTPUT_SCRIPTS_TEXT=""
    OUTPUT_IMAGES_TEXT=""
    OUTPUT_AUDIO_TEXT=""
    OUTPUT_VIDEO_TEXT=""
    OUTPUT_DOCUMENTS_TEXT=""
    OUTPUT_BINARIES_TEXT=""
    OUTPUT_OTHER_TEXT=""
    while IFS=$'\t' read -r OUTPUT_LINE_TYPE OUTPUT_LINE_PATH || [[ "${OUTPUT_LINE_TYPE}${OUTPUT_LINE_PATH}" != "" ]]; do
        [[ "${OUTPUT_LINE_TYPE}" != "" ]] || continue
        [[ "${OUTPUT_LINE_PATH}" != "" ]] || {
            echo "Malformed template asset output cache line: ${CACHE_FILE}" >&2
            return 1
        }
        case "${OUTPUT_LINE_TYPE}" in
            FONTS)
                [[ "${OUTPUT_FONTS_TEXT}" == "" ]] || OUTPUT_FONTS_TEXT+=$'\n'
                OUTPUT_FONTS_TEXT+="${OUTPUT_LINE_PATH}"
                ;;
            STYLES)
                [[ "${OUTPUT_STYLES_TEXT}" == "" ]] || OUTPUT_STYLES_TEXT+=$'\n'
                OUTPUT_STYLES_TEXT+="${OUTPUT_LINE_PATH}"
                ;;
            SCRIPTS)
                [[ "${OUTPUT_SCRIPTS_TEXT}" == "" ]] || OUTPUT_SCRIPTS_TEXT+=$'\n'
                OUTPUT_SCRIPTS_TEXT+="${OUTPUT_LINE_PATH}"
                ;;
            IMAGES)
                [[ "${OUTPUT_IMAGES_TEXT}" == "" ]] || OUTPUT_IMAGES_TEXT+=$'\n'
                OUTPUT_IMAGES_TEXT+="${OUTPUT_LINE_PATH}"
                ;;
            AUDIO)
                [[ "${OUTPUT_AUDIO_TEXT}" == "" ]] || OUTPUT_AUDIO_TEXT+=$'\n'
                OUTPUT_AUDIO_TEXT+="${OUTPUT_LINE_PATH}"
                ;;
            VIDEO)
                [[ "${OUTPUT_VIDEO_TEXT}" == "" ]] || OUTPUT_VIDEO_TEXT+=$'\n'
                OUTPUT_VIDEO_TEXT+="${OUTPUT_LINE_PATH}"
                ;;
            DOCUMENTS)
                [[ "${OUTPUT_DOCUMENTS_TEXT}" == "" ]] || OUTPUT_DOCUMENTS_TEXT+=$'\n'
                OUTPUT_DOCUMENTS_TEXT+="${OUTPUT_LINE_PATH}"
                ;;
            BINARIES)
                [[ "${OUTPUT_BINARIES_TEXT}" == "" ]] || OUTPUT_BINARIES_TEXT+=$'\n'
                OUTPUT_BINARIES_TEXT+="${OUTPUT_LINE_PATH}"
                ;;
            OTHER)
                [[ "${OUTPUT_OTHER_TEXT}" == "" ]] || OUTPUT_OTHER_TEXT+=$'\n'
                OUTPUT_OTHER_TEXT+="${OUTPUT_LINE_PATH}"
                ;;
            *)
                echo "Malformed template asset output cache line: ${CACHE_FILE}" >&2
                return 1
                ;;
        esac
    done < "${CACHE_FILE}" || {
        echo "Unable to read template asset output cache file: ${CACHE_FILE}" >&2
        return 1
    }

    printf -v "${OUTPUT_FONTS_VAR}" '%s' "${OUTPUT_FONTS_TEXT}"
    printf -v "${OUTPUT_STYLES_VAR}" '%s' "${OUTPUT_STYLES_TEXT}"
    printf -v "${OUTPUT_SCRIPTS_VAR}" '%s' "${OUTPUT_SCRIPTS_TEXT}"
    printf -v "${OUTPUT_IMAGES_VAR}" '%s' "${OUTPUT_IMAGES_TEXT}"
    printf -v "${OUTPUT_AUDIO_VAR}" '%s' "${OUTPUT_AUDIO_TEXT}"
    printf -v "${OUTPUT_VIDEO_VAR}" '%s' "${OUTPUT_VIDEO_TEXT}"
    printf -v "${OUTPUT_DOCUMENTS_VAR}" '%s' "${OUTPUT_DOCUMENTS_TEXT}"
    printf -v "${OUTPUT_BINARIES_VAR}" '%s' "${OUTPUT_BINARIES_TEXT}"
    printf -v "${OUTPUT_OTHER_VAR}" '%s' "${OUTPUT_OTHER_TEXT}"
    return 0
}

