    TARGET_OUTPUT_REL="${TARGET_OUTPUT_ROOT#$MARSH_CONFIG_PATH}"
    TARGET_OUTPUT_REL="${TARGET_OUTPUT_REL#/}"
    TARGET_OUTPUT_REL="${TARGET_OUTPUT_REL:-.}"
    marsh_normalize_internal_path "${TARGET_OUTPUT_REL}"
}

