    while [[ "${!ARCHIVE_PATH_NAME:-}" != "" ]]; do
        ARCHIVE_TYPES=()
        while IFS= read -r ARCHIVE_TYPE; do
            ARCHIVE_TYPES+=("${ARCHIVE_TYPE}")
        done < <(marsh_get_flatarray_values "${SOURCE_PREFIX}Archives_${II}_Types_")

        ARCHIVE_EXCLUDED_STATES=()
