function marsh_build_planned_target_documents {  # marsh_build_planned_target_documents site_output_root log_level log_levels_csv jobs sitemap sitemap_search templates_dir template markdown_command markdown_options_csv markdown_document_extensions_csv markdown_document_extensions_replacement remove_link_filenames_csv #template_overrides[@] template_overrides[@] template_assets_path document_records[@]
    local SITE_OUTPUT_ROOT LOG_LEVEL LOG_LEVELS_CSV JOBS SITEMAP SITEMAP_SEARCH TEMPLATES_DIR TEMPLATE
    local MARKDOWN_COMMAND MARKDOWN_OPTIONS_CSV MARKDOWN_DOCUMENT_EXTENSIONS_CSV MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT REMOVE_LINK_FILENAMES_CSV
    local NUM_TEMPLATE_OVERRIDES TEMPLATE_ASSETS_PATH
    local DOCUMENT_RECORD DOCUMENT_ID SOURCE_RELPATH TARGET_OUTPUT_REL SOURCE_ROOT
    local RECORD_REST
    local PLAN_CONTEXT_IDENTIFIED PLAN_TARGET_OUTPUT_REL PLAN_SOURCE_ROOT
    local -a TEMPLATE_OVERRIDES DOCUMENTS

    SITE_OUTPUT_ROOT="${1:-.}"
    LOG_LEVEL="${2:-}"
    LOG_LEVELS_CSV="${3:-}"
