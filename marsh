            if [[ "${TEMPLATE_BASE}" != "" ]]; then
                if [[ -f "${TEMPLATE_BASE}" ]] && [[ -r "${TEMPLATE_BASE}" ]]; then
                    TEMPLATE_RENDER=$(<"${TEMPLATE_BASE}")
