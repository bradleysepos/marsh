        done

        # sitemap
        TARGET_SITEMAP=""
        if [[ "${SITEMAP_SOURCE}" != "" ]]; then
            # lookup failure is only an error where sitemap search is disabled; the document will simply
            # be rendered without a sitemap where sitemap search is enabled and no sitemap can be found
            # note that this can swallow lower level errors that may require manual debugging anyway
            SITEMAP_LOOKUP_PATH=$(marsh_get_sitemap_lookup_path "${BUILD_CONTEXT_OUTPUT_ROOT}" "${DOCUMENT_REL_TO_TARGET}" "${SITEMAP_SOURCE}" "${SITEMAP_SEARCH}" 2>/dev/null);
            if [[ $? -ne 0 ]] && [[ "${SITEMAP_SEARCH}" == false ]]; then
                echo "Unable to resolve configured sitemap for document: ${DOCUMENT_SITE_REL} (${SITEMAP_SOURCE})" >&2
                return 1
            fi
            if [[ "${SITEMAP_LOOKUP_PATH}" != "" ]]; then
                SITEMAP_RENDER_PATH=$(marsh_get_sitemap_render_path "${BUILD_CONTEXT_OUTPUT_ROOT}" "${SITEMAP_LOOKUP_PATH}") || return 1
                if [[ ! -f "${SITEMAP_RENDER_PATH}" ]] || [[ ! -r "${SITEMAP_RENDER_PATH}" ]]; then
                    echo "Configured sitemap render not found for document: ${DOCUMENT_SITE_REL} (${SITEMAP_LOOKUP_PATH})" >&2
                    return 1
                fi
                SITEMAP_OUTPUT_PATH=$(marsh_normalize_internal_path "${TARGET_OUTPUT_REL}/${SITEMAP_LOOKUP_PATH}") || return 1
                SITEMAP_OUTPUT_PATH_EXT=$(marsh_get_extension "${SITEMAP_OUTPUT_PATH}")
                if marsh_is_markdown_extension "${SITEMAP_OUTPUT_PATH_EXT}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}"; then
                    SITEMAP_OUTPUT_PATH="${SITEMAP_OUTPUT_PATH%.*}${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}"
                fi
                SITEMAP_NAME="${SITEMAP_OUTPUT_PATH##*/}"
                SITEMAP_DIR=$(marsh_normalize_internal_path "${SITEMAP_OUTPUT_PATH%/*}") || return 1
                SITEMAP_HREF=$(marsh_get_relative_path "${DOCUMENT_BASE_REL}" "${SITEMAP_OUTPUT_PATH}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
                PROCESSED_SITEMAP_PATH=$(marsh_get_processed_sitemap "${SITEMAP_RENDER_PATH}" "${SITEMAP_DIR}" "${DOCUMENT_BASE_REL}" "${REMOVE_LINK_FILENAMES_CSV}") || {
                    echo "Unable to process configured sitemap for document: ${DOCUMENT_SITE_REL} (${SITEMAP_LOOKUP_PATH})" >&2
                    return 1
                }
                DOCUMENT_HREF_ESC=$(printf '%s' "${DOCUMENT_HREF}" | sed -e 's/[\\]/\\\\/g' -e 's/[][/.|$(){}?+*^]/\\&/g')
                TARGET_SITEMAP=$(<"${PROCESSED_SITEMAP_PATH}" sed -E \
                -e 's|<h1>([^<]+)</h1>|<h1><a href="'"${SITEMAP_HREF}"'">\1</a></h1>|' \
                -e 's|<a (href="'"${DOCUMENT_HREF_ESC}"'"[^>]*)>([^<>]+)</a>|<a \1 class="selected">\2</a>|g')
            fi
        fi

        TEMPLATE_BASE_ESC=$(printf '%s' "${TEMPLATE_BASE_TEMPLATE}" | marsh_escape_substitution)
        TEMPLATE_HEAD_ESC=$(printf '%s' "${TEMPLATE_HEAD_TEMPLATE}" | marsh_escape_substitution)
        TEMPLATE_BODY_ESC=$(printf '%s' "${TEMPLATE_BODY_TEMPLATE}" | marsh_escape_substitution)
        TEMPLATE_DOCUMENT_ESC=$(printf '%s' "${TEMPLATE_DOCUMENT_TEMPLATE}" | marsh_escape_substitution)
        TEMPLATE_HEADER_ESC=$(printf '%s' "${TEMPLATE_HEADER_TEMPLATE}" | marsh_escape_substitution)
        TEMPLATE_FOOTER_ESC=$(printf '%s' "${TEMPLATE_FOOTER_TEMPLATE}" | marsh_escape_substitution)
        TEMPLATE_NAV_ESC=$(printf '%s' "${TEMPLATE_NAV_TEMPLATE}" | marsh_escape_substitution)
        TEMPLATE_NOTICE_ESC=$(printf '%s' "${TEMPLATE_NOTICE_TEMPLATE}" | marsh_escape_substitution)

        TEMPLATE_RENDER=$(printf '%s' "${TEMPLATE_BASE_TEMPLATE}" | sed -E \
        -e "/\{\{[ ]*template\.head[ ]*\}\}/s//${TEMPLATE_HEAD_ESC:-}/g" \
        -e "/\{\{[ ]*template\.body[ ]*\}\}/s//${TEMPLATE_BODY_ESC:-}/g" \
        -e "/\{\{[ ]*template\.document[ ]*\}\}/s//${TEMPLATE_DOCUMENT_ESC:-}/g" \
        -e "/\{\{[ ]*template\.header[ ]*\}\}/s//${TEMPLATE_HEADER_ESC:-}/g" \
        -e "/\{\{[ ]*template\.footer[ ]*\}\}/s//${TEMPLATE_FOOTER_ESC:-}/g" \
        -e "/\{\{[ ]*template\.nav[ ]*\}\}/s//${TEMPLATE_NAV_ESC:-}/g" \
        -e "/\{\{[ ]*template\.notice[ ]*\}\}/s//${TEMPLATE_NOTICE_ESC:-}/g")

        for TEMPLATE_ASSET_TYPE in "${TEMPLATE_ASSET_TYPES[@]}"; do
            case "${TEMPLATE_ASSET_TYPE}" in
                FONTS)
                    for ASSET_INDEX in "${!TEMPLATE_ASSETS_FONTS[@]}"; do
                        ASSET="${TEMPLATE_ASSETS_FONTS[$ASSET_INDEX]}"
                        ASSET_PATH="${ASSET%\?*}"
                        ASSET_QUERY="${ASSET#${ASSET_PATH}}"
                        ASSET_OUTPUT_PATH="${TEMPLATE_ASSET_OUTPUT_PATHS_FONTS[$ASSET_INDEX]:-}"
                        [[ "${ASSET_OUTPUT_PATH}" != "" ]] || return 1
                        ASSET_HREF=$(marsh_get_relative_path "${DOCUMENT_BASE_REL}" "${ASSET_OUTPUT_PATH}") || return 1
                        TEMPLATE_TAG_ASSETS_FONTS+=("${ASSET_HREF}${ASSET_QUERY}")
                    done
                    ;;
                STYLES)
                    for ASSET_INDEX in "${!TEMPLATE_ASSETS_STYLES[@]}"; do
                        ASSET="${TEMPLATE_ASSETS_STYLES[$ASSET_INDEX]}"
                        ASSET_PATH="${ASSET%\?*}"
                        ASSET_QUERY="${ASSET#${ASSET_PATH}}"
                        ASSET_OUTPUT_PATH="${TEMPLATE_ASSET_OUTPUT_PATHS_STYLES[$ASSET_INDEX]:-}"
                        [[ "${ASSET_OUTPUT_PATH}" != "" ]] || return 1
                        ASSET_HREF=$(marsh_get_relative_path "${DOCUMENT_BASE_REL}" "${ASSET_OUTPUT_PATH}") || return 1
                        TEMPLATE_TAG_ASSETS_STYLES+=("${ASSET_HREF}${ASSET_QUERY}")
                    done
