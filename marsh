                NAV_RELPATH="${NAV_RELPATH:-.}"         # empty to current dir
                NAV_RELPATH="${NAV_RELPATH%/}"          # drop trailing slash
                TEMPLATE_ADVNAV=$(<"${DEST_DIR}/${TARGET_DIR}/${NAV}" sed -E \
                -e 's|<h1>([^<]+)</h1>|<h1><a href="'"${NAV_RELPATH}/${NAV_NAME}"'">\1</a></h1>|' \
