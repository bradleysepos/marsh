# returns the temp work root for a target under the temporary directory
function marsh_get_target_temp_root {  # marsh_get_target_temp_root target_output_root
    local TARGET_OUTPUT_ROOT TARGET_OUTPUT_REL TARGET_KEY

    TARGET_OUTPUT_ROOT="${1:-}"
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${MARSH_TEMP:-}" != "" ]] || return 1

    TARGET_OUTPUT_REL=$(marsh_get_target_output_path "${TARGET_OUTPUT_ROOT}") || return 1
    TARGET_KEY="${TARGET_OUTPUT_REL#./}"
    [[ "${TARGET_KEY}" == "." ]] && TARGET_KEY=""
    TARGET_KEY="${TARGET_KEY:-root}"

    # MARSH_TEMP is unique per run, so path only requires a stable target-relative key
    printf '%s\n' "${MARSH_TEMP}/build/targets/${TARGET_KEY}"
}

# loads the build target metadata for one target prefix
function marsh_load_target_build_metadata {  # marsh_load_target_build_metadata source_prefix target_path_var target_name_var target_source_var target_force_var target_sitemap_var target_sitemap_search_var target_template_source_var target_template_var target_template_assets_path_var target_template_overrides_text_var
    local SOURCE_PREFIX TARGET_PATH_VAR TARGET_NAME_VAR TARGET_SOURCE_VAR TARGET_FORCE_VAR TARGET_SITEMAP_VAR TARGET_SITEMAP_SEARCH_VAR
    local TARGET_TEMPLATE_SOURCE_VAR TARGET_TEMPLATE_VAR TARGET_TEMPLATE_ASSETS_PATH_VAR TARGET_TEMPLATE_OVERRIDES_TEXT_VAR
    local TARGET_PATH_NAME TARGET_NAME_NAME TARGET_SOURCE_NAME TARGET_FORCE_NAME TARGET_SITEMAP_NAME TARGET_SITEMAP_SOURCE_NAME TARGET_SITEMAP_SEARCH_NAME
    local TARGET_TEMPLATE_SOURCE_NAME TARGET_TEMPLATE_ASSETS_PATH_NAME TARGET_TEMPLATE_OVERRIDE TARGET_TEMPLATE_OVERRIDES_JOINED OIFS
    local TARGET_PATH_VALUE TARGET_NAME_VALUE TARGET_SOURCE_VALUE TARGET_FORCE_VALUE TARGET_SITEMAP_VALUE TARGET_SITEMAP_SEARCH_VALUE
    local TARGET_TEMPLATE_SOURCE_VALUE TARGET_TEMPLATE_VALUE TARGET_TEMPLATE_ASSETS_PATH_VALUE

    SOURCE_PREFIX="${1:-}"
    TARGET_PATH_VAR="${2:-}"
    TARGET_NAME_VAR="${3:-}"
    TARGET_SOURCE_VAR="${4:-}"
    TARGET_FORCE_VAR="${5:-}"
    TARGET_SITEMAP_VAR="${6:-}"
    TARGET_SITEMAP_SEARCH_VAR="${7:-}"
    TARGET_TEMPLATE_SOURCE_VAR="${8:-}"
    TARGET_TEMPLATE_VAR="${9:-}"
    TARGET_TEMPLATE_ASSETS_PATH_VAR="${10:-}"
    TARGET_TEMPLATE_OVERRIDES_TEXT_VAR="${11:-}"
    [[ "${SOURCE_PREFIX}" == "" ]] && return 1
    [[ "${TARGET_PATH_VAR}" == "" ]] && return 1
    [[ "${TARGET_NAME_VAR}" == "" ]] && return 1
    [[ "${TARGET_SOURCE_VAR}" == "" ]] && return 1
    [[ "${TARGET_FORCE_VAR}" == "" ]] && return 1
    [[ "${TARGET_SITEMAP_VAR}" == "" ]] && return 1
    [[ "${TARGET_SITEMAP_SEARCH_VAR}" == "" ]] && return 1
    [[ "${TARGET_TEMPLATE_SOURCE_VAR}" == "" ]] && return 1
    [[ "${TARGET_TEMPLATE_VAR}" == "" ]] && return 1
    [[ "${TARGET_TEMPLATE_ASSETS_PATH_VAR}" == "" ]] && return 1
    [[ "${TARGET_TEMPLATE_OVERRIDES_TEXT_VAR}" == "" ]] && return 1

    TARGET_PATH_NAME="${SOURCE_PREFIX}Path"
    [[ -z ${!TARGET_PATH_NAME+isset} ]] && return 1
    TARGET_NAME_NAME="${SOURCE_PREFIX}Name"
    TARGET_SOURCE_NAME="${SOURCE_PREFIX}Source"
    TARGET_FORCE_NAME="${SOURCE_PREFIX}Force"
    TARGET_SITEMAP_NAME="${SOURCE_PREFIX}Sitemap"
    TARGET_SITEMAP_SOURCE_NAME="${SOURCE_PREFIX}Sitemap_Source"
    TARGET_SITEMAP_SEARCH_NAME="${SOURCE_PREFIX}Sitemap_Search"
    TARGET_TEMPLATE_SOURCE_NAME="${SOURCE_PREFIX}Template_Source"
    TARGET_TEMPLATE_ASSETS_PATH_NAME="${SOURCE_PREFIX}Template_Assets_Path"

    TARGET_PATH_VALUE="${!TARGET_PATH_NAME}"
    TARGET_NAME_VALUE="${!TARGET_NAME_NAME:-}"
    TARGET_SOURCE_VALUE="${!TARGET_SOURCE_NAME:-}"
    TARGET_FORCE_VALUE="${!TARGET_FORCE_NAME:-}"
    TARGET_SITEMAP_VALUE="${!TARGET_SITEMAP_SOURCE_NAME:-}"
    if [[ "${TARGET_SITEMAP_VALUE}" == "" ]]; then
        TARGET_SITEMAP_VALUE="${!TARGET_SITEMAP_NAME:-}"
    fi
    TARGET_SITEMAP_SEARCH_VALUE="${!TARGET_SITEMAP_SEARCH_NAME:-}"
    TARGET_TEMPLATE_SOURCE_VALUE="${!TARGET_TEMPLATE_SOURCE_NAME:-}"
    TARGET_TEMPLATE_ASSETS_PATH_VALUE="${!TARGET_TEMPLATE_ASSETS_PATH_NAME:-}"
    TARGET_TEMPLATE_VALUE=""
    if [[ "${TARGET_TEMPLATE_SOURCE_VALUE}" != "" ]]; then
        TARGET_TEMPLATE_VALUE=$(marsh_get_template_cache_name "${TARGET_TEMPLATE_SOURCE_VALUE}") || return 1
    fi

    TARGET_TEMPLATE_OVERRIDES_JOINED=""
    while IFS= read -r TARGET_TEMPLATE_OVERRIDE; do
        [[ "${TARGET_TEMPLATE_OVERRIDE}" == "" ]] && continue
        if [[ "${TARGET_TEMPLATE_OVERRIDES_JOINED}" == "" ]]; then
            TARGET_TEMPLATE_OVERRIDES_JOINED="${TARGET_TEMPLATE_OVERRIDE}"
        else
            OIFS="${IFS}"
            IFS=$'\n'
            TARGET_TEMPLATE_OVERRIDES_JOINED+=$'\n'"${TARGET_TEMPLATE_OVERRIDE}"
            IFS="${OIFS}"
        fi
    done < <(marsh_get_flatarray_values "${SOURCE_PREFIX}Template_Overrides_") || return 1

    # write target build fields into caller-owned locals
    printf -v "${TARGET_PATH_VAR}" '%s' "${TARGET_PATH_VALUE}"
    printf -v "${TARGET_NAME_VAR}" '%s' "${TARGET_NAME_VALUE}"
    printf -v "${TARGET_SOURCE_VAR}" '%s' "${TARGET_SOURCE_VALUE}"
    printf -v "${TARGET_FORCE_VAR}" '%s' "${TARGET_FORCE_VALUE}"
    printf -v "${TARGET_SITEMAP_VAR}" '%s' "${TARGET_SITEMAP_VALUE}"
    printf -v "${TARGET_SITEMAP_SEARCH_VAR}" '%s' "${TARGET_SITEMAP_SEARCH_VALUE}"
    printf -v "${TARGET_TEMPLATE_SOURCE_VAR}" '%s' "${TARGET_TEMPLATE_SOURCE_VALUE}"
    printf -v "${TARGET_TEMPLATE_VAR}" '%s' "${TARGET_TEMPLATE_VALUE}"
    printf -v "${TARGET_TEMPLATE_ASSETS_PATH_VAR}" '%s' "${TARGET_TEMPLATE_ASSETS_PATH_VALUE}"
    printf -v "${TARGET_TEMPLATE_OVERRIDES_TEXT_VAR}" '%s' "${TARGET_TEMPLATE_OVERRIDES_JOINED}"
}

# loads the fixed-shape target plan context used by the planned target executor
function marsh_load_target_plan_build_context {  # marsh_load_target_plan_build_context target_plan_root target_output_rel_var target_force_var target_skip_template_assets_var target_sitemap_var target_sitemap_search_var templates_dir_var template_var template_assets_path_var build_context_target_output_rel_var build_context_source_root_var config_file_dir_var target_name_var target_template_source_var template_overrides_text_var
    local TARGET_PLAN_ROOT TARGET_OUTPUT_REL_VAR TARGET_FORCE_VAR TARGET_SKIP_TEMPLATE_ASSETS_VAR TARGET_SITEMAP_VAR TARGET_SITEMAP_SEARCH_VAR TEMPLATES_DIR_VAR TEMPLATE_VAR TEMPLATE_ASSETS_PATH_VAR
    local BUILD_CONTEXT_TARGET_OUTPUT_REL_VAR BUILD_CONTEXT_SOURCE_ROOT_VAR CONFIG_FILE_DIR_VAR TARGET_NAME_VAR TARGET_TEMPLATE_SOURCE_VAR TEMPLATE_OVERRIDES_TEXT_VAR
    local CONTEXT_FILE CONTEXT_LINE CONTEXT_KEY CONTEXT_VALUE OIFS TEMPLATE_OVERRIDES_JOINED
    local TARGET_OUTPUT_REL_VALUE TARGET_FORCE_VALUE TARGET_SKIP_TEMPLATE_ASSETS_VALUE TARGET_SITEMAP_VALUE TARGET_SITEMAP_SEARCH_VALUE TEMPLATES_DIR_VALUE TEMPLATE_VALUE TEMPLATE_ASSETS_PATH_VALUE
    local BUILD_CONTEXT_TARGET_OUTPUT_REL_VALUE BUILD_CONTEXT_SOURCE_ROOT_VALUE CONFIG_FILE_DIR_VALUE TARGET_NAME_VALUE TARGET_TEMPLATE_SOURCE_VALUE HAS_TARGET_OUTPUT_REL
    local -a TEMPLATE_OVERRIDE_VALUES

    TARGET_PLAN_ROOT="${1:-}"
    TARGET_OUTPUT_REL_VAR="${2:-}"
    TARGET_FORCE_VAR="${3:-}"
    TARGET_SKIP_TEMPLATE_ASSETS_VAR="${4:-}"
    TARGET_SITEMAP_VAR="${5:-}"
    TARGET_SITEMAP_SEARCH_VAR="${6:-}"
    TEMPLATES_DIR_VAR="${7:-}"
    TEMPLATE_VAR="${8:-}"
    TEMPLATE_ASSETS_PATH_VAR="${9:-}"
    BUILD_CONTEXT_TARGET_OUTPUT_REL_VAR="${10:-}"
    BUILD_CONTEXT_SOURCE_ROOT_VAR="${11:-}"
    CONFIG_FILE_DIR_VAR="${12:-}"
    TARGET_NAME_VAR="${13:-}"
    TARGET_TEMPLATE_SOURCE_VAR="${14:-}"
    TEMPLATE_OVERRIDES_TEXT_VAR="${15:-}"
    [[ "${TARGET_PLAN_ROOT}" == "" ]] && return 1
    [[ "${TARGET_OUTPUT_REL_VAR}" == "" ]] && return 1
    [[ "${TARGET_FORCE_VAR}" == "" ]] && return 1
    [[ "${TARGET_SKIP_TEMPLATE_ASSETS_VAR}" == "" ]] && return 1
    [[ "${TARGET_SITEMAP_VAR}" == "" ]] && return 1
    [[ "${TARGET_SITEMAP_SEARCH_VAR}" == "" ]] && return 1
    [[ "${TEMPLATES_DIR_VAR}" == "" ]] && return 1
    [[ "${TEMPLATE_VAR}" == "" ]] && return 1
    [[ "${TEMPLATE_ASSETS_PATH_VAR}" == "" ]] && return 1
    [[ "${BUILD_CONTEXT_TARGET_OUTPUT_REL_VAR}" == "" ]] && return 1
    [[ "${BUILD_CONTEXT_SOURCE_ROOT_VAR}" == "" ]] && return 1
    [[ "${CONFIG_FILE_DIR_VAR}" == "" ]] && return 1
    [[ "${TARGET_NAME_VAR}" == "" ]] && return 1
    [[ "${TARGET_TEMPLATE_SOURCE_VAR}" == "" ]] && return 1
    [[ "${TEMPLATE_OVERRIDES_TEXT_VAR}" == "" ]] && return 1

    CONTEXT_FILE="${TARGET_PLAN_ROOT}/context"
    [[ -f "${CONTEXT_FILE}" ]] && [[ -r "${CONTEXT_FILE}" ]] || {
        echo "Target plan context file not found: ${CONTEXT_FILE}" >&2
        return 1
    }

    TARGET_OUTPUT_REL_VALUE=""
    TARGET_FORCE_VALUE="false"
    TARGET_SKIP_TEMPLATE_ASSETS_VALUE="false"
    TARGET_SITEMAP_VALUE=""
    TARGET_SITEMAP_SEARCH_VALUE="false"
    TEMPLATES_DIR_VALUE=""
    TEMPLATE_VALUE=""
    TEMPLATE_ASSETS_PATH_VALUE=""
    BUILD_CONTEXT_TARGET_OUTPUT_REL_VALUE=""
    BUILD_CONTEXT_SOURCE_ROOT_VALUE=""
    CONFIG_FILE_DIR_VALUE=""
    TARGET_NAME_VALUE=""
    TARGET_TEMPLATE_SOURCE_VALUE=""
    HAS_TARGET_OUTPUT_REL=false
    TEMPLATE_OVERRIDE_VALUES=()

    # read the fixed-shape context once and rebuild only the values planned-target execution uses
    while IFS= read -r CONTEXT_LINE || [[ "${CONTEXT_LINE}" != "" ]]; do
        [[ "${CONTEXT_LINE}" == "" ]] && continue
        case "${CONTEXT_LINE}" in
            *$'\t'*)
                CONTEXT_KEY="${CONTEXT_LINE%%$'\t'*}"
                CONTEXT_VALUE="${CONTEXT_LINE#*$'\t'}"
                ;;
            *)
                echo "Malformed target plan context line: ${CONTEXT_FILE}" >&2
                return 1
                ;;
        esac
        case "${CONTEXT_KEY}" in
            TARGET_OUTPUT_REL)
                TARGET_OUTPUT_REL_VALUE="${CONTEXT_VALUE}"
                HAS_TARGET_OUTPUT_REL=true
                ;;
            TARGET_FORCE)
                [[ "${CONTEXT_VALUE}" == true ]] || [[ "${CONTEXT_VALUE}" == false ]] || {
                    echo "Target plan context has invalid TARGET_FORCE: ${CONTEXT_FILE}" >&2
                    return 1
                }
                TARGET_FORCE_VALUE="${CONTEXT_VALUE}"
                ;;
            TARGET_SKIP_TEMPLATE_ASSETS)
                [[ "${CONTEXT_VALUE}" == true ]] || [[ "${CONTEXT_VALUE}" == false ]] || {
                    echo "Target plan context has invalid TARGET_SKIP_TEMPLATE_ASSETS: ${CONTEXT_FILE}" >&2
                    return 1
                }
                TARGET_SKIP_TEMPLATE_ASSETS_VALUE="${CONTEXT_VALUE}"
                ;;
            TARGET_SITEMAP)
                TARGET_SITEMAP_VALUE="${CONTEXT_VALUE}"
                ;;
            TARGET_SITEMAP_SEARCH)
                [[ "${CONTEXT_VALUE}" == true ]] || [[ "${CONTEXT_VALUE}" == false ]] || {
                    echo "Target plan context has invalid TARGET_SITEMAP_SEARCH: ${CONTEXT_FILE}" >&2
                    return 1
                }
                TARGET_SITEMAP_SEARCH_VALUE="${CONTEXT_VALUE}"
                ;;
            TEMPLATES_DIR)
                TEMPLATES_DIR_VALUE="${CONTEXT_VALUE}"
                ;;
            TEMPLATE)
                TEMPLATE_VALUE="${CONTEXT_VALUE}"
                ;;
            TEMPLATE_ASSETS_PATH)
                TEMPLATE_ASSETS_PATH_VALUE="${CONTEXT_VALUE}"
                ;;
            BUILD_CONTEXT_TARGET_OUTPUT_REL)
                BUILD_CONTEXT_TARGET_OUTPUT_REL_VALUE="${CONTEXT_VALUE}"
                ;;
            BUILD_CONTEXT_SOURCE_ROOT)
                BUILD_CONTEXT_SOURCE_ROOT_VALUE="${CONTEXT_VALUE}"
                ;;
            CONFIG_FILE_DIR)
                CONFIG_FILE_DIR_VALUE="${CONTEXT_VALUE}"
                ;;
            TARGET_NAME)
                TARGET_NAME_VALUE="${CONTEXT_VALUE}"
                ;;
            TARGET_TEMPLATE_SOURCE)
                TARGET_TEMPLATE_SOURCE_VALUE="${CONTEXT_VALUE}"
                ;;
            TEMPLATE_OVERRIDE)
                TEMPLATE_OVERRIDE_VALUES+=("${CONTEXT_VALUE}")
                ;;
            *)
                echo "Target plan context has unsupported field ${CONTEXT_KEY}: ${CONTEXT_FILE}" >&2
                return 1
                ;;
        esac
    done < "${CONTEXT_FILE}" || {
        echo "Unable to read target plan context file: ${CONTEXT_FILE}" >&2
        return 1
    }

    [[ "${HAS_TARGET_OUTPUT_REL}" == true ]] || {
        echo "Target plan context missing TARGET_OUTPUT_REL: ${CONTEXT_FILE}" >&2
        return 1
    }

    printf -v "${TARGET_OUTPUT_REL_VAR}" '%s' "${TARGET_OUTPUT_REL_VALUE}"
    printf -v "${TARGET_FORCE_VAR}" '%s' "${TARGET_FORCE_VALUE}"
    printf -v "${TARGET_SKIP_TEMPLATE_ASSETS_VAR}" '%s' "${TARGET_SKIP_TEMPLATE_ASSETS_VALUE}"
    printf -v "${TARGET_SITEMAP_VAR}" '%s' "${TARGET_SITEMAP_VALUE}"
    printf -v "${TARGET_SITEMAP_SEARCH_VAR}" '%s' "${TARGET_SITEMAP_SEARCH_VALUE}"
    printf -v "${TEMPLATES_DIR_VAR}" '%s' "${TEMPLATES_DIR_VALUE}"
    printf -v "${TEMPLATE_VAR}" '%s' "${TEMPLATE_VALUE}"
    printf -v "${TEMPLATE_ASSETS_PATH_VAR}" '%s' "${TEMPLATE_ASSETS_PATH_VALUE}"
    printf -v "${BUILD_CONTEXT_TARGET_OUTPUT_REL_VAR}" '%s' "${BUILD_CONTEXT_TARGET_OUTPUT_REL_VALUE}"
    printf -v "${BUILD_CONTEXT_SOURCE_ROOT_VAR}" '%s' "${BUILD_CONTEXT_SOURCE_ROOT_VALUE}"
    printf -v "${CONFIG_FILE_DIR_VAR}" '%s' "${CONFIG_FILE_DIR_VALUE}"
    printf -v "${TARGET_NAME_VAR}" '%s' "${TARGET_NAME_VALUE}"
    printf -v "${TARGET_TEMPLATE_SOURCE_VAR}" '%s' "${TARGET_TEMPLATE_SOURCE_VALUE}"
    TEMPLATE_OVERRIDES_JOINED=""
    if [[ "${#TEMPLATE_OVERRIDE_VALUES[@]}" -gt 0 ]]; then
        OIFS="${IFS}"
        IFS=$'\n'
        TEMPLATE_OVERRIDES_JOINED="${TEMPLATE_OVERRIDE_VALUES[*]}"
        IFS="${OIFS}"
    fi
    printf -v "${TEMPLATE_OVERRIDES_TEXT_VAR}" '%s' "${TEMPLATE_OVERRIDES_JOINED}"
}

# loads the configured source field for one target prefix
function marsh_load_target_source_value {  # marsh_load_target_source_value source_prefix source_var
    local SOURCE_PREFIX SOURCE_VAR TARGET_PATH_NAME TARGET_SOURCE_NAME TARGET_SOURCE_FIELD_VALUE

    SOURCE_PREFIX="${1:-}"
    SOURCE_VAR="${2:-}"
    [[ "${SOURCE_PREFIX}" == "" ]] && return 1
    [[ "${SOURCE_VAR}" == "" ]] && return 1

    TARGET_PATH_NAME="${SOURCE_PREFIX}Path"
    [[ -z ${!TARGET_PATH_NAME+isset} ]] && return 1
    TARGET_SOURCE_NAME="${SOURCE_PREFIX}Source"
    TARGET_SOURCE_FIELD_VALUE="${!TARGET_SOURCE_NAME:-}"

    printf -v "${SOURCE_VAR}" '%s' "${TARGET_SOURCE_FIELD_VALUE}"
}

# aggregates planner-owned target work under a target-local plan root
function marsh_plan_target {  # marsh_plan_target site_source_root site_output_root target force source sitemap sitemap_search templates_dir template #template_overrides[@] template_overrides[@] template_assets_path build_context_source_root markdown_document_extensions_csv markdown_document_extensions_replacement remove_link_filenames_csv [config_file_dir] [target_name] [target_template_source] [#target_archive_records[@]] [target_archive_records[@]]
    local SITE_SOURCE_ROOT SITE_OUTPUT_ROOT TARGET FORCE SOURCE SITEMAP SITEMAP_SEARCH TEMPLATES_DIR TEMPLATE
    local NUM_TEMPLATE_OVERRIDES NUM_TARGET_ARCHIVE_RECORDS TEMPLATE_ASSETS_PATH BUILD_CONTEXT_SOURCE_ROOT MARKDOWN_DOCUMENT_EXTENSIONS_CSV MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT REMOVE_LINK_FILENAMES_CSV
    local CONFIG_FILE_DIR TARGET_NAME TARGET_TEMPLATE_SOURCE
    local TARGET_OUTPUT_REL TARGET_OUTPUT_ROOT TARGET_PLAN_ROOT
    local PLAN_RECORD TARGET_ARCHIVE_PLAN_ROOT
    local SOURCE_SCOPE_ROOT BUILD_CONTEXT_COMPARE_SOURCE_ROOT
    local -a TEMPLATE_OVERRIDES TARGET_ARCHIVE_RECORDS SOURCE_INVENTORY_RECORDS DOCUMENT_RECORDS SOURCE_ASSET_RECORDS SITEMAP_RECORDS ARCHIVE_PLAN_ROOTS

    SITE_SOURCE_ROOT="${1:-}"
    SITE_OUTPUT_ROOT="${2:-}"
    TARGET="${3:-.}"
    FORCE="${4:-false}"
    SOURCE="${5:-}"
    SITEMAP="${6:-}"
    SITEMAP_SEARCH="${7:-false}"
    TEMPLATES_DIR="${8:-}"
    TEMPLATE="${9:-}"
    shift 9
    [[ "${SITE_SOURCE_ROOT}" == "" ]] && return 1
    [[ "${SITE_OUTPUT_ROOT}" == "" ]] && return 1
    NUM_TEMPLATE_OVERRIDES="${1:-0}"
    shift 1
    TEMPLATE_OVERRIDES=()
    while [[ "${NUM_TEMPLATE_OVERRIDES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        TEMPLATE_OVERRIDES+=("${1}")
        NUM_TEMPLATE_OVERRIDES=$((NUM_TEMPLATE_OVERRIDES - 1))
        shift 1
    done
    TEMPLATE_ASSETS_PATH="${1:-}"
    BUILD_CONTEXT_SOURCE_ROOT="${2:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_CSV="${3:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT="${4:-}"
    REMOVE_LINK_FILENAMES_CSV="${5:-}"
    CONFIG_FILE_DIR="${6:-}"
    TARGET_NAME="${7:-}"
    TARGET_TEMPLATE_SOURCE="${8:-}"
    NUM_TARGET_ARCHIVE_RECORDS=0
    if [[ "${#@}" -gt 8 ]]; then
        NUM_TARGET_ARCHIVE_RECORDS="${9:-0}"
        shift 9
    else
        shift "${#@}"
    fi
    TARGET_ARCHIVE_RECORDS=()
    while [[ "${NUM_TARGET_ARCHIVE_RECORDS}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        TARGET_ARCHIVE_RECORDS+=("${1}")
        NUM_TARGET_ARCHIVE_RECORDS=$((NUM_TARGET_ARCHIVE_RECORDS - 1))
        shift 1
    done
    [[ "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" == "" ]] && return 1

    TARGET_OUTPUT_REL="${TARGET%/}"
    TARGET_OUTPUT_REL="${TARGET_OUTPUT_REL:-.}"
    TARGET_OUTPUT_ROOT=$(marsh_get_target_directory_path "${SITE_OUTPUT_ROOT}/${TARGET_OUTPUT_REL}") || return 1
    TARGET_PLAN_ROOT=$(marsh_create_target_plan_root "${TARGET_OUTPUT_ROOT}") || return 1

    if [[ "${BUILD_CONTEXT_SOURCE_ROOT}" != "" ]]; then
        marsh_create_target_source_root "${TARGET_OUTPUT_ROOT}" "${BUILD_CONTEXT_SOURCE_ROOT}" || return 1
    fi

    marsh_write_target_plan_context "${TARGET_PLAN_ROOT}" "${TARGET_OUTPUT_REL}" "${FORCE}" false "${SITEMAP}" "${SITEMAP_SEARCH}" "${TEMPLATES_DIR}" "${TEMPLATE}" "${#TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_ASSETS_PATH}" "${TARGET_OUTPUT_REL}" "${BUILD_CONTEXT_SOURCE_ROOT}" "${CONFIG_FILE_DIR}" "${TARGET_NAME}" "${TARGET_TEMPLATE_SOURCE}" || return 1

    SOURCE_INVENTORY_RECORDS=()
    if [[ "${BUILD_CONTEXT_SOURCE_ROOT}" != "" ]]; then
        while IFS= read -r PLAN_RECORD; do
            [[ "${PLAN_RECORD}" == "" ]] && continue
            SOURCE_INVENTORY_RECORDS+=("${PLAN_RECORD}")
        done < <(marsh_get_target_source_inventory "${TARGET_OUTPUT_ROOT}" "${BUILD_CONTEXT_SOURCE_ROOT}") || return 1
    fi
    marsh_write_target_plan_records "${TARGET_PLAN_ROOT}" "source-inventory" "${SOURCE_INVENTORY_RECORDS[@]}" || return 1

    DOCUMENT_RECORDS=()
    while IFS= read -r PLAN_RECORD; do
        [[ "${PLAN_RECORD}" == "" ]] && continue
        DOCUMENT_RECORDS+=("${PLAN_RECORD}")
    done < <(marsh_plan_target_documents_from_inventory "${SITE_OUTPUT_ROOT}" "${TARGET}" "${TARGET_OUTPUT_REL}" "${BUILD_CONTEXT_SOURCE_ROOT}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" "${SOURCE_INVENTORY_RECORDS[@]}") || return 1
    marsh_write_target_plan_records "${TARGET_PLAN_ROOT}" "documents" "${DOCUMENT_RECORDS[@]}" || return 1

    SOURCE_ASSET_RECORDS=()
    if [[ "${SOURCE}" != "" ]]; then
        SOURCE_SCOPE_ROOT=$(marsh_get_source_root_path "${SOURCE}") || return 1
        # compare source scope root to the canonical physical path of the build context source root
        BUILD_CONTEXT_COMPARE_SOURCE_ROOT="${BUILD_CONTEXT_SOURCE_ROOT}"
        if [[ "${BUILD_CONTEXT_COMPARE_SOURCE_ROOT}" != "" ]]; then
            BUILD_CONTEXT_COMPARE_SOURCE_ROOT=$(marsh_get_source_root_path "${BUILD_CONTEXT_COMPARE_SOURCE_ROOT}") || return 1
        fi
        while IFS= read -r PLAN_RECORD; do
            [[ "${PLAN_RECORD}" == "" ]] && continue
            SOURCE_ASSET_RECORDS+=("${PLAN_RECORD}")
        done < <(
            if [[ "${SOURCE_SCOPE_ROOT}" == "${BUILD_CONTEXT_COMPARE_SOURCE_ROOT}" ]]; then
                marsh_plan_target_source_assets_from_inventory "${SOURCE}" "${TARGET_OUTPUT_REL}" "${BUILD_CONTEXT_SOURCE_ROOT}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" "${SOURCE_INVENTORY_RECORDS[@]}"
            else
                marsh_plan_target_source_assets "${SOURCE}" "${SITE_OUTPUT_ROOT}" "${TARGET_OUTPUT_REL}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}"
            fi
        ) || return 1
    fi
    marsh_write_target_plan_records "${TARGET_PLAN_ROOT}" "source-assets" "${SOURCE_ASSET_RECORDS[@]}" || return 1

    SITEMAP_RECORDS=()
    if [[ "${SITEMAP}" != "" ]]; then
        [[ "${BUILD_CONTEXT_SOURCE_ROOT}" != "" ]] || {
            echo "Unable to resolve target source root for sitemap: ${SITEMAP}" >&2
            return 1
        }
        while IFS= read -r PLAN_RECORD; do
            [[ "${PLAN_RECORD}" == "" ]] && continue
            SITEMAP_RECORDS+=("${PLAN_RECORD}")
        done < <(
            if [[ "${SITEMAP_SEARCH}" == true ]]; then
                marsh_plan_target_sitemaps_from_inventory "${SITE_SOURCE_ROOT}" "${BUILD_CONTEXT_SOURCE_ROOT}" "${SITEMAP}" "${SITEMAP_SEARCH}" "${SOURCE_INVENTORY_RECORDS[@]}"
            else
                marsh_plan_target_sitemaps "${SITE_SOURCE_ROOT}" "${BUILD_CONTEXT_SOURCE_ROOT}" "${SITEMAP}" "${SITEMAP_SEARCH}" "${TARGET_OUTPUT_ROOT}"
            fi
        ) || return 1
    fi
    marsh_write_target_plan_records "${TARGET_PLAN_ROOT}" "sitemaps" "${SITEMAP_RECORDS[@]}" || return 1

    # directly pass through planned document records so archive planning can avoid
    # rereading the just-written documents file in the same shell
    ARCHIVE_PLAN_ROOTS=()
    while IFS= read -r TARGET_ARCHIVE_PLAN_ROOT; do
        [[ "${TARGET_ARCHIVE_PLAN_ROOT}" == "" ]] && continue
        ARCHIVE_PLAN_ROOTS+=("${TARGET_ARCHIVE_PLAN_ROOT}")
    done < <(marsh_plan_target_archives \
        "${SITE_OUTPUT_ROOT}" \
        "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" \
        "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" \
        "${REMOVE_LINK_FILENAMES_CSV}" \
        "${TARGET_PLAN_ROOT}" \
        "${TARGET_OUTPUT_REL}" \
        "${CONFIG_FILE_DIR}" \
        "${TEMPLATES_DIR}" \
        "${TARGET_NAME}" \
        "${SITEMAP}" \
        "${SITEMAP_SEARCH}" \
        "${TEMPLATE}" \
        "${TARGET_TEMPLATE_SOURCE}" \
        "${TEMPLATE_ASSETS_PATH}" \
        "${TARGET_OUTPUT_REL}" \
        "${BUILD_CONTEXT_SOURCE_ROOT}" \
        "${#TARGET_ARCHIVE_RECORDS[@]}" \
        "${TARGET_ARCHIVE_RECORDS[@]}" \
        "${#TEMPLATE_OVERRIDES[@]}" \
        "${TEMPLATE_OVERRIDES[@]}" \
        "${DOCUMENT_RECORDS[@]}") || return 1
    marsh_write_target_plan_records "${TARGET_PLAN_ROOT}" "archive-plans" "${ARCHIVE_PLAN_ROOTS[@]}" || return 1
    if [[ "${#ARCHIVE_PLAN_ROOTS[@]}" -gt 0 ]]; then
        marsh_write_target_archive_queue_from_archive_plans "${TARGET_PLAN_ROOT}" "${ARCHIVE_PLAN_ROOTS[@]}" || return 1
    fi

    printf '%s\n' "${TARGET_PLAN_ROOT}"
}

# writes the target plan context used by the planned target executor
function marsh_write_target_plan_context {  # marsh_write_target_plan_context target_plan_root target_output_rel force skip_template_assets sitemap sitemap_search templates_dir template #template_overrides[@] template_overrides[@] template_assets_path build_context_target_output_rel build_context_source_root [config_file_dir] [target_name] [target_template_source]
    local TARGET_PLAN_ROOT TARGET_OUTPUT_REL FORCE SKIP_TEMPLATE_ASSETS SITEMAP SITEMAP_SEARCH TEMPLATES_DIR TEMPLATE
    local NUM_TEMPLATE_OVERRIDES TEMPLATE_ASSETS_PATH BUILD_CONTEXT_TARGET_OUTPUT_REL BUILD_CONTEXT_SOURCE_ROOT
    local CONFIG_FILE_DIR TARGET_NAME TARGET_TEMPLATE_SOURCE
    local CONTEXT_FILE CONTEXT_TEMP TEMPLATE_OVERRIDE
    local -a TEMPLATE_OVERRIDES

    TARGET_PLAN_ROOT="${1:-}"
    TARGET_OUTPUT_REL="${2:-}"
    FORCE="${3:-false}"
    SKIP_TEMPLATE_ASSETS="${4:-false}"
    SITEMAP="${5:-}"
    SITEMAP_SEARCH="${6:-false}"
    TEMPLATES_DIR="${7:-}"
    TEMPLATE="${8:-}"
    shift 8
    [[ "${TARGET_PLAN_ROOT}" == "" ]] && return 1
    [[ "${TARGET_OUTPUT_REL}" == "" ]] && return 1
    NUM_TEMPLATE_OVERRIDES="${1:-0}"
    shift 1
    TEMPLATE_OVERRIDES=()
    while [[ "${NUM_TEMPLATE_OVERRIDES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        TEMPLATE_OVERRIDES+=("${1}")
        NUM_TEMPLATE_OVERRIDES=$((NUM_TEMPLATE_OVERRIDES - 1))
        shift 1
    done
    TEMPLATE_ASSETS_PATH="${1:-}"
    BUILD_CONTEXT_TARGET_OUTPUT_REL="${2:-${TARGET_OUTPUT_REL}}"
    BUILD_CONTEXT_SOURCE_ROOT="${3:-}"
    CONFIG_FILE_DIR="${4:-}"
    TARGET_NAME="${5:-}"
    TARGET_TEMPLATE_SOURCE="${6:-}"

    CONTEXT_FILE="${TARGET_PLAN_ROOT}/context"
    CONTEXT_TEMP=$(mktemp "${TARGET_PLAN_ROOT}/context-XXXXXX" 2>/dev/null) || {
        echo "Unable to write target plan context temporary file: ${TARGET_PLAN_ROOT}/context-XXXXXX" >&2
        return 1
    }

    {
        # persist the fixed-shape fields consumed by the planned target executor
        printf 'TARGET_OUTPUT_REL\t%s\n' "${TARGET_OUTPUT_REL}"
        printf 'TARGET_FORCE\t%s\n' "${FORCE}"
        printf 'TARGET_SKIP_TEMPLATE_ASSETS\t%s\n' "${SKIP_TEMPLATE_ASSETS}"
        printf 'TARGET_SITEMAP\t%s\n' "${SITEMAP}"
        printf 'TARGET_SITEMAP_SEARCH\t%s\n' "${SITEMAP_SEARCH}"
        printf 'TEMPLATES_DIR\t%s\n' "${TEMPLATES_DIR}"
        printf 'TEMPLATE\t%s\n' "${TEMPLATE}"
        printf 'TEMPLATE_ASSETS_PATH\t%s\n' "${TEMPLATE_ASSETS_PATH}"
        printf 'BUILD_CONTEXT_TARGET_OUTPUT_REL\t%s\n' "${BUILD_CONTEXT_TARGET_OUTPUT_REL}"
        printf 'BUILD_CONTEXT_SOURCE_ROOT\t%s\n' "${BUILD_CONTEXT_SOURCE_ROOT}"
        printf 'CONFIG_FILE_DIR\t%s\n' "${CONFIG_FILE_DIR}"
        printf 'TARGET_NAME\t%s\n' "${TARGET_NAME}"
        printf 'TARGET_TEMPLATE_SOURCE\t%s\n' "${TARGET_TEMPLATE_SOURCE}"
        for TEMPLATE_OVERRIDE in "${TEMPLATE_OVERRIDES[@]}"; do
            printf 'TEMPLATE_OVERRIDE\t%s\n' "${TEMPLATE_OVERRIDE}"
        done
    } > "${CONTEXT_TEMP}" || {
        echo "Unable to write target plan context temporary file: ${CONTEXT_TEMP}" >&2
        rm -f "${CONTEXT_TEMP}"
        return 1
    }
    mv "${CONTEXT_TEMP}" "${CONTEXT_FILE}" 2>/dev/null || {
        echo "Unable to write target plan context file: ${CONTEXT_FILE}" >&2
        rm -f "${CONTEXT_TEMP}"
        return 1
    }
}

# writes a named record file under the target plan root from the provided records
function marsh_write_target_plan_records {  # marsh_write_target_plan_records target_plan_root record_name records[@]
    local TARGET_PLAN_ROOT RECORD_NAME RECORD_FILE RECORD_TEMP RECORD

    TARGET_PLAN_ROOT="${1:-}"
    RECORD_NAME="${2:-}"
    shift 2
    [[ "${TARGET_PLAN_ROOT}" == "" ]] && return 1
    [[ "${RECORD_NAME}" == "" ]] && return 1

    RECORD_FILE="${TARGET_PLAN_ROOT}/${RECORD_NAME}"
    RECORD_TEMP=$(mktemp "${TARGET_PLAN_ROOT}/${RECORD_NAME}-XXXXXX" 2>/dev/null) || {
        echo "Unable to write target plan record temporary file: ${TARGET_PLAN_ROOT}/${RECORD_NAME}-XXXXXX" >&2
        return 1
    }

    while [[ "${#@}" -gt 0 ]]; do
        RECORD="${1:-}"
        shift 1
        [[ "${RECORD}" == "" ]] && continue
        printf '%s\n' "${RECORD}"
    done > "${RECORD_TEMP}" || {
        echo "Unable to write target plan record temporary file: ${RECORD_TEMP}" >&2
        rm -f "${RECORD_TEMP}"
        return 1
    }
    mv "${RECORD_TEMP}" "${RECORD_FILE}" 2>/dev/null || {
        echo "Unable to write target plan record file: ${RECORD_FILE}" >&2
        rm -f "${RECORD_TEMP}"
        return 1
    }
}

