        echo "${PREFIX}ARCHIVES_LANGUAGE_CODE+=(\"${!ARCHIVE_LANGUAGE_CODE//\"/\\\"}\")"
        echo "${PREFIX}ARCHIVES_COUNT+=(\"${!ARCHIVE_COUNT//\"/\\\"}\")"
        echo "${PREFIX}ARCHIVES_PAGE_SIZE+=(\"${!ARCHIVE_PAGE_SIZE//\"/\\\"}\")"
        echo "${PREFIX}ARCHIVES_CONTENT+=(\"${!ARCHIVE_CONTENT//\"/\\\"}\")"
        eval $(marsh_flat_to_array "ARCHIVE_TYPES" "${SOURCE_PREFIX}Archives_${II}_Types_")
        OIFS="${IFS}"; IFS=$(echo @|tr @ '\034'); echo "${PREFIX}ARCHIVES_TYPES+=(\"${ARCHIVE_TYPES[*]//\"/\\\"}\")"; IFS="${OIFS}"
        eval $(marsh_flat_to_array "ARCHIVE_EXCLUDED_STATES" "${SOURCE_PREFIX}Archives_${II}_Exclude_States_")
        OIFS="${IFS}"; IFS=$(echo @|tr @ '\034'); echo "${PREFIX}ARCHIVES_EXCLUDED_STATES+=(\"${ARCHIVE_EXCLUDED_STATES[*]//\"/\\\"}\")"; IFS="${OIFS}"
        II=$((II+1))
        ARCHIVE="${SOURCE_PREFIX}Archives_${II}_Path"
        ARCHIVE_ENCODING="${SOURCE_PREFIX}Archives_${II}_Encoding"
        ARCHIVE_NAME="${SOURCE_PREFIX}Archives_${II}_Name"
        ARCHIVE_LANGUAGE="${SOURCE_PREFIX}Archives_${II}_Language"
        ARCHIVE_LANGUAGE_CODE="${SOURCE_PREFIX}Archives_${II}_Language_Code"
        ARCHIVE_COUNT="${SOURCE_PREFIX}Archives_${II}_Count"
        ARCHIVE_PAGE_SIZE="${SOURCE_PREFIX}Archives_${II}_Page_Size"
        ARCHIVE_CONTENT="${SOURCE_PREFIX}Archives_${II}_Content"
    done

    return 0
}

# copies files from local sources
function marsh_get_files {  # marsh_get_files source dest force
    local SOURCE DEST FORCE
    local SOURCE_DIR FILES_LIST FILES FILE
    SOURCE="${1:-}"
    DEST="${2:-}"
    if [[ "${SOURCE}" == "" ]]; then
        echo "Internal error copying files: source empty" >&2
        return 1
    elif [[ "${DEST}" == "" ]]; then
        echo "Internal error copying files: destination empty" >&2
        return 1
    fi
    SOURCE_DIR="${SOURCE%/*}"
    SOURCE_DIR="${SOURCE_DIR:-.}"
    FORCE="${3:-}"
    # select files for copy
    if [[ -d "${SOURCE}" ]]; then
        # entire directory
        FILES="${SOURCE#$SOURCE_DIR/}"
        DEST="${DEST%/$FILES}"
        FILES=("${FILES}")
    else
        # directory contents
        FILES_LIST=$(cd "${SOURCE_DIR}" >/dev/null 2>&1 && find . -maxdepth 1 -name "${SOURCE##*/}" | sed -e 's/^\.\///' -e 's/^\.$//')
        if [[ $? -ne 0 ]]; then
            echo "Unable to change into directory: ${SOURCE_DIR}" >&2
            return 1
        fi
        FILES=()
        while IFS= read -r FILE; do
            [[ "${FILE}" == "" ]] && continue
            FILES+=("${FILE}")
        done <<< "${FILES_LIST}"
    fi
    # loop over files
    for FILE in "${FILES[@]}"; do
        # sanity
        if [[ "${SOURCE_DIR}/${FILE}" == "${DEST%/}/${FILE}" ]]; then
            # same source and destination
            echo "Source and destination paths are equal: ${DEST}" >&2
            return 1
        fi
        if [[ -e "${DEST%/}/${FILE}" ]] && [[ "${FORCE}" != true ]]; then
            # path exists
            echo "Path exists (--force to overwrite): ${DEST%/}/${FILE}" >&2
            return 1
        fi
        # create path
        DEST="${DEST%/.}"
        if ! mkdir -p "${DEST}"; then
            echo "Unable to create path: ${DEST}" >&2
            return 1
        fi
        # clean destination
        if ! rm -rf "${DEST%/}/${FILE}"; then
            echo "Unable to replace path: ${DEST}" >&2
            return 1
        fi
        # copy
        if ! cp -R "${SOURCE_DIR}/${FILE}" "${DEST%/}/${FILE}"; then
            echo "Unable to copy file: ${SOURCE_DIR}/${FILE} -> ${DEST%/}/${FILE}" >&2
            return 1
        fi
    done
    return 0
}

# returns paginated archive root for an archive source path
function marsh_get_archive_page_root {  # marsh_get_archive_page_root archive_source
    local ARCHIVE_SOURCE ARCHIVE_DIR ARCHIVE_NAME PAGE_ROOT

    ARCHIVE_SOURCE="${1:-}"
    [[ "${ARCHIVE_SOURCE}" == "" ]] && return 1
    if [[ "${ARCHIVE_SOURCE}" == */* ]]; then
        ARCHIVE_DIR="${ARCHIVE_SOURCE%/*}"
    else
        ARCHIVE_DIR='.'
    fi
    ARCHIVE_NAME="${ARCHIVE_SOURCE##*/}"
    if [[ "${ARCHIVE_NAME%.*}" == "index" ]]; then
        PAGE_ROOT="${ARCHIVE_DIR}/page"
    else
        PAGE_ROOT="${ARCHIVE_SOURCE%.*}/page"
    fi
    printf '%s\n' "${PAGE_ROOT#./}"
}

# returns numbered paginated archive source path for a page
function marsh_get_archive_page_source {  # marsh_get_archive_page_source archive_source page_num
    local ARCHIVE_SOURCE PAGE_NUM PAGE_ROOT ARCHIVE_EXT

    ARCHIVE_SOURCE="${1:-}"
    PAGE_NUM="${2:-}"
    [[ "${ARCHIVE_SOURCE}" == "" ]] && return 1
    [[ "${PAGE_NUM}" == "" ]] && return 1
    PAGE_ROOT=$(marsh_get_archive_page_root "${ARCHIVE_SOURCE}") || return 1
    ARCHIVE_EXT="${ARCHIVE_SOURCE##*.}"
    printf '%s\n' "${PAGE_ROOT}/${PAGE_NUM}/index.${ARCHIVE_EXT}"
}

# returns output uri for an archive source path
function marsh_get_archive_page_uri {  # marsh_get_archive_page_uri target_dir archive_source
    local TARGET_DIR ARCHIVE_SOURCE URI

    TARGET_DIR="${1:-}"
    ARCHIVE_SOURCE="${2:-}"
    [[ "${TARGET_DIR}" == "" ]] && return 1
    [[ "${ARCHIVE_SOURCE}" == "" ]] && return 1
    URI="${TARGET_DIR#$MARSH_CONFIG_PATH}"
    URI="${MARSH_CONFIG_URL%/}/${URI#/}/${ARCHIVE_SOURCE}"
    printf '%s\n' "${URI%.*}.html"
}

# writes a single archive source page and its page-local subdocuments
function marsh_write_archive_page {  # marsh_write_archive_page encoding target_dir archive_source title language langcode paginated page page_total page_size page_subdocuments_total archive_subdocuments_total current_uri canonical_uri first_uri prev_uri next_uri last_uri #documents[@] documents[@] document_uris[@] document_abspaths[@]
    local ENCODING TARGET_DIR DEST DEST_SUB_PREFIX DEST_TITLE LANGUAGE LANGCODE PAGINATED
    local PAGE PAGE_TOTAL PAGE_SIZE PAGE_SUBDOCUMENTS_TOTAL ARCHIVE_SUBDOCUMENTS_TOTAL
    local PAGE_URI PAGE_CANONICAL_URI PAGE_FIRST_URI PAGE_PREV_URI PAGE_NEXT_URI PAGE_LAST_URI
    local NUM_DOCUMENTS DOCUMENTS DOCUMENT_URIS DOCUMENT_ABSPATHS DOCUMENT INDEX URI ABSPATH DEST_SUB MANIFEST_FILE
    local PAGE_IS_FIRST PAGE_IS_LAST PAGE_HAS_PREV PAGE_HAS_NEXT PAGE_HAS_SUBDOCUMENTS

    ENCODING="${1:-}"
    TARGET_DIR="${2:-}"
    DEST="${3:-}"
    [[ "${TARGET_DIR}" == "" ]] && return 1
    [[ "${DEST}" == "" ]] && return 1
    shift 3
    DEST_TITLE="${1:-}"
    LANGUAGE="${2:-}"
    LANGCODE="${3:-}"
    PAGINATED="${4:-false}"
    PAGE="${5:-1}"
    PAGE_TOTAL="${6:-1}"
    PAGE_SIZE="${7:-}"
    PAGE_SUBDOCUMENTS_TOTAL="${8:-0}"
    ARCHIVE_SUBDOCUMENTS_TOTAL="${9:-0}"
    PAGE_URI="${10:-}"
    PAGE_CANONICAL_URI="${11:-}"
    PAGE_FIRST_URI="${12:-}"
    PAGE_PREV_URI="${13:-}"
    PAGE_NEXT_URI="${14:-}"
    PAGE_LAST_URI="${15:-}"
    shift 15
    NUM_DOCUMENTS="${1:-0}"
    shift 1
    DOCUMENTS=()
    while [[ "${NUM_DOCUMENTS}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        DOCUMENTS+=("${1}")
        NUM_DOCUMENTS=$((NUM_DOCUMENTS - 1))
        shift 1
    done
    DOCUMENT_URIS=()
    INDEX=0
    while [[ "${INDEX}" -lt "${#DOCUMENTS[@]}" ]] && [[ "${#@}" -gt 0 ]]; do
        DOCUMENT_URIS+=("${1}")
        INDEX=$((INDEX + 1))
        shift 1
    done
    DOCUMENT_ABSPATHS=()
    INDEX=0
    while [[ "${INDEX}" -lt "${#DOCUMENTS[@]}" ]] && [[ "${#@}" -gt 0 ]]; do
        DOCUMENT_ABSPATHS+=("${1}")
        INDEX=$((INDEX + 1))
        shift 1
    done

    # page metadata
    DEST="${TARGET_DIR}/${DEST}"
    DEST_SUB_PREFIX="${DEST}.${MARSH_UID}.subdocuments"
    PAGE_IS_FIRST=false
    PAGE_IS_LAST=false
    PAGE_HAS_PREV=false
    PAGE_HAS_NEXT=false
    PAGE_HAS_SUBDOCUMENTS=false
    [[ "${PAGE}" -eq 1 ]] && PAGE_IS_FIRST=true
    [[ "${PAGE}" -eq "${PAGE_TOTAL}" ]] && PAGE_IS_LAST=true
    [[ "${PAGE_PREV_URI}" != "" ]] && PAGE_HAS_PREV=true
    [[ "${PAGE_NEXT_URI}" != "" ]] && PAGE_HAS_NEXT=true
    [[ "${PAGE_SUBDOCUMENTS_TOTAL}" -gt 0 ]] && PAGE_HAS_SUBDOCUMENTS=true

    # create output directory and remove old page-local subdocuments
    mkdir -p "${DEST%/*}" >/dev/null 2>&1 || {
        echo "Unable to create archive output directory: ${DEST%/*}" >&2
        return 1
    }
    rm -f "${DEST}.${MARSH_UID}.subdocuments"* >/dev/null 2>&1

    # write the generated archive source with page metadata
    echo "---" > "${DEST}" 2>/dev/null || {
        echo "Unable to write archive file: ${DEST}" >&2
        return 1
    }
    if [[ "${ENCODING}" == "html" ]]; then
        echo "Type: archive" >> "${DEST}"
    else
        echo "Type: archive-${ENCODING}" >> "${DEST}"
    fi
    echo "Date: $(date -u '+%Y-%m-%d %H:%M:%S')" >> "${DEST}"
    echo "Title: ${DEST_TITLE}" >> "${DEST}"
    echo "Language: ${LANGUAGE}" >> "${DEST}"
    echo "Language_Code: ${LANGCODE}" >> "${DEST}"
    if [[ "${ENCODING}" == "html" ]]; then
        echo "Paginated: ${PAGINATED}" >> "${DEST}"
        echo "Page: ${PAGE}" >> "${DEST}"
        echo "Page_Total: ${PAGE_TOTAL}" >> "${DEST}"
        echo "Page_Size: ${PAGE_SIZE}" >> "${DEST}"
        echo "Page_Subdocuments_Total: ${PAGE_SUBDOCUMENTS_TOTAL}" >> "${DEST}"
        echo "Archive_Subdocuments_Total: ${ARCHIVE_SUBDOCUMENTS_TOTAL}" >> "${DEST}"
        echo "Page_Is_First: ${PAGE_IS_FIRST}" >> "${DEST}"
        echo "Page_Is_Last: ${PAGE_IS_LAST}" >> "${DEST}"
        echo "Page_Has_Prev: ${PAGE_HAS_PREV}" >> "${DEST}"
        echo "Page_Has_Next: ${PAGE_HAS_NEXT}" >> "${DEST}"
        echo "Page_Has_Subdocuments: ${PAGE_HAS_SUBDOCUMENTS}" >> "${DEST}"
        echo "Page_URI: ${PAGE_URI}" >> "${DEST}"
        echo "Page_Canonical_URI: ${PAGE_CANONICAL_URI}" >> "${DEST}"
        echo "Page_First_URI: ${PAGE_FIRST_URI}" >> "${DEST}"
        echo "Page_Prev_URI: ${PAGE_PREV_URI}" >> "${DEST}"
        echo "Page_Next_URI: ${PAGE_NEXT_URI}" >> "${DEST}"
        echo "Page_Last_URI: ${PAGE_LAST_URI}" >> "${DEST}"
    fi
    echo "---" >> "${DEST}"

    # create manifest of the subdocuments for this page
    if [[ "${#DOCUMENTS[@]}" -gt 0 ]]; then
        MANIFEST_FILE="${DEST_SUB_PREFIX}.manifest"
        {
            INDEX=0
            for DOCUMENT in "${DOCUMENTS[@]}"; do
                URI="${DOCUMENT_URIS[$INDEX]:-}"
                ABSPATH="${DOCUMENT_ABSPATHS[$INDEX]:-}"
                printf '%q\t%q\t%q\n' "${TARGET_DIR}/${DOCUMENT}" "${URI}" "${ABSPATH}" || {
                    echo "Unable to write archive subdocument manifest: ${MANIFEST_FILE}" >&2
                    return 1
                }
                INDEX=$((INDEX + 1))
            done
        } > "${MANIFEST_FILE}" || {
            echo "Unable to create archive subdocument manifest: ${MANIFEST_FILE}" >&2
            return 1
        }
    fi

    return 0
}

# builds an archive of directory contents, sorted by descending date
function marsh_build_archive {  # marsh_build_archive encoding target_dir dest_file dest_title language langcode count page_size #types[@] types[@] #excluded_states[@] excluded_states[@] archive_manifest
    local ENCODING TARGET_DIR DEST DEST_TITLE LANGUAGE LANGCODE
    local COUNT PAGE_SIZE NUM_TYPES TYPES NUM_EXCLUDED_STATES EXCLUDED_STATES
    local VALID DOCUMENT TYPE STATE STATE_JOINED OIFS E
    local ARCHIVE_MANIFEST MANIFEST_DOCUMENT_ESC MANIFEST_TYPE_ESC MANIFEST_URI_ESC MANIFEST_ABSPATH_ESC MANIFEST_STATE_ESC
    local URI ABSPATH VALID_DOCUMENTS VALID_DOCUMENT_URIS VALID_DOCUMENT_ABSPATHS
    local PAGINATED PAGE_TOTAL PAGE PAGE_START PAGE_END PAGE_INDEX PAGE_DOCUMENTS
    local PAGE_DOCUMENT_URIS PAGE_DOCUMENT_ABSPATHS PAGE_SUBDOCUMENTS_TOTAL
    local ARCHIVE_PAGES ARCHIVE_SUBDOCUMENTS_TOTAL
    local PAGE_DEST PAGE_ALIAS_DEST PAGE_ROOT
    local PAGE_URI PAGE_CANONICAL_URI PAGE_FIRST_URI PAGE_PREV_URI PAGE_NEXT_URI PAGE_LAST_URI
    local PAGE_PREV_DEST PAGE_NEXT_DEST PAGE_LAST_DEST

    # init
    ENCODING="${1:-html}"
    TARGET_DIR="${2:-}"
    DEST="${3:-}"
    [[ "${TARGET_DIR}" == "" ]] && return 1
    [[ "${DEST}" == "" ]] && return 1
    shift 3
    DEST_TITLE="${1:-}"
    LANGUAGE="${2:-}"
    LANGCODE="${3:-}"
    shift 3
    COUNT="${1:-}"
    PAGE_SIZE="${2:-}"
    shift 2
    NUM_TYPES="${1:-0}"
    shift 1
    TYPES=()
    while [[ "${NUM_TYPES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        TYPES+=("${1}")
        NUM_TYPES=$((NUM_TYPES - 1 ))
        shift
    done
    NUM_EXCLUDED_STATES="${1:-0}"
    shift 1
    EXCLUDED_STATES=()
    while [[ "${NUM_EXCLUDED_STATES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        EXCLUDED_STATES+=("${1}")
        NUM_EXCLUDED_STATES=$((NUM_EXCLUDED_STATES - 1 ))
        shift
    done
    ARCHIVE_MANIFEST="${1:-}"

    # sanity check archive count
    if [[ "${COUNT}" != "" ]] && [[ ! "${COUNT}" =~ ^[0-9]+$ ]]; then
        echo "Invalid archive count: ${COUNT}" >&2
        return 1
    fi

    # sanity check; only html archives may be paginated
    PAGINATED=false
    if [[ "${ENCODING}" == "html" ]] && [[ "${PAGE_SIZE}" =~ ^[0-9]+$ ]] && [[ "${PAGE_SIZE}" -gt 0 ]]; then
        PAGINATED=true
        PAGE_ROOT=$(marsh_get_archive_page_root "${DEST}") || return 1
        rm -rf "${TARGET_DIR}/${PAGE_ROOT}" >/dev/null 2>&1 || {
            echo "Unable to clean paginated archive path: ${TARGET_DIR}/${PAGE_ROOT}" >&2
            return 1
        }
    else
        PAGE_SIZE=""
    fi

    # complete document set before pagination
    VALID=0
    VALID_DOCUMENTS=()
    VALID_DOCUMENT_URIS=()
    VALID_DOCUMENT_ABSPATHS=()
    if [[ "${ARCHIVE_MANIFEST}" == "" ]]; then
        ARCHIVE_MANIFEST=$(marsh_get_archive_manifest "${TARGET_DIR}") || return 1
    fi
    while IFS=$'\t' read -r MANIFEST_DOCUMENT_ESC MANIFEST_TYPE_ESC MANIFEST_URI_ESC MANIFEST_ABSPATH_ESC MANIFEST_STATE_ESC; do
        [[ "${MANIFEST_DOCUMENT_ESC}" == "" ]] && continue
        DOCUMENT=""
        TYPE=""
        URI=""
        ABSPATH=""
        STATE_JOINED=""
        STATE=()
        eval "DOCUMENT=${MANIFEST_DOCUMENT_ESC}"
        eval "TYPE=${MANIFEST_TYPE_ESC}"
        eval "URI=${MANIFEST_URI_ESC}"
        eval "ABSPATH=${MANIFEST_ABSPATH_ESC}"
        eval "STATE_JOINED=${MANIFEST_STATE_ESC}"
        if [[ "${STATE_JOINED}" != "" ]]; then
            OIFS="${IFS}"
            IFS=$(printf '\034')
            STATE=(${STATE_JOINED})
            IFS="${OIFS}"
        fi
        if [[ "${COUNT}" != "" ]] && [[ "${VALID}" -ge "${COUNT}" ]]; then
            break
        fi
        if [[ "${TYPE%%-*}" == "archive" ]]; then
            continue
        fi
        if [[ "${#TYPES[@]}" -gt 0 ]] && ! marsh_in_array "${TYPE}" "${TYPES[@]}"; then
            continue
        fi
        if [[ "${#EXCLUDED_STATES[@]}" -gt 0 ]]; then
            for E in "${EXCLUDED_STATES[@]}"; do
                if marsh_in_array "${E}" "${STATE[@]}"; then
                    continue 2
                fi
            done
        fi
        VALID=$((VALID + 1))
        VALID_DOCUMENTS+=("${DOCUMENT}")
        VALID_DOCUMENT_URIS+=("${URI:-}")
        VALID_DOCUMENT_ABSPATHS+=("${ABSPATH:-}")
    done < "${ARCHIVE_MANIFEST}"

    # create page set for paginated html archives
    # create at least one page even where there are no subdocuments
    ARCHIVE_PAGES=()
    ARCHIVE_SUBDOCUMENTS_TOTAL="${#VALID_DOCUMENTS[@]}"
    PAGE_TOTAL=1
    if [[ "${PAGINATED}" == true ]]; then
        PAGE_TOTAL=$(( (ARCHIVE_SUBDOCUMENTS_TOTAL + PAGE_SIZE - 1) / PAGE_SIZE ))
        [[ "${PAGE_TOTAL}" -lt 1 ]] && PAGE_TOTAL=1
    fi
    PAGE_CANONICAL_URI=$(marsh_get_archive_page_uri "${TARGET_DIR}" "${DEST}") || return 1
    PAGE_FIRST_URI="${PAGE_CANONICAL_URI}"
    if [[ "${PAGINATED}" == true ]] && [[ "${PAGE_TOTAL}" -gt 1 ]]; then
        PAGE_LAST_DEST=$(marsh_get_archive_page_source "${DEST}" "${PAGE_TOTAL}") || return 1
        PAGE_LAST_URI=$(marsh_get_archive_page_uri "${TARGET_DIR}" "${PAGE_LAST_DEST}") || return 1
    else
        PAGE_LAST_URI="${PAGE_CANONICAL_URI}"
    fi
    for ((PAGE=1; PAGE<=PAGE_TOTAL; PAGE++)); do
        PAGE_DOCUMENTS=()
        PAGE_DOCUMENT_URIS=()
        PAGE_DOCUMENT_ABSPATHS=()
        if [[ "${PAGINATED}" == true ]]; then
            PAGE_START=$(( (PAGE - 1) * PAGE_SIZE ))
            PAGE_END=$(( PAGE_START + PAGE_SIZE - 1 ))
        else
            PAGE_START=0
            PAGE_END=$(( ARCHIVE_SUBDOCUMENTS_TOTAL - 1 ))
        fi
        for ((PAGE_INDEX=PAGE_START; PAGE_INDEX<=PAGE_END; PAGE_INDEX++)); do
            if [[ "${PAGE_INDEX}" -lt 0 ]] || [[ "${PAGE_INDEX}" -ge "${ARCHIVE_SUBDOCUMENTS_TOTAL}" ]]; then
                continue
            fi
            PAGE_DOCUMENTS+=("${VALID_DOCUMENTS[$PAGE_INDEX]}")
            PAGE_DOCUMENT_URIS+=("${VALID_DOCUMENT_URIS[$PAGE_INDEX]}")
            PAGE_DOCUMENT_ABSPATHS+=("${VALID_DOCUMENT_ABSPATHS[$PAGE_INDEX]}")
        done
        PAGE_SUBDOCUMENTS_TOTAL="${#PAGE_DOCUMENTS[@]}"

        if [[ "${PAGINATED}" == true ]] && [[ "${PAGE}" -gt 1 ]]; then
            PAGE_DEST=$(marsh_get_archive_page_source "${DEST}" "${PAGE}") || return 1
        else
            PAGE_DEST="${DEST}"
        fi
        PAGE_URI=$(marsh_get_archive_page_uri "${TARGET_DIR}" "${PAGE_DEST}") || return 1
        PAGE_PREV_URI=""
        PAGE_NEXT_URI=""
        if [[ "${PAGE}" -gt 1 ]]; then
            if [[ "${PAGE}" -eq 2 ]]; then
                PAGE_PREV_DEST="${DEST}"
            else
                PAGE_PREV_DEST=$(marsh_get_archive_page_source "${DEST}" "$((PAGE - 1))") || return 1
            fi
            PAGE_PREV_URI=$(marsh_get_archive_page_uri "${TARGET_DIR}" "${PAGE_PREV_DEST}") || return 1
        fi
        if [[ "${PAGE}" -lt "${PAGE_TOTAL}" ]]; then
            PAGE_NEXT_DEST=$(marsh_get_archive_page_source "${DEST}" "$((PAGE + 1))") || return 1
            PAGE_NEXT_URI=$(marsh_get_archive_page_uri "${TARGET_DIR}" "${PAGE_NEXT_DEST}") || return 1
        fi

        marsh_write_archive_page "${ENCODING}" \
                "${TARGET_DIR}" \
                "${PAGE_DEST}" \
                "${DEST_TITLE}" \
                "${LANGUAGE}" \
                "${LANGCODE}" \
                "${PAGINATED}" \
                "${PAGE}" \
                "${PAGE_TOTAL}" \
                "${PAGE_SIZE}" \
                "${PAGE_SUBDOCUMENTS_TOTAL}" \
                "${ARCHIVE_SUBDOCUMENTS_TOTAL}" \
                "${PAGE_URI}" \
                "${PAGE_CANONICAL_URI}" \
                "${PAGE_FIRST_URI}" \
                "${PAGE_PREV_URI}" \
                "${PAGE_NEXT_URI}" \
                "${PAGE_LAST_URI}" \
                "${#PAGE_DOCUMENTS[@]}" \
                "${PAGE_DOCUMENTS[@]}" \
                "${PAGE_DOCUMENT_URIS[@]}" \
                "${PAGE_DOCUMENT_ABSPATHS[@]}" || return 1
        ARCHIVE_PAGES+=("${PAGE_DEST}")

        if [[ "${PAGINATED}" == true ]] && [[ "${PAGE}" -eq 1 ]]; then
            PAGE_ALIAS_DEST=$(marsh_get_archive_page_source "${DEST}" '1') || return 1
            PAGE_URI=$(marsh_get_archive_page_uri "${TARGET_DIR}" "${PAGE_ALIAS_DEST}") || return 1
            marsh_write_archive_page "${ENCODING}" \
                    "${TARGET_DIR}" \
                    "${PAGE_ALIAS_DEST}" \
                    "${DEST_TITLE}" \
                    "${LANGUAGE}" \
                    "${LANGCODE}" \
                    "${PAGINATED}" \
                    '1' \
                    "${PAGE_TOTAL}" \
                    "${PAGE_SIZE}" \
                    "${PAGE_SUBDOCUMENTS_TOTAL}" \
                    "${ARCHIVE_SUBDOCUMENTS_TOTAL}" \
                    "${PAGE_URI}" \
                    "${PAGE_CANONICAL_URI}" \
                    "${PAGE_FIRST_URI}" \
                    '' \
                    "${PAGE_NEXT_URI}" \
                    "${PAGE_LAST_URI}" \
                    "${#PAGE_DOCUMENTS[@]}" \
                    "${PAGE_DOCUMENTS[@]}" \
                    "${PAGE_DOCUMENT_URIS[@]}" \
                    "${PAGE_DOCUMENT_ABSPATHS[@]}" || return 1
            ARCHIVE_PAGES+=("${PAGE_ALIAS_DEST}")
        fi
    done

    printf '%s\n' "${ARCHIVE_PAGES[@]}"
    return 0
}

# builds advanced navigation
function marsh_build_advanced_nav {  # marsh_build_advanced_nav target_dir navigation_file markdown_command markdown_options_csv markdown_fileext_csv markdown_rewrite_links
    local TARGET_DIR NAV_FILE MARKDOWN_COMMAND MARKDOWN_OPTIONS_CSV MARKDOWN_FILEEXT_CSV MARKDOWN_REWRITE_LINKS
    local NAV_TARGETS_LIST NAV_TARGET NAV_DEST TEXT_FILTER

    # init
    TARGET_DIR="${1:-}"
    NAV_FILE="${2:-}"
    MARKDOWN_COMMAND="${3:-}"
    MARKDOWN_OPTIONS_CSV="${4:-}"
    MARKDOWN_FILEEXT_CSV="${5:-}"
    MARKDOWN_REWRITE_LINKS="${6:-}"
    [[ "${TARGET_DIR}" == "" ]] && return 1
    [[ "${NAV_FILE}" == "" ]]   && return 1
    [[ "${MARKDOWN_COMMAND}" == "" ]] && return 1
    [[ "${MARKDOWN_FILEEXT_CSV}" == "" ]] && return 1
    [[ "${MARKDOWN_REWRITE_LINKS}" == "" ]] && return 1

    NAV_TARGETS_LIST=$(cd "${TARGET_DIR}" && find . -name "${NAV_FILE#\./}")
    while IFS= read -r NAV_TARGET; do
        [[ "${NAV_TARGET}" == "" ]] && continue
        NAV_TARGET="${TARGET_DIR}/${NAV_TARGET}"
        NAV_DEST="${NAV_TARGET}.${MARSH_UID}.advanced-nav.html"
        if marsh_has_frontmatter "${NAV_TARGET}"; then
            marsh_extract_frontmatter "${NAV_TARGET}" "${NAV_DEST}.meta.yaml" "${NAV_DEST}.temp" || {
                echo "Unable to extract navigation frontmatter: ${NAV_TARGET}" >&2
                return 1
            }
        else
            cp "${NAV_TARGET}" "${NAV_DEST}.temp"
        fi
        TEXT_FILTER=
        if [[ "${MARKDOWN_REWRITE_LINKS}" == true ]]; then
            TEXT_FILTER="links:replace-ext:${MARKDOWN_FILEEXT_CSV}:html"
        fi
        <"${NAV_DEST}.temp" marsh_text_filter ${TEXT_FILTER} | marsh_process_markdown "${MARKDOWN_COMMAND}" "${MARKDOWN_OPTIONS_CSV}" > "${NAV_DEST}"
        rm -f "${NAV_DEST}.meta.yaml" 2>/dev/null || true
        rm -f "${NAV_DEST}.temp"
    done <<< "${NAV_TARGETS_LIST}"
}

# builds a template and applies it to a document
function marsh_build_template {  # marsh_build_template dest_dir target_dir document advanced_nav templates_dir template markdown_command markdown_options_csv markdown_fileext_csv markdown_rewrite_links #template_overrides[@] template_overrides[@]
    function process_conditionals {  # process_conditionals file tag list[@]
        local FILE TAG LIST_SEP LIST_RAW
        local FILE_TEMP
        FILE="${1:-}";       [[ "${FILE}" == "" ]] && return 1
        TAG="${2:-}";        [[ "${TAG}" == "" ]]  && return 1
        shift 2
        LIST_SEP=$(printf '\034')
        LIST_RAW=$(printf "%s${LIST_SEP}" "$@")
        LIST_RAW="${LIST_RAW%${LIST_SEP}}"
        FILE_TEMP=$(mktemp "${MARSH_TEMP}/conditional-XXXXXX")
        awk -v tag="${TAG}" -v list_raw="${LIST_RAW}" -v list_sep="${LIST_SEP}" -v list_count_input="${#@}" '
            BEGIN {
                list_count = list_count_input + 0;
                if (list_count > 0) {
                    if (list_count == 1 && list_raw == "") {
                        allowed_items[1] = "";
                    } else {
                        split(list_raw, allowed_items, list_sep);
                    }
                    for (i = 1; i <= list_count; i++) {
                        allowed[allowed_items[i]] = 1;
                    }
                }
                supported["is"] = 1;
                supported["is not"] = 1;
                supported["equals"] = 1;
                supported["does not equal"] = 1;
                supported["contains"] = 1;
                supported["does not contain"] = 1;
                re_if = "^[ ]*\\{%[ ]*if[ ]+(.+)[ ]+\"([^\"]+)\"[ ]*%\\}[ ]*$";
                re_else = "^[ ]*\\{%[ ]*else[ ]*%\\}[ ]*$";
                re_endif = "^[ ]*\\{%[ ]*endif[ ]*%\\}[ ]*$";
            }
            function eval_condition(comp, cond_value) {
                if (comp == "contains") {
                    return (cond_value in allowed);
                }
                if (comp == "does not contain") {
                    return !(cond_value in allowed);
                }
                if (comp == "is" || comp == "equals") {
                    return (list_count == 1 && cond_value == allowed_items[1]);
                }
                if (comp == "is not" || comp == "does not equal") {
                    return (list_count == 1 && cond_value != allowed_items[1]);
                }
                return 0;
            }
            !in_conditional {
                if ($0 ~ re_if) {
                    condition_line = $0;
                    sub(/^[ ]*\{%[ ]*if[ ]+/, "", condition_line);
                    sub(/[ ]*%\}[ ]*$/, "", condition_line);
                    cond_value = condition_line;
                    sub(/^[^"]*"/, "", cond_value);
                    sub(/".*$/, "", cond_value);
                    condition = condition_line;
                    sub(/[ ]+"[^"]+"[ ]*$/, "", condition);
                    sub(/[ ]+$/, "", condition);
                    line_tag = condition;
                    sub(/[ ].*$/, "", line_tag);
                    line_comparator = condition;
                    sub(/^[^ ]+[ ]+/, "", line_comparator);
                    if (line_tag == tag && (line_comparator in supported)) {
                        in_conditional = 1;
                        branch_matches = eval_condition(line_comparator, cond_value);
                        in_else = 0;
                        next;
                    }
                }
                print;
                next;
            }
            {
                if ($0 ~ re_else) {
                    in_else = 1;
                    next;
                }
                if ($0 ~ re_endif) {
                    in_conditional = 0;
                    branch_matches = 0;
                    in_else = 0;
                    next;
                }
                if ((branch_matches && !in_else) || (!branch_matches && in_else)) {
                    print;
                }
            }' "${FILE}" > "${FILE_TEMP}" || return 1
        mv "${FILE_TEMP}" "${FILE}"
    }

    function clean_conditionals {  # clean_conditionals file
        local FILE FILE_TEMP
        FILE="${1:-}"; [[ "${FILE}" == "" ]] && return 1
        FILE_TEMP=$(mktemp "${MARSH_TEMP}/conditional-XXXXXX")
        # remove unsupported conditionals
        cp "${FILE}" "${FILE_TEMP}"
        <"${FILE_TEMP}" awk '/^[ ]*\{%[ ]*if[^%]+%\}[ ]*$/ {k=1;i=1;for (j in a) delete a[j]} {a[i++]=$0} (k==1 && /^[ ]*\{%[ ]*endif[ ]*%\}[ ]*$/) {k=0;next} (k==0) { print }' > "${FILE}"
        return 0
    }

    function parse_template_tag {  # parse_template_tag tag_string
        local TAG_STRING TAG_BODY TAG_CHAR TAG_CURRENT TAG_QUOTE TAG_ESCAPE TAG_INDEX TAG_PART TAG_NAME_VALUE
        local TAG_PARTS

        TAG_STRING="${1:-}"
        [[ "${TAG_STRING}" == "" ]] && return 1
        TAG_BODY=$(echo "${TAG_STRING}" | sed -E -e 's/^\{\{[ ]*//' -e 's/[ ]*\}\}$//')
        TAG_PARTS=()
        TAG_CURRENT=""
        TAG_QUOTE=""
        TAG_ESCAPE=false

        for (( TAG_INDEX=0; TAG_INDEX<${#TAG_BODY}; TAG_INDEX++ )); do
            TAG_CHAR="${TAG_BODY:${TAG_INDEX}:1}"
            if [[ "${TAG_ESCAPE}" == true ]]; then
                case "${TAG_CHAR}" in
                    '\'|'|'|'"'|"'")
                        TAG_CURRENT+="${TAG_CHAR}"
                        ;;
                    *)
                        TAG_CURRENT+='\'
                        TAG_CURRENT+="${TAG_CHAR}"
                        ;;
                esac
                TAG_ESCAPE=false
            elif [[ "${TAG_CHAR}" == '\' ]]; then
                TAG_ESCAPE=true
            elif [[ "${TAG_CHAR}" == '|' ]] && [[ "${TAG_QUOTE}" == "" ]]; then
                TAG_PARTS+=("$(echo "${TAG_CURRENT}" | sed -E -e 's/^[ ]+//' -e 's/[ ]+$//')")
                TAG_CURRENT=""
            elif [[ "${TAG_CHAR}" == "'" ]] && [[ "${TAG_QUOTE}" != '"' ]]; then
                if [[ "${TAG_QUOTE}" == "'" ]]; then
                    TAG_QUOTE=""
                else
                    TAG_QUOTE="'"
                fi
            elif [[ "${TAG_CHAR}" == '"' ]] && [[ "${TAG_QUOTE}" != "'" ]]; then
                if [[ "${TAG_QUOTE}" == '"' ]]; then
                    TAG_QUOTE=""
                else
                    TAG_QUOTE='"'
                fi
            else
                TAG_CURRENT+="${TAG_CHAR}"
            fi
        done

        [[ "${TAG_ESCAPE}" == true ]] && return 1
        [[ "${TAG_QUOTE}" != "" ]] && return 1
        TAG_PARTS+=("$(echo "${TAG_CURRENT}" | sed -E -e 's/^[ ]+//' -e 's/[ ]+$//')")
        TAG_NAME_VALUE="${TAG_PARTS[0]:-}"
        [[ "${TAG_NAME_VALUE}" == "" ]] && return 1

        printf 'TAG_NAME=%q\n' "${TAG_NAME_VALUE}"
        echo "TAG_FILTERS=()"
        for TAG_INDEX in "${!TAG_PARTS[@]}"; do
            [[ "${TAG_INDEX}" -eq 0 ]] && continue
            TAG_PART="${TAG_PARTS[$TAG_INDEX]}"
            [[ "${TAG_PART}" == "" ]] && continue
            printf 'TAG_FILTERS+=(%q)\n' "${TAG_PART}"
        done
        return 0
    }

    function replace_tags {  # replace_tags document prefix metadata_vars[@]
        local DOCUMENT PREFIX METADATA_VARS
        local TAG_FRAGMENT_UNQUOTED TAG_FRAGMENT_DOUBLE TAG_FRAGMENT_SINGLE TAG_FRAGMENT TAG_REGEX
        local TAGS UNIQUE_TAGS REPLACEMENTS TAG_ESC TAG_NAME TAG_FILTERS TAG_VAR TAG_TYPE TAG_VALUE TAG_VALUES TAG_PARSE
        local I RES

        # init
        DOCUMENT="${1:-}"
        PREFIX="${2:-}"
        METADATA_VARS="${3:-}"
        [[ "${DOCUMENT}" == "" ]] && return 1
        TAG_FRAGMENT_UNQUOTED='([^|}"'"'"' \\]|\\.)+'
        TAG_FRAGMENT_DOUBLE='"(\\.|[^"\\])*"'
        TAG_FRAGMENT_SINGLE="'(\\.|[^'\\])*'"
        TAG_FRAGMENT="(${TAG_FRAGMENT_UNQUOTED}|${TAG_FRAGMENT_DOUBLE}|${TAG_FRAGMENT_SINGLE})+"
        TAG_REGEX="\\{\\{[ ]*[a-z][a-z0-9.-]*([ ]*\\|[ ]*${TAG_FRAGMENT})*[ ]*\\}\\}"

        # find template tags
        TAGS=()
        while IFS= read -r TAG; do
            TAGS+=("${TAG}")
        done < <(<"${DOCUMENT}" grep -Eo "${TAG_REGEX}")
        [[ "${#TAGS[@]}" -eq 0 ]] && return 0
        UNIQUE_TAGS=()
        REPLACEMENTS=$(mktemp "${MARSH_TEMP}/template-tags-XXXXXX") || return 1

        # build single replacement script handling all unique tags
        for I in "${!TAGS[@]}"; do
            if marsh_in_array "${TAGS[$I]}" "${UNIQUE_TAGS[@]}"; then
                continue
            fi
            UNIQUE_TAGS+=("${TAGS[$I]}")
            TAG_ESC=$(printf '%s' "${TAGS[$I]}" | sed -e 's/[\\]/\\\\/g' -e 's/[][/.|$(){}?+*^]/\\&/g')
            TAG_PARSE=$(parse_template_tag "${TAGS[$I]}") || {
                rm -f "${REPLACEMENTS}"
                return 1
            }
            eval "${TAG_PARSE}"
            TAG_VAR=""
            TAG_TYPE=""
            eval "$(marsh_resolve_tag_metadata "${TAG_NAME}" "${PREFIX}" "${METADATA_VARS}" 2>/dev/null)" || true
            if [[ "${TAG_VAR}" != "" ]] && [[ "${TAG_TYPE}" != "" ]]; then
                if [[ "${TAG_TYPE}" == "array" ]]; then
                    eval "$(marsh_flat_to_array "TAG_VALUES" "${TAG_VAR}")"
                    TAG_VALUE=$(printf '%s\n' "${TAG_VALUES[@]}")
                elif [[ "${TAG_TYPE}" == "file" ]]; then
                    if [[ -f "${!TAG_VAR}" ]] && [[ -r "${!TAG_VAR}" ]]; then
                        TAG_VALUE=$(<"${!TAG_VAR}")
                    else
                        rm -f "${REPLACEMENTS}"
                        return 1
                    fi
                elif [[ "${TAG_TYPE}" == "string" ]]; then
                    TAG_VALUE="${!TAG_VAR}"
                else
                    rm -f "${REPLACEMENTS}"
                    return 1
                fi
                TAG_VALUE=$(printf '%s' "${TAG_VALUE}" | marsh_text_filter "${TAG_FILTERS[@]}" | marsh_escape_substitution)
                printf '/%s/s//%s/g\n' "${TAG_ESC}" "${TAG_VALUE:-}" >> "${REPLACEMENTS}" || {
                    rm -f "${REPLACEMENTS}"
                    return 1
                }
            else
                # ignore unknown tags
                :
            fi
        done

        # perform replacements in a single pass
        RES=0
        if [[ -s "${REPLACEMENTS}" ]]; then
            sed -E -f "${REPLACEMENTS}" -i".${MARSH_UID}.backup" "${DOCUMENT}" || RES=1
        fi
        rm -f "${REPLACEMENTS}"
        rm -f "${DOCUMENT}.${MARSH_UID}.backup"
        return "${RES}"
    }

    local DEST_DIR TARGET_DIR ADVANCED_NAV
    local DOCUMENT DOCUMENT_EXT DOCUMENT_DIR DOCUMENT_RELPATH DOCUMENT_ABSPATH DOCUMENT_URI
    local DEST DEST_NAME
