                    ;;
                TEMPLATE_ASSETS_FONTS)
                    [[ "${TEMPLATE_METADATA_ENTRY_TYPE}" == "list" ]] || return 1
                    if [[ "${TEMPLATE_METADATA_ENTRY_LIST}" != "" ]]; then
