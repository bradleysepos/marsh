            "TEMPLATE_ASSET_OUTPUT_PATHS_SCRIPTS_TEXT" \
            "TEMPLATE_ASSET_OUTPUT_PATHS_IMAGES_TEXT" \
            "TEMPLATE_ASSET_OUTPUT_PATHS_AUDIO_TEXT" \
            "TEMPLATE_ASSET_OUTPUT_PATHS_VIDEO_TEXT" \
            "TEMPLATE_ASSET_OUTPUT_PATHS_DOCUMENTS_TEXT" \
            "TEMPLATE_ASSET_OUTPUT_PATHS_BINARIES_TEXT" \
            "TEMPLATE_ASSET_OUTPUT_PATHS_OTHER_TEXT" || return 1
        for TEMPLATE_ASSET_TYPE in "${TEMPLATE_ASSET_TYPES[@]}"; do
            ASSET_OUTPUT_PATHS_TEXT_VAR="TEMPLATE_ASSET_OUTPUT_PATHS_${TEMPLATE_ASSET_TYPE}_TEXT"
            while IFS= read -r ASSET_OUTPUT_PATH; do
                [[ "${ASSET_OUTPUT_PATH}" == "" ]] && continue
                case "${TEMPLATE_ASSET_TYPE}" in
                    FONTS)
                        TEMPLATE_ASSET_OUTPUT_PATHS_FONTS+=("${ASSET_OUTPUT_PATH}")
                        ;;
                    STYLES)
                        TEMPLATE_ASSET_OUTPUT_PATHS_STYLES+=("${ASSET_OUTPUT_PATH}")
                        ;;
                    SCRIPTS)
                        TEMPLATE_ASSET_OUTPUT_PATHS_SCRIPTS+=("${ASSET_OUTPUT_PATH}")
                        ;;
                    IMAGES)
                        TEMPLATE_ASSET_OUTPUT_PATHS_IMAGES+=("${ASSET_OUTPUT_PATH}")
                        ;;
                    AUDIO)
                        TEMPLATE_ASSET_OUTPUT_PATHS_AUDIO+=("${ASSET_OUTPUT_PATH}")
                        ;;
