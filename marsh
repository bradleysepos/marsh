        elif [[ "${DOCUMENT_Type}" == "archive-atom" ]]; then
            TEMPLATE_BASE_FILE="${TEMPLATE_Template_Partials_Archive_Atom_Base:-}"
            TEMPLATE_BODY_FILE="${TEMPLATE_Template_Partials_Archive_Atom_Body:-}"
