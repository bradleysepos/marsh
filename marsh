        fi
        TEMPLATE_HEAD_TEMPLATE=""
        if [[ -f "${TEMPLATE_HEAD_FILE}" ]] && [[ -r "${TEMPLATE_HEAD_FILE}" ]]; then
            TEMPLATE_HEAD_TEMPLATE=$(<"${TEMPLATE_HEAD_FILE}")
