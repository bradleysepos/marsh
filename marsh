            fi
        fi

        TEMPLATE_BODY_ESC=$(printf '%s' "${TEMPLATE_BODY}" | marsh_escape_substitution)
        TEMPLATE_DOCUMENT_ESC=$(printf '%s' "${TEMPLATE_DOCUMENT_TEMPLATE}" | marsh_escape_substitution)
        TEMPLATE_HEADER_ESC=$(printf '%s' "${TEMPLATE_HEADER_TEMPLATE}" | marsh_escape_substitution)
        TEMPLATE_FOOTER_ESC=$(printf '%s' "${TEMPLATE_FOOTER_TEMPLATE}" | marsh_escape_substitution)
        TEMPLATE_NAV_ESC=$(printf '%s' "${TEMPLATE_NAV_TEMPLATE}" | marsh_escape_substitution)
        TEMPLATE_NOTICE_ESC=$(printf '%s' "${TEMPLATE_NOTICE_TEMPLATE}" | marsh_escape_substitution)
        TEMPLATE_SCRIPTS_ESC=$(printf '%s' "${TEMPLATE_SCRIPTS}" | marsh_escape_substitution)
        TEMPLATE_STYLES_ESC=$(printf '%s' "${TEMPLATE_STYLES}" | marsh_escape_substitution)
        TEMPLATE_ADVNAV_ESC=$(printf '%s' "${TEMPLATE_ADVNAV}" | marsh_escape_substitution)

        TEMPLATE_RENDER=$(printf '%s' "${TEMPLATE_RENDER}" | sed -E \
        -e "/\{\{[ ]*template\.body[ ]*\}\}/s//${TEMPLATE_BODY_ESC:-}/g" \
        -e "/\{\{[ ]*template\.document[ ]*\}\}/s//${TEMPLATE_DOCUMENT_ESC:-}/g" \
        -e "/\{\{[ ]*template\.header[ ]*\}\}/s//${TEMPLATE_HEADER_ESC:-}/g" \
        -e "/\{\{[ ]*template\.footer[ ]*\}\}/s//${TEMPLATE_FOOTER_ESC:-}/g" \
        -e "/\{\{[ ]*template\.nav[ ]*\}\}/s//${TEMPLATE_NAV_ESC:-}/g" \
        -e "/\{\{[ ]*template\.notice[ ]*\}\}/s//${TEMPLATE_NOTICE_ESC:-}/g" \
        -e '/\{\{[ ]*template\.scripts[ ]*\}\}/s||'"${TEMPLATE_SCRIPTS_ESC:-}"'|g' \
        -e '/\{\{[ ]*template\.styles[ ]*\}\}/s||'"${TEMPLATE_STYLES_ESC:-}"'|g' \
        -e "/\{\{[ ]*navigation[ ]*\}\}/s//${TEMPLATE_ADVNAV_ESC:-}/g" \
        -e 's/\{\{[ ]*navigation[ ]*\}\}//g' \
        -e '/\{\{[ ]*template(\.[a-z]+)?[ ]*\}\}/s///g')
        printf '%s\n' "${TEMPLATE_RENDER}" > "${DEST}" || {
            echo "Unable to write template output: ${DEST}" >&2
            return 1
        }

        # template tags
        replace_tags "${DEST}" "DOCUMENT_" "${DOCUMENT_META_VARS:-}"

        # subdocuments
        SUBDOCUMENTS=()
        SUBDOCUMENT_URIS=()
        SUBDOCUMENT_ABSPATHS=()
        SUBDOCUMENTS_MANIFEST="${DOCUMENT}.${MARSH_UID}.subdocuments.manifest"
        if [[ -f "${SUBDOCUMENTS_MANIFEST}" ]] && [[ -r "${SUBDOCUMENTS_MANIFEST}" ]]; then
            SUBDOCUMENTS_LIST=$(<"${SUBDOCUMENTS_MANIFEST}")
            while IFS=$'\t' read -r SUBDOCUMENT_DOCUMENT_ESC SUBDOCUMENT_URI_ESC SUBDOCUMENT_ABSPATH_ESC; do
                [[ "${SUBDOCUMENT_DOCUMENT_ESC}" == "" ]] && continue
                SUBDOCUMENT=""
                SUBDOCUMENT_URI_FROM_MANIFEST=""
                SUBDOCUMENT_ABSPATH_FROM_MANIFEST=""
                eval "SUBDOCUMENT=${SUBDOCUMENT_DOCUMENT_ESC}"
                eval "SUBDOCUMENT_URI_FROM_MANIFEST=${SUBDOCUMENT_URI_ESC}"
                eval "SUBDOCUMENT_ABSPATH_FROM_MANIFEST=${SUBDOCUMENT_ABSPATH_ESC}"
                SUBDOCUMENTS+=("${SUBDOCUMENT}")
                SUBDOCUMENT_URIS+=("${SUBDOCUMENT_URI_FROM_MANIFEST}")
                SUBDOCUMENT_ABSPATHS+=("${SUBDOCUMENT_ABSPATH_FROM_MANIFEST}")
            done <<< "${SUBDOCUMENTS_LIST}"
        else
            SUBDOCUMENTS_LIST=$(marsh_get_subdocuments "${DOCUMENT}")
            while IFS= read -r SUBDOCUMENT; do
                [[ "${SUBDOCUMENT}" == "" ]] && continue
                SUBDOCUMENTS+=("${SUBDOCUMENT}")
                SUBDOCUMENT_URIS+=("")
                SUBDOCUMENT_ABSPATHS+=("")
            done <<< "${SUBDOCUMENTS_LIST}"
        fi
        NUM_SUBDOCUMENTS="${#SUBDOCUMENTS[@]}"
        if [[ "${NUM_SUBDOCUMENTS}" -gt 0 ]]; then
            : > "${DOCUMENT}.${MARSH_UID}.subdocuments" || {
                echo "Unable to create subdocuments file: ${DOCUMENT}.${MARSH_UID}.subdocuments" >&2
                return 1
            }
            for J in "${!SUBDOCUMENTS[@]}"; do
                # full path
                SUBDOCUMENT_SOURCE="${SUBDOCUMENTS[$J]}"
                SUBDOCUMENT_URI=""
                SUBDOCUMENT_ABSPATH=""
                SUBDOCUMENT_URI_FROM_MANIFEST="${SUBDOCUMENT_URIS[$J]:-}"
                SUBDOCUMENT_ABSPATH_FROM_MANIFEST="${SUBDOCUMENT_ABSPATHS[$J]:-}"
                SUBDOCUMENT_META=""
                SUBDOCUMENT_META_VARS=""
                # document metadata
                if [[ -f "${SUBDOCUMENT_SOURCE%.document}.meta.yaml" ]] && [[ -r "${SUBDOCUMENT_SOURCE%.document}.meta.yaml" ]]; then
                    # parse metadata
                    SUBDOCUMENT_META=$(marsh_parse_yaml "${SUBDOCUMENT_SOURCE%.document}.meta.yaml" "SUBDOCUMENT_")
                    [[ $? -ne 0 ]] && echo "Unable to parse yaml file: ${SUBDOCUMENT_SOURCE%.document}.meta.yaml" >&2 && return 1
                    SUBDOCUMENT_META_VARS=$(echo "${SUBDOCUMENT_META}" | sed -E -e 's/^([^=]+)=.*/\1/')
                    eval "$(printf '%s\n' "${SUBDOCUMENT_META_VARS}" | marsh_get_local_declarations)"
                    eval "${SUBDOCUMENT_META}"
                fi
                [[ "${SUBDOCUMENT_URI_FROM_MANIFEST:-}" != "" ]] && SUBDOCUMENT_URI="${SUBDOCUMENT_URI_FROM_MANIFEST}"
                [[ "${SUBDOCUMENT_ABSPATH_FROM_MANIFEST:-}" != "" ]] && SUBDOCUMENT_ABSPATH="${SUBDOCUMENT_ABSPATH_FROM_MANIFEST}"
                # state
                eval $(marsh_flat_to_array "SUBDOCUMENT_State" "SUBDOCUMENT_State_")
                SUBDOCUMENT_TEMPLATE=$(<"${SUBDOCUMENT_SOURCE}")
                if [[ "${DOCUMENT_Type}" == "archive-atom" ]]; then
                    SUBDOCUMENT_CONTENT="${SUBDOCUMENT_SOURCE}"
                    # document template
                    if [[ "${TEMPLATE_Template_Partials_Archive_Atom_Document:-}" != "" ]]; then
                        SUBDOCUMENT_TEMPLATE=$(<"${TEMPLATE_Template_Partials_Archive_Atom_Document}")
                    fi
                elif [[ "${DOCUMENT_Type}" == "archive-json" ]]; then
                    SUBDOCUMENT_CONTENT="${SUBDOCUMENT_SOURCE}"
                    # document template
                    if [[ "${TEMPLATE_Template_Partials_Archive_JSON_Document:-}" != "" ]]; then
                        SUBDOCUMENT_TEMPLATE=$(<"${TEMPLATE_Template_Partials_Archive_JSON_Document}")
                    fi
                else
                    # markdown to html
                    TEXT_FILTER=
                    if [[ "${MARKDOWN_REWRITE_LINKS}" == true ]]; then
                        TEXT_FILTER="links:replace-ext:${MARKDOWN_FILEEXT_CSV}:html"
                    fi
                    SUBDOCUMENT_CONTENT=$(mktemp "${MARSH_TEMP}/subdocument-content-XXXXXX") || {
                        echo "Unable to create subdocument render file: ${MARSH_TEMP}/subdocument-content-XXXXXX" >&2
                        return 1
                    }
                    <"${SUBDOCUMENT_SOURCE}" marsh_text_filter ${TEXT_FILTER} | marsh_process_markdown "${MARKDOWN_COMMAND}" "${MARKDOWN_OPTIONS_CSV}" > "${SUBDOCUMENT_CONTENT}" || {
                        echo "Unable to process subdocument markdown: ${SUBDOCUMENT_SOURCE}" >&2
                        rm -f "${SUBDOCUMENT_CONTENT}"
                        return 1
                    }
                    # document template
                    if [[ "${DOCUMENT_Type}" == "archive" ]]; then
                        SUBDOCUMENT_TEMPLATE=$(<"${TEMPLATE_Template_Partials_Archive_HTML_Document}")
                    else
                        SUBDOCUMENT_TEMPLATE=$(<"${TEMPLATE_Template_Partials_Document}")
                    fi
                fi
                SUBDOCUMENT_CONTENT_ESC=$(<"${SUBDOCUMENT_CONTENT}" marsh_escape_substitution)
                SUBDOCUMENT_RENDER=$(printf '%s' "${SUBDOCUMENT_TEMPLATE}" | sed -E \
                    -e "/\{\{[ ]*document[ ]*\}\}/s//${SUBDOCUMENT_CONTENT_ESC}/g" \
                    -e 's/\{\{[ ]*subdocuments[ ]*\}\}//g')
                # template tags
                if [[ "${DOCUMENT_Type}" == "archive-json" ]] && [[ "${J}" -eq $((NUM_SUBDOCUMENTS - 1)) ]]; then
                    SUBDOCUMENT_RENDER=$(printf '%s' "${SUBDOCUMENT_RENDER}" | sed -E -e 's/\{\{[ ]*util.json-separator[ ]*\}\}//g')
                fi
                SUBDOCUMENT_RENDER_FILE=$(mktemp "${MARSH_TEMP}/subdocument-render-XXXXXX") || {
                    [[ "${DOCUMENT_Type}" != "archive-atom" ]] && [[ "${DOCUMENT_Type}" != "archive-json" ]] && rm -f "${SUBDOCUMENT_CONTENT}"
                    echo "Unable to create rendered subdocument file: ${MARSH_TEMP}/subdocument-render-XXXXXX" >&2
                    return 1
                }
                printf '%s\n' "${SUBDOCUMENT_RENDER}" > "${SUBDOCUMENT_RENDER_FILE}" || {
                    [[ "${DOCUMENT_Type}" != "archive-atom" ]] && [[ "${DOCUMENT_Type}" != "archive-json" ]] && rm -f "${SUBDOCUMENT_CONTENT}"
                    rm -f "${SUBDOCUMENT_RENDER_FILE}"
                    echo "Unable to write rendered subdocument: ${SUBDOCUMENT_SOURCE}" >&2
                    return 1
                }
                replace_tags "${SUBDOCUMENT_RENDER_FILE}" "SUBDOCUMENT_" "${SUBDOCUMENT_META_VARS:-}" || {
                    [[ "${DOCUMENT_Type}" != "archive-atom" ]] && [[ "${DOCUMENT_Type}" != "archive-json" ]] && rm -f "${SUBDOCUMENT_CONTENT}"
                    rm -f "${SUBDOCUMENT_RENDER_FILE}"
                    echo "Unable to replace tags in subdocument: ${SUBDOCUMENT_SOURCE}" >&2
                    return 1
                }
                # combine with previous subdocuments
                cat "${SUBDOCUMENT_RENDER_FILE}" >> "${DOCUMENT}.${MARSH_UID}.subdocuments"
                [[ "${DOCUMENT_Type}" != "archive-atom" ]] && [[ "${DOCUMENT_Type}" != "archive-json" ]] && rm -f "${SUBDOCUMENT_CONTENT}"
                rm -f "${SUBDOCUMENT_RENDER_FILE}"
            done
            awk -v subdocuments_file="${DOCUMENT}.${MARSH_UID}.subdocuments" '
            function emit_subdocuments(prefix, suffix, line, first, previous) {
                first = 1
                previous = ""
                while ((getline line < subdocuments_file) > 0) {
                    if (first) {
                        line = prefix line
                        first = 0
                    }
                    if (previous != "") {
                        print previous
                    }
                    previous = line
                }
                close(subdocuments_file)
                if (first) {
                    print prefix suffix
                } else {
                    print previous suffix
                }
            }
            {
                if (match($0, /\{\{[ ]*subdocuments[ ]*\}\}/)) {
                    emit_subdocuments(substr($0, 1, RSTART - 1), substr($0, RSTART + RLENGTH))
                } else {
                    print
                }
            }' "${DEST}" > "${DEST}.${MARSH_UID}.temp" || return 1
            mv "${DEST}.${MARSH_UID}.temp" "${DEST}" || return 1
        else
            sed -E -e 's/\{\{[ ]*subdocuments[ ]*\}\}//g' -i".${MARSH_UID}.backup" "${DEST}" && rm -f "${DEST}.${MARSH_UID}.backup"
        fi
    else
        cp "${DOCUMENT_CONTENT}" "${DEST}"
    fi  # TEMPLATE_DIR != "" else

    # smart comment tags
    sed -E \
    -e 's|<!--[ ]*([a-z]+)\.([^ ]*)([ ]+[^ ]+)[ ]*-->|<\1 class="\2"\3>|g' \
    -e 's|<!--[ ]*([a-z]+)\#([^ ]*)([ ]+[^ ]+)[ ]*-->|<\1 id="\2"\3>|g' \
    -e 's|<!--[ ]*([a-z]+)\.([^ ]*)[ ]*-->|<\1 class="\2">|g' \
    -e 's|<!--[ ]*([a-z]+)\#([^ ]*)[ ]*-->|<\1 id="\2">|g' \
    -e 's|<!--[ ]*\/([a-z]+)([.#])([^ ]*)[ ]*-->|</\1><!-- end \1\2\3 -->|g' \
    -e 's|<!--[ ]*\.([^ ]*)([ ]+[^ ]+)[ ]*-->|<div class="\1"\2>|g' \
    -e 's|<!--[ ]*\#([^ ]*)([ ]+[^ ]+)[ ]*-->|<div id="\1"\2>|g' \
    -e 's|<!--[ ]*\.([^ ]*)[ ]*-->|<div class="\1">|g' \
    -e 's|<!--[ ]*\#([^ ]*)[ ]*-->|<div id="\1">|g' \
    -e 's|<!--[ ]*\/([.#])([^ ]*)[ ]*-->|</div><!-- end div\1\2 -->|g' \
    -i".${MARSH_UID}.backup" "${DEST}" && rm -f "${DEST}.${MARSH_UID}.backup"

    # multiple classes foo.bar.baz to foo bar baz
    sed -E \
    -e ':a' -e 's|class="([^."]+)\.([^"]+)"|class="\1 \2"|g' -e 'ta' \
    -i".${MARSH_UID}.backup" "${DEST}" && rm -f "${DEST}.${MARSH_UID}.backup"

    # escape double quotes for JSON
    if [[ "${DOCUMENT_Type}" == "archive-json" ]]; then
        sed -E \
        -e ':a' -e 's|class="([^"]+)"|class=\\"\1\\"|g' -e 'ta' \
        -i".${MARSH_UID}.backup" "${DEST}" && rm -f "${DEST}.${MARSH_UID}.backup"
    fi

    # unwrap figures
    sed -E \
    -e 's|<p><figure>|<figure>|' \
    -e 's|</figure></p>|</figure>|' \
    -i".${MARSH_UID}.backup" "${DEST}" && rm -f "${DEST}.${MARSH_UID}.backup"
}

# builds a document from a single file
function marsh_build_document {  # marsh_build_document dest_dir target_dir document markdown_command markdown_options_csv markdown_fileext_csv markdown_rewrite_links
    local DEST_DIR TARGET_DIR DOCUMENT DOCUMENT_EXT DOCUMENT_DIR TEXT_FILTER
    local MARKDOWN_COMMAND MARKDOWN_OPTIONS_CSV MARKDOWN_FILEEXT_CSV MARKDOWN_REWRITE_LINKS
    local TARGET_PATH DOCUMENT_PATH DOCUMENT_META DOCUMENT_CONTENT ARCHIVE_META ARCHIVE_META_TEMP

    # init
    DEST_DIR="${1:-.}"
    DEST_DIR="${DEST_DIR%/}"
    TARGET_DIR="${2:-.}"
    TARGET_DIR="${TARGET_DIR%/}"
    DOCUMENT="${3:-}"
    MARKDOWN_COMMAND="${4:-}"
    MARKDOWN_OPTIONS_CSV="${5:-}"
    MARKDOWN_FILEEXT_CSV="${6:-}"
    MARKDOWN_REWRITE_LINKS="${7:-}"
    [[ "${DOCUMENT}" == "" ]] && return 1
    [[ "${MARKDOWN_COMMAND}" == "" ]] && return 1
    [[ "${MARKDOWN_FILEEXT_CSV}" == "" ]] && return 1
    [[ "${MARKDOWN_REWRITE_LINKS}" == "" ]] && return 1
    DOCUMENT_EXT="${DOCUMENT##*.}"
    DOCUMENT_DIR="./${DOCUMENT}"
    DOCUMENT_DIR="${DOCUMENT_DIR%/*}"
    DOCUMENT_DIR="${DOCUMENT_DIR#./}"
    TARGET_PATH="${DEST_DIR}/${TARGET_DIR}"
    DOCUMENT_PATH="${TARGET_PATH}/${DOCUMENT}"
    DOCUMENT_META="${DOCUMENT_PATH}.${MARSH_UID}.meta.yaml"
    DOCUMENT_CONTENT="${DOCUMENT_PATH}.${MARSH_UID}.document"
    ARCHIVE_META="${DOCUMENT_PATH}.${MARSH_UID}.archive-meta"

    # normalize extensions
    if marsh_is_markdown_extension "${DOCUMENT_EXT}" "${MARKDOWN_FILEEXT_CSV}"; then
        DOCUMENT_EXT="markdown"
    fi

    # remove stale archive metadata before rebuilding metadata outputs
    rm -f "${ARCHIVE_META}"

    # extract frontmatter metadata and document content
    if marsh_has_frontmatter "${DOCUMENT_PATH}"; then
        marsh_extract_frontmatter "${DOCUMENT_PATH}" "${DOCUMENT_META}" "${DOCUMENT_CONTENT}" || {
            echo "Unable to extract document frontmatter: ${DOCUMENT_PATH}" >&2
            return 1
        }
    fi

    if [[ "${DOCUMENT_EXT}" == "markdown" ]]; then
        # preprocess markdown to convert markdown links to html
        # preprocess markdown to add implicit figures
        # convert preprocessed markdown to html
        # unwrap figures (remove p tag)
        # process images with multiple resolution assets
        cp "${DOCUMENT_CONTENT}" "${DOCUMENT_CONTENT}.temp"
        TEXT_FILTER=
        if [[ "${MARKDOWN_REWRITE_LINKS}" == true ]]; then
            TEXT_FILTER="links:replace-ext:${MARKDOWN_FILEEXT_CSV}:html"
        fi
        <"${DOCUMENT_CONTENT}.temp" marsh_text_filter ${TEXT_FILTER} | sed -E \
        -e 's|^!\[(.+)]\([ ]*([^ ]+)[ ]*"(.+)"[ ]*\)$|<figure>'$'\\\n''<a href="\2">'$'\\\n''<img src="\2" alt="\1" />'$'\\\n''</a>'$'\\\n''<figcaption>\3</figcaption>'$'\\\n''</figure>|' |
        marsh_process_markdown "${MARKDOWN_COMMAND}" "${MARKDOWN_OPTIONS_CSV}" |
        sed -E \
        -e 's|<p><figure>|<figure>|' \
        -e 's|</figure></p>|</figure>|' |
        awk -v document_dir_prefix="${TARGET_PATH}/${DOCUMENT_DIR}/" '
        {
            if ($0 ~ " src=\"[^\"]+\"")
            {
                num_fields = split($0, a, " ");
                for(i=1; i<=num_fields; i++)
                {
                    if (a[i] ~ "^src=\"[^\"]+\"$")
                    {
                        f=a[i]; gsub(/^src="/, "", f);
                        gsub(/"$/, "", f);
                        f1=f " 1x"; f2=f;
                        gsub(/\.[^\.]+$/, "@2x&", f2);
                        f2abs=document_dir_prefix f2;
                        f3=f;
                        gsub(/\.[^\.]+$/, "@3x&", f3);
                        f3abs=document_dir_prefix f3;
                        if (getline temp < f2abs > 0)
                        {
                            f2=", " f2 " 2x";
                        } else {
                            f2="";
                        }
                        if (getline temp < f3abs > 0)
                        {
                            f3=", " f3 " 3x";
                        } else {
                            f3="";
                        }
                        a[i] = "src=\"" f "\" srcset=\"" f1 f2 f3 "\"";
                    }
                    if (i > 1)
                    {
                        printf " ";
                    }
                    printf "%s", a[i];
                }
                printf "\n";
            } else {
                print $0;
            }
        }' > "${DOCUMENT_CONTENT}"
    fi

    # build archive metadata from the document metadata
    if [[ -f "${DOCUMENT_META}" ]] && [[ -r "${DOCUMENT_META}" ]]; then
        ARCHIVE_META_TEMP=$(mktemp "${MARSH_TEMP}/archive-meta-XXXXXX") || {
            echo "Unable to create archive metadata file: ${MARSH_TEMP}/archive-meta-XXXXXX" >&2
            return 1
        }
        marsh_get_archive_metadata "${TARGET_PATH}" "${DOCUMENT}.${MARSH_UID}.document" > "${ARCHIVE_META_TEMP}" \
            && mv "${ARCHIVE_META_TEMP}" "${ARCHIVE_META}" || {
                echo "Unable to build archive metadata: ${DOCUMENT_PATH}" >&2
                rm -f "${ARCHIVE_META_TEMP}"
                return 1
            }
    fi

}

# builds a target, parallel if possible
function marsh_build_target {  # marsh_build_target dest_dir target jobs advanced_nav templates_dir template markdown_command markdown_options_csv markdown_fileext_csv markdown_rewrite_links #template_overrides[@] template_overrides[@] skip_template_assets
    local DEST_DIR TARGET JOBS ADVANCED_NAV TEMPLATES_DIR TEMPLATE
    local MARKDOWN_COMMAND MARKDOWN_OPTIONS_CSV MARKDOWN_FILEEXT_CSV MARKDOWN_FILEEXT_REGEX MARKDOWN_REWRITE_LINKS
    local NUM_TEMPLATE_OVERRIDES TEMPLATE_OVERRIDES SKIP_TEMPLATE_ASSETS
    local TEMPLATE_META TEMPLATE_META_VARS TEMPLATE_ASSETS_ALL
    local TARGET_DIR TEMPLATE_PREFIX DOCUMENTS_LIST DOCUMENTS DOCUMENTS_DIR DOCUMENTS_FIND_ARGS FILTERED_DOCUMENTS DOCUMENT
    local PARALLEL PARALLEL_MARKDOWN ASSET

    # init
    DEST_DIR="${1:-.}"
    DEST_DIR="${DEST_DIR%/}"
    TARGET="${2:-}"
    TARGET="${TARGET%/}"
    TARGET_DIR="${TARGET%/*}"
    TARGET_DIR="${TARGET_DIR:-.}"
    TARGET="${TARGET:-*}"
    JOBS="${3:-1}"
    ADVANCED_NAV="${4:-}"
    TEMPLATES_DIR="${5:-}"
    TEMPLATE="${6:-}"
    MARKDOWN_COMMAND="${7:-}"
    MARKDOWN_OPTIONS_CSV="${8:-}"
    MARKDOWN_FILEEXT_CSV="${9:-}"
    MARKDOWN_FILEEXT_REGEX="${MARKDOWN_FILEEXT_CSV//,/|}"
    MARKDOWN_REWRITE_LINKS="${10:-}"
    shift 10
    [[ "${MARKDOWN_COMMAND}" == "" ]] && return 1
    [[ "${MARKDOWN_FILEEXT_CSV}" == "" ]] && return 1
    [[ "${MARKDOWN_REWRITE_LINKS}" == "" ]] && return 1
    NUM_TEMPLATE_OVERRIDES="${1:-0}"
    shift 1
    TEMPLATE_OVERRIDES=()
    while [[ "${NUM_TEMPLATE_OVERRIDES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        TEMPLATE_OVERRIDES+=("${1}")
        NUM_TEMPLATE_OVERRIDES=$((NUM_TEMPLATE_OVERRIDES - 1))
        shift 1
    done
    SKIP_TEMPLATE_ASSETS="${1:-false}"

    # copy template assets
    if [[ "${SKIP_TEMPLATE_ASSETS}" != true ]] && [[ "${TEMPLATES_DIR}" != "" ]] && [[ "${TEMPLATE}" != "" ]]; then
        TEMPLATE_PREFIX="TEMPLATE_"
        TEMPLATE_META=$(marsh_get_template_metadata "${TEMPLATE_PREFIX}" "${TEMPLATES_DIR}/${TEMPLATE}" "${#TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_OVERRIDES[@]}")
        if [[ $? -ne 0 ]]; then
            echo "Unable to load template metadata: ${TEMPLATES_DIR}/${TEMPLATE}" >&2
            return 1
        fi
        TEMPLATE_META_VARS=$(echo "${TEMPLATE_META}" | marsh_get_variables)
        eval "$(printf '%s\n' "${TEMPLATE_META_VARS}" | marsh_get_local_declarations)"
        eval "${TEMPLATE_META}"
        TEMPLATE_ASSETS_ALL=()
        TEMPLATE_ASSETS_ALL+=("${TEMPLATE_ASSETS_FONTS[@]}")
        TEMPLATE_ASSETS_ALL+=("${TEMPLATE_ASSETS_STYLES[@]}")
        TEMPLATE_ASSETS_ALL+=("${TEMPLATE_ASSETS_SCRIPTS[@]}")
        TEMPLATE_ASSETS_ALL+=("${TEMPLATE_ASSETS_IMAGES[@]}")
        TEMPLATE_ASSETS_ALL+=("${TEMPLATE_ASSETS_AUDIO[@]}")
        TEMPLATE_ASSETS_ALL+=("${TEMPLATE_ASSETS_VIDEO[@]}")
        TEMPLATE_ASSETS_ALL+=("${TEMPLATE_ASSETS_DOCUMENTS[@]}")
        TEMPLATE_ASSETS_ALL+=("${TEMPLATE_ASSETS_BINARIES[@]}")
        TEMPLATE_ASSETS_ALL+=("${TEMPLATE_ASSETS_OTHER[@]}")
        for ASSET in "${TEMPLATE_ASSETS_ALL[@]}"; do
            ASSET="${ASSET%\?*}"
            if [[ -d "${TEMPLATES_DIR}/${TEMPLATE}/${ASSET}" ]]; then
                mkdir -p "${DEST_DIR}/${TARGET_DIR}/${ASSET}"
            elif [[ -f "${TEMPLATES_DIR}/${TEMPLATE}/${ASSET}" ]]; then
                mkdir -p "${DEST_DIR}/${TARGET_DIR}/${ASSET%/*}"
            fi
            if [[ -e "${TEMPLATES_DIR}/${TEMPLATE}/${ASSET}" ]] && [[ -r "${TEMPLATES_DIR}/${TEMPLATE}/${ASSET}" ]]; then
                cp -R "${TEMPLATES_DIR}/${TEMPLATE}/${ASSET}" "${DEST_DIR}/${TARGET_DIR}/${ASSET}"
            fi
        done
    fi

    # build target documents
    DOCUMENTS=()
    DOCUMENTS_DIR="${DEST_DIR}/${TARGET_DIR}"
    DOCUMENTS_FIND_ARGS=()
    if [[ "${TARGET}" == '*' ]]; then
        DOCUMENTS_FIND_ARGS=(*)
    elif [[ -d "${DEST_DIR}/${TARGET}" ]]; then
        if [[ "${TARGET}" == "." ]]; then
            DOCUMENTS_DIR="${DEST_DIR}"
            DOCUMENTS_FIND_ARGS=(. -maxdepth 1)
        else
            DOCUMENTS_DIR="${DEST_DIR}/${TARGET}"
            DOCUMENTS_FIND_ARGS=(.)
        fi
    else
        DOCUMENTS_FIND_ARGS=("${TARGET##*/}")
    fi
    DOCUMENTS_LIST=$(cd "${DOCUMENTS_DIR}" && find "${DOCUMENTS_FIND_ARGS[@]}")
    DOCUMENTS=()
    while IFS= read -r DOCUMENT; do
        [[ "${DOCUMENT}" == "" ]] && continue
        DOCUMENTS+=("${DOCUMENT}")
    done <<< "${DOCUMENTS_LIST}"
    FILTERED_DOCUMENTS=()
    for DOCUMENT in "${DOCUMENTS[@]}"; do
        DOCUMENT="${DOCUMENT#./}"
        [[ "${DOCUMENT}" =~ \.(${MARKDOWN_FILEEXT_REGEX}|xml|json)$ ]] || continue
        FILTERED_DOCUMENTS+=("${DOCUMENT}")
    done
    DOCUMENTS=("${FILTERED_DOCUMENTS[@]}")
    PARALLEL=$(command -v parallel 2>/dev/null)
    PARALLEL_MARKDOWN=""
    [[ "${MARKDOWN_COMMAND}" != "markdown" ]] && PARALLEL_MARKDOWN="${MARKDOWN_COMMAND}"
    if [[ "${JOBS:-1}" -gt 1 ]] && [[ "${PARALLEL:-}" != "" ]] && [[ "$(${PARALLEL} --version --no-notice 2>/dev/null | head -n 1 | grep -o 'GNU parallel')" == "GNU parallel" ]]; then
        # in parallel
        export -f marsh_build_document
        if ! "${PARALLEL}" --halt now,fail=1 --quote --no-notice --env marsh_text_filter --env marsh_process_markdown --env marsh_build_document --jobs="${JOBS:-1}" "${SELF_DIR}/${SELF_NAME}" build-document --markdown="${PARALLEL_MARKDOWN}" --markdown-options="${MARKDOWN_OPTIONS_CSV}" --markdown-file-extensions="${MARKDOWN_FILEEXT_CSV}" --markdown-rewrite-links="${MARKDOWN_REWRITE_LINKS}" --marsh-uid="${MARSH_UID}" --marsh-temp="${MARSH_TEMP}" --marsh-config-file="${MARSH_CONFIG_FILE}" --marsh-config-file-dir="${MARSH_CONFIG_FILE_DIR}" --marsh-config-path="${MARSH_CONFIG_PATH}" --marsh-config-url="${MARSH_CONFIG_URL}" "${DEST_DIR}" "${TARGET_DIR}" {} ::: "${DOCUMENTS[@]}"; then
            echo "Unable to build one or more documents in target: ${TARGET}" >&2
            return 1
        fi
        if [[ "${TEMPLATES_DIR}" != "" ]] && [[ "${TEMPLATE}" != "" ]]; then
            export -f marsh_build_template
            if ! "${PARALLEL}" --halt now,fail=1 --quote --no-notice --env marsh_text_filter --env marsh_process_markdown --env marsh_build_template --jobs="${JOBS:-1}" "${SELF_DIR}/${SELF_NAME}" build-template --markdown="${PARALLEL_MARKDOWN}" --markdown-options="${MARKDOWN_OPTIONS_CSV}" --markdown-file-extensions="${MARKDOWN_FILEEXT_CSV}" --markdown-rewrite-links="${MARKDOWN_REWRITE_LINKS}" --marsh-uid="${MARSH_UID}" --marsh-temp="${MARSH_TEMP}" --marsh-config-file="${MARSH_CONFIG_FILE}" --marsh-config-file-dir="${MARSH_CONFIG_FILE_DIR}" --marsh-config-path="${MARSH_CONFIG_PATH}" --marsh-config-url="${MARSH_CONFIG_URL}" "${DEST_DIR}" "${TARGET_DIR}" {} "${ADVANCED_NAV}" "${TEMPLATES_DIR}" "${TEMPLATE}" "${#TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_OVERRIDES[@]}" ::: "${DOCUMENTS[@]}"; then
                echo "Unable to build template: ${TEMPLATE}" >&2
                return 1
            fi
        fi
    else
        # serially
        for DOCUMENT in "${DOCUMENTS[@]}"; do
            if ! marsh_build_document "${DEST_DIR}" "${TARGET_DIR}" "${DOCUMENT}" "${MARKDOWN_COMMAND}" "${MARKDOWN_OPTIONS_CSV}" "${MARKDOWN_FILEEXT_CSV}" "${MARKDOWN_REWRITE_LINKS}"; then
                echo "Unable to build document: ${DOCUMENT}" >&2
                return 1
            fi
            if [[ "${TEMPLATES_DIR}" != "" ]] && [[ "${TEMPLATE}" != "" ]]; then
                if ! marsh_build_template "${DEST_DIR}" "${TARGET_DIR}" "${DOCUMENT}" "${ADVANCED_NAV}" "${TEMPLATES_DIR}" "${TEMPLATE}" "${MARKDOWN_COMMAND}" "${MARKDOWN_OPTIONS_CSV}" "${MARKDOWN_FILEEXT_CSV}" "${MARKDOWN_REWRITE_LINKS}" "${#TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_OVERRIDES[@]}"; then
                    echo "Unable to build template: ${TEMPLATE}" >&2
                    return 1
                fi
            fi
        done
    fi
}

# removes temporary files used during target builds
function marsh_clean_target {  # marsh_clean_target target markdown_fileext_csv
    local TARGET MARKDOWN_FILEEXT_CSV CLEAN_FILTERS EXT
    TARGET="${1:-}"; [[ "${TARGET}" == "" ]] && return 1
    MARKDOWN_FILEEXT_CSV="${2:-}"
    [[ "${MARKDOWN_FILEEXT_CSV}" == "" ]] && return 1
    CLEAN_FILTERS=()
    for EXT in ${MARKDOWN_FILEEXT_CSV//,/ }; do
        if [[ "${#CLEAN_FILTERS[@]}" -gt 0 ]]; then
            CLEAN_FILTERS+=("-or")
        fi
        CLEAN_FILTERS+=("-iname" "*.${EXT}")
    done
    find "${TARGET}" \( -name '*.'"${MARSH_UID}"'.*' -or \( "${CLEAN_FILTERS[@]}" \) \) -delete
}

# main function, entry point for command line interface
function marsh_cli {
    set -o pipefail

    local COMMANDS COMMAND OPTSPEC OPTARRAY
    local DEPS MARKDOWN_UNKNOWN UNKNOWN TEMP_DIR TEMPLATES_DIR FORCE JOBS
    local MARKDOWN_COMMAND MARKDOWN_OPTIONS MARKDOWN_FILEEXT MARKDOWN_REWRITE_LINKS
    local MARKDOWN_OPTIONS_CSV MARKDOWN_OPTIONS_CLIARGS MARKDOWN_FILEEXT_CSV
    local INDEX PREFIX META META_VARS CONFIG_VARS OIFS I
    local TARGET_ARCHIVE_TYPES TARGET_ARCHIVE_EXCLUDED_STATES TARGET_ARCHIVE_MANIFEST
    local BUILD_DEST_DIR BUILD_TARGET_DIR BUILD_DOCUMENT BUILD_ADVANCED_NAV
    local BUILD_TEMPLATES_DIR BUILD_TEMPLATE BUILD_NUM_TEMPLATE_OVERRIDES BUILD_TEMPLATE_OVERRIDES

    # args with help
    MARKDOWN_OPTIONS=(-1.0 +alphalist -autolink -cdata +definitionlist -divquote -dldiscount +dlextra +ext +fencedcode +footnote +githubtags -header +html +image -latex +links -safelink +smarty +strikethrough +style +superscript +tables -tabstop -toc)
    MARKDOWN_FILEEXT=('markdown' 'md' 'mkd' 'mkdn' 'mdown' 'mdtxt' 'mdtext' 'text')
    MARKDOWN_REWRITE_LINKS=true

    # env vars
    marsh_env_cli

    # commands
    COMMANDS=('build' 'build-document' 'build-template')
    COMMAND="${1:-}"

    # validate command
    if [[ ! "${COMMAND}" =~ ^- ]]; then
        if [[ "${COMMAND}" == "" ]]; then
            # command not specified
            echo "Command not specified" >&2
            echo -e "${HELP}"
            return 1
        elif ! marsh_in_array "${COMMAND}" "${COMMANDS[@]}"; then
            # invalid command
            echo "Invalid command: ${COMMAND}" >&2
            echo -e "${HELP}"
            return 1
        fi
        shift 1
    else
        # continue processing arguments
        COMMAND=""
    fi

    # args
    FORCE=false
    JOBS=1
    if [[ "${SYS_NAME}" == "darwin" ]]; then
        JOBS=$(sysctl -n hw.ncpu)
    elif [[ "${SYS_NAME}" == "linux" ]]; then
        JOBS=$(nproc)
    fi
    MARKDOWN_COMMAND=""
    OPTIND=1
    OPTSPEC=":-:hvj:"
    OPTARRAY=('-h' '--help' '-v' '--version' '--force' '-j' '--jobs' '--markdown' '--markdown-options' '--markdown-file-extensions' '--markdown-rewrite-links')  # all short and long options
    OPTARRAY+=('marsh-uid' 'marsh-temp' 'marsh-config-file' 'marsh-config-file-dir' 'marsh-config-path' 'marsh-config-url')  # all private options
    while getopts "${OPTSPEC}" OPT; do
        case "${OPT}" in
            -)
                case "${OPTARG}" in
                    help)
                        # Print help and exit
                        echo -e "${HELP}"
                        return 0
                        ;;
                    help=*)
                        # Print help and exit
                        echo -e "${HELP}"
                        return 0
                        ;;
                    version)
                        # Print version and exit
                        echo -e "${NAME} ${VERSION}"
                        return 0
                        ;;
                    version=*)
                        # Print version and exit
                        echo -e "${NAME} ${VERSION}"
                        return 0
                        ;;
                    jobs)
                        if [[ -z ${!OPTIND+isset} ]] || marsh_in_array "${!OPTIND}" "${OPTARRAY[@]}"; then
                            # Option without required argument
                            echo "Option --${OPTARG} requires a value" >&2
                            echo -e "${HELP}"
                            return 1
                        fi
                        JOBS="${!OPTIND}"
                        if [[ ! "${JOBS}" =~ ^[1-9][0-9]*$ ]]; then
                            echo "Option --${OPTARG} requires a numeric value greater than zero" >&2
                            echo -e "${HELP}"
                            return 1
                        fi
                        OPTIND=$((OPTIND + 1))
                        ;;
                    jobs=*)
                        JOBS="${OPTARG#*=}"
                        if [[ ! "${JOBS}" =~ ^[1-9][0-9]*$ ]]; then
                            echo "Option --${OPTARG} requires a numeric value greater than zero" >&2
                            echo -e "${HELP}"
                            return 1
                        fi
                        ;;
                    markdown)
                        if [[ -z ${!OPTIND+isset} ]] || marsh_in_array "${!OPTIND}" "${OPTARRAY[@]}"; then
                            # Option without required argument
                            echo "Option --${OPTARG} requires a value" >&2
                            echo -e "${HELP}"
                            return 1
                        fi
                        MARKDOWN_COMMAND="${!OPTIND}"
                        OPTIND=$((OPTIND + 1))
                        ;;
                    markdown=*)
                        MARKDOWN_COMMAND="${OPTARG#*=}"
                        ;;
                    markdown-options)
                        if [[ -z ${!OPTIND+isset} ]] || marsh_in_array "${!OPTIND}" "${OPTARRAY[@]}"; then
                            # Option without required argument
                            echo "Option --${OPTARG} requires a value" >&2
                            echo -e "${HELP}"
                            return 1
                        fi
                        MARKDOWN_OPTIONS="${!OPTIND}"
                        OIFS="${IFS}"
                        IFS=$'\n'
                        MARKDOWN_OPTIONS=(${MARKDOWN_OPTIONS//,/$IFS})
                        IFS="${OIFS}"
                        OPTIND=$((OPTIND + 1))
                        ;;
                    markdown-options=*)
                        MARKDOWN_OPTIONS="${OPTARG#*=}"
                        OIFS="${IFS}"
                        IFS=$'\n'
                        MARKDOWN_OPTIONS=(${MARKDOWN_OPTIONS//,/$IFS})
                        IFS="${OIFS}"
                        ;;
                    markdown-file-extensions)
                        if [[ -z ${!OPTIND+isset} ]] || marsh_in_array "${!OPTIND}" "${OPTARRAY[@]}"; then
                            # Option without required argument
                            echo "Option --${OPTARG} requires a value" >&2
                            echo -e "${HELP}"
                            return 1
                        fi
                        MARKDOWN_FILEEXT=(${!OPTIND//,/ })
                        OPTIND=$((OPTIND + 1))
                        ;;
                    markdown-file-extensions=*)
                        MARKDOWN_FILEEXT="${OPTARG#*=}"
                        MARKDOWN_FILEEXT=(${MARKDOWN_FILEEXT//,/ })
                        ;;
                    markdown-rewrite-links)
                        if [[ -z ${!OPTIND+isset} ]] || marsh_in_array "${!OPTIND}" "${OPTARRAY[@]}"; then
                            # Option without required argument
                            echo "Option --${OPTARG} requires a value" >&2
                            echo -e "${HELP}"
                            return 1
                        fi
                        MARKDOWN_REWRITE_LINKS=$(echo "${!OPTIND}" | awk '{ print tolower($0) }')
                        if [[ "${MARKDOWN_REWRITE_LINKS}" != true ]] && [[ "${MARKDOWN_REWRITE_LINKS}" != false ]]; then
                            echo "Option --${OPTARG} requires boolean string value true or false" >&2
                            echo -e "${HELP}"
                            return 1
                        fi
                        OPTIND=$((OPTIND + 1))
                        ;;
                    markdown-rewrite-links=*)
                        MARKDOWN_REWRITE_LINKS=$(echo "${OPTARG#*=}" | awk '{ print tolower($0) }')
                        if [[ "${MARKDOWN_REWRITE_LINKS}" != true ]] && [[ "${MARKDOWN_REWRITE_LINKS}" != false ]]; then
                            echo "Option --${OPTARG%%=*} requires boolean string value true or false" >&2
                            echo -e "${HELP}"
                            return 1
                        fi
                        ;;
                    force)
                        FORCE=true
                        ;;
                    force=*)
                        # Option with prohibited value
                        echo "Option --${OPTARG%%=*} takes no value" >&2
                        echo -e "${HELP}"
                        return 1
                        ;;
                    marsh-uid)
                        if [[ -z ${!OPTIND+isset} ]] || marsh_in_array "${!OPTIND}" "${OPTARRAY[@]}"; then
                            # Option without required argument
                            echo "Option --${OPTARG} requires a value" >&2
                            echo -e "${HELP}"
                            return 1
                        fi
                        MARSH_UID="${!OPTIND}"
                        OPTIND=$((OPTIND + 1))
                        ;;
                    marsh-uid=*)
                        MARSH_UID="${OPTARG#*=}"
                        ;;
                    marsh-temp)
                        if [[ -z ${!OPTIND+isset} ]] || marsh_in_array "${!OPTIND}" "${OPTARRAY[@]}"; then
                            # Option without required argument
                            echo "Option --${OPTARG} requires a value" >&2
                            echo -e "${HELP}"
                            return 1
                        fi
                        MARSH_TEMP="${!OPTIND}"
                        OPTIND=$((OPTIND + 1))
                        ;;
                    marsh-temp=*)
                        MARSH_TEMP="${OPTARG#*=}"
                        ;;
                    marsh-config-file)
                        if [[ -z ${!OPTIND+isset} ]] || marsh_in_array "${!OPTIND}" "${OPTARRAY[@]}"; then
                            # Option without required argument
                            echo "Option --${OPTARG} requires a value" >&2
                            echo -e "${HELP}"
                            return 1
                        fi
                        MARSH_CONFIG_FILE="${!OPTIND}"
                        OPTIND=$((OPTIND + 1))
                        ;;
                    marsh-config-file=*)
                        MARSH_CONFIG_FILE="${OPTARG#*=}"
                        ;;
                    marsh-config-file-dir)
                        if [[ -z ${!OPTIND+isset} ]] || marsh_in_array "${!OPTIND}" "${OPTARRAY[@]}"; then
                            # Option without required argument
                            echo "Option --${OPTARG} requires a value" >&2
                            echo -e "${HELP}"
                            return 1
                        fi
                        MARSH_CONFIG_FILE_DIR="${!OPTIND}"
                        OPTIND=$((OPTIND + 1))
                        ;;
                    marsh-config-file-dir=*)
                        MARSH_CONFIG_FILE_DIR="${OPTARG#*=}"
                        ;;
                    marsh-config-path)
                        if [[ -z ${!OPTIND+isset} ]] || marsh_in_array "${!OPTIND}" "${OPTARRAY[@]}"; then
                            # Option without required argument
                            echo "Option --${OPTARG} requires a value" >&2
                            echo -e "${HELP}"
                            return 1
                        fi
                        MARSH_CONFIG_PATH="${!OPTIND}"
                        OPTIND=$((OPTIND + 1))
                        ;;
                    marsh-config-path=*)
                        MARSH_CONFIG_PATH="${OPTARG#*=}"
                        ;;
                    marsh-config-url)
                        if [[ -z ${!OPTIND+isset} ]] || marsh_in_array "${!OPTIND}" "${OPTARRAY[@]}"; then
                            # Option without required argument
                            echo "Option --${OPTARG} requires a value" >&2
                            echo -e "${HELP}"
                            return 1
                        fi
                        MARSH_CONFIG_URL="${!OPTIND}"
                        OPTIND=$((OPTIND + 1))
                        ;;
                    marsh-config-url=*)
                        MARSH_CONFIG_URL="${OPTARG#*=}"
                        ;;
                    *)
                        if [[ "${OPTERR}" == 1 ]]; then
                            # Invalid option specified
                            echo "Invalid option: --${OPTARG}" >&2
                            echo -e "${HELP}"
                            return 1
                        fi
                        ;;
                esac
                ;;
            h)
                # Print help and exit
                echo -e "${HELP}"
                return 0
                ;;
            v)
                # Print version and exit
                echo "${NAME} ${VERSION}"
                return 0
                ;;
            j)
                # Number of jobs
                JOBS="${OPTARG}"
                if [[ ! "${JOBS}" =~ ^[1-9][0-9]*$ ]]; then
                    echo "Option -${OPT} requires a numeric value greater than zero" >&2
                    echo -e "${HELP}"
                    return 1
                fi
                ;;
            :)
                # Option without required value
                echo "Option -${OPTARG} requires a value" >&2
                echo -e "${HELP}"
                return 1
                ;;
            \?)
                # Invalid option specified
                echo "Invalid option: -${OPTARG}" >&2
                echo -e "${HELP}"
                return 1
                ;;
        esac
    done
    shift $((OPTIND - 1))

    # revalidate command
    if [[ "${COMMAND}" == "" ]]; then
        # command not specified
        echo "Command not specified" >&2
        echo -e "${HELP}"
        return 1
    elif ! marsh_in_array "${COMMAND}" "${COMMANDS[@]}"; then
        # invalid command
        echo "Invalid command: ${COMMAND}" >&2
        echo -e "${HELP}"
        return 1
    fi

    # build document/template dispatch vars
    BUILD_DEST_DIR="${1:-}"
    BUILD_TARGET_DIR="${2:-}"
    BUILD_DOCUMENT="${3:-}"
    BUILD_ADVANCED_NAV="${4:-}"
    BUILD_TEMPLATES_DIR="${5:-}"
    BUILD_TEMPLATE="${6:-}"
    BUILD_NUM_TEMPLATE_OVERRIDES="${7:-0}"
    BUILD_TEMPLATE_OVERRIDES=("${@:8}")

    # parse config
    if [[ "${MARSH_CONFIG_FILE:-}" == "" ]]; then
        MARSH_CONFIG_FILE="${1:-$(pwd -P)}"
        if [[ -d "${MARSH_CONFIG_FILE}" ]]; then
            MARSH_CONFIG_FILE=$(cd "${MARSH_CONFIG_FILE}" && (pwd -P . 2>/dev/null || command pwd))
            [[ "${MARSH_CONFIG_FILE}" != "" ]] && MARSH_CONFIG_FILE="${MARSH_CONFIG_FILE%/}/marsh-config.yaml"
        fi
        if [[ -f "${MARSH_CONFIG_FILE}" ]] && [[ -r "${MARSH_CONFIG_FILE}" ]]; then
            MARSH_CONFIG=$(marsh_parse_yaml "${MARSH_CONFIG_FILE}" "CONFIG_")
            [[ $? -ne 0 ]] && echo "Unable to parse yaml file: ${MARSH_CONFIG_FILE}" >&2 && return 1
            CONFIG_VARS=$(printf '%s\n' "${MARSH_CONFIG}" | marsh_get_variables)
            eval "$(printf '%s\n' "${CONFIG_VARS}" | marsh_get_local_declarations)"
            eval "${MARSH_CONFIG}"
        else
            echo "Configuration file not found: ${MARSH_CONFIG_FILE#$SELF_DIR/}" >&2
            return 1
        fi
        if [[ "${CONFIG_Build_Path:-}" != "" ]]; then
            MARSH_CONFIG_PATH="${CONFIG_Build_Path}"
            [[ "${MARSH_CONFIG_FILE}" =~ / ]] && MARSH_CONFIG_FILE_DIR="${MARSH_CONFIG_FILE%/*}"
            MARSH_CONFIG_FILE_DIR="${MARSH_CONFIG_FILE_DIR:-.}"
            [[ ! "${MARSH_CONFIG_PATH}" =~ ^/ ]] && MARSH_CONFIG_PATH="${MARSH_CONFIG_FILE_DIR}/${MARSH_CONFIG_PATH}"
            MARSH_CONFIG_PATH="${MARSH_CONFIG_PATH#./}"
        else
            echo "Build directory empty or not found in config: ${MARSH_CONFIG_FILE}" >&2
            return 1
        fi
        MARSH_CONFIG_URL="${CONFIG_Build_URL:-}"
        #export MARSH_CONFIG_FILE MARSH_CONFIG_FILE_DIR MARSH_CONFIG_PATH MARSH_CONFIG_URL
    fi

    # dependencies
    if [[ "${MARKDOWN_COMMAND}" != "" ]] && [[ "${MARKDOWN_COMMAND#\/}" == "${MARKDOWN_COMMAND}" ]]; then
        MARKDOWN_COMMAND="$(pwd -P)/${MARKDOWN_COMMAND}"
    fi
    MARKDOWN_COMMAND="${MARKDOWN_COMMAND:-markdown}"
    DEPS=("${MARKDOWN_COMMAND}" "md5|md5sum")
    marsh_check_dependencies "${DEPS[@]}" || return 1

    # markdown file extensions
    for I in "${!MARKDOWN_FILEEXT[@]}"; do
        MARKDOWN_FILEEXT[$I]=$(printf '%s' "${MARKDOWN_FILEEXT[$I]}" | awk '{ print tolower($0) }')
    done
    MARKDOWN_FILEEXT_CSV=$(echo ${MARKDOWN_FILEEXT[@]} | sed 's/ /,/g')

    # discount markdown options
    MARKDOWN_OPTIONS_CSV=$(echo ${MARKDOWN_OPTIONS[@]} | sed 's/ /,/g')
    MARKDOWN_OPTIONS_CLIARGS=()
    for I in "${!MARKDOWN_OPTIONS[@]}"; do
        MARKDOWN_OPTIONS_CLIARGS+=("-f${MARKDOWN_OPTIONS[$I]}")
    done
    OIFS="${IFS}"
    IFS=$'\n'
    MARKDOWN_UNKNOWN=($("${MARKDOWN_COMMAND}" ${MARKDOWN_OPTIONS_CLIARGS[@]} -VV 2>&1 >/dev/null | grep -i "unknown" | sed -E -e 's/^markdown: unknown option <([^>]+)>$/\1/'))
    IFS="${OIFS}"
    if [[ "${#MARKDOWN_UNKNOWN[@]}" -gt 0 ]]; then
        echo -n "Unknown markdown options:" >&2
        for UNKNOWN in "${MARKDOWN_UNKNOWN[@]}"; do
            echo -n " '${UNKNOWN}'" >&2
        done
        echo ""
        return 1
    fi
    export -f marsh_process_markdown

    # create target directory
    mkdir -p "${MARSH_CONFIG_PATH}"

    # keep temporary directory creation close to trap to catch quick SIGINT
    # temporary directory
    if [[ "${MARSH_UID:-}" == "" ]]; then
        TEMP_DIR="${TMPDIR:-/tmp}"
        TEMP_DIR="${TEMP_DIR%/}"
        MARSH_TEMP=$(mktemp -d "${TEMP_DIR}/marsh-XXXXXX" 2>/dev/null)
        if [[ ! -d "${MARSH_TEMP}" ]]; then
            echo "Unable to create temporary directory: ${TEMP_DIR}/marsh-XXXXXX" >&2
            return 1
        fi
        MARSH_UID="marsh-${MARSH_TEMP##*marsh-}"
        #export MARSH_TEMP MARSH_UID
    fi
    TEMPLATES_DIR="${MARSH_TEMP}/templates"
    mkdir -p "${TEMPLATES_DIR}"

    # kills child processes and removes temporary files
    function die_gracefully {  # die_gracefully
        trap - EXIT INT
        trap ":" INT  # prevent recursion due to spamming ctrl-c
        echo "Killing all processes and cleaning up (ETA ~3 seconds)..." >&2
        #trap - INT && kill -2 -- -$$  # should not be needed with `parallel --halt now,fail=1 ...`
        sleep 2
        rm -rf "${MARSH_TEMP}" || echo "Temporary files may still remain at: ${MARSH_TEMP}" >&2
        sleep 1
        trap - TERM && kill -- -$$
    }

    # work
    if [[ "${COMMAND}" == "build" ]]; then
        # die gracefully
        trap "die_gracefully" EXIT INT TERM

        # build everything
        echo -n "${NAME} ${VERSION}"
        [[ "${JOBS:-1}" -gt 1 ]] && echo -n " (${JOBS} jobs)"
        echo ""
        echo "${CONFIG_Build_Name:-No Name} (${MARSH_CONFIG_FILE#$SELF_DIR/})"
        echo "${CONFIG_Build_Path%/} -> ${CONFIG_Build_URL%/}"

        # build
        INDEX=0
        PREFIX="CONFIG_Build_Targets_${INDEX}_"
        while META=$(marsh_get_target_metadata "${PREFIX}" "TARGET_"); do
            META_VARS=$(echo "${META}" | marsh_get_variables)
            eval "$(printf '%s\n' "${META_VARS}" | marsh_get_local_declarations)"
            eval "${META}"

            # get template
            if [[ "${TARGET_TEMPLATE_SOURCE:-}" != "" ]]; then
                if [[ ! -e "${TEMPLATES_DIR}/${TARGET_TEMPLATE}" ]]; then
                    if [[ ! "${TARGET_TEMPLATE_SOURCE}" =~ ^/ ]]; then
                        TARGET_TEMPLATE_SOURCE="${MARSH_CONFIG_FILE_DIR}/${TARGET_TEMPLATE_SOURCE}"
                        TARGET_TEMPLATE_SOURCE="${TARGET_TEMPLATE_SOURCE#./}"
                    fi
                    for I in "${!TARGET_TEMPLATE_OVERRIDES[@]}"; do
                        if [[ "${TARGET_TEMPLATE_OVERRIDES[$I]:-}" != "" ]] && [[ ! "${TARGET_TEMPLATE_OVERRIDES[$I]}" =~ ^/ ]]; then
                            TARGET_TEMPLATE_OVERRIDES[$I]="${MARSH_CONFIG_FILE_DIR}/${TARGET_TEMPLATE_OVERRIDES[$I]}"
                            TARGET_TEMPLATE_OVERRIDES[$I]="${TARGET_TEMPLATE_OVERRIDES[$I]#./}"
                        fi
                    done
                    marsh_get_files "${TARGET_TEMPLATE_SOURCE}/*" \
                            "${TEMPLATES_DIR}/${TARGET_TEMPLATE}" \
                            false || die_gracefully
                fi
            fi

            # get source files for target
            if [[ "${TARGET_FORCE}" == true ]] || [[ "${FORCE}" == true ]]; then
                TARGET_FORCE=true
            fi
            if [[ ! "${TARGET_SOURCE}" =~ ^/ ]]; then
                TARGET_SOURCE="${MARSH_CONFIG_FILE_DIR}/${TARGET_SOURCE}"
                TARGET_SOURCE="${TARGET_SOURCE#./}"
            fi
            if [[ "${TARGET_SOURCE}" != "" ]]; then
                marsh_get_files "${TARGET_SOURCE}" \
                        "${MARSH_CONFIG_PATH}/${TARGET_PATH}" \
                        "${TARGET_FORCE}" || die_gracefully
            fi

            # build advanced navigation
            if [[ "${TARGET_NAV}" != "" ]]; then
                marsh_build_advanced_nav "${MARSH_CONFIG_PATH}/${TARGET_PATH}" \
                                "${TARGET_NAV}" \
                                "${MARKDOWN_COMMAND}" \
                                "${MARKDOWN_OPTIONS_CSV}" \
                                "${MARKDOWN_FILEEXT_CSV}" \
                                "${MARKDOWN_REWRITE_LINKS}" || die_gracefully
            fi

            # build target
            marsh_build_target "${MARSH_CONFIG_PATH}" \
                        "${TARGET_PATH}" \
                        "${JOBS}" \
                        "${TARGET_NAV}" \
                        "${TEMPLATES_DIR}" \
                        "${TARGET_TEMPLATE:-}" \
                        "${MARKDOWN_COMMAND}" \
                        "${MARKDOWN_OPTIONS_CSV}" \
                        "${MARKDOWN_FILEEXT_CSV}" \
                        "${MARKDOWN_REWRITE_LINKS}" \
                        "${#TARGET_TEMPLATE_OVERRIDES[@]}" \
                        "${TARGET_TEMPLATE_OVERRIDES[@]}" || die_gracefully

            # archives
            TARGET_ARCHIVE_MANIFEST=""
            if [[ "${#TARGET_ARCHIVES[@]}" -gt 0 ]]; then
                TARGET_ARCHIVE_MANIFEST=$(marsh_get_archive_manifest "${MARSH_CONFIG_PATH}/${TARGET_PATH}") || die_gracefully
            fi
            for I in "${!TARGET_ARCHIVES[@]}"; do
                if [[ "${TARGET_ARCHIVES[$I]}" != "" ]]; then
                    OIFS="${IFS}"
                    IFS=$(echo @|tr @ '\034')
                    TARGET_ARCHIVE_TYPES=(${TARGET_ARCHIVES_TYPES[$I]:-})
                    TARGET_ARCHIVE_EXCLUDED_STATES=(${TARGET_ARCHIVES_EXCLUDED_STATES[$I]:-})
                    IFS="${OIFS}"
                    if ! marsh_build_archive "${TARGET_ARCHIVES_ENCODING[$I]}" \
                        "${MARSH_CONFIG_PATH}/${TARGET_PATH}" \
                        "${TARGET_ARCHIVES[$I]}" \
                        "${TARGET_ARCHIVES_NAME[$I]:-$TARGET_NAME}" \
                        "${TARGET_ARCHIVES_LANGUAGE[$I]:-}" \
                        "${TARGET_ARCHIVES_LANGUAGE_CODE[$I]:-}" \
                        "${TARGET_ARCHIVES_COUNT[$I]}" \
                        "${TARGET_ARCHIVES_PAGE_SIZE[$I]}" \
                        "${#TARGET_ARCHIVE_TYPES[@]}" \
                        "${TARGET_ARCHIVE_TYPES[@]}" \
                        "${#TARGET_ARCHIVE_EXCLUDED_STATES[@]}" \
                        "${TARGET_ARCHIVE_EXCLUDED_STATES[@]}" \
                        "${TARGET_ARCHIVE_MANIFEST}" | while IFS= read -r GENERATED_ARCHIVE; do
                            [[ "${GENERATED_ARCHIVE}" == "" ]] && continue
                            marsh_build_target "${MARSH_CONFIG_PATH}" \
                                "${TARGET_PATH}/${GENERATED_ARCHIVE}" \
                                "${JOBS}" \
                                "" \
                                "${TEMPLATES_DIR}" \
                                "${TARGET_TEMPLATE:-}" \
                                "${MARKDOWN_COMMAND}" \
                                "${MARKDOWN_OPTIONS_CSV}" \
                                "${MARKDOWN_FILEEXT_CSV}" \
                                "${MARKDOWN_REWRITE_LINKS}" \
                                "${#TARGET_TEMPLATE_OVERRIDES[@]}" \
                                "${TARGET_TEMPLATE_OVERRIDES[@]}" \
                                true || exit 1
                        done
                    then
                        die_gracefully
                    fi
                fi
            done

            # clean build files
            marsh_clean_target "${MARSH_CONFIG_PATH}/${TARGET_PATH}" "${MARKDOWN_FILEEXT_CSV}"
            INDEX=$((INDEX+1))
            PREFIX="CONFIG_Build_Targets_${INDEX}_"
        done

        # clean up
        rm -rf "${MARSH_TEMP}"
        trap - EXIT INT TERM
    elif [[ "${COMMAND}" == "build-document" ]]; then
        # build single document
        marsh_build_document "${BUILD_DEST_DIR}" "${BUILD_TARGET_DIR}" "${BUILD_DOCUMENT}" "${MARKDOWN_COMMAND}" "${MARKDOWN_OPTIONS_CSV}" "${MARKDOWN_FILEEXT_CSV}" "${MARKDOWN_REWRITE_LINKS}"
    elif [[ "${COMMAND}" == "build-template" ]]; then
        # build template for document
        marsh_build_template "${BUILD_DEST_DIR}" "${BUILD_TARGET_DIR}" "${BUILD_DOCUMENT}" "${BUILD_ADVANCED_NAV}" "${BUILD_TEMPLATES_DIR}" "${BUILD_TEMPLATE}" "${MARKDOWN_COMMAND}" "${MARKDOWN_OPTIONS_CSV}" "${MARKDOWN_FILEEXT_CSV}" "${MARKDOWN_REWRITE_LINKS}" "${BUILD_NUM_TEMPLATE_OVERRIDES}" "${BUILD_TEMPLATE_OVERRIDES[@]}"
    fi

    # done
    set +o pipefail
    return 0
}

# run only when executed, not when sourced
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    marsh_cli "$@"
fi
