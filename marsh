# returns a site-relative output path as either an absolute public URL or a normalized relative path
function marsh_get_absolute_output_path {  # marsh_get_absolute_output_path output_path [path_kind] [remove_link_filenames_csv]
    local OUTPUT_PATH PATH_KIND REMOVE_LINK_FILENAMES_CSV NORMALIZED_PATH RELATIVE_PATH ABSOLUTE_PATH

    OUTPUT_PATH="${1:-}"
    PATH_KIND="${2:-path}"
    REMOVE_LINK_FILENAMES_CSV="${3:-}"
    [[ "${OUTPUT_PATH}" == "" ]] && return 1
    [[ "${PATH_KIND}" == "path" || "${PATH_KIND}" == "directory" || "${PATH_KIND}" == "document" ]] || return 1

    NORMALIZED_PATH=$(marsh_normalize_path "${OUTPUT_PATH}" "${PATH_KIND}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
    if [[ "${MARSH_CONFIG_URL:-}" == "" ]]; then
        printf '%s\n' "${NORMALIZED_PATH}"
        return 0
    fi

    RELATIVE_PATH="${NORMALIZED_PATH}"
    [[ "${RELATIVE_PATH}" == "./" ]] && RELATIVE_PATH=""
    RELATIVE_PATH="${RELATIVE_PATH#./}"

    ABSOLUTE_PATH="${MARSH_CONFIG_URL%/}"
    if [[ "${RELATIVE_PATH}" != "" ]]; then
        ABSOLUTE_PATH="${ABSOLUTE_PATH}/${RELATIVE_PATH}"
    elif [[ "${PATH_KIND}" == "document" ]]; then
        ABSOLUTE_PATH="${ABSOLUTE_PATH}/"
    fi

    marsh_normalize_path "${ABSOLUTE_PATH}" "${PATH_KIND}" "${REMOVE_LINK_FILENAMES_CSV}"
}

# returns the common directory for a list of paths
function marsh_get_common_directory {  # marsh_get_common_directory paths...
    local COMMON_DIR NEXT_DIR
    local -a PATHS

    PATHS=("${@}")
    [[ "${#PATHS[@]}" -gt 0 ]] || return 1
    COMMON_DIR="${PATHS[0]%/}"
    [[ "${COMMON_DIR}" == "" ]] && COMMON_DIR='/'
    for NEXT_DIR in "${PATHS[@]}"; do
        NEXT_DIR="${NEXT_DIR%/}"
        [[ "${NEXT_DIR}" == "" ]] && NEXT_DIR='/'
        while [[ "${NEXT_DIR}" != "${COMMON_DIR}" ]] && [[ "${NEXT_DIR#${COMMON_DIR}/}" == "${NEXT_DIR}" ]]; do
            if [[ "${COMMON_DIR}" == '/' ]]; then
                break
            fi
            COMMON_DIR="${COMMON_DIR%/*}"
            COMMON_DIR="${COMMON_DIR:-/}"
        done
    done
    printf '%s\n' "${COMMON_DIR}"
}

# returns the normalized parent directory for an internal relative path
function marsh_get_internal_parent_directory {  # marsh_get_internal_parent_directory path
    local PATH_VALUE PARENT_DIR

    PATH_VALUE="${1:-}"
    [[ "${PATH_VALUE}" == "" ]] && return 1

    PATH_VALUE=$(marsh_normalize_internal_path "${PATH_VALUE}") || return 1
    if [[ "${PATH_VALUE}" == "." ]]; then
        printf '%s\n' '.'
        return 0
    fi
    if [[ "${PATH_VALUE}" == */* ]]; then
        PARENT_DIR="${PATH_VALUE%/*}"
    else
        PARENT_DIR='.'
    fi
    printf '%s\n' "${PARENT_DIR}"
}

# calculates a relative link from one rendered page directory to a target document path
function marsh_get_relative_path {  # marsh_get_relative_path base_dir target_path [remove_link_filenames_csv]
    local BASE_DIR TARGET_PATH REMOVE_LINK_FILENAMES_CSV BASE_DIR_NORM TARGET_PATH_NORM
    local BASE_PATH TARGET_PATH_VALUE TARGET_IS_DIR
    local RESULT I J COMMON_PREFIX
    local -a BASE_PARTS TARGET_PARTS

    BASE_DIR="${1:-}"
    TARGET_PATH="${2:-}"
    REMOVE_LINK_FILENAMES_CSV="${3:-}"
    [[ "${BASE_DIR}" == "" ]] && return 1
    [[ "${TARGET_PATH}" == "" ]] && return 1

    BASE_DIR_NORM=$(marsh_normalize_path "${BASE_DIR}" "directory") || return 1
    TARGET_PATH_NORM=$(marsh_normalize_path "${TARGET_PATH}" "document" "${REMOVE_LINK_FILENAMES_CSV}") || return 1

    BASE_PATH="${BASE_DIR_NORM#./}"
    BASE_PATH="${BASE_PATH%/}"
    TARGET_PATH_VALUE="${TARGET_PATH_NORM#./}"
    TARGET_IS_DIR=false
    [[ "${TARGET_PATH_NORM}" == */ ]] && TARGET_IS_DIR=true
    TARGET_PATH_VALUE="${TARGET_PATH_VALUE%/}"

    BASE_PARTS=()
    TARGET_PARTS=()
    if [[ "${BASE_PATH}" != "" ]]; then
        IFS='/' read -r -a BASE_PARTS <<< "${BASE_PATH}"
    fi
    if [[ "${TARGET_PATH_VALUE}" != "" ]]; then
        IFS='/' read -r -a TARGET_PARTS <<< "${TARGET_PATH_VALUE}"
    fi

    COMMON_PREFIX=0
    while [[ "${COMMON_PREFIX}" -lt "${#BASE_PARTS[@]}" ]] && [[ "${COMMON_PREFIX}" -lt "${#TARGET_PARTS[@]}" ]] && [[ "${BASE_PARTS[$COMMON_PREFIX]}" == "${TARGET_PARTS[$COMMON_PREFIX]}" ]]; do
        COMMON_PREFIX=$((COMMON_PREFIX + 1))
    done

    RESULT=""
    for ((I=COMMON_PREFIX; I < "${#BASE_PARTS[@]}"; I++)); do
        RESULT="${RESULT}../"
    done
    for ((J=COMMON_PREFIX; J < "${#TARGET_PARTS[@]}"; J++)); do
        RESULT="${RESULT}${TARGET_PARTS[$J]}"
        if [[ "${J}" -lt $(( ${#TARGET_PARTS[@]} - 1 )) ]]; then
            RESULT="${RESULT}/"
        fi
    done

    if [[ "${RESULT}" == "" ]]; then
        RESULT="./"
    elif [[ "${TARGET_IS_DIR}" == true ]]; then
        RESULT=$(marsh_normalize_path "${RESULT}" "directory") || return 1
    fi

    if [[ "${RESULT}" != "./" ]]; then
        RESULT="${RESULT#./}"
    fi

    printf '%s\n' "${RESULT}"
}

# creates a lock directory for a file
function marsh_lock_acquire {  # marsh_lock_acquire file
    local FILE LOCK_DIR

    FILE="${1:-}"
    [[ "${FILE}" == "" ]] && return 1
    LOCK_DIR=$(marsh_lock_get_directory "${FILE}") || return 1

    if mkdir "${LOCK_DIR}" 2>/dev/null; then
        return 0
    fi
    return 1
}

# returns the path for a lock directory associated with a file
function marsh_lock_get_directory {  # marsh_lock_get_directory file
    local FILE LOCK_DIR

    FILE="${1:-}"
    [[ "${FILE}" == "" ]] && return 1
    LOCK_DIR="${FILE}.marsh-lock"

    printf '%s\n' "${LOCK_DIR}"
}

# removes a lock directory
function marsh_lock_release {  # marsh_lock_release file
    local FILE LOCK_DIR

    FILE="${1:-}"
    [[ "${FILE}" == "" ]] && return 1
    LOCK_DIR=$(marsh_lock_get_directory "${FILE}") || return 1

    rmdir "${LOCK_DIR}" 2>/dev/null || return 1
}

# awaits lock release by checking for the existence of the lock directory in a loop with bounded retries
function marsh_lock_wait {  # marsh_lock_wait file max_retries sleep_interval
    local FILE MAX_RETRIES SLEEP_INTERVAL LOCK_DIR ATTEMPT

    FILE="${1:-}"
    MAX_RETRIES="${2:-100}"
    SLEEP_INTERVAL="${3:-0.3}"
    [[ "${FILE}" == "" ]] && return 1

    LOCK_DIR=$(marsh_lock_get_directory "${FILE}") || return 1

    ATTEMPT=0
    while [[ "${ATTEMPT}" -lt "${MAX_RETRIES}" ]]; do
        if [[ ! -e "${LOCK_DIR}" ]]; then
            return 0
        fi
        ATTEMPT=$((ATTEMPT + 1))
        sleep "${SLEEP_INTERVAL}"
    done
    return 1
}

# normalizes a marsh-internal relative path value for reuse in path helpers
function marsh_normalize_internal_path {  # marsh_normalize_internal_path path [path_kind]
    local PATH_VALUE PATH_KIND

    PATH_VALUE="${1:-}"
    PATH_KIND="${2:-path}"
    [[ "${PATH_VALUE}" == "" ]] && return 1
    [[ "${PATH_KIND}" == "path" || "${PATH_KIND}" == "directory" ]] || return 1

    while [[ "${PATH_VALUE}" == ./* ]]; do
        PATH_VALUE="${PATH_VALUE#./}"
    done
    while [[ "${PATH_VALUE}" == */. ]]; do
        PATH_VALUE="${PATH_VALUE%/.}"
    done

    PATH_VALUE="${PATH_VALUE%/}"
    PATH_VALUE="${PATH_VALUE:-.}/"
    if [[ "${PATH_KIND}" != "directory" ]]; then
        PATH_VALUE="${PATH_VALUE%/}"
    fi

    printf '%s\n' "${PATH_VALUE}"
}

# normalizes a path for directory or document semantics
function marsh_normalize_path {  # marsh_normalize_path path [path_kind] [remove_link_filenames_csv]
    local PATH_VALUE PATH_KIND REMOVE_LINK_FILENAMES_CSV LEADING_DOT_SLASH
    local -a REMOVE_LINK_FILENAMES

    PATH_VALUE="${1:-}"
    PATH_KIND="${2:-path}"
    REMOVE_LINK_FILENAMES_CSV="${3:-}"
    shift 3

    [[ "${PATH_VALUE}" == "" ]] && return 1
    [[ "${PATH_KIND}" == "path" || "${PATH_KIND}" == "directory" || "${PATH_KIND}" == "document" ]] || return 1
    REMOVE_LINK_FILENAMES=()
    if [[ "${REMOVE_LINK_FILENAMES_CSV}" != "" ]]; then
        REMOVE_LINK_FILENAMES=("${REMOVE_LINK_FILENAMES_CSV//,/ }")
    fi

    if [[ "${PATH_KIND}" == "document" ]]; then
        LEADING_DOT_SLASH=false
        [[ "${PATH_VALUE}" == ./* ]] && LEADING_DOT_SLASH=true
        if marsh_in_array "${PATH_VALUE}" "${REMOVE_LINK_FILENAMES[@]}"; then
            PATH_VALUE=$(marsh_normalize_internal_path "." "directory") || return 1
        elif [[ "${PATH_VALUE}" == */* ]] && marsh_in_array "${PATH_VALUE##*/}" "${REMOVE_LINK_FILENAMES[@]}"; then
            PATH_VALUE=$(marsh_normalize_internal_path "${PATH_VALUE%/*}" "directory") || return 1
            if [[ "${LEADING_DOT_SLASH}" == true ]] && [[ "${PATH_VALUE}" != "./" ]]; then
                PATH_VALUE="./${PATH_VALUE}"
            fi
        fi
    elif [[ "${PATH_KIND}" == "directory" ]]; then
        LEADING_DOT_SLASH=false
        [[ "${PATH_VALUE}" == ./* ]] && LEADING_DOT_SLASH=true
        PATH_VALUE=$(marsh_normalize_internal_path "${PATH_VALUE}" "directory") || return 1
        if [[ "${LEADING_DOT_SLASH}" == true ]] && [[ "${PATH_VALUE}" != "./" ]]; then
            PATH_VALUE="./${PATH_VALUE}"
        fi
    else
        PATH_VALUE=$(marsh_normalize_internal_path "${PATH_VALUE}") || return 1
    fi

    printf '%s\n' "${PATH_VALUE}"
}

# resolves a config-relative path against the config file directory without
# changing absolute paths or glob expressions beyond prefixing the base dir
function marsh_resolve_config_path {  # marsh_resolve_config_path config_file_dir path
    local CONFIG_FILE_DIR PATH_VALUE

    CONFIG_FILE_DIR="${1:-}"
    PATH_VALUE="${2:-}"
    [[ "${CONFIG_FILE_DIR}" == "" ]] && return 1
    [[ "${PATH_VALUE}" == "" ]] && return 1

    if [[ ! "${PATH_VALUE}" =~ ^/ ]]; then
        PATH_VALUE="${CONFIG_FILE_DIR}/${PATH_VALUE}"
    fi
    PATH_VALUE="${PATH_VALUE#./}"
    printf '%s\n' "${PATH_VALUE}"
}

# resolves a relative path against a base directory path without touching the filesystem
function marsh_resolve_relative_path {  # marsh_resolve_relative_path base_dir target_path [remove_link_filenames_csv]
    local BASE_DIR TARGET_PATH REMOVE_LINK_FILENAMES_CSV BASE_DIR_NORM BASE_PATH TARGET_IS_DIR
    local PART RESULT LAST_INDEX
    local -a RESULT_PARTS INPUT_PARTS

    BASE_DIR="${1:-}"
    TARGET_PATH="${2:-}"
    REMOVE_LINK_FILENAMES_CSV="${3:-}"
    [[ "${BASE_DIR}" == "" ]] && return 1
    [[ "${TARGET_PATH}" == "" ]] && return 1

    BASE_DIR_NORM=$(marsh_normalize_path "${BASE_DIR}" "directory") || return 1
    BASE_PATH="${BASE_DIR_NORM#./}"
    BASE_PATH="${BASE_PATH%/}"
    TARGET_IS_DIR=false
    if [[ "${TARGET_PATH}" == */ ]] || [[ "${TARGET_PATH}" == "." ]] || [[ "${TARGET_PATH}" == "./" ]] || [[ "${TARGET_PATH}" == ".." ]] || [[ "${TARGET_PATH}" == "../" ]]; then
        TARGET_IS_DIR=true
    fi

    RESULT_PARTS=()
    if [[ "${BASE_PATH}" != "" ]]; then
        IFS='/' read -r -a RESULT_PARTS <<< "${BASE_PATH}"
    fi
    IFS='/' read -r -a INPUT_PARTS <<< "${TARGET_PATH}"
    for PART in "${INPUT_PARTS[@]}"; do
        [[ "${PART}" == "" ]] && continue
        if [[ "${PART}" == "." ]]; then
            continue
        elif [[ "${PART}" == ".." ]]; then
            LAST_INDEX=$(( ${#RESULT_PARTS[@]} - 1 ))
            if [[ "${#RESULT_PARTS[@]}" -gt 0 ]] && [[ "${RESULT_PARTS[$LAST_INDEX]}" != ".." ]]; then
                unset 'RESULT_PARTS[$LAST_INDEX]'
                RESULT_PARTS=("${RESULT_PARTS[@]}")
            else
                RESULT_PARTS+=("..")
            fi
        else
            RESULT_PARTS+=("${PART}")
        fi
    done

    RESULT=$(IFS=/; printf '%s' "${RESULT_PARTS[*]}")
    RESULT="${RESULT:-.}"
    if [[ "${TARGET_IS_DIR}" == true ]]; then
        RESULT=$(marsh_normalize_path "${RESULT}" "directory") || return 1
    else
        RESULT=$(marsh_normalize_path "${RESULT}" "document" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
    fi
    if [[ "${RESULT}" != "./" ]]; then
        RESULT="${RESULT#./}"
    fi
    printf '%s\n' "${RESULT}"
}

