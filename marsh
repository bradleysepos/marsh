                    [[ "${TEMPLATE_METADATA_ENTRY_TYPE}" == "list" ]] || return 1
                    if [[ "${TEMPLATE_METADATA_ENTRY_LIST}" != "" ]]; then
                        while IFS= read -r ASSET; do
                            [[ "${ASSET}" == "" ]] && continue
                            TEMPLATE_ASSETS_OTHER+=("${ASSET}")
                        done <<< "${TEMPLATE_METADATA_ENTRY_LIST}"
                    fi
                    ;;
            esac
            TEMPLATE_METADATA_INDEX=$((TEMPLATE_METADATA_INDEX + 1))
        done

        # partials
        PARTIALS=("${TEMPLATE_Template_Partials_Redirect:-}" "${TEMPLATE_Template_Partials_Base:-}" "${TEMPLATE_Template_Partials_Head:-}" "${TEMPLATE_Template_Partials_Body:-}" "${TEMPLATE_Template_Partials_Document:-}" "${TEMPLATE_Template_Partials_Header:-}" "${TEMPLATE_Template_Partials_Footer:-}" "${TEMPLATE_Template_Partials_Nav:-}" "${TEMPLATE_Template_Partials_Notice:-}" "${TEMPLATE_Template_Partials_Archive_HTML_Base:-}" "${TEMPLATE_Template_Partials_Archive_HTML_Head:-}" "${TEMPLATE_Template_Partials_Archive_HTML_Body:-}" "${TEMPLATE_Template_Partials_Archive_HTML_Document:-}" "${TEMPLATE_Template_Partials_Archive_HTML_Header:-}" "${TEMPLATE_Template_Partials_Archive_HTML_Footer:-}" "${TEMPLATE_Template_Partials_Archive_HTML_Nav:-}" "${TEMPLATE_Template_Partials_Archive_HTML_Notice:-}" "${TEMPLATE_Template_Partials_Archive_Atom_Base:-}" "${TEMPLATE_Template_Partials_Archive_Atom_Body:-}" "${TEMPLATE_Template_Partials_Archive_Atom_Document:-}" "${TEMPLATE_Template_Partials_Archive_JSON_Base:-}" "${TEMPLATE_Template_Partials_Archive_JSON_Body:-}" "${TEMPLATE_Template_Partials_Archive_JSON_Document:-}")
        # conditionals
        for J in "${!PARTIALS[@]}"; do
            [[ "${PARTIALS[$J]}" == "" ]] && continue
            PARTIALS[$J]=$(get_processed_conditional_partial "${PARTIALS[$J]}" "DOCUMENT_" "${DOCUMENT_META_VARS:-}") || return 1
        done
        TEMPLATE_Template_Partials_Redirect="${PARTIALS[0]:-}"
        TEMPLATE_Template_Partials_Base="${PARTIALS[1]:-}"
        TEMPLATE_Template_Partials_Head="${PARTIALS[2]:-}"
        TEMPLATE_Template_Partials_Body="${PARTIALS[3]:-}"
        TEMPLATE_Template_Partials_Document="${PARTIALS[4]:-}"
        TEMPLATE_Template_Partials_Header="${PARTIALS[5]:-}"
        TEMPLATE_Template_Partials_Footer="${PARTIALS[6]:-}"
        TEMPLATE_Template_Partials_Nav="${PARTIALS[7]:-}"
        TEMPLATE_Template_Partials_Notice="${PARTIALS[8]:-}"
        TEMPLATE_Template_Partials_Archive_HTML_Base="${PARTIALS[9]:-}"
        TEMPLATE_Template_Partials_Archive_HTML_Head="${PARTIALS[10]:-}"
        TEMPLATE_Template_Partials_Archive_HTML_Body="${PARTIALS[11]:-}"
        TEMPLATE_Template_Partials_Archive_HTML_Document="${PARTIALS[12]:-}"
        TEMPLATE_Template_Partials_Archive_HTML_Header="${PARTIALS[13]:-}"
        TEMPLATE_Template_Partials_Archive_HTML_Footer="${PARTIALS[14]:-}"
        TEMPLATE_Template_Partials_Archive_HTML_Nav="${PARTIALS[15]:-}"
        TEMPLATE_Template_Partials_Archive_HTML_Notice="${PARTIALS[16]:-}"
        TEMPLATE_Template_Partials_Archive_Atom_Base="${PARTIALS[17]:-}"
        TEMPLATE_Template_Partials_Archive_Atom_Body="${PARTIALS[18]:-}"
        TEMPLATE_Template_Partials_Archive_Atom_Document="${PARTIALS[19]:-}"
        TEMPLATE_Template_Partials_Archive_JSON_Base="${PARTIALS[20]:-}"
        TEMPLATE_Template_Partials_Archive_JSON_Body="${PARTIALS[21]:-}"
        TEMPLATE_Template_Partials_Archive_JSON_Document="${PARTIALS[22]:-}"

        TEMPLATE_BASE_FILE="${TEMPLATE_Template_Partials_Base:-}"
        TEMPLATE_HEAD_FILE="${TEMPLATE_Template_Partials_Head:-}"
        TEMPLATE_BODY_FILE="${TEMPLATE_Template_Partials_Body:-}"
        TEMPLATE_DOCUMENT_FILE="${TEMPLATE_Template_Partials_Document:-}"
        TEMPLATE_HEADER_FILE="${TEMPLATE_Template_Partials_Header:-}"
        TEMPLATE_FOOTER_FILE="${TEMPLATE_Template_Partials_Footer:-}"
        TEMPLATE_NAV_FILE="${TEMPLATE_Template_Partials_Nav:-}"
        TEMPLATE_NOTICE_FILE="${TEMPLATE_Template_Partials_Notice:-}"
        if [[ "${DOCUMENT_Type}" == "archive" ]]; then
            TEMPLATE_BASE_FILE="${TEMPLATE_Template_Partials_Archive_HTML_Base:-${TEMPLATE_BASE_FILE:-}}"
            TEMPLATE_HEAD_FILE="${TEMPLATE_Template_Partials_Archive_HTML_Head:-${TEMPLATE_HEAD_FILE:-}}"
            TEMPLATE_BODY_FILE="${TEMPLATE_Template_Partials_Archive_HTML_Body:-${TEMPLATE_BODY_FILE:-}}"
            TEMPLATE_DOCUMENT_FILE="${TEMPLATE_Template_Partials_Archive_HTML_Document:-${TEMPLATE_DOCUMENT_FILE:-}}"
            TEMPLATE_HEADER_FILE="${TEMPLATE_Template_Partials_Archive_HTML_Header:-${TEMPLATE_HEADER_FILE:-}}"
            TEMPLATE_FOOTER_FILE="${TEMPLATE_Template_Partials_Archive_HTML_Footer:-${TEMPLATE_FOOTER_FILE:-}}"
            TEMPLATE_NAV_FILE="${TEMPLATE_Template_Partials_Archive_HTML_Nav:-${TEMPLATE_NAV_FILE:-}}"
