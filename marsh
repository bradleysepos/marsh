    # keep archive manifest creation internal to archive planning while still allowing
    # the fast path to reuse in-memory document records instead of rereading from disk
    marsh_write_target_archive_manifest "${SITE_OUTPUT_ROOT}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" "${REMOVE_LINK_FILENAMES_CSV}" "${TARGET_PLAN_ROOT}" "${DOCUMENT_RECORDS_IN[@]}" || {
        echo "Unable to write target archive manifest: ${TARGET_PLAN_ROOT}" >&2
        return 1
    }

    # archives for the same target share the same manifest
    TARGET_ARCHIVE_MANIFEST="${TARGET_PLAN_ROOT}/archive-manifest"

    for I in "${!TARGET_ARCHIVE_RECORDS[@]}"; do
        TARGET_ARCHIVE_RECORD="${TARGET_ARCHIVE_RECORDS[$I]:-}"
        [[ "${TARGET_ARCHIVE_RECORD}" == "" ]] && continue
        IFS=$(printf '\034') read -r TARGET_ARCHIVE_PATH TARGET_ARCHIVE_ENCODING TARGET_ARCHIVE_NAME_VALUE TARGET_ARCHIVE_LANGUAGE_VALUE TARGET_ARCHIVE_LANGUAGE_CODE_VALUE TARGET_ARCHIVE_ROOT TARGET_ARCHIVE_COUNT_VALUE TARGET_ARCHIVE_PAGE_SIZE_VALUE TARGET_ARCHIVE_CONTENT_VALUE TARGET_ARCHIVE_TYPES_JOINED TARGET_ARCHIVE_EXCLUDED_STATES_JOINED TARGET_ARCHIVE_TEMPLATE_SOURCE_VALUE TARGET_ARCHIVE_TEMPLATE_ASSETS_PATH_VALUE TARGET_ARCHIVE_TEMPLATE_OVERRIDES_JOINED TARGET_ARCHIVE_TEMPLATE_VALUE TARGET_ARCHIVE_RECORD_EXTRA <<< "${TARGET_ARCHIVE_RECORD}"
        [[ "${TARGET_ARCHIVE_RECORD_EXTRA}" == "" ]] && [[ "${TARGET_ARCHIVE_PATH}" != "" ]] || {
            echo "Malformed target archive record: ${TARGET_PLAN_ROOT}" >&2
            return 1
        }

        # unpack per-archive selection arrays from their serialized record form
        OIFS="${IFS}"
        IFS=$(printf '\034')
        TARGET_ARCHIVE_TYPES=(${TARGET_ARCHIVE_TYPES_JOINED:-})
        TARGET_ARCHIVE_EXCLUDED_STATES=(${TARGET_ARCHIVE_EXCLUDED_STATES_JOINED:-})
        TARGET_ARCHIVE_TEMPLATE_OVERRIDES=(${TARGET_ARCHIVE_TEMPLATE_OVERRIDES_JOINED:-})
        IFS="${OIFS}"

        # start from the target defaults, then let archive-specific settings override them
        TARGET_ARCHIVE_TEMPLATE="${TEMPLATE:-}"
        TARGET_ARCHIVE_TEMPLATE_SOURCE="${TARGET_TEMPLATE_SOURCE:-}"
        TARGET_ARCHIVE_TEMPLATE_ASSETS_PATH="${TEMPLATE_ASSETS_PATH:-}"
        if [[ "${TARGET_ARCHIVE_TEMPLATE_SOURCE_VALUE}" != "" ]]; then
            TARGET_ARCHIVE_TEMPLATE="${TARGET_ARCHIVE_TEMPLATE_VALUE:-}"
            TARGET_ARCHIVE_TEMPLATE_SOURCE="${TARGET_ARCHIVE_TEMPLATE_SOURCE_VALUE}"
        fi
        if [[ "${TARGET_ARCHIVE_TEMPLATE_ASSETS_PATH_VALUE}" != "" ]]; then
            TARGET_ARCHIVE_TEMPLATE_ASSETS_PATH="${TARGET_ARCHIVE_TEMPLATE_ASSETS_PATH_VALUE}"
        fi
        if [[ "${TARGET_ARCHIVE_TEMPLATE_SOURCE_VALUE}" == "" ]] && [[ "${TARGET_ARCHIVE_TEMPLATE_OVERRIDES_JOINED}" == "" ]]; then
            TARGET_ARCHIVE_TEMPLATE_OVERRIDES=("${TARGET_TEMPLATE_OVERRIDES[@]}")
        fi
        if [[ "${TARGET_ARCHIVE_TEMPLATE_SOURCE:-}" != "" ]]; then
            TARGET_ARCHIVE_TEMPLATE_SOURCE=$(marsh_resolve_config_path "${CONFIG_FILE_DIR}" "${TARGET_ARCHIVE_TEMPLATE_SOURCE}") || return 1
            for J in "${!TARGET_ARCHIVE_TEMPLATE_OVERRIDES[@]}"; do
                [[ "${TARGET_ARCHIVE_TEMPLATE_OVERRIDES[$J]:-}" == "" ]] && continue
                TARGET_ARCHIVE_TEMPLATE_OVERRIDES[$J]=$(marsh_resolve_config_path "${CONFIG_FILE_DIR}" "${TARGET_ARCHIVE_TEMPLATE_OVERRIDES[$J]}") || return 1
            done
            marsh_get_template_cache_path "${TEMPLATES_DIR}" "${TARGET_ARCHIVE_TEMPLATE}" "${TARGET_ARCHIVE_TEMPLATE_SOURCE}" >/dev/null || return 1
        fi

        # where no explicit archive root is configured, group archives that share the
        # same content selection so they derive a stable shared root path
        if [[ "${TARGET_ARCHIVE_ROOT}" == "" ]]; then
            TARGET_ARCHIVE_GROUP_PATHS=()
            for TARGET_ARCHIVE_COMPARE_RECORD in "${TARGET_ARCHIVE_RECORDS[@]}"; do
                [[ "${TARGET_ARCHIVE_COMPARE_RECORD}" == "" ]] && continue
                IFS=$(printf '\034') read -r TARGET_ARCHIVE_COMPARE_PATH _ _ _ _ _ _ _ _ TARGET_ARCHIVE_COMPARE_TYPES_JOINED TARGET_ARCHIVE_COMPARE_EXCLUDED_STATES_JOINED _ _ _ _ TARGET_ARCHIVE_COMPARE_RECORD_EXTRA <<< "${TARGET_ARCHIVE_COMPARE_RECORD}"
                [[ "${TARGET_ARCHIVE_COMPARE_RECORD_EXTRA}" == "" ]] && [[ "${TARGET_ARCHIVE_COMPARE_PATH}" != "" ]] || {
                    echo "Malformed target archive record: ${TARGET_PLAN_ROOT}" >&2
                    return 1
                }
                if [[ "${TARGET_ARCHIVE_COMPARE_TYPES_JOINED}" == "${TARGET_ARCHIVE_TYPES_JOINED}" ]] && [[ "${TARGET_ARCHIVE_COMPARE_EXCLUDED_STATES_JOINED}" == "${TARGET_ARCHIVE_EXCLUDED_STATES_JOINED}" ]]; then
                    TARGET_ARCHIVE_GROUP_PATHS+=("${TARGET_ARCHIVE_COMPARE_PATH}")
                fi
            done
            TARGET_ARCHIVE_ROOT=$(marsh_get_archive_root_path "${TARGET_ARCHIVE_PATH}" "${TARGET_ARCHIVE_GROUP_PATHS[@]}") || return 1
        fi

        # each archive config expands into one explicit archive plan root
        TARGET_ARCHIVE_PLAN_ROOT=$(marsh_plan_archive_pages \
            "${TARGET_OUTPUT_ROOT}" \
            "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" \
            "${REMOVE_LINK_FILENAMES_CSV}" \
            "${TARGET_ARCHIVE_ENCODING}" \
            "${TARGET_ARCHIVE_PATH}" \
            "${TARGET_ARCHIVE_NAME_VALUE:-$TARGET_NAME}" \
            "${TARGET_ARCHIVE_LANGUAGE_VALUE:-}" \
            "${TARGET_ARCHIVE_LANGUAGE_CODE_VALUE:-}" \
            "${TARGET_ARCHIVE_COUNT_VALUE}" \
            "${TARGET_ARCHIVE_PAGE_SIZE_VALUE}" \
            "${#TARGET_ARCHIVE_TYPES[@]}" \
            "${TARGET_ARCHIVE_TYPES[@]}" \
            "${#TARGET_ARCHIVE_EXCLUDED_STATES[@]}" \
            "${TARGET_ARCHIVE_EXCLUDED_STATES[@]}" \
            "${TARGET_ARCHIVE_MANIFEST}" \
            "${TARGET_ARCHIVE_ROOT}" \
            "${TEMPLATES_DIR}" \
            "${TARGET_ARCHIVE_TEMPLATE:-}" \
            "${TARGET_SITEMAP}" \
            "${TARGET_SITEMAP_SEARCH}" \
            "${#TARGET_ARCHIVE_TEMPLATE_OVERRIDES[@]}" \
            "${TARGET_ARCHIVE_TEMPLATE_OVERRIDES[@]}" \
            "${TARGET_ARCHIVE_TEMPLATE_ASSETS_PATH:-}" \
            "${BUILD_CONTEXT_TARGET_OUTPUT_REL}" \
            "${BUILD_CONTEXT_SOURCE_ROOT}") || return 1
        printf '%s\n' "${TARGET_ARCHIVE_PLAN_ROOT}"
    done
}

# writes a single archive source page and its page-local subdocuments
function marsh_write_archive_page {  # marsh_write_archive_page encoding target_output_root archive_source archive_title language langcode paginated page page_total page_size page_subdocuments_total archive_subdocuments_total current_uri canonical_uri first_uri prev_uri next_uri last_uri current_href canonical_href first_href prev_href next_href last_href archive_root_path archive_root_href #documents[@] documents[@] document_uris[@] document_abspaths[@]
    local ENCODING TARGET_OUTPUT_ROOT ARCHIVE_SOURCE ARCHIVE_OUTPUT_SOURCE_PATH ARCHIVE_TEMP_SOURCE_FILE ARCHIVE_TITLE LANGUAGE LANGCODE PAGINATED
    local PAGE PAGE_TOTAL PAGE_SIZE PAGE_SUBDOCUMENTS_TOTAL ARCHIVE_SUBDOCUMENTS_TOTAL
    local PAGE_URI PAGE_CANONICAL_URI PAGE_FIRST_URI PAGE_PREV_URI PAGE_NEXT_URI PAGE_LAST_URI
    local PAGE_HREF PAGE_CANONICAL_HREF PAGE_FIRST_HREF PAGE_PREV_HREF PAGE_NEXT_HREF PAGE_LAST_HREF
    local ARCHIVE_ROOT_PATH ARCHIVE_ROOT_HREF
    local NUM_DOCUMENTS DOCUMENT INDEX URI ABSPATH MANIFEST_FILE
    local PAGE_IS_FIRST PAGE_IS_LAST PAGE_HAS_PREV PAGE_HAS_NEXT PAGE_HAS_SUBDOCUMENTS
    local -a DOCUMENTS DOCUMENT_URIS DOCUMENT_ABSPATHS

    ENCODING="${1:-}"
    TARGET_OUTPUT_ROOT="${2:-}"
    ARCHIVE_SOURCE="${3:-}"
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${ARCHIVE_SOURCE}" == "" ]] && return 1
    shift 3
    ARCHIVE_TITLE="${1:-}"
    LANGUAGE="${2:-}"
    LANGCODE="${3:-}"
    PAGINATED="${4:-false}"
    PAGE="${5:-1}"
    PAGE_TOTAL="${6:-1}"
    PAGE_SIZE="${7:-}"
    PAGE_SUBDOCUMENTS_TOTAL="${8:-0}"
    ARCHIVE_SUBDOCUMENTS_TOTAL="${9:-0}"
    PAGE_URI="${10:-}"
    PAGE_CANONICAL_URI="${11:-}"
    PAGE_FIRST_URI="${12:-}"
    PAGE_PREV_URI="${13:-}"
    PAGE_NEXT_URI="${14:-}"
    PAGE_LAST_URI="${15:-}"
    PAGE_HREF="${16:-}"
    PAGE_CANONICAL_HREF="${17:-}"
    PAGE_FIRST_HREF="${18:-}"
    PAGE_PREV_HREF="${19:-}"
    PAGE_NEXT_HREF="${20:-}"
    PAGE_LAST_HREF="${21:-}"
    ARCHIVE_ROOT_PATH="${22:-}"
    ARCHIVE_ROOT_HREF="${23:-}"
    shift 23
    NUM_DOCUMENTS="${1:-0}"
    shift 1
    DOCUMENTS=()
    while [[ "${NUM_DOCUMENTS}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        DOCUMENTS+=("${1}")
        NUM_DOCUMENTS=$((NUM_DOCUMENTS - 1))
        shift 1
    done
    DOCUMENT_URIS=()
    INDEX=0
    while [[ "${INDEX}" -lt "${#DOCUMENTS[@]}" ]] && [[ "${#@}" -gt 0 ]]; do
        DOCUMENT_URIS+=("${1}")
        INDEX=$((INDEX + 1))
        shift 1
    done
    DOCUMENT_ABSPATHS=()
    INDEX=0
    while [[ "${INDEX}" -lt "${#DOCUMENTS[@]}" ]] && [[ "${#@}" -gt 0 ]]; do
        DOCUMENT_ABSPATHS+=("${1}")
        INDEX=$((INDEX + 1))
        shift 1
    done

    # page metadata
    ARCHIVE_OUTPUT_SOURCE_PATH="${TARGET_OUTPUT_ROOT}/${ARCHIVE_SOURCE}"
    ARCHIVE_TEMP_SOURCE_FILE=$(marsh_get_archive_temp_path "${TARGET_OUTPUT_ROOT}" "${ARCHIVE_SOURCE}" "source") || return 1
    PAGE_IS_FIRST=false
    PAGE_IS_LAST=false
    PAGE_HAS_PREV=false
    PAGE_HAS_NEXT=false
    PAGE_HAS_SUBDOCUMENTS=false
    [[ "${PAGE}" -eq 1 ]] && PAGE_IS_FIRST=true
    [[ "${PAGE}" -eq "${PAGE_TOTAL}" ]] && PAGE_IS_LAST=true
    [[ "${PAGE_PREV_URI}" != "" ]] && PAGE_HAS_PREV=true
    [[ "${PAGE_NEXT_URI}" != "" ]] && PAGE_HAS_NEXT=true
    [[ "${PAGE_SUBDOCUMENTS_TOTAL}" -gt 0 ]] && PAGE_HAS_SUBDOCUMENTS=true

    # Keep final output directories present for later archive page publication.
    mkdir -p "${ARCHIVE_OUTPUT_SOURCE_PATH%/*}" >/dev/null 2>&1 || {
        echo "Unable to create archive output directory: ${ARCHIVE_OUTPUT_SOURCE_PATH%/*}" >&2
        return 1
    }

    mkdir -p "${ARCHIVE_TEMP_SOURCE_FILE%/*}" >/dev/null 2>&1 || {
        echo "Unable to create archive temp directory: ${ARCHIVE_TEMP_SOURCE_FILE%/*}" >&2
        return 1
    }
    rm -f "${ARCHIVE_OUTPUT_SOURCE_PATH}" >/dev/null 2>&1 || {
        echo "Unable to remove stale archive file: ${ARCHIVE_OUTPUT_SOURCE_PATH}" >&2
        return 1
    }

    # write the generated archive source with page metadata
    {
        echo "---" > "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
        if [[ "${ENCODING}" == "html" ]]; then
            echo "Type: archive" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
        else
            echo "Type: archive-${ENCODING}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
        fi
        echo "Date: $(date -u '+%Y-%m-%d %H:%M:%S')" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
        echo "Title: ${ARCHIVE_TITLE}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
        echo "Language: ${LANGUAGE}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
        echo "Language_Code: ${LANGCODE}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
        echo "Archive_Root_Path: ${ARCHIVE_ROOT_PATH}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
        echo "Archive_Root_Href: ${ARCHIVE_ROOT_HREF}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
        if [[ "${ENCODING}" == "html" ]]; then
            echo "Paginated: ${PAGINATED}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page: ${PAGE}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Total: ${PAGE_TOTAL}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Size: ${PAGE_SIZE}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Subdocuments_Total: ${PAGE_SUBDOCUMENTS_TOTAL}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Archive_Subdocuments_Total: ${ARCHIVE_SUBDOCUMENTS_TOTAL}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Is_First: ${PAGE_IS_FIRST}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Is_Last: ${PAGE_IS_LAST}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Has_Prev: ${PAGE_HAS_PREV}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Has_Next: ${PAGE_HAS_NEXT}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Has_Subdocuments: ${PAGE_HAS_SUBDOCUMENTS}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_URI: ${PAGE_URI}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Canonical_URI: ${PAGE_CANONICAL_URI}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_First_URI: ${PAGE_FIRST_URI}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Prev_URI: ${PAGE_PREV_URI}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Next_URI: ${PAGE_NEXT_URI}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Last_URI: ${PAGE_LAST_URI}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Href: ${PAGE_HREF}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Canonical_Href: ${PAGE_CANONICAL_HREF}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_First_Href: ${PAGE_FIRST_HREF}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Prev_Href: ${PAGE_PREV_HREF}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Next_Href: ${PAGE_NEXT_HREF}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
            echo "Page_Last_Href: ${PAGE_LAST_HREF}" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
        fi
        echo "---" >> "${ARCHIVE_TEMP_SOURCE_FILE}" 2>/dev/null
    } || {
        echo "Unable to write archive file: ${ARCHIVE_TEMP_SOURCE_FILE}" >&2
        rm -f "${ARCHIVE_TEMP_SOURCE_FILE}"
        return 1
    }

    # create manifest of the subdocuments for this page
    if [[ "${#DOCUMENTS[@]}" -gt 0 ]]; then
        MANIFEST_FILE=$(marsh_get_archive_temp_path "${TARGET_OUTPUT_ROOT}" "${ARCHIVE_SOURCE}" "subdocuments-manifest") || return 1
        mkdir -p "${MANIFEST_FILE%/*}" >/dev/null 2>&1 || {
            echo "Unable to create archive manifest temp directory: ${MANIFEST_FILE%/*}" >&2
            return 1
        }
        {
            INDEX=0
            for DOCUMENT in "${DOCUMENTS[@]}"; do
                URI="${DOCUMENT_URIS[$INDEX]:-}"
                ABSPATH="${DOCUMENT_ABSPATHS[$INDEX]:-}"
                marsh_validate_record_fields "subdocument manifest record" "${DOCUMENT}" "${URI}" "${ABSPATH}" || {
                    echo "Unable to write archive subdocument manifest: ${MANIFEST_FILE}" >&2
                    return 1
                }
                printf '%s\037%s\037%s\n' "${DOCUMENT}" "${URI}" "${ABSPATH}" || {
                    echo "Unable to write archive subdocument manifest: ${MANIFEST_FILE}" >&2
                    return 1
                }
                INDEX=$((INDEX + 1))
            done
        } > "${MANIFEST_FILE}" || {
            echo "Unable to create archive subdocument manifest: ${MANIFEST_FILE}" >&2
            rm -f "${MANIFEST_FILE}"
            return 1
        }
    fi

    return 0
}

# writes an archive manifest under the target plan root from planned target documents
function marsh_write_target_archive_manifest {  # marsh_write_target_archive_manifest site_output_root markdown_document_extensions_csv markdown_document_extensions_replacement remove_link_filenames_csv target_plan_root [document_records[@]]
    local SITE_OUTPUT_ROOT MARKDOWN_DOCUMENT_EXTENSIONS_CSV MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT REMOVE_LINK_FILENAMES_CSV TARGET_PLAN_ROOT MANIFEST_FILE MANIFEST_TEMP DOCUMENT_RECORD
    local DOCUMENT_ID SOURCE_RELPATH TARGET_OUTPUT_REL SOURCE_ROOT DOCUMENT_SOURCE_FILE BUILD_CONTEXT_OUTPUT_ROOT
    local DOCUMENT_ARTIFACT_ROOT DOCUMENT_ARTIFACT_CONTENT DOCUMENT_ARTIFACT_META_YAML DOCUMENT_ARTIFACT_META
    local TYPE URI ABSPATH DOCUMENT_OUTPUT_REL STATE_TEXT STATE_VALUE RECORD_REST
    local -a DOCUMENT_RECORDS_IN STATE

    SITE_OUTPUT_ROOT="${1:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_CSV="${2:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT="${3:-}"
    REMOVE_LINK_FILENAMES_CSV="${4:-}"
    TARGET_PLAN_ROOT="${5:-}"
    [[ "${SITE_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" == "" ]] && return 1
    [[ "${TARGET_PLAN_ROOT}" == "" ]] && return 1
    shift 5
    DOCUMENT_RECORDS_IN=("$@")

    MANIFEST_FILE="${TARGET_PLAN_ROOT}/archive-manifest"
    MANIFEST_TEMP=$(mktemp "${TARGET_PLAN_ROOT}/archive-manifest-XXXXXX") || return 1
    [[ "${#DOCUMENT_RECORDS_IN[@]}" -gt 0 ]] || return 1

    # require caller-supplied document records on the fast path
    while IFS=$'\t' read -r DOCUMENT_ID DOCUMENT_RECORD; do
        [[ "${DOCUMENT_ID}" == "" ]] && continue
        [[ "${DOCUMENT_RECORD}" == "" ]] && continue

        IFS=$'\037' read -r DOCUMENT_ID SOURCE_RELPATH TARGET_OUTPUT_REL SOURCE_ROOT RECORD_REST <<< "${DOCUMENT_RECORD}"
        [[ "${DOCUMENT_ID}" == "" ]] && continue
        [[ "${SOURCE_RELPATH}" != "" ]] || continue
        [[ "${TARGET_OUTPUT_REL}" != "" ]] || {
            rm -f "${MANIFEST_TEMP}"
            return 1
        }
        [[ "${SOURCE_ROOT}" != "" ]] || {
            rm -f "${MANIFEST_TEMP}"
            return 1
        }
        [[ "${RECORD_REST}" == "" ]] || {
            rm -f "${MANIFEST_TEMP}"
            return 1
        }
        [[ "${SOURCE_ROOT}" == "" ]] && {
            rm -f "${MANIFEST_TEMP}"
            return 1
        }

        DOCUMENT_SOURCE_FILE="${SOURCE_ROOT}/${SOURCE_RELPATH}"
        [[ -f "${DOCUMENT_SOURCE_FILE}" ]] && [[ -r "${DOCUMENT_SOURCE_FILE}" ]] || {
            rm -f "${MANIFEST_TEMP}"
            return 1
        }
        BUILD_CONTEXT_OUTPUT_ROOT=$(marsh_get_target_directory_path "${SITE_OUTPUT_ROOT}/${TARGET_OUTPUT_REL}") || {
            rm -f "${MANIFEST_TEMP}"
            return 1
        }

        TYPE=""
        STATE=()
        if [[ -f "${DOCUMENT_SOURCE_FILE}" ]] && marsh_has_frontmatter "${DOCUMENT_SOURCE_FILE}"; then
            # archive planning must not seed raw content artifacts, only metadata artifacts
            if ! marsh_write_document_metadata_artifacts "${BUILD_CONTEXT_OUTPUT_ROOT}" "${DOCUMENT_ID}" "${DOCUMENT_SOURCE_FILE}"; then
                echo "Unable to plan archive metadata: ${DOCUMENT_SOURCE_FILE}" >&2
                rm -f "${MANIFEST_TEMP}"
                return 1
            fi
            marsh_get_document_artifacts "${BUILD_CONTEXT_OUTPUT_ROOT}" "${DOCUMENT_ID}" "DOCUMENT_ARTIFACT_ROOT" "DOCUMENT_ARTIFACT_CONTENT" "DOCUMENT_ARTIFACT_META_YAML" "DOCUMENT_ARTIFACT_META" || {
                rm -f "${MANIFEST_TEMP}"
                return 1
            }
            marsh_load_archive_document_metadata "${DOCUMENT_ARTIFACT_META}" "TYPE" "STATE_TEXT" || {
                echo "Unable to plan archive metadata: ${DOCUMENT_SOURCE_FILE}" >&2
                rm -f "${MANIFEST_TEMP}"
                return 1
            }
            STATE=()
            while IFS= read -r STATE_VALUE; do
                [[ "${STATE_VALUE}" != "" ]] || continue
                STATE+=("${STATE_VALUE}")
            done <<< "${STATE_TEXT}"
        else
            echo "Unable to plan archive metadata: ${DOCUMENT_SOURCE_FILE}" >&2
            rm -f "${MANIFEST_TEMP}"
            return 1
        fi

        marsh_get_target_document_paths "${DOCUMENT_ID}" "${SITE_OUTPUT_ROOT}" "${TARGET_OUTPUT_REL}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" "TARGET_OUTPUT_ROOT" "DOCUMENT_DIR" "DOCUMENT_EXT" "DOCUMENT_OUTPUT_REL" "DOCUMENT_SITE_REL" "DOCUMENT_BASE_REL" || return 1
        URI=$(marsh_get_absolute_output_path "${DOCUMENT_OUTPUT_REL}" "document") || return 1
        ABSPATH=""
        [[ "${URI}" =~ / ]] && ABSPATH="${URI%/*}"

        marsh_validate_record_fields "archive manifest record" "${DOCUMENT_ID}" "${TYPE}" "${URI}" "${ABSPATH}" "${#STATE[@]}" "${STATE[@]}" || {
            rm -f "${MANIFEST_TEMP}"
            return 1
        }
        printf '%s\037%s\037%s\037%s\037%s' "${DOCUMENT_ID}" "${TYPE}" "${URI}" "${ABSPATH}" "${#STATE[@]}"
        for STATE_VALUE in "${STATE[@]}"; do
            printf '\037%s' "${STATE_VALUE}"
        done
        printf '\n'
    done < <(
        for DOCUMENT_RECORD in "${DOCUMENT_RECORDS_IN[@]}"; do
            [[ "${DOCUMENT_RECORD}" == "" ]] && continue
            IFS=$'\037' read -r DOCUMENT_ID SOURCE_RELPATH TARGET_OUTPUT_REL SOURCE_ROOT RECORD_REST <<< "${DOCUMENT_RECORD}"
            [[ "${DOCUMENT_ID}" == "" ]] && continue
            [[ "${SOURCE_RELPATH}" != "" ]] || continue
            [[ "${TARGET_OUTPUT_REL}" != "" ]] || continue
            [[ "${SOURCE_ROOT}" != "" ]] || continue
            [[ "${RECORD_REST}" == "" ]] || continue
            printf '%s\t%s\n' "${DOCUMENT_ID}" "${DOCUMENT_RECORD}"
        done | sort -nr -t/
    ) > "${MANIFEST_TEMP}" || {
        rm -f "${MANIFEST_TEMP}"
        return 1
    }

    mv "${MANIFEST_TEMP}" "${MANIFEST_FILE}" 2>/dev/null || {
        rm -f "${MANIFEST_TEMP}"
        return 1
    }
}

#
# Archive queue management
#

# builds aggregate archive-queue records for a target
function marsh_build_target_archive_queue {  # marsh_build_target_archive_queue site_output_root log_level log_levels_csv jobs markdown_command markdown_options_csv markdown_document_extensions_csv markdown_document_extensions_replacement remove_link_filenames_csv target_plan_root
    local SITE_OUTPUT_ROOT LOG_LEVEL LOG_LEVELS_CSV JOBS MARKDOWN_COMMAND MARKDOWN_OPTIONS_CSV MARKDOWN_DOCUMENT_EXTENSIONS_CSV MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT REMOVE_LINK_FILENAMES_CSV TARGET_PLAN_ROOT
    local TARGET_ARCHIVE_QUEUE_RECORDS_FILE QUEUE_RECORD DOCUMENT_RECORD
    local QUEUE_DOCUMENT_ID QUEUE_SOURCE_RELPATH QUEUE_TARGET_OUTPUT_REL QUEUE_SOURCE_ROOT QUEUE_ARCHIVE_PLAN_ROOT QUEUE_RECORD_REST
    local CURRENT_DOCUMENT_ID CURRENT_DOCUMENT_SOURCE_RELPATH CURRENT_DOCUMENT_TARGET_OUTPUT_REL CURRENT_DOCUMENT_SOURCE_ROOT CURRENT_DOCUMENT_RECORD_REST
    local CURRENT_ARCHIVE_PLAN_ROOT TARGET_OUTPUT_REL TARGET_SITEMAP TARGET_SITEMAP_SEARCH TEMPLATES_DIR TEMPLATE TEMPLATE_ASSETS_PATH
    local BUILD_CONTEXT_TARGET_OUTPUT_REL BUILD_CONTEXT_SOURCE_ROOT DOCUMENTS_FILE CURRENT_DOCUMENT_INDEX TEMPLATE_OVERRIDE TEMPLATE_OVERRIDES_TEXT
    local PARALLEL PARALLEL_MARKDOWN
    local -a TEMPLATE_OVERRIDES QUEUE_RECORDS CURRENT_DOCUMENT_RECORDS

    SITE_OUTPUT_ROOT="${1:-}"
    LOG_LEVEL="${2:-}"
    LOG_LEVELS_CSV="${3:-}"
    JOBS="${4:-1}"
    MARKDOWN_COMMAND="${5:-}"
    MARKDOWN_OPTIONS_CSV="${6:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_CSV="${7:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT="${8:-}"
    REMOVE_LINK_FILENAMES_CSV="${9:-}"
    TARGET_PLAN_ROOT="${10:-}"
    [[ "${SITE_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${MARKDOWN_COMMAND}" == "" ]] && return 1
    [[ "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" == "" ]] && return 1
    [[ "${TARGET_PLAN_ROOT}" == "" ]] && return 1

    TARGET_ARCHIVE_QUEUE_RECORDS_FILE=$(marsh_get_target_archive_queue_records_path "${TARGET_PLAN_ROOT}") || return 1
    [[ -f "${TARGET_ARCHIVE_QUEUE_RECORDS_FILE}" ]] && [[ -r "${TARGET_ARCHIVE_QUEUE_RECORDS_FILE}" ]] || {
        echo "Target archive queue records file not found: ${TARGET_ARCHIVE_QUEUE_RECORDS_FILE}" >&2
        return 1
    }

    QUEUE_RECORDS=()
    while IFS= read -r QUEUE_RECORD; do
        [[ "${QUEUE_RECORD}" == "" ]] && continue
        QUEUE_RECORDS+=("${QUEUE_RECORD}")
    done < "${TARGET_ARCHIVE_QUEUE_RECORDS_FILE}"
    [[ "${#QUEUE_RECORDS[@]}" -gt 0 ]] || return 0

    PARALLEL=$(command -v parallel 2>/dev/null)
    PARALLEL_MARKDOWN=""
    [[ "${MARKDOWN_COMMAND}" != "markdown" ]] && PARALLEL_MARKDOWN="${MARKDOWN_COMMAND}"
    if [[ "${#QUEUE_RECORDS[@]}" -gt 2 ]] && [[ "${JOBS:-1}" -gt 1 ]] && [[ "${PARALLEL:-}" != "" ]] && [[ "$(${PARALLEL} --version --no-notice 2>/dev/null | head -n 1 | grep -o 'GNU parallel')" == "GNU parallel" ]]; then
        CURRENT_ARCHIVE_PLAN_ROOT=""
        for QUEUE_RECORD in "${QUEUE_RECORDS[@]}"; do
            IFS=$'\037' read -r _ _ _ _ QUEUE_ARCHIVE_PLAN_ROOT QUEUE_RECORD_REST <<< "${QUEUE_RECORD}"
            [[ "${QUEUE_ARCHIVE_PLAN_ROOT}" != "" ]] || return 1
            [[ "${QUEUE_RECORD_REST}" == "" ]] || return 1
            if [[ "${CURRENT_ARCHIVE_PLAN_ROOT}" == "${QUEUE_ARCHIVE_PLAN_ROOT}" ]]; then
                continue
            fi
            CURRENT_ARCHIVE_PLAN_ROOT="${QUEUE_ARCHIVE_PLAN_ROOT}"
            TEMPLATE_OVERRIDES=()
            marsh_load_archive_plan_build_context \
                "${CURRENT_ARCHIVE_PLAN_ROOT}" \
                "BUILD_CONTEXT_TARGET_OUTPUT_REL" \
                "BUILD_CONTEXT_SOURCE_ROOT" \
                "TARGET_SITEMAP" \
                "TARGET_SITEMAP_SEARCH" \
                "TEMPLATES_DIR" \
                "TEMPLATE" \
                "TEMPLATE_ASSETS_PATH" \
                "TEMPLATE_OVERRIDES_TEXT" || return 1
            if [[ "${TEMPLATE_OVERRIDES_TEXT}" != "" ]]; then
                while IFS= read -r TEMPLATE_OVERRIDE; do
                    TEMPLATE_OVERRIDES+=("${TEMPLATE_OVERRIDE}")
                done <<< "${TEMPLATE_OVERRIDES_TEXT}"
            fi
            TARGET_OUTPUT_REL="${BUILD_CONTEXT_TARGET_OUTPUT_REL}"

            # pre-copy template assets once per archive plan before parallel workers start
            if [[ "${TEMPLATES_DIR}" != "" ]] && [[ "${TEMPLATE}" != "" ]]; then
                marsh_copy_template_assets "${SITE_OUTPUT_ROOT}" "${TARGET_OUTPUT_REL}" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}" "${TEMPLATES_DIR}" "${TEMPLATE}" "${#TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_ASSETS_PATH}" || return 1
            fi
        done

        if ! "${PARALLEL}" --halt now,fail=1 --quote --no-notice --jobs="${JOBS:-1}" "${SELF_DIR}/${SELF_NAME}" build-target-archive-queue-record --log-level="${LOG_LEVEL}" --markdown="${PARALLEL_MARKDOWN}" --markdown-options="${MARKDOWN_OPTIONS_CSV}" --markdown-document-extensions="${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" --markdown-document-extensions-replacement="${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" --remove-link-filenames="${REMOVE_LINK_FILENAMES_CSV}" --marsh-temp="${MARSH_TEMP}" --marsh-config-file="${MARSH_CONFIG_FILE}" --marsh-config-file-dir="${MARSH_CONFIG_FILE_DIR}" --marsh-config-path="${MARSH_CONFIG_PATH}" --marsh-config-url="${MARSH_CONFIG_URL}" "${SITE_OUTPUT_ROOT}" {} ::: "${QUEUE_RECORDS[@]}"; then
            return 1
        fi
        return 0
    fi

    CURRENT_ARCHIVE_PLAN_ROOT=""
    CURRENT_DOCUMENT_INDEX=0
    CURRENT_DOCUMENT_RECORDS=()
    for QUEUE_RECORD in "${QUEUE_RECORDS[@]}"; do
        IFS=$'\037' read -r QUEUE_DOCUMENT_ID QUEUE_SOURCE_RELPATH QUEUE_TARGET_OUTPUT_REL QUEUE_SOURCE_ROOT QUEUE_ARCHIVE_PLAN_ROOT QUEUE_RECORD_REST <<< "${QUEUE_RECORD}"
        [[ "${QUEUE_DOCUMENT_ID}" != "" ]] || continue
        [[ "${QUEUE_SOURCE_RELPATH}" != "" ]] || return 1
        [[ "${QUEUE_TARGET_OUTPUT_REL}" != "" ]] || return 1
        [[ "${QUEUE_SOURCE_ROOT}" != "" ]] || return 1
        [[ "${QUEUE_ARCHIVE_PLAN_ROOT}" != "" ]] || return 1
        [[ "${QUEUE_RECORD_REST}" == "" ]] || return 1

        if [[ "${CURRENT_ARCHIVE_PLAN_ROOT}" != "${QUEUE_ARCHIVE_PLAN_ROOT}" ]]; then
            CURRENT_ARCHIVE_PLAN_ROOT="${QUEUE_ARCHIVE_PLAN_ROOT}"
            CURRENT_DOCUMENT_INDEX=0
            CURRENT_DOCUMENT_RECORDS=()

            TEMPLATE_OVERRIDES=()
            marsh_load_archive_plan_build_context \
                "${CURRENT_ARCHIVE_PLAN_ROOT}" \
                "BUILD_CONTEXT_TARGET_OUTPUT_REL" \
                "BUILD_CONTEXT_SOURCE_ROOT" \
                "TARGET_SITEMAP" \
                "TARGET_SITEMAP_SEARCH" \
                "TEMPLATES_DIR" \
                "TEMPLATE" \
                "TEMPLATE_ASSETS_PATH" \
                "TEMPLATE_OVERRIDES_TEXT" || return 1
            if [[ "${TEMPLATE_OVERRIDES_TEXT}" != "" ]]; then
                while IFS= read -r TEMPLATE_OVERRIDE; do
                    TEMPLATE_OVERRIDES+=("${TEMPLATE_OVERRIDE}")
                done <<< "${TEMPLATE_OVERRIDES_TEXT}"
            fi
            TARGET_OUTPUT_REL="${BUILD_CONTEXT_TARGET_OUTPUT_REL}"

            DOCUMENTS_FILE="${CURRENT_ARCHIVE_PLAN_ROOT}/documents"
            [[ -f "${DOCUMENTS_FILE}" ]] && [[ -r "${DOCUMENTS_FILE}" ]] || {
                echo "Archive plan documents file not found: ${DOCUMENTS_FILE}" >&2
                return 1
            }
            while IFS= read -r DOCUMENT_RECORD; do
                [[ "${DOCUMENT_RECORD}" == "" ]] && continue
                CURRENT_DOCUMENT_RECORDS+=("${DOCUMENT_RECORD}")
            done < "${DOCUMENTS_FILE}"

            # copy assets once per archive plan before rendering that plan's queued records
            if [[ "${TEMPLATES_DIR}" != "" ]] && [[ "${TEMPLATE}" != "" ]]; then
                marsh_copy_template_assets "${SITE_OUTPUT_ROOT}" "${TARGET_OUTPUT_REL}" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}" "${TEMPLATES_DIR}" "${TEMPLATE}" "${#TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_ASSETS_PATH}" || return 1
            fi
        fi

        DOCUMENT_RECORD="${CURRENT_DOCUMENT_RECORDS[$CURRENT_DOCUMENT_INDEX]:-}"
        [[ "${DOCUMENT_RECORD}" != "" ]] || {
            echo "Archive queue record has no matching document record: ${QUEUE_DOCUMENT_ID}" >&2
            return 1
        }
        IFS=$'\037' read -r CURRENT_DOCUMENT_ID CURRENT_DOCUMENT_SOURCE_RELPATH CURRENT_DOCUMENT_TARGET_OUTPUT_REL CURRENT_DOCUMENT_SOURCE_ROOT CURRENT_DOCUMENT_RECORD_REST <<< "${DOCUMENT_RECORD}"
        [[ "${CURRENT_DOCUMENT_ID}" != "" ]] || return 1
        [[ "${CURRENT_DOCUMENT_SOURCE_RELPATH}" != "" ]] || return 1
        [[ "${CURRENT_DOCUMENT_TARGET_OUTPUT_REL}" != "" ]] || return 1
        [[ "${CURRENT_DOCUMENT_RECORD_REST}" == "" ]] || return 1

        # queue generation preserves document order within each archive plan
        if [[ "${CURRENT_DOCUMENT_ID}" != "${QUEUE_DOCUMENT_ID}" ]]; then
            echo "Archive queue record out of sync with archive plan documents: ${CURRENT_ARCHIVE_PLAN_ROOT}" >&2
            return 1
        fi

        marsh_build_planned_target_documents "${SITE_OUTPUT_ROOT}" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}" '1' "${TARGET_SITEMAP}" "${TARGET_SITEMAP_SEARCH}" "${TEMPLATES_DIR}" "${TEMPLATE}" "${MARKDOWN_COMMAND}" "${MARKDOWN_OPTIONS_CSV}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" "${REMOVE_LINK_FILENAMES_CSV}" "${#TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_ASSETS_PATH}" "${DOCUMENT_RECORD}" || return 1
        CURRENT_DOCUMENT_INDEX=$((CURRENT_DOCUMENT_INDEX + 1))
    done
}

# builds one aggregate archive-queue record from a document record and archive plan root
function marsh_build_target_archive_queue_record {  # marsh_build_target_archive_queue_record archive_plan_root document_record
    local ARCHIVE_PLAN_ROOT DOCUMENT_RECORD
    local DOCUMENT_ID SOURCE_RELPATH TARGET_OUTPUT_REL SOURCE_ROOT
    local RECORD_REST

    ARCHIVE_PLAN_ROOT="${1:-}"
    DOCUMENT_RECORD="${2:-}"
    [[ "${ARCHIVE_PLAN_ROOT}" == "" ]] && return 1
    [[ "${DOCUMENT_RECORD}" == "" ]] && return 1

    IFS=$'\037' read -r DOCUMENT_ID SOURCE_RELPATH TARGET_OUTPUT_REL SOURCE_ROOT RECORD_REST <<< "${DOCUMENT_RECORD}"
    [[ "${DOCUMENT_ID}" == "" ]] && return 1
    [[ "${SOURCE_RELPATH}" != "" ]] || return 1
    [[ "${TARGET_OUTPUT_REL}" != "" ]] || return 1
    [[ "${SOURCE_ROOT}" != "" ]] || return 1
    [[ "${RECORD_REST}" == "" ]] || return 1

    # keep document identity and archive-plan context explicit in the queue record
    marsh_validate_record_fields "queue record" "${DOCUMENT_ID}" "${SOURCE_RELPATH}" "${TARGET_OUTPUT_REL}" "${SOURCE_ROOT}" "${ARCHIVE_PLAN_ROOT}" || return 1
    printf '%s\037%s\037%s\037%s\037%s\n' \
        "${DOCUMENT_ID}" \
        "${SOURCE_RELPATH}" \
        "${TARGET_OUTPUT_REL}" \
        "${SOURCE_ROOT}" \
        "${ARCHIVE_PLAN_ROOT}"
}

