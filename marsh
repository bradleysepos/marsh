    shift 13
    [[ "${MARKDOWN_COMMAND}" == "" ]] && return 1
    [[ "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" == "" ]] && return 1
    NUM_TEMPLATE_OVERRIDES="${1:-0}"
    shift 1
    TEMPLATE_OVERRIDES=()
    while [[ "${NUM_TEMPLATE_OVERRIDES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        TEMPLATE_OVERRIDES+=("${1}")
        NUM_TEMPLATE_OVERRIDES=$((NUM_TEMPLATE_OVERRIDES - 1))
        shift 1
    done
    TEMPLATE_ASSETS_PATH="${1:-}"
    shift 1

    # first record establishes the shared target context for the batch
    # PLAN_CONTEXT_IDENTIFIED distinguishes the initial record from later validation
    TARGET_OUTPUT_REL=""
    SOURCE_ROOT=""
    PLAN_CONTEXT_IDENTIFIED=false
    DOCUMENTS=()
    while [[ "${#@}" -gt 0 ]]; do
        DOCUMENT_RECORD="${1:-}"
        shift 1
        [[ "${DOCUMENT_RECORD}" == "" ]] && continue
        IFS=$'\037' read -r DOCUMENT_ID SOURCE_RELPATH TARGET_OUTPUT_REL SOURCE_ROOT RECORD_REST <<< "${DOCUMENT_RECORD}"
        [[ "${DOCUMENT_ID}" == "" ]] && continue
        [[ "${SOURCE_RELPATH}" != "" ]] || return 1
        [[ "${RECORD_REST}" == "" ]] || return 1
        [[ "${DOCUMENT_ID}" == "" ]] && return 1
        [[ "${TARGET_OUTPUT_REL}" == "" ]] && return 1

        # consume one target-scoped document batch at a time
        # mixed target contexts should be split by the caller
        if [[ "${PLAN_CONTEXT_IDENTIFIED}" != true ]]; then
            PLAN_CONTEXT_IDENTIFIED=true
            PLAN_TARGET_OUTPUT_REL="${TARGET_OUTPUT_REL}"
            PLAN_SOURCE_ROOT="${SOURCE_ROOT}"
        else
            [[ "${PLAN_TARGET_OUTPUT_REL}" == "${TARGET_OUTPUT_REL}" ]] || return 1
            [[ "${PLAN_SOURCE_ROOT}" == "${SOURCE_ROOT}" ]] || return 1
        fi

        DOCUMENTS+=("${DOCUMENT_ID}")
    done

    [[ "${#DOCUMENTS[@]}" -gt 0 ]] || return 0
    marsh_build_target_documents "${SITE_OUTPUT_ROOT}" "${PLAN_TARGET_OUTPUT_REL}" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}" "${JOBS}" "${SITEMAP}" "${SITEMAP_SEARCH}" "${TEMPLATES_DIR}" "${TEMPLATE}" "${MARKDOWN_COMMAND}" "${MARKDOWN_OPTIONS_CSV}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" "${REMOVE_LINK_FILENAMES_CSV}" "${#TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_ASSETS_PATH}" "${PLAN_TARGET_OUTPUT_REL}" "${PLAN_SOURCE_ROOT}" "${DOCUMENTS[@]}"
