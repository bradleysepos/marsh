        fi

        # templates
        TEMPLATE_BASE_TEMPLATE=""
        if [[ -f "${TEMPLATE_BASE_FILE}" ]] && [[ -r "${TEMPLATE_BASE_FILE}" ]]; then
            TEMPLATE_BASE_TEMPLATE=$(<"${TEMPLATE_BASE_FILE}")
        fi
        TEMPLATE_BODY_TEMPLATE=""
        if [[ -f "${TEMPLATE_BODY_FILE}" ]] && [[ -r "${TEMPLATE_BODY_FILE}" ]]; then
            TEMPLATE_BODY_TEMPLATE=$(<"${TEMPLATE_BODY_FILE}")
        fi
        TEMPLATE_DOCUMENT_TEMPLATE=""
