            ARCHIVE_TEMPLATE_OVERRIDES+=("${ARCHIVE_TEMPLATE_OVERRIDE}")
        done < <(marsh_get_flatarray_values "${SOURCE_PREFIX}Archives_${II}_Template_Overrides_")

        OIFS="${IFS}"
        IFS="${SEP}"
        ARCHIVE_TYPES_JOINED="${ARCHIVE_TYPES[*]}"
        ARCHIVE_EXCLUDED_STATES_JOINED="${ARCHIVE_EXCLUDED_STATES[*]}"
        ARCHIVE_TEMPLATE_OVERRIDES_JOINED="${ARCHIVE_TEMPLATE_OVERRIDES[*]}"
        IFS="${OIFS}"

        ARCHIVE_TEMPLATE_VALUE=""
        if [[ "${!ARCHIVE_TEMPLATE_SOURCE_NAME:-}" != "" ]]; then
            ARCHIVE_TEMPLATE_VALUE=$(marsh_get_template_cache_name "${!ARCHIVE_TEMPLATE_SOURCE_NAME}") || return 1
        fi

        printf '%s\034%s\034%s\034%s\034%s\034%s\034%s\034%s\034%s\034%s\034%s\034%s\034%s\034%s\034%s\n' \
            "${!ARCHIVE_PATH_NAME}" \
            "${!ARCHIVE_ENCODING_NAME:-}" \
            "${!ARCHIVE_NAME_NAME:-}" \
            "${!ARCHIVE_LANGUAGE_NAME:-}" \
            "${!ARCHIVE_LANGUAGE_CODE_NAME:-}" \
            "${!ARCHIVE_ROOT_PATH_NAME:-}" \
            "${!ARCHIVE_COUNT_NAME:-}" \
            "${!ARCHIVE_PAGE_SIZE_NAME:-}" \
            "${!ARCHIVE_CONTENT_NAME:-}" \
            "${ARCHIVE_TYPES_JOINED}" \
            "${ARCHIVE_EXCLUDED_STATES_JOINED}" \
            "${!ARCHIVE_TEMPLATE_SOURCE_NAME:-}" \
            "${!ARCHIVE_TEMPLATE_ASSETS_PATH_NAME:-}" \
            "${ARCHIVE_TEMPLATE_OVERRIDES_JOINED}" \
            "${ARCHIVE_TEMPLATE_VALUE}"

        II=$((II + 1))
        ARCHIVE_PATH_NAME="${SOURCE_PREFIX}Archives_${II}_Path"
        ARCHIVE_ENCODING_NAME="${SOURCE_PREFIX}Archives_${II}_Encoding"
        ARCHIVE_NAME_NAME="${SOURCE_PREFIX}Archives_${II}_Name"
        ARCHIVE_LANGUAGE_NAME="${SOURCE_PREFIX}Archives_${II}_Language"
        ARCHIVE_LANGUAGE_CODE_NAME="${SOURCE_PREFIX}Archives_${II}_Language_Code"
        ARCHIVE_ROOT_PATH_NAME="${SOURCE_PREFIX}Archives_${II}_Root_Path"
        ARCHIVE_COUNT_NAME="${SOURCE_PREFIX}Archives_${II}_Count"
        ARCHIVE_PAGE_SIZE_NAME="${SOURCE_PREFIX}Archives_${II}_Page_Size"
        ARCHIVE_CONTENT_NAME="${SOURCE_PREFIX}Archives_${II}_Content"
        ARCHIVE_TEMPLATE_SOURCE_NAME="${SOURCE_PREFIX}Archives_${II}_Template_Source"
        ARCHIVE_TEMPLATE_ASSETS_PATH_NAME="${SOURCE_PREFIX}Archives_${II}_Template_Assets_Path"
    done

    return 0
}

# loads the archive planning metadata fields from document metadata cache
function marsh_load_archive_document_metadata {  # marsh_load_archive_document_metadata meta_cache_file type_var state_text_var
    local META_CACHE_FILE TYPE_VAR STATE_TEXT_VAR
    local METADATA_STATE_PREFIX METADATA_STATE_COUNT INDEX
    local KEY_VAR TYPE_ENTRY_VAR VALUE_VAR LIST_VAR
    local ENTRY_KEY ENTRY_TYPE
    local ARCHIVE_TYPE ARCHIVE_STATE_TEXT

    META_CACHE_FILE="${1:-}"
    TYPE_VAR="${2:-}"
    STATE_TEXT_VAR="${3:-}"
    [[ "${META_CACHE_FILE}" != "" ]] || return 1
    [[ "${TYPE_VAR}" != "" ]] || return 1
    [[ "${STATE_TEXT_VAR}" != "" ]] || return 1

    METADATA_STATE_PREFIX="MARSH_ARCHIVE_DOCUMENT_METADATA_STATE_"
    METADATA_STATE_COUNT=0
    marsh_load_document_metadata_state "${META_CACHE_FILE}" "${METADATA_STATE_PREFIX}" "METADATA_STATE_COUNT" || return 1

    ARCHIVE_TYPE=""
    ARCHIVE_STATE_TEXT=""
    INDEX=0
    while [[ "${INDEX}" -lt "${METADATA_STATE_COUNT}" ]]; do
        KEY_VAR="${METADATA_STATE_PREFIX}KEY_${INDEX}"
        TYPE_ENTRY_VAR="${METADATA_STATE_PREFIX}TYPE_${INDEX}"
        VALUE_VAR="${METADATA_STATE_PREFIX}VALUE_${INDEX}"
        LIST_VAR="${METADATA_STATE_PREFIX}LIST_${INDEX}"
        ENTRY_KEY="${!KEY_VAR}"
        ENTRY_TYPE="${!TYPE_ENTRY_VAR}"

        case "${ENTRY_KEY}" in
            Type)
                [[ "${ENTRY_TYPE}" == "value" ]] || return 1
                ARCHIVE_TYPE="${!VALUE_VAR}"
                ;;
            State)
                [[ "${ENTRY_TYPE}" == "list" ]] || [[ "${ENTRY_TYPE}" == "value" ]] || return 1
                if [[ "${ENTRY_TYPE}" == "list" ]]; then
                    ARCHIVE_STATE_TEXT="${!LIST_VAR}"
                else
                    ARCHIVE_STATE_TEXT=""
                fi
                ;;
        esac
        INDEX=$((INDEX + 1))
    done

    printf -v "${TYPE_VAR}" '%s' "${ARCHIVE_TYPE}"
    printf -v "${STATE_TEXT_VAR}" '%s' "${ARCHIVE_STATE_TEXT}"
}

# plans target archive page generation
function marsh_plan_archive_pages {  # marsh_plan_archive_pages target_output_root markdown_document_extensions_replacement remove_link_filenames_csv encoding archive_source archive_title language langcode count page_size #types[@] types[@] #excluded_states[@] excluded_states[@] archive_manifest archive_root_path templates_dir template sitemap sitemap_search #template_overrides[@] template_overrides[@] template_assets_path build_context_target_output_rel build_context_source_root
    local TARGET_OUTPUT_ROOT REMOVE_LINK_FILENAMES_CSV ENCODING ARCHIVE_SOURCE ARCHIVE_TITLE LANGUAGE LANGCODE COUNT PAGE_SIZE
    local NUM_TYPES NUM_EXCLUDED_STATES ARCHIVE_MANIFEST ARCHIVE_ROOT_PATH
    local TEMPLATES_DIR TEMPLATE TARGET_SITEMAP TARGET_SITEMAP_SEARCH
    local NUM_TEMPLATE_OVERRIDES TEMPLATE_ASSETS_PATH BUILD_CONTEXT_TARGET_OUTPUT_REL BUILD_CONTEXT_SOURCE_ROOT
    local TARGET_PLAN_ROOT ARCHIVE_PLANS_ROOT ARCHIVE_PLAN_ROOT CONTEXT_FILE DOCUMENTS_FILE DOCUMENTS_TEMP
    local GENERATED_ARCHIVES GENERATED_ARCHIVE
    local -a TYPES EXCLUDED_STATES TEMPLATE_OVERRIDES

    # init
    # unpack archive selection, archive rendering, and archive template context
    TARGET_OUTPUT_ROOT="${1:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT="${2:-}"
    REMOVE_LINK_FILENAMES_CSV="${3:-}"
    ENCODING="${4:-}"
    ARCHIVE_SOURCE="${5:-}"
    ARCHIVE_TITLE="${6:-}"
    LANGUAGE="${7:-}"
    LANGCODE="${8:-}"
    COUNT="${9:-}"
    PAGE_SIZE="${10:-}"
    shift 10
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${ARCHIVE_SOURCE}" == "" ]] && return 1
    NUM_TYPES="${1:-0}"
    shift 1
    TYPES=()
    while [[ "${NUM_TYPES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        TYPES+=("${1}")
        NUM_TYPES=$((NUM_TYPES - 1))
        shift 1
    done
    NUM_EXCLUDED_STATES="${1:-0}"
    shift 1
    EXCLUDED_STATES=()
    while [[ "${NUM_EXCLUDED_STATES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        EXCLUDED_STATES+=("${1}")
        NUM_EXCLUDED_STATES=$((NUM_EXCLUDED_STATES - 1))
        shift 1
    done
    ARCHIVE_MANIFEST="${1:-}"
    ARCHIVE_ROOT_PATH="${2:-}"
    TEMPLATES_DIR="${3:-}"
    TEMPLATE="${4:-}"
    TARGET_SITEMAP="${5:-}"
    TARGET_SITEMAP_SEARCH="${6:-false}"
    shift 6
    NUM_TEMPLATE_OVERRIDES="${1:-0}"
    shift 1
    TEMPLATE_OVERRIDES=()
    while [[ "${NUM_TEMPLATE_OVERRIDES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        TEMPLATE_OVERRIDES+=("${1}")
        NUM_TEMPLATE_OVERRIDES=$((NUM_TEMPLATE_OVERRIDES - 1))
        shift 1
    done
    TEMPLATE_ASSETS_PATH="${1:-}"
    BUILD_CONTEXT_TARGET_OUTPUT_REL="${2:-.}"
    BUILD_CONTEXT_SOURCE_ROOT="${3:-}"

    # persist archive plans under the target plan root so that the archive executor can consume them
    TARGET_OUTPUT_ROOT=$(marsh_get_target_directory_path "${TARGET_OUTPUT_ROOT}") || return 1
    TARGET_PLAN_ROOT=$(marsh_get_target_plan_root "${TARGET_OUTPUT_ROOT}") || return 1
    ARCHIVE_PLANS_ROOT="${TARGET_PLAN_ROOT}/archives"
    mkdir -p "${ARCHIVE_PLANS_ROOT}" >/dev/null 2>&1 || {
        echo "Unable to create archive plans path: ${ARCHIVE_PLANS_ROOT}" >&2
        return 1
    }
    ARCHIVE_PLAN_ROOT=$(mktemp -d "${ARCHIVE_PLANS_ROOT}/archive-XXXXXX") || {
        echo "Unable to create archive plan path: ${ARCHIVE_PLANS_ROOT}/archive-XXXXXX" >&2
        return 1
    }

    # reuse archive generation to materialize synthetic archive sources first,
    # then capture the generated archive document ids as explicit planned work
    GENERATED_ARCHIVES=$(marsh_build_archive \
        "${TARGET_OUTPUT_ROOT}" \
        "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" \
        "${REMOVE_LINK_FILENAMES_CSV}" \
        "${ENCODING}" \
        "${ARCHIVE_SOURCE}" \
        "${ARCHIVE_TITLE}" \
        "${LANGUAGE}" \
        "${LANGCODE}" \
        "${COUNT}" \
        "${PAGE_SIZE}" \
        "${#TYPES[@]}" \
        "${TYPES[@]}" \
        "${#EXCLUDED_STATES[@]}" \
        "${EXCLUDED_STATES[@]}" \
        "${ARCHIVE_MANIFEST}" \
        "${ARCHIVE_ROOT_PATH}" \
        "${REMOVE_LINK_FILENAMES_CSV}") || {
            rm -rf "${ARCHIVE_PLAN_ROOT}"
            return 1
        }

    # store the target-scoped rendering context
    CONTEXT_FILE="${ARCHIVE_PLAN_ROOT}/context"
    marsh_write_archive_plan_context \
        "${CONTEXT_FILE}" \
        "${BUILD_CONTEXT_TARGET_OUTPUT_REL}" \
        "${BUILD_CONTEXT_SOURCE_ROOT}" \
        "${TARGET_SITEMAP}" \
        "${TARGET_SITEMAP_SEARCH}" \
        "${TEMPLATES_DIR}" \
        "${TEMPLATE}" \
        "${#TEMPLATE_OVERRIDES[@]}" \
        "${TEMPLATE_OVERRIDES[@]}" \
        "${TEMPLATE_ASSETS_PATH}" || {
        rm -rf "${ARCHIVE_PLAN_ROOT}"
        return 1
    }

    # record each generated archive source as a document plan record so
    # archive rendering can reuse the planned document executor
    DOCUMENTS_FILE="${ARCHIVE_PLAN_ROOT}/documents"
    DOCUMENTS_TEMP=$(mktemp "${ARCHIVE_PLAN_ROOT}/documents-XXXXXX") || {
        rm -rf "${ARCHIVE_PLAN_ROOT}"
        return 1
    }
    while IFS= read -r GENERATED_ARCHIVE; do
        [[ "${GENERATED_ARCHIVE}" == "" ]] && continue
        marsh_validate_record_fields "document record" "${GENERATED_ARCHIVE}" "${GENERATED_ARCHIVE}" "${BUILD_CONTEXT_TARGET_OUTPUT_REL}" "${BUILD_CONTEXT_SOURCE_ROOT}" || {
            rm -f "${DOCUMENTS_TEMP}"
            rm -rf "${ARCHIVE_PLAN_ROOT}"
            return 1
        }
        printf '%s\037%s\037%s\037%s\n' "${GENERATED_ARCHIVE}" "${GENERATED_ARCHIVE}" "${BUILD_CONTEXT_TARGET_OUTPUT_REL}" "${BUILD_CONTEXT_SOURCE_ROOT}"
    done <<< "${GENERATED_ARCHIVES}" > "${DOCUMENTS_TEMP}" || {
        rm -f "${DOCUMENTS_TEMP}"
        rm -rf "${ARCHIVE_PLAN_ROOT}"
        return 1
    }
    mv "${DOCUMENTS_TEMP}" "${DOCUMENTS_FILE}" 2>/dev/null || {
        rm -f "${DOCUMENTS_TEMP}"
        rm -rf "${ARCHIVE_PLAN_ROOT}"
        return 1
    }

    printf '%s\n' "${ARCHIVE_PLAN_ROOT}"
}

