# derives a stable cached template name from a template source path
function marsh_get_template_cache_name {  # marsh_get_template_cache_name template_source
    local TEMPLATE_SOURCE TEMPLATE_NAME TEMPLATE_KEY

    # init
    TEMPLATE_SOURCE="${1:-}"
    [[ "${TEMPLATE_SOURCE}" == "" ]] && return 1
    TEMPLATE_SOURCE="${TEMPLATE_SOURCE%/}"

    # combine the readable basename with the full source path for uniqueness
    TEMPLATE_NAME="${TEMPLATE_SOURCE##*/}"
    [[ "${TEMPLATE_NAME}" != "" ]] || TEMPLATE_NAME='template'
    TEMPLATE_KEY=$(printf '%s\n' "${TEMPLATE_NAME}" "${TEMPLATE_SOURCE}" | marsh_text_transform hash:md5) || return 1
    printf '%s\n' "${TEMPLATE_KEY}"
}

# returns the cached template path, creating it when needed
function marsh_get_template_cache_path {  # marsh_get_template_cache_path templates_dir template template_source
    local TEMPLATES_DIR TEMPLATE TEMPLATE_SOURCE TEMPLATE_CACHE_PATH

    TEMPLATES_DIR="${1:-}"
    TEMPLATE="${2:-}"
    TEMPLATE_SOURCE="${3:-}"
    [[ "${TEMPLATES_DIR}" == "" ]] && return 1
    [[ "${TEMPLATE}" == "" ]] && return 1
    [[ "${TEMPLATE_SOURCE}" == "" ]] && return 1
    TEMPLATE_CACHE_PATH="${TEMPLATES_DIR}/${TEMPLATE}"

    if [[ ! -e "${TEMPLATE_CACHE_PATH}" ]]; then
        marsh_copy_files "${TEMPLATE_SOURCE}/*" \
                "${TEMPLATE_CACHE_PATH}" \
                false || return 1
    fi

    [[ -e "${TEMPLATE_CACHE_PATH}" ]] || {
        echo "Template cache path not found after copy: ${TEMPLATE_CACHE_PATH}" >&2
        return 1
    }
    printf '%s\n' "${TEMPLATE_CACHE_PATH}"
}

# loads cached template metadata assignments where available
function marsh_get_template_metadata {  # marsh_get_template_metadata prefix template_dir #template_overrides[@] template_overrides[@]
    local PREFIX TEMPLATE_DIR NUM_TEMPLATE_OVERRIDES
    local CACHE_DIR CACHE_FILE CACHE_TEMP TEMPLATE_META
    local -a TEMPLATE_OVERRIDES

    # init
    PREFIX="${1:-}"
    TEMPLATE_DIR="${2:-}"
    [[ "${TEMPLATE_DIR}" == "" ]] && return 1
    shift 2
    NUM_TEMPLATE_OVERRIDES="${1:-0}"
    shift 1
    TEMPLATE_OVERRIDES=()
    while [[ "${NUM_TEMPLATE_OVERRIDES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        TEMPLATE_OVERRIDES+=("${1}")
        NUM_TEMPLATE_OVERRIDES=$((NUM_TEMPLATE_OVERRIDES - 1))
        shift 1
    done

    # create temporary directory
    CACHE_DIR="${MARSH_TEMP}/template-metadata-cache"
    mkdir -p "${CACHE_DIR}" >/dev/null 2>&1 || {
        echo "Unable to create template metadata cache directory: ${CACHE_DIR}" >&2
        return 1
    }

    # generate cache file path
    CACHE_FILE=$(marsh_get_cache_path "${CACHE_DIR}" ".meta" "$(printf '%s\034' "${PREFIX}" "${TEMPLATE_DIR}" "${TEMPLATE_OVERRIDES[@]}")") || return 1

    # use existing cache if available
    if [[ -f "${CACHE_FILE}" ]] && [[ -r "${CACHE_FILE}" ]]; then
        cat "${CACHE_FILE}" || {
            echo "Unable to read template metadata cache file: ${CACHE_FILE}" >&2
            return 1
        }
        return 0
    fi

    # no existing cache, proceed to generate it
    # acquire lock for cache file creation
    if ! marsh_lock_acquire "${CACHE_FILE}" 2>/dev/null; then
        # unable to acquire lock, likely due to another process generating the metadata
        # wait a while for the lock to be released and attempt to use the cache file if it exists
        if marsh_lock_wait "${CACHE_FILE}" 2>/dev/null; then
            # lock released, use existing cache if available
            if [[ -f "${CACHE_FILE}" ]] && [[ -r "${CACHE_FILE}" ]]; then
                cat "${CACHE_FILE}" || {
                    echo "Unable to read template metadata cache file: ${CACHE_FILE}" >&2
                    return 1
                }
                return 0
            else
                # fail fast when the first writer releases the lock without publishing
                # lock ownership is not retried because a write failure aborts the whole build
                echo "Template metadata cache file missing after lock wait: ${CACHE_FILE}" >&2
                return 1
            fi
        else
            # error on timeout waiting for lock to be released
            echo "Unable to acquire template metadata cache lock: ${CACHE_FILE}" >&2
            return 1
        fi
    else
        # lock acquired, proceed generating and caching metadata
        # generate temporary cache file in lock directory
        CACHE_TEMP=$(marsh_lock_get_directory "${CACHE_FILE}")
        CACHE_TEMP="${CACHE_TEMP}/tempfile"
        TEMPLATE_META=$(marsh_parse_template_metadata "${PREFIX}" "${TEMPLATE_DIR}" "${#TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_OVERRIDES[@]}")
        [[ $? -ne 0 ]] && {
            echo "Unable to parse template metadata for caching: ${TEMPLATE_DIR}" >&2
            rm -f "${CACHE_TEMP}"
            marsh_lock_release "${CACHE_FILE}"
            return 1
        }
        printf '%s\n' "${TEMPLATE_META}" > "${CACHE_TEMP}" 2>/dev/null || {
            echo "Unable to write template metadata cache file: ${CACHE_TEMP}" >&2
            rm -f "${CACHE_TEMP}"
            marsh_lock_release "${CACHE_FILE}"
            return 1
        }

        # move temporary cache file into place as shared cache file
        mv "${CACHE_TEMP}" "${CACHE_FILE}" 2>/dev/null || {
            echo "Unable to write template metadata cache file: ${CACHE_FILE}" >&2
            rm -f "${CACHE_TEMP}"
            marsh_lock_release "${CACHE_FILE}"
            return 1
        }

        # output cache file contents and release lock
        cat "${CACHE_FILE}" 2>/dev/null || {
            echo "Unable to read template metadata cache file: ${CACHE_FILE}" >&2
            marsh_lock_release "${CACHE_FILE}"
            return 1
        }
        marsh_lock_release "${CACHE_FILE}" || {
            echo "Unable to release template metadata cache lock: ${CACHE_FILE}" >&2
            return 1
        }
        return 0
    fi
}

# returns success when a normalized key collides with a reserved document.* metadata key
function marsh_is_reserved_document_template_tag {  # marsh_is_reserved_document_template_tag normalized_key
    local NORMALIZED_KEY

    NORMALIZED_KEY="${1:-}"
    [[ "${NORMALIZED_KEY}" != "" ]] || return 1

    if marsh_is_reserved_archive_page_template_tag "${NORMALIZED_KEY}"; then
        return 0
    fi

    case "${NORMALIZED_KEY}" in
        href | \
        uri | \
        content)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# returns success when a normalized key collides with a reserved archive-specific document.* metadata key
function marsh_is_reserved_archive_page_template_tag {  # marsh_is_reserved_archive_page_template_tag normalized_key
    local NORMALIZED_KEY

    NORMALIZED_KEY="${1:-}"
    [[ "${NORMALIZED_KEY}" != "" ]] || return 1

    case "${NORMALIZED_KEY}" in
        page-canonical-uri | \
        page-canonical-href | \
        page-first-uri | \
        page-first-href | \
        page-prev-uri | \
        page-prev-href | \
        page-next-uri | \
        page-next-href | \
        page-last-uri | \
        page-last-href)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# loads grouped template asset lists from loaded template metadata state
function marsh_load_template_asset_lists_from_metadata_state {  # marsh_load_template_asset_lists_from_metadata_state state_prefix state_count out_fonts_var out_styles_var out_scripts_var out_images_var out_audio_var out_video_var out_documents_var out_binaries_var out_other_var
    local STATE_PREFIX STATE_COUNT
    local OUT_FONTS_VAR OUT_STYLES_VAR OUT_SCRIPTS_VAR OUT_IMAGES_VAR OUT_AUDIO_VAR OUT_VIDEO_VAR OUT_DOCUMENTS_VAR OUT_BINARIES_VAR OUT_OTHER_VAR
    local INDEX KEY_VAR TYPE_VAR LIST_VAR ENTRY_KEY ENTRY_TYPE ENTRY_LIST ENTRY_ITEM
    local FONTS_TEXT STYLES_TEXT SCRIPTS_TEXT IMAGES_TEXT AUDIO_TEXT VIDEO_TEXT DOCUMENTS_TEXT BINARIES_TEXT OTHER_TEXT

    STATE_PREFIX="${1:-}"
    STATE_COUNT="${2:-}"
    OUT_FONTS_VAR="${3:-}"
    OUT_STYLES_VAR="${4:-}"
    OUT_SCRIPTS_VAR="${5:-}"
    OUT_IMAGES_VAR="${6:-}"
    OUT_AUDIO_VAR="${7:-}"
    OUT_VIDEO_VAR="${8:-}"
    OUT_DOCUMENTS_VAR="${9:-}"
    OUT_BINARIES_VAR="${10:-}"
    OUT_OTHER_VAR="${11:-}"
    [[ "${STATE_PREFIX}" != "" ]] || return 1
    [[ "${STATE_COUNT}" =~ ^[0-9]+$ ]] || return 1
    [[ "${OUT_FONTS_VAR}" != "" ]] || return 1
    [[ "${OUT_STYLES_VAR}" != "" ]] || return 1
    [[ "${OUT_SCRIPTS_VAR}" != "" ]] || return 1
    [[ "${OUT_IMAGES_VAR}" != "" ]] || return 1
    [[ "${OUT_AUDIO_VAR}" != "" ]] || return 1
    [[ "${OUT_VIDEO_VAR}" != "" ]] || return 1
    [[ "${OUT_DOCUMENTS_VAR}" != "" ]] || return 1
    [[ "${OUT_BINARIES_VAR}" != "" ]] || return 1
    [[ "${OUT_OTHER_VAR}" != "" ]] || return 1

    FONTS_TEXT=""
    STYLES_TEXT=""
    SCRIPTS_TEXT=""
    IMAGES_TEXT=""
    AUDIO_TEXT=""
    VIDEO_TEXT=""
    DOCUMENTS_TEXT=""
    BINARIES_TEXT=""
    OTHER_TEXT=""
    INDEX=0
    while [[ "${INDEX}" -lt "${STATE_COUNT}" ]]; do
        KEY_VAR="${STATE_PREFIX}KEY_${INDEX}"
        TYPE_VAR="${STATE_PREFIX}TYPE_${INDEX}"
        LIST_VAR="${STATE_PREFIX}LIST_${INDEX}"
        ENTRY_KEY="${!KEY_VAR}"
        ENTRY_TYPE="${!TYPE_VAR}"
        ENTRY_LIST="${!LIST_VAR}"

        case "${ENTRY_KEY}" in
            TEMPLATE_ASSETS_FONTS|TEMPLATE_ASSETS_STYLES|TEMPLATE_ASSETS_SCRIPTS|TEMPLATE_ASSETS_IMAGES|TEMPLATE_ASSETS_AUDIO|TEMPLATE_ASSETS_VIDEO|TEMPLATE_ASSETS_DOCUMENTS|TEMPLATE_ASSETS_BINARIES|TEMPLATE_ASSETS_OTHER)
                [[ "${ENTRY_TYPE}" == "list" ]] || return 1
                while IFS= read -r ENTRY_ITEM; do
                    [[ "${ENTRY_ITEM}" == "" ]] && continue
                    case "${ENTRY_KEY}" in
                        TEMPLATE_ASSETS_FONTS)
                            [[ "${FONTS_TEXT}" == "" ]] || FONTS_TEXT+=$'\n'
                            FONTS_TEXT+="${ENTRY_ITEM}"
                            ;;
                        TEMPLATE_ASSETS_STYLES)
                            [[ "${STYLES_TEXT}" == "" ]] || STYLES_TEXT+=$'\n'
                            STYLES_TEXT+="${ENTRY_ITEM}"
                            ;;
                        TEMPLATE_ASSETS_SCRIPTS)
                            [[ "${SCRIPTS_TEXT}" == "" ]] || SCRIPTS_TEXT+=$'\n'
                            SCRIPTS_TEXT+="${ENTRY_ITEM}"
                            ;;
                        TEMPLATE_ASSETS_IMAGES)
                            [[ "${IMAGES_TEXT}" == "" ]] || IMAGES_TEXT+=$'\n'
                            IMAGES_TEXT+="${ENTRY_ITEM}"
                            ;;
                        TEMPLATE_ASSETS_AUDIO)
                            [[ "${AUDIO_TEXT}" == "" ]] || AUDIO_TEXT+=$'\n'
                            AUDIO_TEXT+="${ENTRY_ITEM}"
                            ;;
                        TEMPLATE_ASSETS_VIDEO)
                            [[ "${VIDEO_TEXT}" == "" ]] || VIDEO_TEXT+=$'\n'
                            VIDEO_TEXT+="${ENTRY_ITEM}"
                            ;;
                        TEMPLATE_ASSETS_DOCUMENTS)
                            [[ "${DOCUMENTS_TEXT}" == "" ]] || DOCUMENTS_TEXT+=$'\n'
                            DOCUMENTS_TEXT+="${ENTRY_ITEM}"
                            ;;
                        TEMPLATE_ASSETS_BINARIES)
                            [[ "${BINARIES_TEXT}" == "" ]] || BINARIES_TEXT+=$'\n'
                            BINARIES_TEXT+="${ENTRY_ITEM}"
                            ;;
                        TEMPLATE_ASSETS_OTHER)
                            [[ "${OTHER_TEXT}" == "" ]] || OTHER_TEXT+=$'\n'
                            OTHER_TEXT+="${ENTRY_ITEM}"
                            ;;
                    esac
                done <<< "${ENTRY_LIST}"
                ;;
        esac
        INDEX=$((INDEX + 1))
    done

    printf -v "${OUT_FONTS_VAR}" '%s' "${FONTS_TEXT}"
    printf -v "${OUT_STYLES_VAR}" '%s' "${STYLES_TEXT}"
    printf -v "${OUT_SCRIPTS_VAR}" '%s' "${SCRIPTS_TEXT}"
    printf -v "${OUT_IMAGES_VAR}" '%s' "${IMAGES_TEXT}"
    printf -v "${OUT_AUDIO_VAR}" '%s' "${AUDIO_TEXT}"
    printf -v "${OUT_VIDEO_VAR}" '%s' "${VIDEO_TEXT}"
    printf -v "${OUT_DOCUMENTS_VAR}" '%s' "${DOCUMENTS_TEXT}"
    printf -v "${OUT_BINARIES_VAR}" '%s' "${BINARIES_TEXT}"
    printf -v "${OUT_OTHER_VAR}" '%s' "${OTHER_TEXT}"
}

# loads template metadata output into caller-owned flat state
function marsh_load_template_metadata_state {  # marsh_load_template_metadata_state template_metadata_text state_prefix out_count_var
    local TEMPLATE_METADATA_TEXT STATE_PREFIX OUT_COUNT_VAR ASSIGNMENT_LINE
    local ENTRY_NAME ENTRY_TYPE ENTRY_VALUE
    local CURRENT_KEY CURRENT_TYPE CURRENT_VALUE CURRENT_LIST
    local CURRENT_HAS_VALUE CURRENT_HAS_LIST_ROOT CURRENT_HAS_LIST_ITEMS ENTRY_COUNT

    TEMPLATE_METADATA_TEXT="${1-}"
    STATE_PREFIX="${2:-}"
    OUT_COUNT_VAR="${3:-}"
    [[ "${STATE_PREFIX}" != "" ]] || return 1
    [[ "${OUT_COUNT_VAR}" != "" ]] || return 1
    [[ "${STATE_PREFIX}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || return 1
    [[ "${OUT_COUNT_VAR}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || return 1

    CURRENT_KEY=""
    CURRENT_TYPE=""
    CURRENT_VALUE=""
    CURRENT_LIST=""
    CURRENT_HAS_VALUE=false
    CURRENT_HAS_LIST_ROOT=false
    CURRENT_HAS_LIST_ITEMS=false
    ENTRY_COUNT=0

    while IFS= read -r ASSIGNMENT_LINE || [[ "${ASSIGNMENT_LINE}" != "" ]]; do
        [[ "${ASSIGNMENT_LINE}" != "" ]] || continue

        ENTRY_NAME=""
        ENTRY_TYPE=""
        ENTRY_VALUE=""
        marsh_parse_template_metadata_assignment "${ASSIGNMENT_LINE}" "ENTRY_NAME" "ENTRY_TYPE" "ENTRY_VALUE" || return 1

        if [[ "${CURRENT_KEY}" != "" ]] && [[ "${ENTRY_NAME}" != "${CURRENT_KEY}" ]]; then
            printf -v "${STATE_PREFIX}KEY_${ENTRY_COUNT}" '%s' "${CURRENT_KEY}"
            printf -v "${STATE_PREFIX}TYPE_${ENTRY_COUNT}" '%s' "${CURRENT_TYPE}"
            printf -v "${STATE_PREFIX}VALUE_${ENTRY_COUNT}" '%s' "${CURRENT_VALUE}"
            printf -v "${STATE_PREFIX}LIST_${ENTRY_COUNT}" '%s' "${CURRENT_LIST}"
            ENTRY_COUNT=$((ENTRY_COUNT + 1))

            CURRENT_KEY=""
            CURRENT_TYPE=""
            CURRENT_VALUE=""
            CURRENT_LIST=""
            CURRENT_HAS_VALUE=false
            CURRENT_HAS_LIST_ROOT=false
            CURRENT_HAS_LIST_ITEMS=false
        fi

        if [[ "${CURRENT_KEY}" == "" ]]; then
            CURRENT_KEY="${ENTRY_NAME}"
            CURRENT_TYPE=""
            CURRENT_VALUE=""
            CURRENT_LIST=""
            CURRENT_HAS_VALUE=false
            CURRENT_HAS_LIST_ROOT=false
            CURRENT_HAS_LIST_ITEMS=false
        fi

        case "${ENTRY_TYPE}" in
            value)
                if [[ "${CURRENT_HAS_VALUE}" == true ]] || [[ "${CURRENT_HAS_LIST_ROOT}" == true ]] || [[ "${CURRENT_HAS_LIST_ITEMS}" == true ]]; then
                    echo "Malformed template metadata assignment sequence: ${CURRENT_KEY}" >&2
                    return 1
                fi
                CURRENT_TYPE='value'
                CURRENT_VALUE="${ENTRY_VALUE}"
                CURRENT_HAS_VALUE=true
                ;;
            list-root)
                if [[ "${CURRENT_HAS_VALUE}" == true ]] || [[ "${CURRENT_HAS_LIST_ROOT}" == true ]] || [[ "${CURRENT_HAS_LIST_ITEMS}" == true ]]; then
                    echo "Malformed template metadata assignment sequence: ${CURRENT_KEY}" >&2
                    return 1
                fi
                CURRENT_TYPE='list'
                CURRENT_HAS_LIST_ROOT=true
                ;;
            list-item)
                if [[ "${CURRENT_HAS_VALUE}" == true ]] || [[ "${CURRENT_HAS_LIST_ROOT}" != true ]] && [[ "${CURRENT_HAS_LIST_ITEMS}" != true ]]; then
                    echo "Malformed template metadata assignment sequence: ${CURRENT_KEY}" >&2
                    return 1
                fi
                CURRENT_TYPE='list'
                [[ "${CURRENT_LIST}" == "" ]] || CURRENT_LIST+=$'\n'
                CURRENT_LIST+="${ENTRY_VALUE}"
                CURRENT_HAS_LIST_ITEMS=true
                ;;
            *)
                return 1
                ;;
        esac
    done <<< "${TEMPLATE_METADATA_TEXT}"

    if [[ "${CURRENT_KEY}" != "" ]]; then
        printf -v "${STATE_PREFIX}KEY_${ENTRY_COUNT}" '%s' "${CURRENT_KEY}"
        printf -v "${STATE_PREFIX}TYPE_${ENTRY_COUNT}" '%s' "${CURRENT_TYPE}"
        printf -v "${STATE_PREFIX}VALUE_${ENTRY_COUNT}" '%s' "${CURRENT_VALUE}"
        printf -v "${STATE_PREFIX}LIST_${ENTRY_COUNT}" '%s' "${CURRENT_LIST}"
        ENTRY_COUNT=$((ENTRY_COUNT + 1))
    fi

    printf -v "${OUT_COUNT_VAR}" '%s' "${ENTRY_COUNT}"
}

# prints bash variable assignments for template metadata
function marsh_parse_template_metadata {  # marsh_parse_template_metadata prefix template_dir #template_overrides[@] template_overrides[@]
    local PREFIX TEMPLATE_DIR NUM_TEMPLATE_OVERRIDES TEMPLATE_OVERRIDE
    local TEMPLATE_META TEMPLATE_LOOKUP_VALUE TEMPLATE_PARSED_YAML_STATE_COUNT PARTIAL_OUTPUT_NAME
    local INDEX ASSET_TYPE ASSET_TYPE_UPPER ASSET FILTER_INDEX REGEX EXTENDED MATCH REPLACE EXTRA I
    local ASSETS_INDEX ASSETS_TYPE ASSET_TEXT_VAR ASSETS_TEXT ASSETS_UPDATED_TEXT
    local STATE_INDEX STATE_KEY_VAR STATE_VALUE_VAR STATE_KEY STATE_VALUE
    local PARTIAL_VALUE_VAR ASSET_ENTRY_VAR FILTER_REGEX_VAR FILTER_EXTENDED_VAR FILTER_ASSET_TYPE_VAR
    local TEMPLATE_ASSETS_FONTS_TEXT TEMPLATE_ASSETS_STYLES_TEXT TEMPLATE_ASSETS_SCRIPTS_TEXT TEMPLATE_ASSETS_IMAGES_TEXT
    local TEMPLATE_ASSETS_AUDIO_TEXT TEMPLATE_ASSETS_VIDEO_TEXT TEMPLATE_ASSETS_DOCUMENTS_TEXT TEMPLATE_ASSETS_BINARIES_TEXT TEMPLATE_ASSETS_OTHER_TEXT
    local -a TEMPLATE_OVERRIDES ASSET_TYPES ASSETS_TEMP TEMPLATE_PARTIAL_KEYS

    # init
    PREFIX="${1:-}"
    TEMPLATE_DIR="${2:-}"
    [[ "${TEMPLATE_DIR}" == "" ]] && return 1
    shift 2
    NUM_TEMPLATE_OVERRIDES="${1:-0}"
    shift 1
    TEMPLATE_OVERRIDES=()
    while [[ "${NUM_TEMPLATE_OVERRIDES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        TEMPLATE_OVERRIDES+=("${1}")
        NUM_TEMPLATE_OVERRIDES=$((NUM_TEMPLATE_OVERRIDES - 1))
        shift 1
    done

    # load config
    if [[ -f "${TEMPLATE_DIR}/marsh-template.yaml" ]] && [[ -r "${TEMPLATE_DIR}/marsh-template.yaml" ]]; then
        TEMPLATE_META=$(marsh_parse_yaml "MARSH_TEMPLATE" < "${TEMPLATE_DIR}/marsh-template.yaml")
        [[ $? -ne 0 ]] && echo "Unable to parse yaml file: ${TEMPLATE_DIR}/marsh-template.yaml" >&2 && return 1
    else
        echo "Template configuration file not found: ${TEMPLATE_DIR}/marsh-template.yaml" >&2
        return 1
    fi
    for TEMPLATE_OVERRIDE in "${TEMPLATE_OVERRIDES[@]}"; do
        [[ "${TEMPLATE_OVERRIDE}" == "" ]] && continue
        if [[ -f "${TEMPLATE_OVERRIDE}" ]] && [[ -r "${TEMPLATE_OVERRIDE}" ]]; then
            TEMPLATE_LOOKUP_VALUE=$(marsh_parse_yaml "MARSH_TEMPLATE" < "${TEMPLATE_OVERRIDE}")
            [[ $? -ne 0 ]] && echo "Unable to parse yaml file: ${TEMPLATE_OVERRIDE}" >&2 && return 1
            [[ "${TEMPLATE_META}" == "" ]] || TEMPLATE_META+=$'\n'
            TEMPLATE_META+="${TEMPLATE_LOOKUP_VALUE}"
        else
            echo "Template configuration override file not found: ${TEMPLATE_OVERRIDE}" >&2
            return 1
        fi
    done
    TEMPLATE_PARSED_YAML_STATE_COUNT=0
    marsh_load_parsed_yaml_state "${TEMPLATE_META}" "MARSH_TEMPLATE_STATE_" "TEMPLATE_PARSED_YAML_STATE_COUNT" || return 1

    # materialize resolved partial values, asset entries, and filter fields in one pass
    TEMPLATE_PARTIAL_KEYS=(
        'MARSH_TEMPLATE_Template_Partials_Base'
        'MARSH_TEMPLATE_Template_Partials_Head'
        'MARSH_TEMPLATE_Template_Partials_Body'
        'MARSH_TEMPLATE_Template_Partials_Document'
        'MARSH_TEMPLATE_Template_Partials_Header'
        'MARSH_TEMPLATE_Template_Partials_Nav'
        'MARSH_TEMPLATE_Template_Partials_Notice'
        'MARSH_TEMPLATE_Template_Partials_Footer'
        'MARSH_TEMPLATE_Template_Partials_Redirect'
        'MARSH_TEMPLATE_Template_Partials_Archive_HTML_Base'
        'MARSH_TEMPLATE_Template_Partials_Archive_HTML_Head'
        'MARSH_TEMPLATE_Template_Partials_Archive_HTML_Body'
        'MARSH_TEMPLATE_Template_Partials_Archive_HTML_Document'
        'MARSH_TEMPLATE_Template_Partials_Archive_HTML_Header'
        'MARSH_TEMPLATE_Template_Partials_Archive_HTML_Nav'
        'MARSH_TEMPLATE_Template_Partials_Archive_HTML_Notice'
        'MARSH_TEMPLATE_Template_Partials_Archive_HTML_Footer'
        'MARSH_TEMPLATE_Template_Partials_Archive_Atom_Base'
        'MARSH_TEMPLATE_Template_Partials_Archive_Atom_Body'
        'MARSH_TEMPLATE_Template_Partials_Archive_Atom_Document'
        'MARSH_TEMPLATE_Template_Partials_Archive_JSON_Base'
        'MARSH_TEMPLATE_Template_Partials_Archive_JSON_Body'
        'MARSH_TEMPLATE_Template_Partials_Archive_JSON_Document'
    )
    ASSET_TYPES=('Fonts' 'Styles' 'Scripts' 'Images' 'Audio' 'Video' 'Documents' 'Binaries' 'Other')
    for ASSET_TYPE in "${ASSET_TYPES[@]}"; do
        ASSET_TEXT_VAR="TEMPLATE_ASSETS_${ASSET_TYPE}_TEXT"
        printf -v "${ASSET_TEXT_VAR}" '%s' ''
    done
    STATE_INDEX=0
    while [[ "${STATE_INDEX}" -lt "${TEMPLATE_PARSED_YAML_STATE_COUNT}" ]]; do
        STATE_KEY_VAR="MARSH_TEMPLATE_STATE_KEY_${STATE_INDEX}"
        STATE_VALUE_VAR="MARSH_TEMPLATE_STATE_VALUE_${STATE_INDEX}"
        STATE_KEY="${!STATE_KEY_VAR}"
        STATE_VALUE="${!STATE_VALUE_VAR}"
        case "${STATE_KEY}" in
            MARSH_TEMPLATE_Template_Partials_*)
                PARTIAL_OUTPUT_NAME="${STATE_KEY#MARSH_TEMPLATE_}"
                PARTIAL_VALUE_VAR="TEMPLATE_PARTIAL_VALUE_${PARTIAL_OUTPUT_NAME}"
                printf -v "${PARTIAL_VALUE_VAR}" '%s' "${STATE_VALUE}"
                ;;
            MARSH_TEMPLATE_Template_Assets_*)
                if [[ "${STATE_KEY}" =~ ^MARSH_TEMPLATE_Template_Assets_([A-Za-z]+)_([0-9]+)$ ]]; then
                    ASSET_ENTRY_VAR="TEMPLATE_ASSET_VALUE_${BASH_REMATCH[1]}_${BASH_REMATCH[2]}"
                    printf -v "${ASSET_ENTRY_VAR}" '%s' "${STATE_VALUE}"
                fi
                ;;
            MARSH_TEMPLATE_Template_Filters_*)
                if [[ "${STATE_KEY}" =~ ^MARSH_TEMPLATE_Template_Filters_([0-9]+)_Regex$ ]]; then
                    FILTER_REGEX_VAR="TEMPLATE_FILTER_REGEX_${BASH_REMATCH[1]}"
                    printf -v "${FILTER_REGEX_VAR}" '%s' "${STATE_VALUE}"
                elif [[ "${STATE_KEY}" =~ ^MARSH_TEMPLATE_Template_Filters_([0-9]+)_Extended$ ]]; then
                    FILTER_EXTENDED_VAR="TEMPLATE_FILTER_EXTENDED_${BASH_REMATCH[1]}"
                    printf -v "${FILTER_EXTENDED_VAR}" '%s' "${STATE_VALUE}"
                elif [[ "${STATE_KEY}" =~ ^MARSH_TEMPLATE_Template_Filters_([0-9]+)_Assets_([0-9]+)$ ]]; then
                    FILTER_ASSET_TYPE_VAR="TEMPLATE_FILTER_ASSET_TYPE_${BASH_REMATCH[1]}_${BASH_REMATCH[2]}"
                    printf -v "${FILTER_ASSET_TYPE_VAR}" '%s' "${STATE_VALUE}"
                fi
                ;;
        esac
        STATE_INDEX=$((STATE_INDEX + 1))
    done

    # print partials paths relative to template dir
    for STATE_KEY in "${TEMPLATE_PARTIAL_KEYS[@]}"; do
        PARTIAL_OUTPUT_NAME="${STATE_KEY#MARSH_TEMPLATE_}"
        PARTIAL_VALUE_VAR="TEMPLATE_PARTIAL_VALUE_${PARTIAL_OUTPUT_NAME}"
        TEMPLATE_LOOKUP_VALUE="${!PARTIAL_VALUE_VAR:-}"
        if [[ "${TEMPLATE_LOOKUP_VALUE}" != "" ]]; then
            echo "${PREFIX}${PARTIAL_OUTPUT_NAME}=\"${TEMPLATE_DIR}/${TEMPLATE_LOOKUP_VALUE//\"/\\\"}\""
        fi
    done

    # assets
    for ASSET_TYPE in "${ASSET_TYPES[@]}"; do
        ASSET_TEXT_VAR="TEMPLATE_ASSETS_${ASSET_TYPE}_TEXT"
        INDEX=0
        ASSET_ENTRY_VAR="TEMPLATE_ASSET_VALUE_${ASSET_TYPE}_${INDEX}"
        ASSET="${!ASSET_ENTRY_VAR:-}"
        while [[ "${ASSET}" != "" ]]; do
            ASSETS_TEXT="${!ASSET_TEXT_VAR}"
            [[ "${ASSETS_TEXT}" == "" ]] || ASSETS_TEXT+=$'\n'
            ASSETS_TEXT+="${ASSET}"
            printf -v "${ASSET_TEXT_VAR}" '%s' "${ASSETS_TEXT}"
            INDEX=$((INDEX+1))
            ASSET_ENTRY_VAR="TEMPLATE_ASSET_VALUE_${ASSET_TYPE}_${INDEX}"
            ASSET="${!ASSET_ENTRY_VAR:-}"
        done
    done

    # assets filters
    FILTER_INDEX=0
    FILTER_REGEX_VAR="TEMPLATE_FILTER_REGEX_${FILTER_INDEX}"
    REGEX="${!FILTER_REGEX_VAR:-}"
    FILTER_EXTENDED_VAR="TEMPLATE_FILTER_EXTENDED_${FILTER_INDEX}"
    EXTENDED="${!FILTER_EXTENDED_VAR:-}"
    # loop over assets filters
    while [[ "${REGEX}" != "" ]]; do
        # escape match
        if [[ "$(echo ${REGEX} | grep -E '^s/.+[^\]/.*[^\]/g?$')" == "${REGEX}" ]]; then
            MATCH=$(echo "${REGEX}" | sed -E 's/^s\/(.+[^\])\/.*[^\]\/g?/\1/' | sed 's/[[]\.|$(){}?+*^]/\\&/g')
            REPLACE=$(echo "${REGEX}" | sed -E 's/^s\/.+[^\]\/(.*[^\])\/g?/\1/')
            EXTRA=$(echo "${REGEX}" | sed -E 's/^s\/.+[^\]\/.*[^\]\/(g?)/\1/')
            REGEX="s/${MATCH}/${REPLACE}/${EXTRA}"
        elif [[ "$(echo ${REGEX} | grep -E '^s\|.+[^\]\|.*[^\]\|g?$')" == "${REGEX}" ]]; then
            MATCH=$(echo "${REGEX}" | sed -E 's/^s\|(.+[^\])\|.*[^\]\|g?/\1/' | sed 's/[[]\.|$(){}?+*^]/\\&/g')
            REPLACE=$(echo "${REGEX}" | sed -E 's/^s\|.+[^\]\|(.*[^\])\|g?/\1/')
            EXTRA=$(echo "${REGEX}" | sed -E 's/^s\|.+[^\]\|.*[^\]\|(g?)/\1/')
            REGEX="s|${MATCH}|${REPLACE}|${EXTRA}"
        elif [[ "$(echo ${REGEX} | grep -E '^/.+[^\]/d?$')" == "${REGEX}" ]]; then
            MATCH=$(echo "${REGEX}" | sed -E 's/^\/(.+[^\])\/d?/\1/' | sed 's/[[]\.|$(){}?+*^]/\\&/g')
            REPLACE=""
            EXTRA=$(echo "${REGEX}" | sed -E 's/^\/.+[^\]\/(d?)/\1/')
            REGEX="/${MATCH}/${EXTRA}"
        else
            continue
        fi
        ASSETS_INDEX=0
        FILTER_ASSET_TYPE_VAR="TEMPLATE_FILTER_ASSET_TYPE_${FILTER_INDEX}_${ASSETS_INDEX}"
        ASSETS_TYPE="${!FILTER_ASSET_TYPE_VAR:-}"
        # loop over assets types for filter
        while [[ "${ASSETS_TYPE}" != "" ]]; do
            ASSET_TEXT_VAR="TEMPLATE_ASSETS_${ASSETS_TYPE}_TEXT"
            ASSETS_TEXT="${!ASSET_TEXT_VAR}"
            ASSETS_TEMP=()
            # loop over all individual assets of this type
            if [[ "${ASSETS_TEXT}" != "" ]]; then
                while IFS= read -r ASSET; do
                    # do regex
                    if [[ "${EXTENDED}" == true ]]; then
                        ASSET=$(echo "${ASSET}" | sed -E "${REGEX}" 2>/dev/null)
                    else
                        ASSET=$(echo "${ASSET}" | sed "${REGEX}" 2>/dev/null)
                    fi
                    # remove empty
                    if [[ "${ASSET:-}" != "" ]]; then
                        ASSETS_TEMP+=("${ASSET}")
                    fi
                done <<< "${ASSETS_TEXT}"
            fi
            # update original asset list text
            ASSETS_UPDATED_TEXT=""
            for I in "${!ASSETS_TEMP[@]}"; do
                [[ "${ASSETS_UPDATED_TEXT}" == "" ]] || ASSETS_UPDATED_TEXT+=$'\n'
                ASSETS_UPDATED_TEXT+="${ASSETS_TEMP[$I]}"
            done
            printf -v "${ASSET_TEXT_VAR}" '%s' "${ASSETS_UPDATED_TEXT}"
            ASSETS_INDEX=$((ASSETS_INDEX+1))
            FILTER_ASSET_TYPE_VAR="TEMPLATE_FILTER_ASSET_TYPE_${FILTER_INDEX}_${ASSETS_INDEX}"
            ASSETS_TYPE="${!FILTER_ASSET_TYPE_VAR:-}"
        done
        FILTER_INDEX=$((FILTER_INDEX+1))
        FILTER_REGEX_VAR="TEMPLATE_FILTER_REGEX_${FILTER_INDEX}"
        REGEX="${!FILTER_REGEX_VAR:-}"
        FILTER_EXTENDED_VAR="TEMPLATE_FILTER_EXTENDED_${FILTER_INDEX}"
        EXTENDED="${!FILTER_EXTENDED_VAR:-}"
    done

    # print assets
    for ASSET_TYPE in "${ASSET_TYPES[@]}"; do
        ASSET_TYPE_UPPER=$(echo "${ASSET_TYPE}" | awk '{ print toupper($0) }')
        ASSET_TEXT_VAR="TEMPLATE_ASSETS_${ASSET_TYPE}_TEXT"
        ASSETS_TEXT="${!ASSET_TEXT_VAR}"
        echo "${PREFIX}ASSETS_${ASSET_TYPE_UPPER}=()"
        if [[ "${ASSETS_TEXT}" != "" ]]; then
            while IFS= read -r ASSET; do
                [[ "${ASSET:-}" != "" ]] && echo "${PREFIX}ASSETS_${ASSET_TYPE_UPPER}+=(\"${ASSET//\"/\\\"}\")"
            done <<< "${ASSETS_TEXT}"
        fi
    done
}

# parses one template metadata assignment line
function marsh_parse_template_metadata_assignment {  # marsh_parse_template_metadata_assignment assignment_line out_name_var out_type_var out_value_var
    local ASSIGNMENT_LINE OUT_NAME_VAR OUT_TYPE_VAR OUT_VALUE_VAR
    local TEMPLATE_ASSIGNMENT_NAME TEMPLATE_ASSIGNMENT_VALUE TEMPLATE_ASSIGNMENT_TEXT

    ASSIGNMENT_LINE="${1:-}"
    OUT_NAME_VAR="${2:-}"
    OUT_TYPE_VAR="${3:-}"
    OUT_VALUE_VAR="${4:-}"
    [[ "${ASSIGNMENT_LINE}" != "" ]] || return 1
    [[ "${OUT_NAME_VAR}" != "" ]] || return 1
    [[ "${OUT_TYPE_VAR}" != "" ]] || return 1
    [[ "${OUT_VALUE_VAR}" != "" ]] || return 1

    if [[ "${ASSIGNMENT_LINE}" =~ ^([A-Za-z_][A-Za-z0-9_]*)=\(\)$ ]]; then
        printf -v "${OUT_NAME_VAR}" '%s' "${BASH_REMATCH[1]}"
        printf -v "${OUT_TYPE_VAR}" '%s' 'list-root'
        printf -v "${OUT_VALUE_VAR}" '%s' ''
        return 0
    fi

    if [[ "${ASSIGNMENT_LINE}" =~ ^([A-Za-z_][A-Za-z0-9_]*)\+=\((.*)\)$ ]]; then
        TEMPLATE_ASSIGNMENT_TEXT="${BASH_REMATCH[1]}=${BASH_REMATCH[2]}"
        marsh_parse_internal_assignment "${TEMPLATE_ASSIGNMENT_TEXT}" "TEMPLATE_ASSIGNMENT_NAME" "TEMPLATE_ASSIGNMENT_VALUE" 'template metadata' || return 1
        printf -v "${OUT_NAME_VAR}" '%s' "${TEMPLATE_ASSIGNMENT_NAME}"
        printf -v "${OUT_TYPE_VAR}" '%s' 'list-item'
        printf -v "${OUT_VALUE_VAR}" '%s' "${TEMPLATE_ASSIGNMENT_VALUE}"
        return 0
    fi

    marsh_parse_internal_assignment "${ASSIGNMENT_LINE}" "TEMPLATE_ASSIGNMENT_NAME" "TEMPLATE_ASSIGNMENT_VALUE" 'template metadata' || return 1
    printf -v "${OUT_NAME_VAR}" '%s' "${TEMPLATE_ASSIGNMENT_NAME}"
    printf -v "${OUT_TYPE_VAR}" '%s' 'value'
    printf -v "${OUT_VALUE_VAR}" '%s' "${TEMPLATE_ASSIGNMENT_VALUE}"
}

# parses a template tag into caller-owned outputs
function marsh_parse_template_tag {  # marsh_parse_template_tag tag_string tag_name_var tag_transforms_var
    local TAG_STRING TAG_NAME_VAR TAG_TRANSFORMS_VAR TAG_BODY TAG_CHAR TAG_CURRENT TAG_QUOTE TAG_ESCAPE TAG_INDEX TAG_PART TAG_NAME_VALUE PARSED_TRANSFORMS_TEXT
    local -a TAG_PARTS

    TAG_STRING="${1:-}"
    TAG_NAME_VAR="${2:-}"
    TAG_TRANSFORMS_VAR="${3:-}"
    [[ "${TAG_STRING}" == "" ]] && return 1
    [[ "${TAG_NAME_VAR}" == "" ]] && return 1
    [[ "${TAG_TRANSFORMS_VAR}" == "" ]] && return 1
    TAG_BODY=$(echo "${TAG_STRING}" | sed -E -e 's/^\{\{[ ]*//' -e 's/[ ]*\}\}$//')
    TAG_PARTS=()
    TAG_CURRENT=""
    TAG_QUOTE=""
    TAG_ESCAPE=false

    for (( TAG_INDEX=0; TAG_INDEX < "${#TAG_BODY}"; TAG_INDEX++ )); do
        TAG_CHAR="${TAG_BODY:${TAG_INDEX}:1}"
        if [[ "${TAG_ESCAPE}" == true ]]; then
            case "${TAG_CHAR}" in
                '\'|'|'|'"'|"'")
                    TAG_CURRENT+="${TAG_CHAR}"
                    ;;
                *)
                    TAG_CURRENT+='\'
                    TAG_CURRENT+="${TAG_CHAR}"
                    ;;
            esac
            TAG_ESCAPE=false
        elif [[ "${TAG_CHAR}" == '\' ]]; then
            TAG_ESCAPE=true
        elif [[ "${TAG_CHAR}" == '|' ]] && [[ "${TAG_QUOTE}" == "" ]]; then
            TAG_PARTS+=("$(echo "${TAG_CURRENT}" | sed -E -e 's/^[ ]+//' -e 's/[ ]+$//')")
            TAG_CURRENT=""
        elif [[ "${TAG_CHAR}" == "'" ]] && [[ "${TAG_QUOTE}" != '"' ]]; then
            if [[ "${TAG_QUOTE}" == "'" ]]; then
                TAG_QUOTE=""
            else
                TAG_QUOTE="'"
            fi
        elif [[ "${TAG_CHAR}" == '"' ]] && [[ "${TAG_QUOTE}" != "'" ]]; then
            if [[ "${TAG_QUOTE}" == '"' ]]; then
                TAG_QUOTE=""
            else
                TAG_QUOTE='"'
            fi
        else
            TAG_CURRENT+="${TAG_CHAR}"
        fi
    done

    [[ "${TAG_ESCAPE}" == true ]] && return 1
    [[ "${TAG_QUOTE}" != "" ]] && return 1
    TAG_PARTS+=("$(echo "${TAG_CURRENT}" | sed -E -e 's/^[ ]+//' -e 's/[ ]+$//')")
    TAG_NAME_VALUE="${TAG_PARTS[0]:-}"
    [[ "${TAG_NAME_VALUE}" == "" ]] && return 1

    # collect transforms as newline-delimited text for caller-owned arrays
    # keep parsed transform text separate from the caller output variable name
    PARSED_TRANSFORMS_TEXT=""
    for TAG_INDEX in "${!TAG_PARTS[@]}"; do
        [[ "${TAG_INDEX}" -eq 0 ]] && continue
        TAG_PART="${TAG_PARTS[$TAG_INDEX]}"
        [[ "${TAG_PART}" == "" ]] && continue
        if [[ "${PARSED_TRANSFORMS_TEXT}" != "" ]]; then
            PARSED_TRANSFORMS_TEXT+=$'\n'
        fi
        PARSED_TRANSFORMS_TEXT+="${TAG_PART}"
    done
    printf -v "${TAG_NAME_VAR}" '%s' "${TAG_NAME_VALUE}"
    printf -v "${TAG_TRANSFORMS_VAR}" '%s' "${PARSED_TRANSFORMS_TEXT}"
    return 0
}

