        else
            if [[ -f "${TEMPLATE_Template_Partials_Document}" ]] && [[ -r "${TEMPLATE_Template_Partials_Document}" ]]; then
                TEMPLATE_DOCUMENT_TEMPLATE=$(<"${TEMPLATE_Template_Partials_Document}")
