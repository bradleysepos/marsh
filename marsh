                            [[ "${ASSET}" == "" ]] && continue
                            TEMPLATE_ASSETS_VIDEO+=("${ASSET}")
                        done <<< "${TEMPLATE_METADATA_ENTRY_LIST}"
                    fi
                    ;;
                TEMPLATE_ASSETS_DOCUMENTS)
                    [[ "${TEMPLATE_METADATA_ENTRY_TYPE}" == "list" ]] || return 1
                    if [[ "${TEMPLATE_METADATA_ENTRY_LIST}" != "" ]]; then
                        while IFS= read -r ASSET; do
                            [[ "${ASSET}" == "" ]] && continue
                            TEMPLATE_ASSETS_DOCUMENTS+=("${ASSET}")
                        done <<< "${TEMPLATE_METADATA_ENTRY_LIST}"
                    fi
                    ;;
                TEMPLATE_ASSETS_BINARIES)
                    [[ "${TEMPLATE_METADATA_ENTRY_TYPE}" == "list" ]] || return 1
                    if [[ "${TEMPLATE_METADATA_ENTRY_LIST}" != "" ]]; then
