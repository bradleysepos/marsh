function marsh_env_cli {
    NAME="marsh"
    VERSION="1.0.0-alpha.1"
    SELF="${BASH_SOURCE[0]}"
    SELF_DIR=$(cd $(dirname "${BASH_SOURCE[0]}") && pwd -P)
    SELF_DIR="${SELF_DIR:-$(pwd)}"
    SELF_NAME=$(basename "${SELF}")
    SYS_NAME=$(uname | awk '{ print tolower($0)}')
    HELP="\
usage: ${SELF_NAME} [-h | --help]
       ${SELF_NAME} [-v | --version]
       ${SELF_NAME} build [--force] [-j # | --jobs #]
         [--markdown markdown] [--markdown-options opt1,opt2]
         [--markdown-file-extensions ext1,ext2]
         [--markdown-rewrite-links true|false] [config_file]
where:
  -h, --help
        display this help text
  -v, --version
        display version information
  --force
        remove and replace existing targets (overwrite)
  -j, --jobs
        number of concurrent jobs to run using GNU Parallel
        default: automatically chosen by GNU Parallel, if available
  --markdown
        path to discount markdown application
  --markdown-options
        discount markdown translation options (comma delimited)
        default: $(echo ${MARKDOWN_OPTIONS[@]:-} | sed 's/ /,/g')
  --markdown-file-extensions
        markdown file extensions to process (comma delimited)
        default: $(echo ${MARKDOWN_FILEEXT[@]:-} | sed 's/ /,/g')
  --markdown-rewrite-links
        rewrite markdown syntax relative markdown links to *.html
        default: ${MARKDOWN_REWRITE_LINKS:-}"
}

# creates bash variables from yaml records
# extended to support arrays, empty values, and more
# https://gist.github.com/DinoChiesa/3e3c3866b51290f31243
# https://gist.github.com/epiloque/8cf512c6d64641bde388
# https://gist.github.com/pkuczynski/8665367
function marsh_parse_yaml {  # marsh_parse_yaml yaml_string_or_file variables_prefix spaces_per_indentation
    local INPUT PREFIX INDENT S W FS
    INPUT="${1:-}"
    [[ "${INPUT}" == "" ]] && return 0
    if [[ -f "${INPUT}" ]] && [[ -r "${INPUT}" ]]; then
        INPUT=$(<"${INPUT}")
    fi
    PREFIX="${2:-}"
    INDENT="${3:-}"
    if [[ ! "${INDENT}" =~ ^[0-9]+$ ]] || [[ "${INDENT}" -eq 0 ]]; then
        INDENT=2
    fi
    S='[[:space:]]*'
    W='[a-zA-Z0-9_]*'
    FS=$(echo @|tr @ '\034')
    echo "${INPUT}" |
    sed -n \
        -e "s|^\(\(${S}\)\(-\) \)\{1\}\(${S}\)\(${W}\)${S}:${S}\(\".*\"\)\${S}\$|\3${FS}\2  \4${FS}\5${FS}\6|p" \
        -e "s|^\(\(${S}\)\(-\) \)\{1\}\(${S}\)\(${W}\)${S}:${S}\(.*\)${S}\$|\3${FS}\2  \4${FS}\5${FS}\6|p" \
        -e "s|^\(\(${S}\)\(-\) \)\{1\}\(${S}\)\(\".*\"\)${S}\$|\3${FS}\2  \4${FS}${FS}\5|p" \
        -e "s|^\(\(${S}\)\(-\) \)\{1\}\(${S}\)\([^:].*\)${S}\$|\3${FS}\2  \4${FS}${FS}\5|p" \
        -e "s|^\(${S}\)\(${W}\)${S}:${S}\(\".*\"\)${S}\$|${FS}\1${FS}\2${FS}\3|p" \
        -e "s|^\(${S}\)\(${W}\)${S}:${S}\(.*\)${S}\$|${FS}\1${FS}\2${FS}\3|p" |
    awk -F"${FS}" -v prefix="${PREFIX}" -v indent="${INDENT}" -v field_sep="${FS}" \
        '#
        # parse_csv, public domain, http://lorance.freeshell.org/csv/
        #**************************************************************************
        #
        # This file is in the public domain.
        #
        # For more information email LoranceStinson+csv@gmail.com.
        # Or see http://lorance.freeshell.org/csv/
        #
        # Parse a CSV string into an array.
        # The number of fields found is returned.
        # In the event of an error a negative value is returned and csverr is set to
        # the error. See below for the error values.
        #
        # Parameters:
        # string  = The string to parse.
        # csv     = The array to parse the fields into.
        # sep     = The field separator character. Normally ,
        # quote   = The string quote character. Normally "
        # escape  = The quote escape character. Normally "
        # newline = Handle embedded newlines. Provide either a newline or the
        #           string to use in place of a newline. If left empty embedded
        #           newlines cause an error.
        # trim    = When true spaces around the separator are removed.
        #           This affects parsing. Without this a space between the
        #           separator and quote result in the quote being ignored.
        #
        # These variables are private:
        # fields  = The number of fields found thus far.
        # pos     = Where to pull a field from the string.
        # strtrim = True when a string is found so we know to remove the quotes.
        #
        # Error conditions:
        # -1  = Unable to read the next line.
        # -2  = Missing end quote.
        # -3  = Missing separator.
        #
        # Notes:
        # The code assumes that every field is preceded by a separator, even the
        # first field. This makes the logic much simpler, but also requires a
        # separator be prepended to the string before parsing.
        function parse_csv(string,csv,sep,quote,escape,newline,trim, fields,pos,strtrim) {
            # Make sure there is something to parse.
            if (length(string) == 0) return 0;
            string = sep string; # The code below assumes ,FIELD.
            fields = 0; # The number of fields found thus far.
            while (length(string) > 0) {
                # Remove spaces after the separator if requested.
                if (trim && substr(string, 2, 1) == " ") {
                    if (length(string) == 1) return fields;
                    string = substr(string, 2);
                    continue;
                }
                strtrim = 0; # Used to trim quotes off strings.
                # Handle a quoted field.
                if (substr(string, 2, 1) == quote) {
                    pos = 2;
                    do {
                        pos++
                        if (pos != length(string) &&
                            substr(string, pos, 1) == escape &&
                            (substr(string, pos + 1, 1) == quote ||
                             substr(string, pos + 1, 1) == escape)) {
                            # Remove escaped quote characters.
                            string = substr(string, 1, pos - 1) substr(string, pos + 1);
                        } else if (substr(string, pos, 1) == quote) {
                            # Found the end of the string.
                            strtrim = 1;
                        } else if (newline && pos >= length(string)) {
                            # Handle embedded newlines if requested.
                            if (getline == -1) {
                                csverr = "Unable to read the next line.";
                                return -1;
                            }
                            string = string newline $0;
                        }
                    } while (pos < length(string) && strtrim == 0)
                    if (strtrim == 0) {
                        csverr = "Missing end quote.";
                        return -2;
                    }
                } else {
                    # Handle an empty field.
                    if (length(string) == 1 || substr(string, 2, 1) == sep) {
                        csv[fields] = "";
                        fields++;
                        if (length(string) == 1)
                            return fields;
                        string = substr(string, 2);
                        continue;
                    }
                    # Search for a separator.
                    pos = index(substr(string, 2), sep);
                    # If there is no separator the rest of the string is a field.
                    if (pos == 0) {
                        csv[fields] = substr(string, 2);
                        fields++;
                        return fields;
                    }
                }
                # Remove spaces after the separator if requested.
                if (trim && pos != length(string) && substr(string, pos + strtrim, 1) == " ") {
                    trim = strtrim
                    # Count the number fo spaces found.
                    while (pos < length(string) && substr(string, pos + trim, 1) == " ") {
                        trim++
                    }
                    # Remove them from the string.
                    string = substr(string, 1, pos + strtrim - 1) substr(string,  pos + trim);
                    # Adjust pos with the trimmed spaces if a quotes string was not found.
                    if (!strtrim) {
                        pos -= trim;
                    }
                }
                # Make sure we are at the end of the string or there is a separator.
                if ((pos != length(string) && substr(string, pos + 1, 1) != sep)) {
                    csverr = "Missing separator.";
                    return -3;
                }
                # Gather the field.
                csv[fields] = substr(string, 2 + strtrim, pos - (1 + strtrim * 2));
                fields++;
                # Remove the field from the string for the next pass.
                string = substr(string, pos + 1);
            }
            return fields;
        }
        BEGIN { prev_level = 0; }
        {
            type  = $1;
            level = length($2)/indent;
            key   = $3;
            val   = $4;
            out   = "";
            array = 0;
            num_vals = 0;
            if (level < prev_level) { adepth[prev_level] = -1; }
            if (adepth[level] == "") { adepth[level] = -1; }
            if (type == "-") { adepth[level]++; }
            vname[level] = key;
            for (i in vname) {
                if (i > (level)) { vname[i] = ""; }
            }
            for (i = 0; i < level; i++) {
                if (vname[i] != "") {
                    out = out "_" vname[i];
                    if (adepth[i] > -1 && adepth[i+1] > -1) { out = out "_" adepth[i+1]; }
                } else {
                    out = out "_" adepth[i+1];
                }
            }
            if (substr(val,1,1) == "[" && substr(val,length(val),1) == "]") {
                array = 1;
                gsub(/^\[[ ]*/, "", val);
                gsub(/[ ]*\]$/, "", val);
                num_vals = parse_csv(val, vals, ",", "\"", "\"", "\\n", 1);
                if (num_vals < 0) {
                    # Error parsing inline array
                    exit 1;
                }
            } else {
                if (substr(val,1,1) == "\"" && substr(val,length(val),1) == "\"") {
                    num_vals = parse_csv(val, vals, field_sep, "\"", "\"", "\\n", 0);
                    if (num_vals < 0) {
                        # Error parsing
                        exit 1;
                    }
                } else {
                    num_vals = 1;
                    vals[0] = val;
                }
            }
            if (key != "") { out = out "_" key; }
            out = prefix out;
            gsub(/__/, "_", out);
            gsub(/_=/, "", out);
            for (i = 0; i < num_vals; i++) {
                gsub(/"/, "\\\"", vals[i]);
                if (vals[i] != "true" && vals[i] != "false") {
                    vals[i]="\"" vals[i] "\""
                }
                if (array == 1) {
                    print out "_" i "=" vals[i];
                } else {
                    print out "=" vals[i];
                }
            }
            for (i = 0; i < num_vals; i++) {
                delete vals[i];
            }
            prev_level = level;
        }'
}

# tests whether a string is an exact match for an array item
function marsh_in_array {  # marsh_in_array needle haystack[@]
    local e
    for e in "${@:2}"; do
        [[ "${e}" == "${1}" ]] && return 0;
    done
    return 1
}

# creates an array from the contents of flat variables
# TEST_0="foo"; TEST_1="bar"; TEST_2="baz"
# eval $(marsh_flat_to_array "TEST" "TEST_")  # loops over TEST_{0..2}
# echo "${TEST[*]}"                           # foo bar baz
function marsh_flat_to_array {  # marsh_flat_to_array array_name variable_prefix
    local ARRAY_NAME PREFIX INDEX ITEM_NAME ITEM_VALUE
    ARRAY_NAME="${1:-}"
    [[ "${ARRAY_NAME}" == "" ]] && return 1
    PREFIX="${2:-}"
    [[ "${PREFIX}" == "" ]] && return 1
    echo "${ARRAY_NAME}=()"
    INDEX=0
    ITEM_NAME="${PREFIX}${INDEX}"
    while [[ -n "${!ITEM_NAME+isset}" ]]; do
        ITEM_VALUE="${!ITEM_NAME}"
        echo "${ARRAY_NAME}+=(\"${ITEM_VALUE//\"/\\\"}\")"
        INDEX=$((INDEX + 1))
        ITEM_NAME="${PREFIX}${INDEX}"
    done
    return 0
}

# transforms headings without relying on GNU sed multiline behavior
function marsh_text_filter_headings {  # marsh_text_filter_headings action
    local ACTION="${1:-}"
    awk -v ACTION="${ACTION}" '
    BEGIN {
        prefix[1] = "# "
        prefix[2] = "## "
        prefix[3] = "### "
        prefix[4] = "#### "
        prefix[5] = "##### "
        prefix[6] = "###### "
    }

    function remove_html_level(line, level, pattern) {
        pattern = "<h" level "[^>]*>[^<]*</h" level ">"
        while (match(line, pattern)) {
            line = substr(line, 1, RSTART - 1) substr(line, RSTART + RLENGTH)
        }
        return line
    }

    function remove_all_html_headings(line, level) {
        for (level = 1; level <= 6; level++) {
            line = remove_html_level(line, level)
        }
        return line
    }

    function rewrite_html_open_tags(line, from, to, tag, open_tag, attrs) {
        tag = "<h" from "[^>]*>"
        while (match(line, tag)) {
            open_tag = substr(line, RSTART, RLENGTH)
            attrs = substr(open_tag, 4, length(open_tag) - 4)
            line = substr(line, 1, RSTART - 1) "<h" to attrs ">" substr(line, RSTART + RLENGTH)
        }
        return line
    }

    function rewrite_html_close_tags(line, from, to, tag) {
        tag = "</h" from ">"
        while (match(line, tag)) {
            line = substr(line, 1, RSTART - 1) "</h" to ">" substr(line, RSTART + RLENGTH)
        }
        return line
    }

    function rewrite_html_strong_tags(line, level, open_tag, attrs) {
        level = 6
        while (match(line, "<h" level "[^>]*>")) {
            open_tag = substr(line, RSTART, RLENGTH)
            attrs = substr(open_tag, 4, length(open_tag) - 4)
            line = substr(line, 1, RSTART - 1) "<strong" attrs ">" substr(line, RSTART + RLENGTH)
        }
        while (match(line, "</h" level ">")) {
            line = substr(line, 1, RSTART - 1) "</strong>" substr(line, RSTART + RLENGTH)
        }
        return line
    }

    function transform_markdown(line, hashes, text, level, split_pos) {
        if (substr(line, 1, 1) != "#") {
            return line
        }
        if (match(line, /^#+ /)) {
            split_pos = RLENGTH
            hashes = substr(line, 1, split_pos - 1)
            text = substr(line, split_pos + 1)
            level = length(hashes)
            if (ACTION == "push") {
                level++
                if (level == 7) {
                    return "**" text "**"
                }
                return prefix[level] text
            }
            if (ACTION == "shift") {
                if (level == 1) {
                    return ""
                }
                return prefix[level - 1] text
            }
            if (ACTION == "remove") {
                return ""
            }
        }
        return line
    }

    function transform_html(line) {
        if (index(line, "<h") == 0) {
            return line
        }
        if (ACTION == "push") {
            line = rewrite_html_strong_tags(line)
            line = rewrite_html_open_tags(line, 5, 6)
            line = rewrite_html_close_tags(line, 5, 6)
            line = rewrite_html_open_tags(line, 4, 5)
            line = rewrite_html_close_tags(line, 4, 5)
            line = rewrite_html_open_tags(line, 3, 4)
            line = rewrite_html_close_tags(line, 3, 4)
            line = rewrite_html_open_tags(line, 2, 3)
            line = rewrite_html_close_tags(line, 2, 3)
            line = rewrite_html_open_tags(line, 1, 2)
            line = rewrite_html_close_tags(line, 1, 2)
            return line
        }
        if (ACTION == "shift") {
            line = remove_html_level(line, 1)
            line = rewrite_html_open_tags(line, 2, 1)
            line = rewrite_html_close_tags(line, 2, 1)
            line = rewrite_html_open_tags(line, 3, 2)
            line = rewrite_html_close_tags(line, 3, 2)
            line = rewrite_html_open_tags(line, 4, 3)
            line = rewrite_html_close_tags(line, 4, 3)
            line = rewrite_html_open_tags(line, 5, 4)
            line = rewrite_html_close_tags(line, 5, 4)
            line = rewrite_html_open_tags(line, 6, 5)
            line = rewrite_html_close_tags(line, 6, 5)
            return line
        }
        if (ACTION == "remove") {
            return remove_all_html_headings(line)
        }
        return line
    }

    function emit_line(line, transformed) {
        if (substr(line, 1, 1) != "#" && index(line, "<h") == 0) {
            print line
            return
        }
        transformed = transform_markdown(line)
        transformed = transform_html(transformed)
        if (transformed == "" && line != "") {
            return
        }
        print transformed
    }

    {
        if (have_pending) {
            if ($0 ~ /^=+$/) {
                emit_line("# " pending)
                have_pending = 0
                next
            }
            if ($0 ~ /^-+$/) {
                emit_line("## " pending)
                have_pending = 0
                next
            }
            emit_line(pending)
        }
        pending = $0
        have_pending = 1
    }

    END {
        if (have_pending) {
            emit_line(pending)
        }
    }
    '
}

# transforms a string
function marsh_text_filter {  # marsh_text_filter filter [filter...]
    local FILTER OIFS PIPE_STATUS STATUS
    FILTER="${1:-}"
    OIFS="${IFS}"
    IFS=$'\n'
    if [[ "${#@}" -gt 1 ]]; then
        shift 1
        marsh_text_filter "${FILTER}" | marsh_text_filter "${@}"
        PIPE_STATUS=(${PIPESTATUS[@]})
        for STATUS in "${PIPE_STATUS[@]}"; do
            [[ "${STATUS}" -ne 0 ]] && return "${STATUS}"
        done
        return 0
    fi
    local OPTIONS OPTIONS_STRING OPTION_CURRENT OPTION_INDEX OPTION_CHAR OPTION_NEXT
    OPTIONS=()
    OPTIONS_STRING="${FILTER#*:}"
    if [[ "${OPTIONS_STRING}" == "${FILTER}" ]]; then
        :
    elif [[ "${OPTIONS_STRING}" != *\\* ]]; then
        OPTIONS=(${OPTIONS_STRING//:/$'\n'})
    else
        OPTION_CURRENT=""
        OPTION_INDEX=0
        while [[ "${OPTION_INDEX}" -lt "${#OPTIONS_STRING}" ]]; do
            OPTION_CHAR="${OPTIONS_STRING:${OPTION_INDEX}:1}"
            if [[ "${OPTION_CHAR}" == '\' ]]; then
                OPTION_INDEX=$((OPTION_INDEX + 1))
                if [[ "${OPTION_INDEX}" -ge "${#OPTIONS_STRING}" ]]; then
                    OPTION_CURRENT+='\'
                    break
                fi
                OPTION_NEXT="${OPTIONS_STRING:${OPTION_INDEX}:1}"
                if [[ "${OPTION_NEXT}" == ':' ]]; then
                    OPTION_CURRENT+=':'
                elif [[ "${OPTION_NEXT}" == '\' ]]; then
                    OPTION_CURRENT+='\'
                else
                    OPTION_CURRENT+='\'
                    OPTION_CURRENT+="${OPTION_NEXT}"
                fi
            elif [[ "${OPTION_CHAR}" == ':' ]]; then
                OPTIONS+=("${OPTION_CURRENT}")
                OPTION_CURRENT=""
            else
                OPTION_CURRENT+="${OPTION_CHAR}"
            fi
            OPTION_INDEX=$((OPTION_INDEX + 1))
        done
        OPTIONS+=("${OPTION_CURRENT}")
    fi
    IFS="${OIFS}"
    local TRAILING_PUNCTUATION APPEND MAX_CHARS MAX_PARAS MD_EXT_REGEX PROTOCOL_SEP WRAP_START WRAP_END
    local COUNT DELIM1 DELIM2 DELIM3 END I ITEM_KEY PREPEND REPLACE_EXT START XML_TAG XML_TAG_CLOSE XML_TAG_OPEN
    TRAILING_PUNCTUATION=',.:;?!'
    case "${FILTER}" in
        append:*)
            APPEND="${OPTIONS[0]:-}"
            APPEND=$(printf '%s' "${APPEND}" | marsh_escape_substitution)
            sed -e '$ s/$/'"${APPEND}"'/'
            ;;
        append-type:block:*)
            APPEND="${OPTIONS[1]:-}"
            APPEND="${APPEND//\\/\\\\}"
            awk -v APPEND="${APPEND}" '{ print } END { print APPEND }'
            ;;
        date:rfc2822)
            if [[ "${SYS_NAME}" =~ bsd|darwin ]]; then
                sed -E -e 's/^([0-9]{4}-[0-9]{2}-[0-9]{2})$/\1 00:00:00/' | TZ=UTC date -jf '%Y-%m-%d %H:%M:%S' -R "$(</dev/stdin)" 2>/dev/null
            else
                sed -E -e 's/^([0-9]{4}-[0-9]{2}-[0-9]{2})$/\1 00:00:00/' | TZ=UTC date --rfc-2822 -d "$(</dev/stdin)" 2>/dev/null
            fi
            ;;
        date:rfc3339)
            if [[ "${SYS_NAME}" =~ bsd|darwin ]]; then
                sed -E -e 's/^([0-9]{4}-[0-9]{2}-[0-9]{2})$/\1 00:00:00/' | TZ=UTC date -jf '%Y-%m-%d %H:%M:%S' '+%Y-%m-%dT%T%z' "$(</dev/stdin)" 2>/dev/null | sed -E -e 's/([0-9]{2})([0-9]{2})$/\1:\2/'
            else
                sed -E -e 's/^([0-9]{4}-[0-9]{2}-[0-9]{2})$/\1 00:00:00/' | TZ=UTC date --rfc-3339=seconds -d "$(</dev/stdin)" 2>/dev/null | sed -E -e 's/([0-9-]{10}) /\1T/'
            fi
            ;;
        date)
            if [[ "${SYS_NAME}" =~ bsd|darwin ]]; then
                sed -E -e 's/^([0-9]{4}-[0-9]{2}-[0-9]{2})$/\1 00:00:00/' | TZ=UTC date -jf '%Y-%m-%d %H:%M:%S' '+%Y-%m-%d' "$(</dev/stdin)" 2>/dev/null
            else
                sed -E -e 's/^([0-9]{4}-[0-9]{2}-[0-9]{2})$/\1 00:00:00/' | TZ=UTC date '+%Y-%m-%d' -d "$(</dev/stdin)" 2>/dev/null
            fi
