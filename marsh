    local TARGET_ARCHIVE_TYPES_JOINED TARGET_ARCHIVE_EXCLUDED_STATES_JOINED TARGET_ARCHIVE_TEMPLATE_SOURCE_VALUE TARGET_ARCHIVE_TEMPLATE_ASSETS_PATH_VALUE TARGET_ARCHIVE_TEMPLATE_OVERRIDES_JOINED TARGET_ARCHIVE_TEMPLATE_VALUE
    local TARGET_ARCHIVE_COMPARE_RECORD TARGET_ARCHIVE_COMPARE_RECORD_EXTRA TARGET_ARCHIVE_COMPARE_PATH TARGET_ARCHIVE_COMPARE_TYPES_JOINED TARGET_ARCHIVE_COMPARE_EXCLUDED_STATES_JOINED
    local TARGET_ARCHIVE_TEMPLATE TARGET_ARCHIVE_TEMPLATE_SOURCE TARGET_ARCHIVE_TEMPLATE_ASSETS_PATH
    local I J OIFS
