# prints a list of variables given their assignment commands, one per line, e.g. FOO="bar" prints FOO
function marsh_get_variables {  # marsh_get_variables assignments_string
    sed -E -e 's/^([^=]+[^+])[+]?=.*/\1/' | sort -u
}

# prints local declarations for the given list of variable names, one per line
function marsh_get_local_declarations {  # marsh_get_local_declarations variables_string
    sed -n -E -e '/^$/d' -e 's/^/local /p'
}

# escapes text for safe sed replacement, trimming trailing newlines to match shell command substitution behavior
function marsh_escape_substitution {  # marsh_escape_substitution
    sed -e ':a' -e '$!{N' -e 'ba' -e '}' -e 's/\n*$//' -e 's/[&/\]/\\&/g' -e 's/\n/\\&/g'
}

# lists archive subdocuments in numeric order
function marsh_get_subdocuments {  # marsh_get_subdocuments document
    local DOCUMENT INDEX MANIFEST DOCUMENT_ESC URI_ESC ABSPATH_ESC MANIFEST_DOCUMENT

    DOCUMENT="${1:-}"
    [[ "${DOCUMENT}" == "" ]] && return 1

    MANIFEST="${DOCUMENT}.${MARSH_UID}.subdocuments.manifest"
    if [[ -f "${MANIFEST}" ]] && [[ -r "${MANIFEST}" ]]; then
        while IFS=$'\t' read -r DOCUMENT_ESC URI_ESC ABSPATH_ESC; do
            [[ "${DOCUMENT_ESC}" == "" ]] && continue
            MANIFEST_DOCUMENT=""
            eval "MANIFEST_DOCUMENT=${DOCUMENT_ESC}"
            printf '%s\n' "${MANIFEST_DOCUMENT}"
        done < "${MANIFEST}"
        return 0
    fi

    INDEX=0
    while [[ -f "${DOCUMENT}.${MARSH_UID}.subdocuments.${INDEX}.document" ]]; do
        printf '%s\n' "${DOCUMENT}.${MARSH_UID}.subdocuments.${INDEX}.document"
        INDEX=$((INDEX + 1))
    done
}

# returns success when file extension is a markdown file extension
function marsh_is_markdown_extension {  # marsh_is_markdown_extension file_ext markdown_fileext_csv
    local FILE_EXT MARKDOWN_FILEEXT_CSV MD_EXT

    FILE_EXT="${1:-}"
    MARKDOWN_FILEEXT_CSV="${2:-}"
    [[ "${FILE_EXT}" == "" ]] && return 1
    [[ "${MARKDOWN_FILEEXT_CSV}" == "" ]] && return 1
    FILE_EXT=$(printf '%s' "${FILE_EXT}" | awk '{ print tolower($0) }')
    for MD_EXT in ${MARKDOWN_FILEEXT_CSV//,/ }; do
        [[ "${FILE_EXT}" == "${MD_EXT}" ]] && return 0
    done
    return 1
}

# resolves a template tag to shell variable assignments
function marsh_resolve_tag_metadata {  # marsh_resolve_tag_metadata tag_name prefix metadata_vars[@]
    local TAG_NAME PREFIX METADATA_VARS TAG_VAR TAG_TYPE
    local OIFS META_VAR NORMALIZED_TAG NORMALIZED_META MATCH_VAR MATCH_COUNT

    # init
    TAG_NAME="${1:-}"
    [[ "${TAG_NAME}" == "" ]] && return 1
    PREFIX="${2:-}"
    METADATA_VARS="${3:-}"

    # handle known metadata tags
    TAG_VAR=""
    TAG_TYPE=""
    case "${TAG_NAME}" in
        base.relpath|document.relpath)
            TAG_VAR="${PREFIX}RELPATH"
            TAG_TYPE="string"
            ;;
        base.abspath|document.abspath)
            TAG_VAR="${PREFIX}ABSPATH"
            TAG_TYPE="string"
            ;;
        document.uri)
            TAG_VAR="${PREFIX}URI"
            TAG_TYPE="string"
            ;;
        document)
            TAG_VAR="${PREFIX}CONTENT"
            TAG_TYPE="file"
            ;;
        document.authors)
            TAG_VAR="${PREFIX}Authors_"
            TAG_TYPE="array"
            ;;
        document.copyright)
            TAG_VAR="${PREFIX}Copyright"
            TAG_TYPE="string"
            ;;
        document.credits-url)
            TAG_VAR="${PREFIX}Credits_URL"
            TAG_TYPE="string"
            ;;
        document.date)
            TAG_VAR="${PREFIX}Date"
            TAG_TYPE="string"
            ;;
        document.language)
            TAG_VAR="${PREFIX}Language"
            TAG_TYPE="string"
            ;;
        document.language-code)
            TAG_VAR="${PREFIX}Language_Code"
            TAG_TYPE="string"
            ;;
        document.license)
            TAG_VAR="${PREFIX}License"
            TAG_TYPE="string"
            ;;
        document.license-abbr)
            TAG_VAR="${PREFIX}License_Abbr"
            TAG_TYPE="string"
            ;;
        document.license-url)
            TAG_VAR="${PREFIX}License_URL"
            TAG_TYPE="string"
            ;;
        document.project)
            TAG_VAR="${PREFIX}Project"
            TAG_TYPE="string"
            ;;
        document.project-version)
            TAG_VAR="${PREFIX}Project_Version"
            TAG_TYPE="string"
            ;;
        document.project-url)
            TAG_VAR="${PREFIX}Project_URL"
            TAG_TYPE="string"
            ;;
        document.redirect-url)
            TAG_VAR="${PREFIX}Redirect_URL"
            TAG_TYPE="string"
            ;;
        document.state)
            TAG_VAR="${PREFIX}State_"
            TAG_TYPE="array"
            ;;
        document.title)
            TAG_VAR="${PREFIX}Title"
            TAG_TYPE="string"
            ;;
        document.type)
            TAG_VAR="${PREFIX}Type"
            TAG_TYPE="string"
            ;;
        util.json-separator)
            TAG_VAR="UTIL_JSON_SEPARATOR"
            TAG_TYPE="string"
            ;;
        *)
            ;;
    esac

    # handle all other metadata tags, only string values are supported
    # tag names begin with 'document.' and a list of metadata variables must be provided to match against
    # normalization follows the output pattern of converting to lowercase and replacing underscores with dashes
    if [[ "${TAG_VAR}" == "" ]] && [[ "${TAG_TYPE}" == "" ]]; then
        [[ "${TAG_NAME#document.}" != "${TAG_NAME}" ]] || return 1
        [[ "${METADATA_VARS}" != "" ]] || return 1
        NORMALIZED_TAG="${TAG_NAME#document.}"
        NORMALIZED_TAG=$(printf '%s' "${NORMALIZED_TAG}" | awk '{ print tolower($0) }')
        MATCH_VAR=""
        MATCH_COUNT=0
        OIFS="${IFS}"
        IFS=$'\n'
        for META_VAR in ${METADATA_VARS}; do
            [[ "${META_VAR}" == "${PREFIX}"* ]] || continue
            NORMALIZED_META="${META_VAR#${PREFIX}}"
            NORMALIZED_META=$(printf '%s' "${NORMALIZED_META}" | awk '{ print tolower($0) }')
            NORMALIZED_META="${NORMALIZED_META//_/-}"
            [[ "${NORMALIZED_META}" == "${NORMALIZED_TAG}" ]] || continue
            MATCH_VAR="${META_VAR}"
            MATCH_COUNT=$((MATCH_COUNT + 1))
        done
        IFS="${OIFS}"
        [[ "${MATCH_COUNT}" -eq 1 ]] || return 1
        TAG_VAR="${MATCH_VAR}"
        TAG_TYPE="string"
    fi

    printf 'TAG_VAR=%q\n' "${TAG_VAR}"
    printf 'TAG_TYPE=%q\n' "${TAG_TYPE}"
    return 0
}

# processes markdown from stdin using explicit runtime configuration
function marsh_process_markdown {  # marsh_process_markdown markdown_command markdown_options_csv [args...]
    local MARKDOWN_COMMAND MARKDOWN_OPTIONS_CSV MARKDOWN_OPTIONS MARKDOWN_OPTIONS_CLIARGS OIFS I

    MARKDOWN_COMMAND="${1:-}"
    MARKDOWN_OPTIONS_CSV="${2:-}"
    [[ "${MARKDOWN_COMMAND}" == "" ]] && return 1
    shift 2

    MARKDOWN_OPTIONS=()
    MARKDOWN_OPTIONS_CLIARGS=()
    if [[ "${MARKDOWN_OPTIONS_CSV}" != "" ]]; then
        OIFS="${IFS}"
        IFS=$'\n'
        MARKDOWN_OPTIONS=(${MARKDOWN_OPTIONS_CSV//,/$IFS})
        IFS="${OIFS}"
        for I in "${!MARKDOWN_OPTIONS[@]}"; do
            MARKDOWN_OPTIONS_CLIARGS+=("-f${MARKDOWN_OPTIONS[$I]}")
        done
    fi

    # normalize known output quirks of discount markdown
    # remove invalid re[lv]="footnote" attributes
    # fix rendering of backslash-escaped literal angle brackets
    {
        if [[ "${#MARKDOWN_OPTIONS_CLIARGS[@]}" -gt 0 ]]; then
            "${MARKDOWN_COMMAND}" "${MARKDOWN_OPTIONS_CLIARGS[@]}" "$@"
        else
            "${MARKDOWN_COMMAND}" "$@"
        fi
    } | sed -E \
        -e '/<a href="#[a-z]+:[^"]+" re[lv]="footnote">/s/ re[lv]="footnote"//g' \
        -e 's/\\&lt;/\&lt;/g' \
        -e 's/\\&gt;/\&gt;/g' \
        -e 's/\\</\&lt;/g' \
        -e 's/\\>/\&gt;/g' \
        -e 's/(&lt;[^<>]+)>/\1\&gt;/g'
}

# returns success when file begins with yaml frontmatter
function marsh_has_frontmatter {  # marsh_has_frontmatter source
    local SOURCE FIRST_LINE

    SOURCE="${1:-}"
    [[ "${SOURCE}" == "" ]] && return 1
    IFS= read -r FIRST_LINE < "${SOURCE}" || return 1
    [[ "${FIRST_LINE}" =~ ^---\ *(#.*)?$ ]]
}

# extracts yaml frontmatter and document content
function marsh_extract_frontmatter {  # marsh_extract_frontmatter source meta_dest content_dest
    local SOURCE META_DEST CONTENT_DEST

    # init
    SOURCE="${1:-}"
    META_DEST="${2:-}"
    CONTENT_DEST="${3:-}"
    [[ "${SOURCE}" == "" ]] && return 1
    [[ "${META_DEST}" == "" ]] && return 1
    [[ "${CONTENT_DEST}" == "" ]] && return 1

    # prepare output files
    rm -f "${META_DEST}" "${CONTENT_DEST}"
    : > "${META_DEST}" || return 1
    : > "${CONTENT_DEST}" || {
        rm -f "${META_DEST}"
        return 1
    }

    # extract frontmatter and content
    awk -v meta_out="${META_DEST}" -v content_out="${CONTENT_DEST}" '
    NR == 1 {
        if ($0 ~ /^---[ ]*(#.*)?$/) {
            have_yaml = 1
            in_yaml = 1
            if (meta_out != "") {
                print "---" > meta_out
            }
            next
        }
    }
    have_yaml && in_yaml {
        if ($0 ~ /^---[ ]*(#.*)?$/) {
            in_yaml = 0
            next
        }
        if (meta_out != "") {
            print >> meta_out
        }
        next
    }
    {
        print >> content_out
    }
    END {
        if (!have_yaml) {
            exit 1
        }
        if (meta_out != "") {
            print "..." >> meta_out
        }
    }' "${SOURCE}"

    # clean up on failure
    if [[ "$?" -ne 0 ]] || [[ ! -f "${META_DEST}" ]] || [[ ! -f "${CONTENT_DEST}" ]]; then
        rm -f "${META_DEST}" "${CONTENT_DEST}" 2>/dev/null
        return 1
    fi

    return 0
}

# loads cached archive metadata for a document
function marsh_get_archive_metadata {  # marsh_get_archive_metadata target_dir document
    local TARGET_DIR DOCUMENT
    local INDEX META DOCUMENT_SOURCE META_PREFIX META_ASSIGNMENTS META_VARS
    local TYPE_VAR TYPE URI ABSPATH STATE VALUE_ESC

    # init
    TARGET_DIR="${1:-}"
    DOCUMENT="${2:-}"
    [[ "${TARGET_DIR}" == "" ]] && return 1
    [[ "${DOCUMENT}" == "" ]] && return 1

    # use cache where available
    INDEX="${TARGET_DIR}/${DOCUMENT%.document}.archive-meta"
    if [[ -f "${INDEX}" ]] && [[ -r "${INDEX}" ]]; then
        cat "${INDEX}"
        return 0
    fi

    # get archive metadata from the document metadata
    META="${TARGET_DIR}/${DOCUMENT%.document}.meta.yaml"
    DOCUMENT_SOURCE="${DOCUMENT%.${MARSH_UID}.document}"
    [[ "${DOCUMENT_SOURCE}" == "${DOCUMENT}" ]] && DOCUMENT_SOURCE="${DOCUMENT%.document}"
    [[ -f "${META}" ]] && [[ -r "${META}" ]] || return 1

    # parse
    META_PREFIX=$(echo "marsh_archive_${META}_" | sed -E -e 's/[^A-Za-z0-9_]/_/g')
    META_PREFIX=$(echo "${META_PREFIX}" | sed -E -e 's/_{2,}/_/g')
    META_ASSIGNMENTS=$(marsh_parse_yaml "${META}" "${META_PREFIX}")
    [[ $? -ne 0 ]] && return 1
    META_VARS=$(echo "${META_ASSIGNMENTS}" | marsh_get_variables)
    eval "$(printf '%s\n' "${META_VARS}" | marsh_get_local_declarations)"
    eval "${META_ASSIGNMENTS}"

    # keep only the metadata that archive generation actually needs
    # reconstruct public paths here so archive generation does not need to repeat it
    TYPE_VAR="${META_PREFIX}Type"
    TYPE="${!TYPE_VAR:-}"
    URI="${TARGET_DIR#$MARSH_CONFIG_PATH}"
    URI="${MARSH_CONFIG_URL%/}/${URI#/}/${DOCUMENT_SOURCE}"
    URI="${URI%.markdown}.html"
    ABSPATH=""
    [[ "${URI}" =~ / ]] && ABSPATH="${URI%/*}"

    # reconstruct state array
    STATE=()
    eval $(marsh_flat_to_array "STATE" "${META_PREFIX}State_")

    # output shell variable assignments
    printf 'TYPE=%q\n' "${TYPE}"
    printf 'URI=%q\n' "${URI}"
    printf 'ABSPATH=%q\n' "${ABSPATH}"
    echo "STATE=()"
    for VALUE_ESC in "${STATE[@]}"; do
        printf 'STATE+=(%q)\n' "${VALUE_ESC}"
    done

    return 0
}

# builds a sorted archive manifest from cached archive metadata
function marsh_build_archive_manifest {  # marsh_build_archive_manifest target_dir
    local TARGET_DIR DOCUMENTS_LIST DOCUMENT TYPE URI ABSPATH STATE
    local ARCHIVE_META STATE_JOINED OIFS

    TARGET_DIR="${1:-}"
    [[ "${TARGET_DIR}" == "" ]] && return 1

    DOCUMENTS_LIST=$(cd "${TARGET_DIR}" && find . -name '*.'"${MARSH_UID}"'.document' | sed 's/^\.\///' | sort -nr -t/)
    while IFS= read -r DOCUMENT; do
        [[ "${DOCUMENT}" == "" ]] && continue
        TYPE=""
        URI=""
        ABSPATH=""
        STATE=()
        ARCHIVE_META=$(marsh_get_archive_metadata "${TARGET_DIR}" "${DOCUMENT}")
        [[ $? -ne 0 ]] && echo "Unable to load archive metadata: ${TARGET_DIR}/${DOCUMENT%.document}.meta.yaml" >&2 && return 1
        eval "${ARCHIVE_META}"
        OIFS="${IFS}"
        IFS=$(printf '\034')
        STATE_JOINED="${STATE[*]}"
        IFS="${OIFS}"
        printf '%q\t%q\t%q\t%q\t%q\n' "${DOCUMENT}" "${TYPE}" "${URI}" "${ABSPATH}" "${STATE_JOINED}"
    done <<< "${DOCUMENTS_LIST}"

    return 0
}

# returns the path to a cached archive manifest, building it where needed
function marsh_get_archive_manifest {  # marsh_get_archive_manifest target_dir
    local TARGET_DIR CACHE_DIR CACHE_KEY CACHE_FILE CACHE_TEMP

    TARGET_DIR="${1:-}"
    [[ "${TARGET_DIR}" == "" ]] && return 1

    CACHE_DIR="${MARSH_TEMP}/archive-manifest-cache"
    mkdir -p "${CACHE_DIR}" >/dev/null 2>&1 || {
        echo "Unable to create archive manifest cache directory: ${CACHE_DIR}" >&2
        return 1
    }
    CACHE_KEY=$(printf '%s\034%s\n' "${TARGET_DIR}" "${MARSH_UID}" | marsh_text_filter hash:md5)
    CACHE_FILE="${CACHE_DIR}/${CACHE_KEY}.manifest"
    if [[ -f "${CACHE_FILE}" ]] && [[ -r "${CACHE_FILE}" ]]; then
        printf '%s\n' "${CACHE_FILE}"
        return 0
    fi

    CACHE_TEMP=$(mktemp "${CACHE_DIR}/manifest-XXXXXX") || {
        echo "Unable to create archive manifest cache file: ${CACHE_DIR}/manifest-XXXXXX" >&2
        return 1
    }
    marsh_build_archive_manifest "${TARGET_DIR}" > "${CACHE_TEMP}" && mv "${CACHE_TEMP}" "${CACHE_FILE}" 2>/dev/null || {
        echo "Unable to build archive manifest: ${TARGET_DIR}" >&2
        rm -f "${CACHE_TEMP}"
        return 1
    }
    printf '%s\n' "${CACHE_FILE}"
    return 0
}

# finds the closest generated advanced navigation file for a document
function marsh_find_advanced_nav {  # marsh_find_advanced_nav target_dir document navigation_file
    local TARGET_DIR DOCUMENT NAV_FILE DOCUMENT_DIR SEARCH_DIR NAV_PATH

    # init
    TARGET_DIR="${1:-}"
    DOCUMENT="${2:-}"
    NAV_FILE="${3:-}"
    [[ "${TARGET_DIR}" == "" ]] && return 1
    [[ "${DOCUMENT}" == "" ]] && return 1
    [[ "${NAV_FILE}" == "" ]] && return 1

    # set up document path and search directory
    if [[ "${DOCUMENT#${TARGET_DIR}/}" != "${DOCUMENT}" ]]; then
        DOCUMENT="${DOCUMENT#${TARGET_DIR}/}"
    fi
    DOCUMENT="${DOCUMENT#./}"
    DOCUMENT_DIR="./${DOCUMENT}"
    DOCUMENT_DIR="${DOCUMENT_DIR%/*}"
    DOCUMENT_DIR="${DOCUMENT_DIR#./}"
    DOCUMENT_DIR="${DOCUMENT_DIR:-.}"
    SEARCH_DIR="${DOCUMENT_DIR}"

    # search for advanced nav file in document directory and parent directories
    while true; do
        NAV_PATH="${NAV_FILE#\./}.${MARSH_UID}.advanced-nav.html"
        if [[ "${SEARCH_DIR}" != "." ]]; then
            NAV_PATH="${SEARCH_DIR}/${NAV_PATH}"
        fi
        if [[ -f "${TARGET_DIR}/${NAV_PATH}" ]] && [[ -r "${TARGET_DIR}/${NAV_PATH}" ]]; then
            printf '%s\n' "${NAV_PATH}"
            return 0
        fi
        [[ "${SEARCH_DIR}" == "." ]] && break
        if [[ "${SEARCH_DIR}" =~ / ]]; then
            SEARCH_DIR="${SEARCH_DIR%/*}"
        else
            SEARCH_DIR="."
        fi
    done
    return 1
}

# checks for required external tools
function marsh_check_dependencies {  # marsh_check_dependencies $DEP1 $DEP2 ...
    local DEPS ERRORS DEPS_EACH DEPS_MULTI FOUND DEP
    DEPS=("${@}");
    ERRORS=()
    for DEPS_EACH in "${DEPS[@]}"; do
        DEPS_MULTI=(${DEPS_EACH//|/ })
        FOUND=false
        for DEP in "${DEPS_MULTI[@]}"; do
            if [[ "${DEP}" == */* ]]; then
                if [[ -x "${DEP}" ]]; then
                    FOUND=true
                fi
                break
            elif hash "${DEP}" >/dev/null 2>&1; then
                FOUND=true
                break
            fi
        done
        if [[ "${FOUND}" == false ]]; then
            ERRORS+=("${DEPS_EACH}")
        fi
    done
    if [[ "${#ERRORS[@]}" -ne 0 ]]; then
        echo "dependencies: ${DEPS[@]}" >&2
        echo "unable to find command(s): ${ERRORS[*]}" >&2
        return 1
    fi
}

# prints bash variable assignments for template metadata
function marsh_parse_template_metadata {  # marsh_parse_template_metadata prefix template_dir #template_overrides[@] template_overrides[@]
    local PREFIX TEMPLATE_DIR NUM_TEMPLATE_OVERRIDES TEMPLATE_OVERRIDE TEMPLATE_OVERRIDES
    local TEMPLATE_META TEMPLATE_META_VARS
    local TEMPLATE_ASSETS_FONTS TEMPLATE_ASSETS_STYLES TEMPLATE_ASSETS_SCRIPTS TEMPLATE_ASSETS_IMAGES TEMPLATE_ASSETS_AUDIO TEMPLATE_ASSETS_VIDEO TEMPLATE_ASSETS_DOCUMENTS TEMPLATE_ASSETS_OTHER
    local INDEX ASSET_TYPES ASSET_TYPE ASSET_TYPE_UPPER ASSET FILTER_INDEX REGEX EXTENDED MATCH REPLACE EXTRA
    local ASSETS_INDEX ASSETS_TYPE ASSETS ASSETS_TEMP OIFS

    # init
    PREFIX="${1:-}"
    TEMPLATE_DIR="${2:-}"
    [[ "${TEMPLATE_DIR}" == "" ]] && return 1
    shift 2
    NUM_TEMPLATE_OVERRIDES="${1:-0}"
    shift 1
    TEMPLATE_OVERRIDES=()
    while [[ "${NUM_TEMPLATE_OVERRIDES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        TEMPLATE_OVERRIDES+=("${1}")
        NUM_TEMPLATE_OVERRIDES=$((NUM_TEMPLATE_OVERRIDES - 1))
        shift 1
    done

    # load config
    if [[ -f "${TEMPLATE_DIR}/template.yaml" ]] && [[ -r "${TEMPLATE_DIR}/template.yaml" ]]; then
        TEMPLATE_META=$(marsh_parse_yaml "${TEMPLATE_DIR}/template.yaml" "MARSH_TEMPLATE_")
        [[ $? -ne 0 ]] && echo "Unable to parse yaml file: ${TEMPLATE_DIR}/template.yaml" >&2 && return 1
        TEMPLATE_META_VARS=$(echo "${TEMPLATE_META}" | marsh_get_variables)
        eval "$(printf '%s\n' "${TEMPLATE_META_VARS}" | marsh_get_local_declarations)"
        eval "${TEMPLATE_META}"
    else
        echo "Template configuration file not found: ${TEMPLATE_DIR}/template.yaml" >&2
        return 1
    fi
    for TEMPLATE_OVERRIDE in "${TEMPLATE_OVERRIDES[@]}"; do
        [[ "${TEMPLATE_OVERRIDE}" == "" ]] && continue
        if [[ -f "${TEMPLATE_OVERRIDE}" ]] && [[ -r "${TEMPLATE_OVERRIDE}" ]]; then
            TEMPLATE_META=$(marsh_parse_yaml "${TEMPLATE_OVERRIDE}" "MARSH_TEMPLATE_")
            [[ $? -ne 0 ]] && echo "Unable to parse yaml file: ${TEMPLATE_OVERRIDE}" >&2 && return 1
            TEMPLATE_META_VARS=$(echo "${TEMPLATE_META_VARS}"$'\n'"${TEMPLATE_META}" | marsh_get_variables)
            eval "$(printf '%s\n' "${TEMPLATE_META_VARS}" | marsh_get_local_declarations)"
            eval "${TEMPLATE_META}"
        else
            echo "Template configuration override file not found: ${TEMPLATE_OVERRIDE}" >&2
            return 1
        fi
    done

    # print partials paths relative to template dir
    [[ "${MARSH_TEMPLATE_Template_Partials_Base:-}"     != "" ]] && echo "${PREFIX}Template_Partials_Base=\"${TEMPLATE_DIR}/${MARSH_TEMPLATE_Template_Partials_Base//\"/\\\"}\""
    [[ "${MARSH_TEMPLATE_Template_Partials_Body:-}"     != "" ]] && echo "${PREFIX}Template_Partials_Body=\"${TEMPLATE_DIR}/${MARSH_TEMPLATE_Template_Partials_Body//\"/\\\"}\""
    [[ "${MARSH_TEMPLATE_Template_Partials_Document:-}" != "" ]] && echo "${PREFIX}Template_Partials_Document=\"${TEMPLATE_DIR}/${MARSH_TEMPLATE_Template_Partials_Document//\"/\\\"}\""
    [[ "${MARSH_TEMPLATE_Template_Partials_Header:-}"   != "" ]] && echo "${PREFIX}Template_Partials_Header=\"${TEMPLATE_DIR}/${MARSH_TEMPLATE_Template_Partials_Header//\"/\\\"}\""
    [[ "${MARSH_TEMPLATE_Template_Partials_Nav:-}"      != "" ]] && echo "${PREFIX}Template_Partials_Nav=\"${TEMPLATE_DIR}/${MARSH_TEMPLATE_Template_Partials_Nav//\"/\\\"}\""
    [[ "${MARSH_TEMPLATE_Template_Partials_Notice:-}"   != "" ]] && echo "${PREFIX}Template_Partials_Notice=\"${TEMPLATE_DIR}/${MARSH_TEMPLATE_Template_Partials_Notice//\"/\\\"}\""
    [[ "${MARSH_TEMPLATE_Template_Partials_Footer:-}"   != "" ]] && echo "${PREFIX}Template_Partials_Footer=\"${TEMPLATE_DIR}/${MARSH_TEMPLATE_Template_Partials_Footer//\"/\\\"}\""
    [[ "${MARSH_TEMPLATE_Template_Partials_Redirect:-}" != "" ]] && echo "${PREFIX}Template_Partials_Redirect=\"${TEMPLATE_DIR}/${MARSH_TEMPLATE_Template_Partials_Redirect//\"/\\\"}\""
    [[ "${MARSH_TEMPLATE_Template_Partials_Archive_HTML_Body:-}"     != "" ]] && echo "${PREFIX}Template_Partials_Archive_HTML_Body=\"${TEMPLATE_DIR}/${MARSH_TEMPLATE_Template_Partials_Archive_HTML_Body//\"/\\\"}\""
    [[ "${MARSH_TEMPLATE_Template_Partials_Archive_HTML_Document:-}" != "" ]] && echo "${PREFIX}Template_Partials_Archive_HTML_Document=\"${TEMPLATE_DIR}/${MARSH_TEMPLATE_Template_Partials_Archive_HTML_Document//\"/\\\"}\""
    [[ "${MARSH_TEMPLATE_Template_Partials_Archive_Atom_Body:-}"     != "" ]] && echo "${PREFIX}Template_Partials_Archive_Atom_Body=\"${TEMPLATE_DIR}/${MARSH_TEMPLATE_Template_Partials_Archive_Atom_Body//\"/\\\"}\""
    [[ "${MARSH_TEMPLATE_Template_Partials_Archive_Atom_Document:-}" != "" ]] && echo "${PREFIX}Template_Partials_Archive_Atom_Document=\"${TEMPLATE_DIR}/${MARSH_TEMPLATE_Template_Partials_Archive_Atom_Document//\"/\\\"}\""
    [[ "${MARSH_TEMPLATE_Template_Partials_Archive_JSON_Body:-}"     != "" ]] && echo "${PREFIX}Template_Partials_Archive_JSON_Body=\"${TEMPLATE_DIR}/${MARSH_TEMPLATE_Template_Partials_Archive_JSON_Body//\"/\\\"}\""
    [[ "${MARSH_TEMPLATE_Template_Partials_Archive_JSON_Document:-}" != "" ]] && echo "${PREFIX}Template_Partials_Archive_JSON_Document=\"${TEMPLATE_DIR}/${MARSH_TEMPLATE_Template_Partials_Archive_JSON_Document//\"/\\\"}\""

    # assets
    ASSET_TYPES=('Fonts' 'Styles' 'Scripts' 'Images' 'Audio' 'Video' 'Documents' 'Binaries' 'Other')
    for ASSET_TYPE in "${ASSET_TYPES[@]}"; do
        eval "TEMPLATE_ASSETS_${ASSET_TYPE}=()"
        INDEX=0
        ASSET="MARSH_TEMPLATE_Template_Assets_${ASSET_TYPE}_${INDEX}"
        ASSET="${!ASSET:-}"
        while [[ "${ASSET}" != "" ]]; do
            eval "TEMPLATE_ASSETS_${ASSET_TYPE}+=(\"${ASSET//\"/\\\"}\")"
            INDEX=$((INDEX+1))
            ASSET="MARSH_TEMPLATE_Template_Assets_${ASSET_TYPE}_${INDEX}"
            ASSET="${!ASSET:-}"
        done
    done

    # assets filters
    FILTER_INDEX=0
    REGEX="MARSH_TEMPLATE_Template_Filters_${FILTER_INDEX}_Regex"
    REGEX="${!REGEX:-}"
    EXTENDED="MARSH_TEMPLATE_Template_Filters_${FILTER_INDEX}_Extended"
    EXTENDED="${!EXTENDED:-}"
    # loop over assets filters
    while [[ "${REGEX}" != "" ]]; do
        # escape match
        if [[ "$(echo ${REGEX} | grep -E '^s/.+[^\]/.*[^\]/g?$')" == "${REGEX}" ]]; then
            MATCH=$(echo "${REGEX}" | sed -E 's/^s\/(.+[^\])\/.*[^\]\/g?/\1/' | sed 's/[[]\.|$(){}?+*^]/\\&/g')
            REPLACE=$(echo "${REGEX}" | sed -E 's/^s\/.+[^\]\/(.*[^\])\/g?/\1/')
            EXTRA=$(echo "${REGEX}" | sed -E 's/^s\/.+[^\]\/.*[^\]\/(g?)/\1/')
            REGEX="s/${MATCH}/${REPLACE}/${EXTRA}"
        elif [[ "$(echo ${REGEX} | grep -E '^s\|.+[^\]\|.*[^\]\|g?$')" == "${REGEX}" ]]; then
            MATCH=$(echo "${REGEX}" | sed -E 's/^s\|(.+[^\])\|.*[^\]\|g?/\1/' | sed 's/[[]\.|$(){}?+*^]/\\&/g')
            REPLACE=$(echo "${REGEX}" | sed -E 's/^s\|.+[^\]\|(.*[^\])\|g?/\1/')
            EXTRA=$(echo "${REGEX}" | sed -E 's/^s\|.+[^\]\|.*[^\]\|(g?)/\1/')
            REGEX="s|${MATCH}|${REPLACE}|${EXTRA}"
        elif [[ "$(echo ${REGEX} | grep -E '^/.+[^\]/d?$')" == "${REGEX}" ]]; then
            MATCH=$(echo "${REGEX}" | sed -E 's/^\/(.+[^\])\/d?/\1/' | sed 's/[[]\.|$(){}?+*^]/\\&/g')
            REPLACE=""
            EXTRA=$(echo "${REGEX}" | sed -E 's/^\/.+[^\]\/(d?)/\1/')
            REGEX="/${MATCH}/${EXTRA}"
        else
            continue
        fi
        ASSETS_INDEX=0
        ASSETS_TYPE="MARSH_TEMPLATE_Template_Filters_${FILTER_INDEX}_Assets_${ASSETS_INDEX}"
        ASSETS_TYPE="${!ASSETS_TYPE}"
        # loop over assets types for filter
        while [[ "${ASSETS_TYPE}" != "" ]]; do
            ASSETS="TEMPLATE_ASSETS_${ASSETS_TYPE}[@]"
            OIFS="${IFS}"
            IFS=$'\n'
            ASSETS=(${!ASSETS})
            IFS="${OIFS}"
            ASSETS_TEMP=()
            # loop over all individual assets of this type
            for ASSET in "${ASSETS[@]}"; do
                # do regex
                if [[ "${EXTENDED}" == true ]]; then
                    ASSET=$(echo "${ASSET}" | sed -E "${REGEX}" 2>/dev/null)
                else
                    ASSET=$(echo "${ASSET}" | sed "${REGEX}" 2>/dev/null)
                fi
                # remove empty
                if [[ "${ASSET:-}" != "" ]]; then
                    ASSETS_TEMP+=("${ASSET}")
                fi
            done
            # update original array
            eval "TEMPLATE_ASSETS_${ASSETS_TYPE}=()"
            for I in "${!ASSETS_TEMP[@]}"; do
                eval "TEMPLATE_ASSETS_${ASSETS_TYPE}+=(\"${ASSETS_TEMP[$I]//\"/\\\"}\")"
            done
            ASSETS_INDEX=$((ASSETS_INDEX+1))
            ASSETS_TYPE="MARSH_TEMPLATE_Template_Filters_${FILTER_INDEX}_Assets_${ASSETS_INDEX}"
            ASSETS_TYPE="${!ASSETS_TYPE:-}"
        done
        FILTER_INDEX=$((FILTER_INDEX+1))
        REGEX="MARSH_TEMPLATE_Template_Filters_${FILTER_INDEX}_Regex"
        REGEX="${!REGEX:-}"
        EXTENDED="MARSH_TEMPLATE_Template_Filters_${FILTER_INDEX}_Extended"
        EXTENDED="${!EXTENDED:-}"
        ASSETS_INDEX=0
        ASSETS_TYPE="MARSH_TEMPLATE_Template_Filters_${FILTER_INDEX}_Assets_${ASSETS_INDEX}"
        ASSETS_TYPE="${!ASSETS_TYPE:-}"
    done

    # print assets
    for ASSET_TYPE in "${ASSET_TYPES[@]}"; do
        ASSET_TYPE_UPPER=$(echo "${ASSET_TYPE}" | awk '{ print toupper($0) }')
        ASSETS="TEMPLATE_ASSETS_${ASSET_TYPE}[@]"
        OIFS="${IFS}"
        IFS=$'\n'
        ASSETS=(${!ASSETS})
        IFS="${OIFS}"
        echo "${PREFIX}ASSETS_${ASSET_TYPE_UPPER}=()"
        for ASSET in "${ASSETS[@]}"; do
            [[ "${ASSET:-}" != "" ]] && echo "${PREFIX}ASSETS_${ASSET_TYPE_UPPER}+=(\"${ASSET//\"/\\\"}\")"
        done
    done
}

# loads cached template metadata assignments where available
function marsh_get_template_metadata {  # marsh_get_template_metadata prefix template_dir #template_overrides[@] template_overrides[@]
    local PREFIX TEMPLATE_DIR NUM_TEMPLATE_OVERRIDES TEMPLATE_OVERRIDES
    local CACHE_DIR CACHE_KEY CACHE_FILE CACHE_TEMP TEMPLATE_META

    # init
    PREFIX="${1:-}"
    TEMPLATE_DIR="${2:-}"
    [[ "${TEMPLATE_DIR}" == "" ]] && return 1
    shift 2
    NUM_TEMPLATE_OVERRIDES="${1:-0}"
    shift 1
    TEMPLATE_OVERRIDES=()
    while [[ "${NUM_TEMPLATE_OVERRIDES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        TEMPLATE_OVERRIDES+=("${1}")
        NUM_TEMPLATE_OVERRIDES=$((NUM_TEMPLATE_OVERRIDES - 1))
        shift 1
    done

    # create cache directory and key
    CACHE_DIR="${MARSH_TEMP}/template-metadata-cache"
    mkdir -p "${CACHE_DIR}" >/dev/null 2>&1 || {
        echo "Unable to create template metadata cache directory: ${CACHE_DIR}" >&2
        return 1
    }
    CACHE_KEY=$(printf '%s\034' "${PREFIX}" "${TEMPLATE_DIR}" "${TEMPLATE_OVERRIDES[@]}" | marsh_text_filter hash:md5)
    CACHE_FILE="${CACHE_DIR}/${CACHE_KEY}.meta"
    if [[ -f "${CACHE_FILE}" ]] && [[ -r "${CACHE_FILE}" ]]; then
        cat "${CACHE_FILE}"
        return 0
    fi

    # parse and cache template metadata
    TEMPLATE_META=$(marsh_parse_template_metadata "${PREFIX}" "${TEMPLATE_DIR}" "${#TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_OVERRIDES[@]}")
    [[ $? -ne 0 ]] && return 1
    CACHE_TEMP=$(mktemp "${CACHE_DIR}/metadata-XXXXXX") || {
        echo "Unable to create template metadata cache file: ${CACHE_DIR}/metadata-XXXXXX" >&2
        return 1
    }
    printf '%s\n' "${TEMPLATE_META}" > "${CACHE_TEMP}" || {
        echo "Unable to write template metadata cache file: ${CACHE_TEMP}" >&2
        rm -f "${CACHE_TEMP}"
        return 1
    }
    mv "${CACHE_TEMP}" "${CACHE_FILE}" 2>/dev/null || rm -f "${CACHE_TEMP}"
    printf '%s\n' "${TEMPLATE_META}"
}

# loads target metadata into convenience variables
function marsh_get_target_metadata {  # marsh_get_target_metadata source_prefix prefix
