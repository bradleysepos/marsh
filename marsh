# copies planned source assets for a target
function marsh_copy_planned_target_source_assets {  # marsh_copy_planned_target_source_assets site_output_root log_level log_levels_csv force source_asset_records[@]
    local SITE_OUTPUT_ROOT LOG_LEVEL LOG_LEVELS_CSV FORCE TARGET_OUTPUT_REL TARGET_OUTPUT_ROOT SOURCE_ROOT
    local SOURCE_ASSET_RECORD SOURCE_RELPATH PLAN_TARGET_OUTPUT_REL PLAN_SOURCE_ROOT
    local ASSET_RELPATH SOURCE_RELPATH RECORD_TARGET_OUTPUT_REL RECORD_SOURCE_ROOT RECORD_REST
    local -a SOURCE_OBJECTS

    SITE_OUTPUT_ROOT="${1:-}"
    LOG_LEVEL="${2:-}"
    LOG_LEVELS_CSV="${3:-}"
    FORCE="${4:-}"
    shift 4
    [[ "${SITE_OUTPUT_ROOT}" == "" ]] && return 1

    # first record establishes the shared target context for the batch
    # later records must stay within the same TARGET_OUTPUT_REL and SOURCE_ROOT
    SOURCE_ROOT=""
    TARGET_OUTPUT_REL=""
    SOURCE_OBJECTS=()
    while [[ "${#@}" -gt 0 ]]; do
        SOURCE_ASSET_RECORD="${1:-}"
        shift 1
        [[ "${SOURCE_ASSET_RECORD}" == "" ]] && continue
        IFS=$'\037' read -r ASSET_RELPATH SOURCE_RELPATH RECORD_TARGET_OUTPUT_REL RECORD_SOURCE_ROOT RECORD_REST <<< "${SOURCE_ASSET_RECORD}"
        [[ "${ASSET_RELPATH}" != "" ]] || return 1
        [[ "${SOURCE_RELPATH}" != "" ]] || return 1
        [[ "${RECORD_TARGET_OUTPUT_REL}" != "" ]] || return 1
        [[ "${RECORD_SOURCE_ROOT}" != "" ]] || return 1
        [[ "${RECORD_REST}" == "" ]] || return 1

        # consume one target-scoped source assets batch at a time
        # mixed target contexts should be split by the caller
        if [[ "${SOURCE_ROOT}" == "" ]]; then
            SOURCE_ROOT="${RECORD_SOURCE_ROOT}"
            TARGET_OUTPUT_REL="${RECORD_TARGET_OUTPUT_REL}"
        else
            [[ "${SOURCE_ROOT}" == "${RECORD_SOURCE_ROOT}" ]] || return 1
            [[ "${TARGET_OUTPUT_REL}" == "${RECORD_TARGET_OUTPUT_REL}" ]] || return 1
        fi

        SOURCE_OBJECTS+=("${SOURCE_RELPATH}")
    done

    [[ "${#SOURCE_OBJECTS[@]}" -gt 0 ]] || return 0
    TARGET_OUTPUT_ROOT=$(marsh_get_target_directory_path "${SITE_OUTPUT_ROOT}/${TARGET_OUTPUT_REL}") || return 1
    marsh_copy_source_objects "${SOURCE_ROOT}" "${TARGET_OUTPUT_ROOT}" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}" "${FORCE}" "${SOURCE_OBJECTS[@]}" || return 1
}

# copies source-relative objects into a resolved target output root
function marsh_copy_source_objects {  # marsh_copy_source_objects source_dir target_output_root log_level log_levels_csv force source_objects[@]
    local SOURCE_DIR TARGET_OUTPUT_ROOT LOG_LEVEL LOG_LEVELS_CSV FORCE
    local LOG_LEVELS TARGET_OUTPUT_REL REL_PATH OUTPUT_PATH OUTPUT_RELPATH

    SOURCE_DIR="${1:-}"
    TARGET_OUTPUT_ROOT="${2:-}"
    LOG_LEVEL="${3:-}"
    LOG_LEVELS_CSV="${4:-}"
    FORCE="${5:-}"
    shift 5
    [[ "${SOURCE_DIR}" == "" ]] && return 1
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1

    TARGET_OUTPUT_REL=""
    if marsh_should_log "verbose" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}"; then
        TARGET_OUTPUT_REL=$(marsh_get_target_output_path "${TARGET_OUTPUT_ROOT}") || return 1
    fi

    mkdir -p "${TARGET_OUTPUT_ROOT}" >/dev/null 2>&1 || {
        echo "Unable to create path: ${TARGET_OUTPUT_ROOT}" >&2
        return 1
    }

    while [[ "${#@}" -gt 0 ]]; do
        REL_PATH="${1:-}"
        shift 1
        [[ "${REL_PATH}" == "" ]] && continue
        OUTPUT_PATH="${TARGET_OUTPUT_ROOT}/${REL_PATH}"
        if [[ -e "${OUTPUT_PATH}" ]] && [[ "${FORCE}" != true ]]; then
            echo "Path exists (--force to overwrite): ${OUTPUT_PATH}" >&2
            return 1
        fi
        mkdir -p "${OUTPUT_PATH%/*}" >/dev/null 2>&1 || {
            echo "Unable to create path: ${OUTPUT_PATH%/*}" >&2
            return 1
        }
        rm -rf "${OUTPUT_PATH}" || {
            echo "Unable to replace path: ${OUTPUT_PATH}" >&2
            return 1
        }
        cp -R "${SOURCE_DIR}/${REL_PATH}" "${OUTPUT_PATH}" || {
            echo "Unable to copy file: ${SOURCE_DIR}/${REL_PATH} -> ${OUTPUT_PATH}" >&2
            return 1
        }

        # path output at verbose level
        if marsh_should_log "verbose" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}"; then
            OUTPUT_RELPATH="${TARGET_OUTPUT_REL}/${REL_PATH}"
            OUTPUT_RELPATH=$(marsh_normalize_internal_path "${OUTPUT_RELPATH}") || return 1
            marsh_print_verbose_output_path "${OUTPUT_RELPATH}"
        fi
    done
}

# creates the cached source-root record for a target under the temporary directory
function marsh_create_target_source_root {  # marsh_create_target_source_root target_output_root source_root
    local TARGET_OUTPUT_ROOT SOURCE_ROOT TARGET_BUILD_TEMP_ROOT TARGET_SOURCE_ROOT_CACHE_FILE

    TARGET_OUTPUT_ROOT="${1:-}"
    SOURCE_ROOT="${2:-}"
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${SOURCE_ROOT}" == "" ]] && return 1
    [[ -d "${SOURCE_ROOT}" ]] || {
        echo "Target source root not found: ${SOURCE_ROOT}" >&2
        return 1
    }

    TARGET_BUILD_TEMP_ROOT=$(marsh_get_target_temp_root "${TARGET_OUTPUT_ROOT}") || return 1
    TARGET_SOURCE_ROOT_CACHE_FILE="${TARGET_BUILD_TEMP_ROOT}/source-root"
    mkdir -p "${TARGET_SOURCE_ROOT_CACHE_FILE%/*}" >/dev/null 2>&1 || {
        echo "Unable to create target source root path: ${TARGET_SOURCE_ROOT_CACHE_FILE%/*}" >&2
        return 1
    }
    printf '%s\n' "${SOURCE_ROOT}" > "${TARGET_SOURCE_ROOT_CACHE_FILE}" || {
        echo "Unable to write target source root path: ${TARGET_SOURCE_ROOT_CACHE_FILE}" >&2
        return 1
    }
}

# returns the common site source root for all configured targets
function marsh_get_site_source_root_path {  # marsh_get_site_source_root_path config_file_dir
    local CONFIG_FILE_DIR INDEX PREFIX TARGET_SOURCE_VALUE SOURCE_ROOT
    local -a SOURCE_ROOTS

    CONFIG_FILE_DIR="${1:-.}"
    [[ -d "${CONFIG_FILE_DIR}" ]] || {
        echo "Config file directory not found for site source root: ${CONFIG_FILE_DIR}" >&2
        return 1
    }
    CONFIG_FILE_DIR=$(cd "${CONFIG_FILE_DIR}" && (pwd -P . 2>/dev/null || command pwd)) || {
        echo "Unable to resolve config file directory for site source root: ${CONFIG_FILE_DIR}" >&2
        return 1
    }
    SOURCE_ROOTS=()
    INDEX=0
    PREFIX="CONFIG_Build_Targets_${INDEX}_"
    while marsh_load_target_source_value "${PREFIX}" "TARGET_SOURCE_VALUE"; do
        if [[ "${TARGET_SOURCE_VALUE}" != "" ]]; then
            if [[ ! "${TARGET_SOURCE_VALUE}" =~ ^/ ]]; then
                TARGET_SOURCE_VALUE="${CONFIG_FILE_DIR}/${TARGET_SOURCE_VALUE}"
            fi
            SOURCE_ROOT=$(marsh_get_source_root_path "${TARGET_SOURCE_VALUE}") || {
                echo "Unable to resolve configured target source root: ${TARGET_SOURCE_VALUE}" >&2
                return 1
            }
            SOURCE_ROOTS+=("${SOURCE_ROOT}")
        fi
        INDEX=$((INDEX + 1))
        PREFIX="CONFIG_Build_Targets_${INDEX}_"
    done
    [[ "${#SOURCE_ROOTS[@]}" -gt 0 ]] || {
        echo "No target sources configured for site source root resolution" >&2
        return 1
    }
    marsh_get_common_directory "${SOURCE_ROOTS[@]}" || {
        echo "Unable to determine common site source root from target sources" >&2
        return 1
    }
}

# returns a normalized relative source inventory for a source root
function marsh_get_directory_inventory {  # marsh_get_directory_inventory directory [skip_links]
    local DIRECTORY SKIP_LINKS

    DIRECTORY="${1:-}"
    SKIP_LINKS="${2:-false}"
    [[ "${DIRECTORY}" == "" ]] || [[ ! -d "${DIRECTORY}" ]] && return 1

    if [[ "${SKIP_LINKS}" == true ]]; then
        cd "${DIRECTORY}" >/dev/null 2>&1 && find . -type f 2>/dev/null | sed -e 's/^\.\///' -e 's/^\.$//'
    elif [[ "${SKIP_LINKS}" == false ]]; then
        cd "${DIRECTORY}" >/dev/null 2>&1 && find . \( -type f -o -type l \) 2>/dev/null | sed -e 's/^\.\///' -e 's/^\.$//'
    else
        return 1
    fi
}

# returns the base directory for a target source path
function marsh_get_source_root_path {  # marsh_get_source_root_path source_path
    local SOURCE_PATH SOURCE_ROOT

    SOURCE_PATH="${1:-}"
    [[ "${SOURCE_PATH}" == "" ]] && return 1
    if [[ -d "${SOURCE_PATH}" ]]; then
        SOURCE_ROOT="${SOURCE_PATH}"
    else
        SOURCE_ROOT="${SOURCE_PATH%/*}"
        SOURCE_ROOT="${SOURCE_ROOT:-.}"
    fi
    [[ -d "${SOURCE_ROOT}" ]] || return 1
    SOURCE_ROOT=$(cd "${SOURCE_ROOT}" && (pwd -P . 2>/dev/null || command pwd)) || return 1
    printf '%s\n' "${SOURCE_ROOT}"
}

# returns a cached output inventory for a site root optionally keyed by target output root, building it on miss
function marsh_get_site_output_inventory {  # marsh_get_site_output_inventory site_output_root [target_output_root] [skip_links]
    local SITE_OUTPUT_ROOT TARGET_OUTPUT_ROOT SKIP_LINKS INVENTORY_CACHE_DIR INVENTORY_KEY INVENTORY_FILE

    SITE_OUTPUT_ROOT="${1:-}"
    TARGET_OUTPUT_ROOT="${2:-}"
    SKIP_LINKS="${3:-false}"
    [[ "${SITE_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${SKIP_LINKS}" == true || "${SKIP_LINKS}" == false ]] || return 1

    # validate site and target directories
    marsh_get_target_directory_path "${SITE_OUTPUT_ROOT}" >/dev/null || return 1
    marsh_get_target_directory_path "${TARGET_OUTPUT_ROOT}" >/dev/null || return 1

    # share one output inventory cache per target, or if empty, across targets within the same build
    INVENTORY_CACHE_DIR="${MARSH_TEMP}/output-inventory"
    INVENTORY_KEY=$(printf '%s\n' "${SITE_OUTPUT_ROOT}" "${TARGET_OUTPUT_ROOT}" "${SKIP_LINKS}" | marsh_text_transform hash:md5) || return 1
    INVENTORY_FILE="${INVENTORY_CACHE_DIR}/${INVENTORY_KEY}.inventory"

    if [[ ! -f "${INVENTORY_FILE}" ]]; then
        mkdir -p "${INVENTORY_CACHE_DIR}" >/dev/null 2>&1 || {
            echo "Unable to create output inventory path: ${INVENTORY_CACHE_DIR}" >&2
            return 1
        }
        marsh_get_directory_inventory "${SITE_OUTPUT_ROOT}" "${SKIP_LINKS}" > "${INVENTORY_FILE}" || {
            rm -f "${INVENTORY_FILE}"
            echo "Unable to generate output inventory: ${SITE_OUTPUT_ROOT}" >&2
            return 1
        }
    fi

    cat "${INVENTORY_FILE}" || {
        echo "Unable to read output inventory file: ${INVENTORY_FILE}" >&2
        return 1
    }
}

# returns a cached source inventory for a target source root, building it on miss
function marsh_get_target_source_inventory {  # marsh_get_target_source_inventory target_output_root source_root [skip_links]
    local TARGET_OUTPUT_ROOT SOURCE_ROOT SKIP_LINKS INVENTORY_CACHE_DIR INVENTORY_KEY INVENTORY_FILE

    TARGET_OUTPUT_ROOT="${1:-}"
    SOURCE_ROOT="${2:-}"
    SKIP_LINKS="${3:-false}"
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${SOURCE_ROOT}" == "" ]] && return 1
    [[ -d "${SOURCE_ROOT}" ]] || return 1
    [[ "${SKIP_LINKS}" == true || "${SKIP_LINKS}" == false ]] || return 1

    # validate target directory path and source root
    marsh_get_target_directory_path "${TARGET_OUTPUT_ROOT}" >/dev/null || return 1
    SOURCE_ROOT=$(marsh_get_source_root_path "${SOURCE_ROOT}") || return 1

    # share one source inventory cache across targets within the same build
    INVENTORY_CACHE_DIR="${MARSH_TEMP}/source-inventory"
    INVENTORY_KEY=$(printf '%s\n' "${SOURCE_ROOT}" "${SKIP_LINKS}" | marsh_text_transform hash:md5) || return 1
    INVENTORY_FILE="${INVENTORY_CACHE_DIR}/${INVENTORY_KEY}.inventory"

    if [[ ! -f "${INVENTORY_FILE}" ]]; then
        mkdir -p "${INVENTORY_CACHE_DIR}" >/dev/null 2>&1 || {
            echo "Unable to create source inventory path: ${INVENTORY_CACHE_DIR}" >&2
            return 1
        }
        marsh_get_directory_inventory "${SOURCE_ROOT}" "${SKIP_LINKS}" > "${INVENTORY_FILE}" || {
            rm -f "${INVENTORY_FILE}"
            echo "Unable to generate source inventory: ${SOURCE_ROOT}" >&2
            return 1
        }
    fi

    cat "${INVENTORY_FILE}" || {
        echo "Unable to read source inventory file: ${INVENTORY_FILE}" >&2
        return 1
    }
}

# creates a plan for direct copy of source assets for a target based on the target source inventory
function marsh_plan_target_source_assets {  # marsh_plan_target_source_assets source site_output_root target_output_rel markdown_document_extensions_csv
    local SOURCE SITE_OUTPUT_ROOT TARGET_OUTPUT_REL MARKDOWN_DOCUMENT_EXTENSIONS_CSV
    local SOURCE_ROOT TARGET_OUTPUT_ROOT TARGET_SOURCE_INVENTORY_LINE
    local -a TARGET_SOURCE_INVENTORY_RECORDS

    SOURCE="${1:-}"
    SITE_OUTPUT_ROOT="${2:-}"
    TARGET_OUTPUT_REL="${3:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_CSV="${4:-}"
    [[ "${SOURCE}" == "" ]] && return 1
    [[ "${SITE_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${TARGET_OUTPUT_REL}" == "" ]] && return 1
    [[ "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" == "" ]] && return 1

    SOURCE_ROOT=$(marsh_get_source_root_path "${SOURCE}") || return 1
    TARGET_OUTPUT_ROOT=$(marsh_get_target_directory_path "${SITE_OUTPUT_ROOT}/${TARGET_OUTPUT_REL}") || return 1
    TARGET_SOURCE_INVENTORY_RECORDS=()
    while IFS= read -r TARGET_SOURCE_INVENTORY_LINE; do
        [[ "${TARGET_SOURCE_INVENTORY_LINE}" == "" ]] && continue
        TARGET_SOURCE_INVENTORY_RECORDS+=("${TARGET_SOURCE_INVENTORY_LINE}")
    done < <(marsh_get_target_source_inventory "${TARGET_OUTPUT_ROOT}" "${SOURCE_ROOT}") || return 1

    marsh_plan_target_source_assets_from_inventory "${SOURCE}" "${TARGET_OUTPUT_REL}" "${SOURCE_ROOT}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" "${TARGET_SOURCE_INVENTORY_RECORDS[@]}"
}

# creates a plan for direct copy of source assets for a target based on provided inventory records
function marsh_plan_target_source_assets_from_inventory {  # marsh_plan_target_source_assets_from_inventory source target_output_rel source_root markdown_document_extensions_csv inventory_records[@]
    local SOURCE TARGET_OUTPUT_REL SOURCE_ROOT MARKDOWN_DOCUMENT_EXTENSIONS_CSV
    local SOURCE_PATH_PATTERN REL_PATH REL_PATH_EXT MATCH_REL_PATH

    SOURCE="${1:-}"
    TARGET_OUTPUT_REL="${2:-}"
    SOURCE_ROOT="${3:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_CSV="${4:-}"
    [[ "${SOURCE}" == "" ]] && return 1
    [[ "${TARGET_OUTPUT_REL}" == "" ]] && return 1
    [[ "${SOURCE_ROOT}" == "" ]] && return 1
    [[ "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" == "" ]] && return 1

    shift 4
    SOURCE_PATH_PATTERN="${SOURCE##*/}"
    [[ -d "${SOURCE}" ]] && SOURCE_PATH_PATTERN=""
    TARGET_OUTPUT_REL=$(marsh_normalize_internal_path "${TARGET_OUTPUT_REL}") || return 1

    # emit source asset records from the provided inventory
    while [[ "${#@}" -gt 0 ]]; do
        REL_PATH="${1:-}"
        shift 1
        [[ "${REL_PATH}" == "" ]] && continue
        if [[ "${SOURCE_PATH_PATTERN}" != "" ]]; then
            MATCH_REL_PATH="${REL_PATH%%/*}"
            [[ "${REL_PATH}" == */* ]] || MATCH_REL_PATH="${REL_PATH}"
            [[ "${MATCH_REL_PATH}" == ${SOURCE_PATH_PATTERN} ]] || continue
        fi
        # markdown files are rendered instead of copied directly
        REL_PATH_EXT=$(marsh_get_extension "${REL_PATH}")
        if marsh_is_markdown_extension "${REL_PATH_EXT}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}"; then
            continue
        fi
        marsh_validate_record_fields "source asset record" "${REL_PATH}" "${REL_PATH}" "${TARGET_OUTPUT_REL}" "${SOURCE_ROOT}" || return 1
        printf '%s\037%s\037%s\037%s\n' "${REL_PATH}" "${REL_PATH}" "${TARGET_OUTPUT_REL}" "${SOURCE_ROOT}"
    done
}

#
# Target build context and planning
#

# builds a planned target
function marsh_build_planned_target {  # marsh_build_planned_target site_output_root log_level log_levels_csv jobs markdown_command markdown_options_csv markdown_document_extensions_csv markdown_document_extensions_replacement remove_link_filenames_csv target_plan_root [target_number]
    local SITE_OUTPUT_ROOT LOG_LEVEL LOG_LEVELS_CSV JOBS MARKDOWN_COMMAND MARKDOWN_OPTIONS_CSV MARKDOWN_DOCUMENT_EXTENSIONS_CSV MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT REMOVE_LINK_FILENAMES_CSV TARGET_PLAN_ROOT TARGET_NUMBER
    local TARGET_OUTPUT_REL TARGET_FORCE TARGET_SKIP_TEMPLATE_ASSETS TARGET_SITEMAP TARGET_SITEMAP_SEARCH
    local TEMPLATES_DIR TEMPLATE TEMPLATE_ASSETS_PATH BUILD_CONTEXT_TARGET_OUTPUT_REL BUILD_CONTEXT_SOURCE_ROOT
    local CONFIG_FILE_DIR TARGET_NAME TARGET_TEMPLATE_SOURCE TEMPLATE_OVERRIDE TEMPLATE_OVERRIDES_TEXT
    local TARGET_OUTPUT_ROOT CONTEXT_FILE DOCUMENTS_FILE SOURCE_ASSETS_FILE SITEMAPS_FILE ARCHIVE_PLANS_FILE PLAN_RECORD PLAN_RECORDS_COUNT
    local TARGET_ARCHIVE_PLAN_ROOT
    local TEMPLATE_ASSETS TEMPLATE_ASSETS_COUNT ARCHIVE_DOCUMENTS_COUNT ARCHIVE_DOCUMENTS_FILE TARGET_ARCHIVE_QUEUE_RECORDS_FILE
    local -a TEMPLATE_OVERRIDES DOCUMENT_RECORDS SOURCE_ASSET_RECORDS SITEMAP_RECORDS ARCHIVE_PLAN_ROOTS

    SITE_OUTPUT_ROOT="${1:-}"
    LOG_LEVEL="${2:-}"
    LOG_LEVELS_CSV="${3:-}"
    JOBS="${4:-1}"
    MARKDOWN_COMMAND="${5:-}"
    MARKDOWN_OPTIONS_CSV="${6:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_CSV="${7:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT="${8:-}"
    REMOVE_LINK_FILENAMES_CSV="${9:-}"
    TARGET_PLAN_ROOT="${10:-}"
    TARGET_NUMBER="${11:-}"
    [[ "${SITE_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${MARKDOWN_COMMAND}" == "" ]] && return 1
    [[ "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" == "" ]] && return 1
    [[ "${TARGET_PLAN_ROOT}" == "" ]] && return 1

    CONTEXT_FILE="${TARGET_PLAN_ROOT}/context"
    DOCUMENTS_FILE="${TARGET_PLAN_ROOT}/documents"
    SOURCE_ASSETS_FILE="${TARGET_PLAN_ROOT}/source-assets"
    SITEMAPS_FILE="${TARGET_PLAN_ROOT}/sitemaps"
    ARCHIVE_PLANS_FILE="${TARGET_PLAN_ROOT}/archive-plans"
    [[ -f "${CONTEXT_FILE}" ]] && [[ -r "${CONTEXT_FILE}" ]] || {
        echo "Target plan context file not found: ${CONTEXT_FILE}" >&2
        return 1
    }

    TEMPLATE_OVERRIDES=()
    TEMPLATE_OVERRIDES_TEXT=""
    marsh_load_target_plan_build_context \
        "${TARGET_PLAN_ROOT}" \
        "TARGET_OUTPUT_REL" \
        "TARGET_FORCE" \
        "TARGET_SKIP_TEMPLATE_ASSETS" \
        "TARGET_SITEMAP" \
        "TARGET_SITEMAP_SEARCH" \
        "TEMPLATES_DIR" \
        "TEMPLATE" \
        "TEMPLATE_ASSETS_PATH" \
        "BUILD_CONTEXT_TARGET_OUTPUT_REL" \
        "BUILD_CONTEXT_SOURCE_ROOT" \
        "CONFIG_FILE_DIR" \
        "TARGET_NAME" \
        "TARGET_TEMPLATE_SOURCE" \
        "TEMPLATE_OVERRIDES_TEXT" || return 1
    if [[ "${TEMPLATE_OVERRIDES_TEXT}" != "" ]]; then
        while IFS= read -r TEMPLATE_OVERRIDE; do
            TEMPLATE_OVERRIDES+=("${TEMPLATE_OVERRIDE}")
        done <<< "${TEMPLATE_OVERRIDES_TEXT}"
    fi
    [[ "${TARGET_OUTPUT_REL:-}" != "" ]] || {
        echo "Target plan context missing TARGET_OUTPUT_REL: ${CONTEXT_FILE}" >&2
        return 1
    }
    TARGET_OUTPUT_ROOT=$(marsh_get_target_directory_path "${SITE_OUTPUT_ROOT}/${TARGET_OUTPUT_REL}") || return 1

    DOCUMENT_RECORDS=()
    if [[ -f "${DOCUMENTS_FILE}" ]] && [[ -r "${DOCUMENTS_FILE}" ]]; then
        while IFS= read -r PLAN_RECORD; do
            [[ "${PLAN_RECORD}" == "" ]] && continue
            DOCUMENT_RECORDS+=("${PLAN_RECORD}")
        done < "${DOCUMENTS_FILE}"
    fi

    SOURCE_ASSET_RECORDS=()
    if [[ -f "${SOURCE_ASSETS_FILE}" ]] && [[ -r "${SOURCE_ASSETS_FILE}" ]]; then
        while IFS= read -r PLAN_RECORD; do
            [[ "${PLAN_RECORD}" == "" ]] && continue
            SOURCE_ASSET_RECORDS+=("${PLAN_RECORD}")
        done < "${SOURCE_ASSETS_FILE}"
    fi

    SITEMAP_RECORDS=()
    if [[ -f "${SITEMAPS_FILE}" ]] && [[ -r "${SITEMAPS_FILE}" ]]; then
        while IFS= read -r PLAN_RECORD; do
            [[ "${PLAN_RECORD}" == "" ]] && continue
            SITEMAP_RECORDS+=("${PLAN_RECORD}")
        done < "${SITEMAPS_FILE}"
    fi

    if [[ "${TARGET_SKIP_TEMPLATE_ASSETS}" != true ]] && [[ "${TEMPLATES_DIR}" != "" ]] && [[ "${TEMPLATE}" != "" ]]; then
        TEMPLATE_ASSETS_COUNT=0
        TEMPLATE_ASSETS=$(marsh_get_template_assets "${TEMPLATES_DIR}" "${TEMPLATE}" "${#TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_OVERRIDES[@]}") || return 1
        while IFS= read -r PLAN_RECORD; do
            [[ "${PLAN_RECORD}" == "" ]] && continue
            TEMPLATE_ASSETS_COUNT=$((TEMPLATE_ASSETS_COUNT + 1))
        done <<< "${TEMPLATE_ASSETS}"
        if marsh_should_log "info" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}" \
            && [[ "${TARGET_NUMBER}" != "" ]] \
            && [[ "${TEMPLATE_ASSETS_COUNT}" -gt 0 ]]; then
            echo "Target ${TARGET_NUMBER}: copying $(marsh_inflect 'template static asset' "${TEMPLATE_ASSETS_COUNT}")"
        fi
        marsh_copy_template_assets "${SITE_OUTPUT_ROOT}" "${TARGET_OUTPUT_REL}" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}" "${TEMPLATES_DIR}" "${TEMPLATE}" "${#TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_ASSETS_PATH}" || return 1
    fi

    if [[ "${#SOURCE_ASSET_RECORDS[@]}" -gt 0 ]]; then
        if marsh_should_log "info" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}" && [[ "${TARGET_NUMBER}" != "" ]]; then
            echo "Target ${TARGET_NUMBER}: copying $(marsh_inflect 'source tree object' "${#SOURCE_ASSET_RECORDS[@]}")"
        fi
        marsh_copy_planned_target_source_assets "${SITE_OUTPUT_ROOT}" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}" "${TARGET_FORCE}" "${SOURCE_ASSET_RECORDS[@]}" || return 1
    fi

    if [[ "${#SITEMAP_RECORDS[@]}" -gt 0 ]]; then
        if marsh_should_log "info" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}" && [[ "${TARGET_NUMBER}" != "" ]]; then
            echo "Target ${TARGET_NUMBER}: building $(marsh_inflect 'sitemap' "${#SITEMAP_RECORDS[@]}")"
        fi
        if ! marsh_build_planned_target_sitemaps "${TARGET_OUTPUT_ROOT}" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}" "${MARKDOWN_COMMAND}" "${MARKDOWN_OPTIONS_CSV}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" "${REMOVE_LINK_FILENAMES_CSV}" "${SITEMAP_RECORDS[@]}"; then
            echo "Unable to build one or more configured sitemaps in target: ${TARGET_OUTPUT_REL}" >&2
            return 1
        fi
    fi

    if [[ "${#DOCUMENT_RECORDS[@]}" -eq 0 ]] && [[ "${BUILD_CONTEXT_SOURCE_ROOT}" == "" ]]; then
        echo "Document source root not found for target: ${TARGET_OUTPUT_ROOT}" >&2
        return 1
    fi
    if [[ "${#DOCUMENT_RECORDS[@]}" -gt 0 ]]; then
        if marsh_should_log "info" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}" && [[ "${TARGET_NUMBER}" != "" ]]; then
            echo "Target ${TARGET_NUMBER}: building $(marsh_inflect 'document' "${#DOCUMENT_RECORDS[@]}")"
        fi
        if ! marsh_build_planned_target_documents "${SITE_OUTPUT_ROOT}" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}" "${JOBS}" "${TARGET_SITEMAP}" "${TARGET_SITEMAP_SEARCH}" "${TEMPLATES_DIR}" "${TEMPLATE}" "${MARKDOWN_COMMAND}" "${MARKDOWN_OPTIONS_CSV}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" "${REMOVE_LINK_FILENAMES_CSV}" "${#TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_OVERRIDES[@]}" "${TEMPLATE_ASSETS_PATH}" "${DOCUMENT_RECORDS[@]}"; then
            echo "Unable to build one or more documents in target: ${TARGET_OUTPUT_REL}" >&2
            return 1
        fi
    fi

    ARCHIVE_PLAN_ROOTS=()
    if [[ -f "${ARCHIVE_PLANS_FILE}" ]] && [[ -r "${ARCHIVE_PLANS_FILE}" ]]; then
        while IFS= read -r PLAN_RECORD; do
            [[ "${PLAN_RECORD}" == "" ]] && continue
            ARCHIVE_PLAN_ROOTS+=("${PLAN_RECORD}")
        done < "${ARCHIVE_PLANS_FILE}"
    fi

    if [[ "${#ARCHIVE_PLAN_ROOTS[@]}" -gt 0 ]]; then
        TARGET_ARCHIVE_QUEUE_RECORDS_FILE=$(marsh_get_target_archive_queue_records_path "${TARGET_PLAN_ROOT}") || return 1
        ARCHIVE_DOCUMENTS_COUNT=0
        if [[ -f "${TARGET_ARCHIVE_QUEUE_RECORDS_FILE}" ]] && [[ -r "${TARGET_ARCHIVE_QUEUE_RECORDS_FILE}" ]]; then
            PLAN_RECORDS_COUNT=$(wc -l < "${TARGET_ARCHIVE_QUEUE_RECORDS_FILE}") || return 1
            ARCHIVE_DOCUMENTS_COUNT=$((ARCHIVE_DOCUMENTS_COUNT + PLAN_RECORDS_COUNT))
        fi
        if marsh_should_log "info" "${LOG_LEVEL}" "${LOG_LEVELS_CSV}" && [[ "${TARGET_NUMBER}" != "" ]]; then
            echo "Target ${TARGET_NUMBER}: building $(marsh_inflect 'archive' "${#ARCHIVE_PLAN_ROOTS[@]}") with $(marsh_inflect 'output' "${ARCHIVE_DOCUMENTS_COUNT}")"
        fi
        marsh_build_target_archive_queue \
            "${SITE_OUTPUT_ROOT}" \
            "${LOG_LEVEL}" \
            "${LOG_LEVELS_CSV}" \
            "${JOBS}" \
            "${MARKDOWN_COMMAND}" \
            "${MARKDOWN_OPTIONS_CSV}" \
            "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" \
            "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" \
            "${REMOVE_LINK_FILENAMES_CSV}" \
            "${TARGET_PLAN_ROOT}" || return 1
    fi
}

# removes the temporary working directory for a target under the temporary directory
function marsh_clean_target_temp {  # marsh_clean_target_temp target_output_root
    local TARGET_OUTPUT_ROOT TARGET_BUILD_TEMP_ROOT

    TARGET_OUTPUT_ROOT="${1:-}"
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1

    TARGET_BUILD_TEMP_ROOT=$(marsh_get_target_temp_root "${TARGET_OUTPUT_ROOT}") || return 1
    rm -rf "${TARGET_BUILD_TEMP_ROOT}"
}

# recreates the planner-owned target plan root for a target and prints its path
function marsh_create_target_plan_root {  # marsh_create_target_plan_root target_output_root
    local TARGET_OUTPUT_ROOT TARGET_PLAN_ROOT

    TARGET_OUTPUT_ROOT="${1:-}"
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1

    TARGET_PLAN_ROOT=$(marsh_get_target_plan_root "${TARGET_OUTPUT_ROOT}") || return 1
    rm -rf "${TARGET_PLAN_ROOT}" >/dev/null 2>&1 || {
        echo "Unable to clean target plan path: ${TARGET_PLAN_ROOT}" >&2
        return 1
    }
    mkdir -p "${TARGET_PLAN_ROOT}" >/dev/null 2>&1 || {
        echo "Unable to create target plan path: ${TARGET_PLAN_ROOT}" >&2
        return 1
    }
    printf '%s\n' "${TARGET_PLAN_ROOT}"
}

# returns the normalized target directory path
function marsh_get_target_directory_path {  # marsh_get_target_directory_path target_output_root
    local TARGET_OUTPUT_ROOT

    TARGET_OUTPUT_ROOT="${1:-}"
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1

    TARGET_OUTPUT_ROOT="${TARGET_OUTPUT_ROOT%/}"
    TARGET_OUTPUT_ROOT="${TARGET_OUTPUT_ROOT%/.}"
    printf '%s\n' "${TARGET_OUTPUT_ROOT:-.}"
}

# derives normalized target/document path values shared by document and template builds
function marsh_get_target_document_paths {  # marsh_get_target_document_paths document site_output_root target_output_rel markdown_document_extensions_csv markdown_document_extensions_replacement target_output_root_var document_dir_var document_ext_var document_output_rel_var document_site_rel_var document_base_rel_var
    local DOCUMENT SITE_OUTPUT_ROOT TARGET_OUTPUT_REL MARKDOWN_DOCUMENT_EXTENSIONS_CSV MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT
    local TARGET_OUTPUT_ROOT_VAR DOCUMENT_DIR_VAR DOCUMENT_EXT_VAR DOCUMENT_OUTPUT_REL_VAR DOCUMENT_SITE_REL_VAR DOCUMENT_BASE_REL_VAR
    local DOCUMENT_EXT_VALUE DOCUMENT_DIR_VALUE TARGET_OUTPUT_ROOT_VALUE DOCUMENT_OUTPUT_REL_VALUE DOCUMENT_SITE_REL_VALUE DOCUMENT_BASE_REL_VALUE

    DOCUMENT="${1:-}"
    SITE_OUTPUT_ROOT="${2:-.}"
    TARGET_OUTPUT_REL="${3:-.}"
    MARKDOWN_DOCUMENT_EXTENSIONS_CSV="${4:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT="${5:-}"
    TARGET_OUTPUT_ROOT_VAR="${6:-}"
    DOCUMENT_DIR_VAR="${7:-}"
    DOCUMENT_EXT_VAR="${8:-}"
    DOCUMENT_OUTPUT_REL_VAR="${9:-}"
    DOCUMENT_SITE_REL_VAR="${10:-}"
    DOCUMENT_BASE_REL_VAR="${11:-}"
    [[ "${DOCUMENT}" == "" ]] && return 1
    [[ "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" == "" ]] && return 1
    [[ "${TARGET_OUTPUT_ROOT_VAR}" == "" ]] && return 1
    [[ "${DOCUMENT_DIR_VAR}" == "" ]] && return 1
    [[ "${DOCUMENT_EXT_VAR}" == "" ]] && return 1
    [[ "${DOCUMENT_OUTPUT_REL_VAR}" == "" ]] && return 1
    [[ "${DOCUMENT_SITE_REL_VAR}" == "" ]] && return 1
    [[ "${DOCUMENT_BASE_REL_VAR}" == "" ]] && return 1

    SITE_OUTPUT_ROOT="${SITE_OUTPUT_ROOT%/}"
    TARGET_OUTPUT_REL="${TARGET_OUTPUT_REL%/}"
    TARGET_OUTPUT_ROOT_VALUE="${SITE_OUTPUT_ROOT}/${TARGET_OUTPUT_REL}"
    TARGET_OUTPUT_ROOT_VALUE="${TARGET_OUTPUT_ROOT_VALUE%/.}"

    DOCUMENT_EXT_VALUE=$(marsh_get_extension "${DOCUMENT}")
    DOCUMENT_DIR_VALUE=$(marsh_get_internal_parent_directory "${DOCUMENT}") || return 1

    DOCUMENT_OUTPUT_REL_VALUE="${DOCUMENT}"
    if marsh_is_markdown_extension "${DOCUMENT_EXT_VALUE}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}"; then
        DOCUMENT_OUTPUT_REL_VALUE="${DOCUMENT_OUTPUT_REL_VALUE%.*}${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}"
    fi
    if [[ "${TARGET_OUTPUT_REL}" != "." ]]; then
        DOCUMENT_OUTPUT_REL_VALUE="${TARGET_OUTPUT_REL}/${DOCUMENT_OUTPUT_REL_VALUE}"
    fi
    DOCUMENT_OUTPUT_REL_VALUE="${DOCUMENT_OUTPUT_REL_VALUE#./}"

    DOCUMENT_SITE_REL_VALUE=$(marsh_normalize_internal_path "${TARGET_OUTPUT_REL}/${DOCUMENT}") || return 1
    DOCUMENT_BASE_REL_VALUE=$(marsh_normalize_internal_path "${TARGET_OUTPUT_REL}/${DOCUMENT_DIR_VALUE}" "directory") || return 1

    # write derived document paths into caller-owned locals
    printf -v "${TARGET_OUTPUT_ROOT_VAR}" '%s' "${TARGET_OUTPUT_ROOT_VALUE}"
    printf -v "${DOCUMENT_DIR_VAR}" '%s' "${DOCUMENT_DIR_VALUE}"
    printf -v "${DOCUMENT_EXT_VAR}" '%s' "${DOCUMENT_EXT_VALUE}"
    printf -v "${DOCUMENT_OUTPUT_REL_VAR}" '%s' "${DOCUMENT_OUTPUT_REL_VALUE}"
    printf -v "${DOCUMENT_SITE_REL_VAR}" '%s' "${DOCUMENT_SITE_REL_VALUE}"
    printf -v "${DOCUMENT_BASE_REL_VAR}" '%s' "${DOCUMENT_BASE_REL_VALUE}"
}

# returns the normalized target path relative to the site output root
