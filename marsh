# loads cached document metadata assignments where available, creating the cache from the source metadata when needed
function marsh_get_document_metadata {  # marsh_get_document_metadata meta_file [prefix]
    local META_FILE PREFIX CACHE_FILE CACHE_FILE_CONTENTS CACHE_TEMP META_ASSIGNMENTS META_ASSIGNMENT
    local META_NAME META_VALUE

    META_FILE="${1:-}"
    PREFIX="${2:-}"
    [[ "${META_FILE}" == "" ]] && return 1

    CACHE_FILE="${META_FILE%.yaml}"
    if [[ -f "${CACHE_FILE}" ]] && [[ -r "${CACHE_FILE}" ]]; then
        # use existing cache if available
        CACHE_FILE_CONTENTS="$(<"${CACHE_FILE}")"
        if [[ $? -ne 0 ]]; then
            echo "Unable to read document metadata cache file: ${CACHE_FILE}" >&2
            return 1
        fi
    else
        # no existing cache, proceed to generate it
        # acquire lock for cache file creation
        if ! marsh_lock_acquire "${CACHE_FILE}" 2>/dev/null; then
            # unable to acquire lock, likely due to another process generating the cache file
            # wait a while for the lock to be released and attempt to use the cache file if it exists
            if marsh_lock_wait "${CACHE_FILE}" 2>/dev/null; then
                # lock released, use existing cache if available
                if [[ ! -f "${CACHE_FILE}" ]] || [[ ! -r "${CACHE_FILE}" ]]; then
                    # fail fast when the first writer releases the lock without publishing
                    # lock ownership is not retried because a write failure aborts the whole build
                    echo "Document metadata cache file missing after lock wait: ${CACHE_FILE}" >&2
                    return 1
                fi
                CACHE_FILE_CONTENTS="$(<"${CACHE_FILE}")"
                if [[ $? -ne 0 ]]; then
                    echo "Unable to read document metadata cache file: ${CACHE_FILE}" >&2
                    return 1
                fi
                # fall through to output cache file contents below
            else
                # error on timeout waiting for lock to be released
                echo "Unable to acquire document metadata cache lock: ${CACHE_FILE}" >&2
                return 1
            fi
        else
            # lock acquired, proceed generating cache file
            # generate temporary cache file in lock directory
            CACHE_TEMP=$(marsh_lock_get_directory "${CACHE_FILE}")
            CACHE_TEMP="${CACHE_TEMP}/tempfile"
            touch "${CACHE_TEMP}" 2>/dev/null || {
                echo "Unable to create document metadata cache file: ${CACHE_TEMP}" >&2
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }

            # parse metadata from source file
            [[ -f "${META_FILE}" ]] && [[ -r "${META_FILE}" ]] || {
                echo "Document metadata file not found for cache generation: ${META_FILE}" >&2
                rm -f "${CACHE_TEMP}"
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }
            META_ASSIGNMENTS=$(marsh_parse_yaml < "${META_FILE}")
            [[ $? -ne 0 ]] && {
                echo "Unable to parse document metadata for cache generation: ${META_FILE}" >&2
                rm -f "${CACHE_TEMP}"
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }

            # write metadata assignments to temporary cache file
            while IFS= read -r META_ASSIGNMENT; do
                [[ "${META_ASSIGNMENT}" == "" ]] && continue
                META_NAME="${META_ASSIGNMENT%%=*}"
                META_VALUE="${META_ASSIGNMENT#*=}"
                printf '%s=%s\n' "${META_NAME#_}" "${META_VALUE}" >> "${CACHE_TEMP}" || {
                    rm -f "${CACHE_TEMP}"
                    marsh_lock_release "${CACHE_FILE}"
                    return 1
                }
            done <<< "${META_ASSIGNMENTS}"

            # move temporary cache file into place as shared cache file
            mv "${CACHE_TEMP}" "${CACHE_FILE}" 2>/dev/null || {
                echo "Unable to write document metadata cache file: ${CACHE_FILE}" >&2
                rm -f "${CACHE_TEMP}"
                marsh_lock_release "${CACHE_FILE}"
                return 1
            }

            # read shared cache file contents and release lock
            CACHE_FILE_CONTENTS="$(<"${CACHE_FILE}")"
            if [[ $? -ne 0 ]]; then
                echo "Unable to read document metadata cache file: ${CACHE_FILE}" >&2
                marsh_lock_release "${CACHE_FILE}"
                return 1
            fi
            marsh_lock_release "${CACHE_FILE}" || {
                echo "Unable to release document metadata cache lock: ${CACHE_FILE}" >&2
                return 1
            }
            # fall through to output cache file contents below
        fi
    fi

    # output metadata assignments from cache file contents with optional prefix for namespacing
    {
        while IFS= read -r META_ASSIGNMENT; do
            [[ "${META_ASSIGNMENT}" == "" ]] && continue
            META_NAME="${META_ASSIGNMENT%%=*}"
            META_VALUE="${META_ASSIGNMENT#*=}"
            printf '%s%s=%s\n' "${PREFIX}" "${META_NAME}" "${META_VALUE}"
        done <<< "${CACHE_FILE_CONTENTS}"
    } || {
        echo "Unable to read document metadata cache file: ${CACHE_FILE}" >&2
        return 1
    }
    return 0
}

# resolves a document temp artifact path under the target temp work tree
function marsh_get_document_temp_path {  # marsh_get_document_temp_path target_output_root document artifact
    local TARGET_OUTPUT_ROOT DOCUMENT ARTIFACT TARGET_BUILD_TEMP_ROOT DOCUMENT_KEY DOCUMENT_ROOT

    TARGET_OUTPUT_ROOT="${1:-}"
    DOCUMENT="${2:-}"
    ARTIFACT="${3:-}"
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${DOCUMENT}" == "" ]] && return 1
    [[ "${ARTIFACT}" == "" ]] && return 1
    [[ "${DOCUMENT}" != /* ]] || return 1

    TARGET_BUILD_TEMP_ROOT=$(marsh_get_target_temp_root "${TARGET_OUTPUT_ROOT}") || return 1
    # Document temp artifacts are keyed by site-relative document path so nested target builds share them.
    DOCUMENT_KEY=$(marsh_normalize_internal_path "${DOCUMENT}") || return 1
    [[ "${DOCUMENT_KEY}" == "." ]] && return 1
    DOCUMENT_ROOT="${TARGET_BUILD_TEMP_ROOT}/documents/${DOCUMENT_KEY}"

    case "${ARTIFACT}" in
        root)
            printf '%s\n' "${DOCUMENT_ROOT}"
            ;;
        content)
            printf '%s\n' "${DOCUMENT_ROOT}/content"
            ;;
        is-rendered)
            printf '%s\n' "${DOCUMENT_ROOT}/is-rendered"
            ;;
        meta-yaml)
            printf '%s\n' "${DOCUMENT_ROOT}/meta.yaml"
            ;;
        meta)
            printf '%s\n' "${DOCUMENT_ROOT}/meta"
            ;;
        *)
            return 1
            ;;
    esac
}

# resolves the temp render path for a processed output file under the target temp work tree
function marsh_get_render_temp_path {  # marsh_get_render_temp_path target_output_root output_path
    local TARGET_OUTPUT_ROOT OUTPUT_PATH TARGET_BUILD_TEMP_ROOT OUTPUT_KEY

    TARGET_OUTPUT_ROOT="${1:-}"
    OUTPUT_PATH="${2:-}"
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${OUTPUT_PATH}" == "" ]] && return 1
    [[ "${OUTPUT_PATH}" != /* ]] || return 1

    TARGET_BUILD_TEMP_ROOT=$(marsh_get_target_temp_root "${TARGET_OUTPUT_ROOT}") || return 1
    OUTPUT_KEY=$(marsh_normalize_internal_path "${OUTPUT_PATH}") || return 1
    [[ "${OUTPUT_KEY}" == "." ]] && return 1

    printf '%s\n' "${TARGET_BUILD_TEMP_ROOT}/render/${OUTPUT_KEY}"
}

# returns success when file begins with yaml frontmatter
function marsh_has_frontmatter {  # marsh_has_frontmatter source
