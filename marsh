# transforms markdown and html headings to increase/decrease levels or remove entirely
function marsh_text_transform_headings {  # marsh_text_transform_headings action
    local ACTION="${1:-}"
    awk -v ACTION="${ACTION}" '
    BEGIN {
        prefix[1] = "# "
        prefix[2] = "## "
        prefix[3] = "### "
        prefix[4] = "#### "
        prefix[5] = "##### "
        prefix[6] = "###### "
    }

    function remove_html_tags(line, result, rest, prefix_text, open_tag, level, rest_after_tag, close_tag, close_pos) {
        result = ""
        rest = line

        # remove matched heading elements in source order
        while (match(rest, /<h[1-6][^>]*>/)) {
            prefix_text = substr(rest, 1, RSTART - 1)
            open_tag = substr(rest, RSTART, RLENGTH)
            level = substr(open_tag, 3, 1) + 0
            rest_after_tag = substr(rest, RSTART + RLENGTH)
            close_tag = "</h" level ">"
            close_pos = index(rest_after_tag, close_tag)
            if (close_pos == 0) {
                result = result prefix_text open_tag
                rest = rest_after_tag
                continue
            }
            result = result prefix_text
            rest = substr(rest_after_tag, close_pos + length(close_tag))
        }
        return result rest
    }

    function rewrite_html_tags(line, result, rest, prefix_text, tag, is_close, level, attrs, replacement, rest_after_tag, close_tag, close_pos) {
        result = ""
        rest = line

        while (match(rest, /<\/?h[1-6][^>]*>/)) {
            prefix_text = substr(rest, 1, RSTART - 1)
            tag = substr(rest, RSTART, RLENGTH)
            rest_after_tag = substr(rest, RSTART + RLENGTH)
            result = result prefix_text
            is_close = (substr(tag, 2, 1) == "/")
            if (is_close) {
                level = substr(tag, 4, 1) + 0
                if (ACTION == "push") {
                    if (level == 6) {
                        replacement = "</strong>"
                    } else {
                        replacement = "</h" (level + 1) ">"
                    }
                } else if (ACTION == "shift") {
                    if (level == 1) {
                        replacement = tag
                    } else {
                        replacement = "</h" (level - 1) ">"
                    }
                } else {
                    replacement = tag
                }
                result = result replacement
                rest = rest_after_tag
                continue
            }

            level = substr(tag, 3, 1) + 0
            attrs = substr(tag, 4, length(tag) - 4)
            if (ACTION == "push") {
                if (level == 6) {
                    replacement = "<strong" attrs ">"
                } else {
                    replacement = "<h" (level + 1) attrs ">"
                }
                result = result replacement
                rest = rest_after_tag
                continue
            }

            if (ACTION == "shift") {
                if (level == 1) {
                    close_tag = "</h1>"
                    close_pos = index(rest_after_tag, close_tag)
                    if (close_pos == 0) {
                        return result tag rest_after_tag
                    }
                    rest = substr(rest_after_tag, close_pos + length(close_tag))
                    continue
                }
                result = result "<h" (level - 1) attrs ">"
                rest = rest_after_tag
                continue
            }

            result = result tag
            rest = rest_after_tag
        }
        return result rest
    }

    function transform_markdown(line, hashes, text, level, split_pos) {
        if (substr(line, 1, 1) != "#") {
            return line
        }
        if (match(line, /^#+ /)) {
            split_pos = RLENGTH
            hashes = substr(line, 1, split_pos - 1)
            text = substr(line, split_pos + 1)
            level = length(hashes)
            if (ACTION == "push") {
                level++
                if (level == 7) {
                    return "**" text "**"
                }
                return prefix[level] text
            }
            if (ACTION == "shift") {
                if (level == 1) {
                    return ""
                }
                return prefix[level - 1] text
            }
            if (ACTION == "remove") {
                return ""
            }
        }
        return line
    }

    function transform_html(line) {
        if (index(line, "<h") == 0) {
            return line
        }
        if (ACTION == "push" || ACTION == "shift") {
            return rewrite_html_tags(line)
        }
        if (ACTION == "remove") {
            return remove_html_tags(line)
        }
        return line
    }

    function emit_line(line, transformed) {
        if (substr(line, 1, 1) != "#" && index(line, "<h") == 0) {
            print line
            return
        }
        transformed = transform_markdown(line)
        transformed = transform_html(transformed)
        if (transformed == "" && line != "") {
            return
        }
        print transformed
    }

    {
        if (have_pending) {
            if ($0 ~ /^=+$/) {
                emit_line("# " pending)
                have_pending = 0
                next
            }
            if ($0 ~ /^-+$/) {
                emit_line("## " pending)
                have_pending = 0
                next
            }
            emit_line(pending)
        }
        pending = $0
        have_pending = 1
    }

    END {
        if (have_pending) {
            emit_line(pending)
        }
    }
    '
}

# validates one plaintext record field against shared byte rules
function marsh_validate_record_field {  # marsh_validate_record_field record_field error_context
    local RECORD_FIELD ERROR_CONTEXT

    RECORD_FIELD="${1-}"
    ERROR_CONTEXT="${2:-}"
    [[ "${ERROR_CONTEXT}" != "" ]] || return 1

    if [[ "${RECORD_FIELD}" == *$'\037'* ]]; then
        echo "Unsupported ${ERROR_CONTEXT} field delimiter byte" >&2
        return 1
    fi
    if [[ "${RECORD_FIELD}" == *$'\n'* ]] || [[ "${RECORD_FIELD}" == *$'\r'* ]]; then
        echo "Unsupported ${ERROR_CONTEXT} multiline field" >&2
        return 1
    fi
}

# validates a provided field list against shared plaintext record byte rules
function marsh_validate_record_fields {  # marsh_validate_record_fields error_context fields[@]
    local ERROR_CONTEXT RECORD_FIELD

    ERROR_CONTEXT="${1:-}"
    [[ "${ERROR_CONTEXT}" != "" ]] || return 1
    shift 1

    while [[ "${#@}" -gt 0 ]]; do
        RECORD_FIELD="${1-}"
        shift 1
        marsh_validate_record_field "${RECORD_FIELD}" "${ERROR_CONTEXT}" || return 1
    done
}

# validates a plaintext record field count against expected bounds
function marsh_validate_record_field_count {  # marsh_validate_record_field_count actual_count minimum_count maximum_count error_context
    local ACTUAL_COUNT MINIMUM_COUNT MAXIMUM_COUNT ERROR_CONTEXT

    ACTUAL_COUNT="${1:-}"
    MINIMUM_COUNT="${2:-}"
    MAXIMUM_COUNT="${3:-}"
    ERROR_CONTEXT="${4:-}"
    [[ "${ACTUAL_COUNT}" =~ ^[0-9]+$ ]] || return 1
    [[ "${MINIMUM_COUNT}" =~ ^[0-9]+$ ]] || return 1
    [[ "${MAXIMUM_COUNT}" =~ ^[0-9]+$ ]] || return 1
    [[ "${ERROR_CONTEXT}" != "" ]] || return 1
    [[ "${MINIMUM_COUNT}" -le "${MAXIMUM_COUNT}" ]] || return 1

    if [[ "${ACTUAL_COUNT}" -lt "${MINIMUM_COUNT}" ]] || [[ "${ACTUAL_COUNT}" -gt "${MAXIMUM_COUNT}" ]]; then
        if [[ "${MINIMUM_COUNT}" -eq "${MAXIMUM_COUNT}" ]]; then
            echo "Malformed ${ERROR_CONTEXT} field count: expected ${MINIMUM_COUNT}, got ${ACTUAL_COUNT}" >&2
        else
            echo "Malformed ${ERROR_CONTEXT} field count: expected ${MINIMUM_COUNT}-${MAXIMUM_COUNT}, got ${ACTUAL_COUNT}" >&2
        fi
        return 1
    fi
}

