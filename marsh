# returns the common archive root directory for a related set of archive outputs
function marsh_get_archive_root_path {  # marsh_get_archive_root_path archive_path[@]
    local ARCHIVE_PATH CURRENT_DIR COMMON_DIR NEXT_DIR
    local COMMON_COUNT INDEX
    local -a COMMON_PARTS NEXT_PARTS

    ARCHIVE_PATH="${1:-}"
    [[ "${ARCHIVE_PATH}" == "" ]] && return 1
    shift 1

    COMMON_DIR=$(marsh_get_internal_parent_directory "${ARCHIVE_PATH}") || return 1

    for ARCHIVE_PATH in "$@"; do
        [[ "${ARCHIVE_PATH}" == "" ]] && continue
        NEXT_DIR=$(marsh_get_internal_parent_directory "${ARCHIVE_PATH}") || return 1

        COMMON_PARTS=()
        NEXT_PARTS=()
        if [[ "${COMMON_DIR}" != "." ]]; then
            IFS='/' read -r -a COMMON_PARTS <<< "${COMMON_DIR}"
        fi
        if [[ "${NEXT_DIR}" != "." ]]; then
            IFS='/' read -r -a NEXT_PARTS <<< "${NEXT_DIR}"
        fi

        COMMON_COUNT=0
        while [[ "${COMMON_COUNT}" -lt "${#COMMON_PARTS[@]}" ]] && [[ "${COMMON_COUNT}" -lt "${#NEXT_PARTS[@]}" ]] && [[ "${COMMON_PARTS[$COMMON_COUNT]}" == "${NEXT_PARTS[$COMMON_COUNT]}" ]]; do
            COMMON_COUNT=$((COMMON_COUNT + 1))
        done

        if [[ "${COMMON_COUNT}" -eq 0 ]]; then
            COMMON_DIR='.'
        else
            COMMON_DIR="${COMMON_PARTS[0]}"
            for ((INDEX=1; INDEX<COMMON_COUNT; INDEX++)); do
                COMMON_DIR+="/${COMMON_PARTS[$INDEX]}"
            done
        fi
    done

    marsh_normalize_path "${COMMON_DIR}" "directory"
}

# resolves an archive temp artifact path under the target temp work tree
function marsh_get_archive_temp_path {  # marsh_get_archive_temp_path target_output_root archive_source artifact
    local TARGET_OUTPUT_ROOT ARCHIVE_SOURCE ARTIFACT TARGET_BUILD_TEMP_ROOT ARCHIVE_KEY ARCHIVE_ROOT

    TARGET_OUTPUT_ROOT="${1:-}"
    ARCHIVE_SOURCE="${2:-}"
    ARTIFACT="${3:-}"
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${ARCHIVE_SOURCE}" == "" ]] && return 1
    [[ "${ARTIFACT}" == "" ]] && return 1
    [[ "${ARCHIVE_SOURCE}" != /* ]] || return 1

    TARGET_BUILD_TEMP_ROOT=$(marsh_get_target_temp_root "${TARGET_OUTPUT_ROOT}") || return 1
    ARCHIVE_KEY=$(marsh_normalize_internal_path "${ARCHIVE_SOURCE}") || return 1
    [[ "${ARCHIVE_KEY}" == "." ]] && return 1
    ARCHIVE_ROOT="${TARGET_BUILD_TEMP_ROOT}/archives/${ARCHIVE_KEY}"

    case "${ARTIFACT}" in
        root)
            printf '%s\n' "${ARCHIVE_ROOT}"
            ;;
        source)
            printf '%s\n' "${ARCHIVE_ROOT}/source"
            ;;
        subdocuments)
            printf '%s\n' "${ARCHIVE_ROOT}/subdocuments"
            ;;
        subdocuments-manifest)
            printf '%s\n' "${ARCHIVE_ROOT}/subdocuments.manifest"
            ;;
        *)
            return 1
            ;;
    esac
}

