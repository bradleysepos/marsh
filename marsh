# loads one document metadata cache file into caller-owned flat state
function marsh_load_document_metadata_state {  # marsh_load_document_metadata_state meta_cache_file state_prefix out_count_var
    local META_CACHE_FILE STATE_PREFIX OUT_COUNT_VAR ASSIGNMENT_LINE
    local ENTRY_NAME ENTRY_TYPE ENTRY_VALUE ENTRY_INDEX
    local CURRENT_KEY CURRENT_NORMALIZED_KEY CURRENT_TYPE CURRENT_VALUE CURRENT_LIST
    local ENTRY_COUNT
    local CURRENT_RESERVED CURRENT_HAS_VALUE CURRENT_HAS_LIST_ITEMS

    META_CACHE_FILE="${1:-}"
    STATE_PREFIX="${2:-}"
    OUT_COUNT_VAR="${3:-}"
    [[ "${META_CACHE_FILE}" != "" ]] || return 1
    [[ "${STATE_PREFIX}" != "" ]] || return 1
    [[ "${OUT_COUNT_VAR}" != "" ]] || return 1
    [[ -f "${META_CACHE_FILE}" ]] && [[ -r "${META_CACHE_FILE}" ]] || return 1
    [[ "${STATE_PREFIX}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || return 1
    [[ "${OUT_COUNT_VAR}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || return 1

    CURRENT_KEY=""
    CURRENT_NORMALIZED_KEY=""
    CURRENT_TYPE=""
    CURRENT_VALUE=""
    CURRENT_LIST=""
    CURRENT_RESERVED=false
    CURRENT_HAS_VALUE=false
    CURRENT_HAS_LIST_ITEMS=false
    ENTRY_COUNT=0

    while IFS= read -r ASSIGNMENT_LINE || [[ "${ASSIGNMENT_LINE}" != "" ]]; do
        [[ "${ASSIGNMENT_LINE}" != "" ]] || continue

        ENTRY_NAME=""
        ENTRY_TYPE=""
        ENTRY_VALUE=""
        ENTRY_INDEX=""
        marsh_parse_document_metadata_assignment "${ASSIGNMENT_LINE}" "ENTRY_NAME" "ENTRY_TYPE" "ENTRY_VALUE" "ENTRY_INDEX" || return 1

        if [[ "${CURRENT_KEY}" != "" ]] && [[ "${ENTRY_NAME}" != "${CURRENT_KEY}" ]]; then
            if [[ "${CURRENT_RESERVED}" != true ]]; then
                printf -v "${STATE_PREFIX}KEY_${ENTRY_COUNT}" '%s' "${CURRENT_KEY}"
                printf -v "${STATE_PREFIX}NORMALIZED_KEY_${ENTRY_COUNT}" '%s' "${CURRENT_NORMALIZED_KEY}"
                printf -v "${STATE_PREFIX}TYPE_${ENTRY_COUNT}" '%s' "${CURRENT_TYPE}"
                printf -v "${STATE_PREFIX}VALUE_${ENTRY_COUNT}" '%s' "${CURRENT_VALUE}"
                printf -v "${STATE_PREFIX}LIST_${ENTRY_COUNT}" '%s' "${CURRENT_LIST}"
                ENTRY_COUNT=$((ENTRY_COUNT + 1))
            fi

            CURRENT_KEY=""
            CURRENT_NORMALIZED_KEY=""
            CURRENT_TYPE=""
            CURRENT_VALUE=""
            CURRENT_LIST=""
            CURRENT_RESERVED=false
            CURRENT_HAS_VALUE=false
            CURRENT_HAS_LIST_ITEMS=false
        fi

        if [[ "${CURRENT_KEY}" == "" ]]; then
            CURRENT_KEY="${ENTRY_NAME}"
            marsh_normalize_document_metadata_key "${CURRENT_KEY}" "CURRENT_NORMALIZED_KEY" || return 1
            CURRENT_TYPE="value"
            CURRENT_VALUE=""
            CURRENT_LIST=""
            CURRENT_RESERVED=false
            CURRENT_HAS_VALUE=false
            CURRENT_HAS_LIST_ITEMS=false
            marsh_is_reserved_document_template_tag "${CURRENT_NORMALIZED_KEY}" && CURRENT_RESERVED=true
        fi

        if [[ "${ENTRY_TYPE}" == "value" ]]; then
            if [[ "${CURRENT_HAS_VALUE}" == true ]] || [[ "${CURRENT_HAS_LIST_ITEMS}" == true ]]; then
                echo "Malformed document metadata cache entry sequence: ${CURRENT_KEY}" >&2
                return 1
            fi
            CURRENT_VALUE="${ENTRY_VALUE}"
            CURRENT_HAS_VALUE=true
        else
            if [[ "${CURRENT_HAS_LIST_ITEMS}" != true ]]; then
                if [[ "${CURRENT_HAS_VALUE}" == true ]] && [[ "${CURRENT_VALUE}" != "" ]]; then
                    echo "Malformed document metadata cache entry sequence: ${CURRENT_KEY}" >&2
                    return 1
                fi
                CURRENT_TYPE="list"
                CURRENT_VALUE=""
            fi
            [[ "${CURRENT_LIST}" == "" ]] || CURRENT_LIST+=$'\n'
            CURRENT_LIST+="${ENTRY_VALUE}"
            CURRENT_HAS_LIST_ITEMS=true
        fi
    done < "${META_CACHE_FILE}"

    if [[ "${CURRENT_KEY}" != "" ]] && [[ "${CURRENT_RESERVED}" != true ]]; then
        printf -v "${STATE_PREFIX}KEY_${ENTRY_COUNT}" '%s' "${CURRENT_KEY}"
        printf -v "${STATE_PREFIX}NORMALIZED_KEY_${ENTRY_COUNT}" '%s' "${CURRENT_NORMALIZED_KEY}"
        printf -v "${STATE_PREFIX}TYPE_${ENTRY_COUNT}" '%s' "${CURRENT_TYPE}"
        printf -v "${STATE_PREFIX}VALUE_${ENTRY_COUNT}" '%s' "${CURRENT_VALUE}"
        printf -v "${STATE_PREFIX}LIST_${ENTRY_COUNT}" '%s' "${CURRENT_LIST}"
        ENTRY_COUNT=$((ENTRY_COUNT + 1))
    fi

    printf -v "${OUT_COUNT_VAR}" '%s' "${ENTRY_COUNT}"
}

# looks up one custom document.* metadata entry from loaded document metadata state
function marsh_lookup_document_metadata_state {  # marsh_lookup_document_metadata_state state_prefix state_count tag_name out_key_var out_type_var out_value_var
    local STATE_PREFIX STATE_COUNT TAG_NAME OUT_KEY_VAR OUT_TYPE_VAR OUT_VALUE_VAR
    local NORMALIZED_TAG MATCH_COUNT MATCH_INDEX INDEX
    local NORMALIZED_KEY_VAR TYPE_VAR VALUE_VAR LIST_VAR KEY_VAR
    local LOOKUP_ENTRY_TYPE LOOKUP_ENTRY_VALUE

    STATE_PREFIX="${1:-}"
    STATE_COUNT="${2:-}"
    TAG_NAME="${3:-}"
    OUT_KEY_VAR="${4:-}"
    OUT_TYPE_VAR="${5:-}"
    OUT_VALUE_VAR="${6:-}"
    [[ "${STATE_PREFIX}" != "" ]] || return 1
    [[ "${STATE_COUNT}" =~ ^[0-9]+$ ]] || return 1
    [[ "${TAG_NAME}" != "" ]] || return 1
    [[ "${OUT_KEY_VAR}" != "" ]] || return 1
    [[ "${OUT_TYPE_VAR}" != "" ]] || return 1
    [[ "${OUT_VALUE_VAR}" != "" ]] || return 1
    [[ "${TAG_NAME#document.}" != "${TAG_NAME}" ]] || return 1

    NORMALIZED_TAG="${TAG_NAME#document.}"
    marsh_normalize_document_metadata_key "${NORMALIZED_TAG}" "NORMALIZED_TAG" || return 1
    marsh_is_reserved_document_template_tag "${NORMALIZED_TAG}" && return 1

    MATCH_COUNT=0
    MATCH_INDEX=""
    INDEX=0
    while [[ "${INDEX}" -lt "${STATE_COUNT}" ]]; do
        NORMALIZED_KEY_VAR="${STATE_PREFIX}NORMALIZED_KEY_${INDEX}"
        [[ "${!NORMALIZED_KEY_VAR}" == "${NORMALIZED_TAG}" ]] || {
            INDEX=$((INDEX + 1))
            continue
        }
        MATCH_INDEX="${INDEX}"
        MATCH_COUNT=$((MATCH_COUNT + 1))
        INDEX=$((INDEX + 1))
    done
    [[ "${MATCH_COUNT}" -eq 1 ]] || return 1

    KEY_VAR="${STATE_PREFIX}KEY_${MATCH_INDEX}"
    TYPE_VAR="${STATE_PREFIX}TYPE_${MATCH_INDEX}"
    VALUE_VAR="${STATE_PREFIX}VALUE_${MATCH_INDEX}"
    LIST_VAR="${STATE_PREFIX}LIST_${MATCH_INDEX}"
    LOOKUP_ENTRY_TYPE="${!TYPE_VAR}"
    [[ "${LOOKUP_ENTRY_TYPE}" == "value" ]] || [[ "${LOOKUP_ENTRY_TYPE}" == "list" ]] || return 1

    LOOKUP_ENTRY_VALUE="${!VALUE_VAR}"
    if [[ "${LOOKUP_ENTRY_TYPE}" == "list" ]]; then
        LOOKUP_ENTRY_VALUE="${!LIST_VAR}"
    fi

    printf -v "${OUT_KEY_VAR}" '%s' "${!KEY_VAR}"
    printf -v "${OUT_TYPE_VAR}" '%s' "${LOOKUP_ENTRY_TYPE}"
    printf -v "${OUT_VALUE_VAR}" '%s' "${LOOKUP_ENTRY_VALUE}"
}

# normalizes a document metadata key for custom document.* metadata
function marsh_normalize_document_metadata_key {  # marsh_normalize_document_metadata_key metadata_key out_key_var
    local METADATA_KEY OUT_KEY_VAR NORMALIZED_KEY

    METADATA_KEY="${1:-}"
    OUT_KEY_VAR="${2:-}"
    [[ "${METADATA_KEY}" != "" ]] || return 1
    [[ "${OUT_KEY_VAR}" != "" ]] || return 1

    NORMALIZED_KEY=$(printf '%s' "${METADATA_KEY}" | awk '{ print tolower($0) }') || return 1
    NORMALIZED_KEY="${NORMALIZED_KEY//_/-}"
    printf -v "${OUT_KEY_VAR}" '%s' "${NORMALIZED_KEY}"
}

# parses one document metadata cache assignment line into caller-owned outputs
function marsh_parse_document_metadata_assignment {  # marsh_parse_document_metadata_assignment assignment_line out_name_var out_entry_type_var out_value_var out_index_var
    local ASSIGNMENT_LINE OUT_NAME_VAR OUT_ENTRY_TYPE_VAR OUT_VALUE_VAR OUT_INDEX_VAR
    local PARSED_METADATA_NAME PARSED_METADATA_VALUE PARSED_METADATA_BASE_NAME PARSED_METADATA_INDEX PARSED_METADATA_ENTRY_TYPE

    ASSIGNMENT_LINE="${1:-}"
    OUT_NAME_VAR="${2:-}"
    OUT_ENTRY_TYPE_VAR="${3:-}"
    OUT_VALUE_VAR="${4:-}"
    OUT_INDEX_VAR="${5:-}"
    [[ "${ASSIGNMENT_LINE}" != "" ]] || return 1
    [[ "${OUT_NAME_VAR}" != "" ]] || return 1
    [[ "${OUT_ENTRY_TYPE_VAR}" != "" ]] || return 1
    [[ "${OUT_VALUE_VAR}" != "" ]] || return 1
    [[ "${OUT_INDEX_VAR}" != "" ]] || return 1

    marsh_parse_internal_assignment "${ASSIGNMENT_LINE}" "PARSED_METADATA_NAME" "PARSED_METADATA_VALUE" "document metadata" || return 1

    PARSED_METADATA_BASE_NAME="${PARSED_METADATA_NAME}"
    PARSED_METADATA_INDEX=""
    PARSED_METADATA_ENTRY_TYPE="value"
    if [[ "${PARSED_METADATA_NAME}" =~ _[0-9]+$ ]]; then
        PARSED_METADATA_BASE_NAME="${PARSED_METADATA_NAME%_*}"
        PARSED_METADATA_INDEX="${PARSED_METADATA_NAME##*_}"
        PARSED_METADATA_ENTRY_TYPE="list-item"
    fi

    printf -v "${OUT_NAME_VAR}" '%s' "${PARSED_METADATA_BASE_NAME}"
    printf -v "${OUT_ENTRY_TYPE_VAR}" '%s' "${PARSED_METADATA_ENTRY_TYPE}"
    printf -v "${OUT_VALUE_VAR}" '%s' "${PARSED_METADATA_VALUE}"
    printf -v "${OUT_INDEX_VAR}" '%s' "${PARSED_METADATA_INDEX}"
}

# plans target documents to build from the target source inventory
function marsh_plan_target_documents {  # marsh_plan_target_documents site_output_root target target_output_rel target_source_root markdown_document_extensions_csv
    local SITE_OUTPUT_ROOT TARGET TARGET_OUTPUT_REL TARGET_SOURCE_ROOT MARKDOWN_DOCUMENT_EXTENSIONS_CSV
    local TARGET_OUTPUT_ROOT TARGET_SOURCE_INVENTORY_LINE
    local -a TARGET_SOURCE_INVENTORY_RECORDS

    SITE_OUTPUT_ROOT="${1:-}"
    TARGET="${2:-}"
    TARGET_OUTPUT_REL="${3:-.}"
    TARGET_SOURCE_ROOT="${4:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_CSV="${5:-}"
    [[ "${SITE_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${TARGET}" == "" ]] && return 1
    [[ "${TARGET_OUTPUT_REL}" == "" ]] && return 1
    [[ "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" == "" ]] && return 1

    [[ "${TARGET_SOURCE_ROOT}" != "" ]] || return 0
    TARGET_OUTPUT_ROOT=$(marsh_get_target_directory_path "${SITE_OUTPUT_ROOT}/${TARGET_OUTPUT_REL}") || return 1
    TARGET_SOURCE_INVENTORY_RECORDS=()
    while IFS= read -r TARGET_SOURCE_INVENTORY_LINE; do
        [[ "${TARGET_SOURCE_INVENTORY_LINE}" == "" ]] && continue
        TARGET_SOURCE_INVENTORY_RECORDS+=("${TARGET_SOURCE_INVENTORY_LINE}")
    done < <(marsh_get_target_source_inventory "${TARGET_OUTPUT_ROOT}" "${TARGET_SOURCE_ROOT}") || return 1

    marsh_plan_target_documents_from_inventory "${SITE_OUTPUT_ROOT}" "${TARGET}" "${TARGET_OUTPUT_REL}" "${TARGET_SOURCE_ROOT}" "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" "${TARGET_SOURCE_INVENTORY_RECORDS[@]}"
}

# plans target documents to build from a provided list of source inventory records
function marsh_plan_target_documents_from_inventory {  # marsh_plan_target_documents_from_inventory site_output_root target target_output_rel target_source_root markdown_document_extensions_csv inventory_records[@]
    local SITE_OUTPUT_ROOT TARGET TARGET_OUTPUT_REL TARGET_SOURCE_ROOT MARKDOWN_DOCUMENT_EXTENSIONS_CSV MARKDOWN_DOCUMENT_EXTENSIONS_REGEX
    local DOCUMENT_ID REQUESTED_TARGET_REL TARGET_IS_DIRECTORY_SCOPE SOURCE_MATCHES_TARGET

    SITE_OUTPUT_ROOT="${1:-}"
    TARGET="${2:-}"
    TARGET_OUTPUT_REL="${3:-.}"
    TARGET_SOURCE_ROOT="${4:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_CSV="${5:-}"
    [[ "${SITE_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${TARGET}" == "" ]] && return 1
    [[ "${TARGET_OUTPUT_REL}" == "" ]] && return 1
    [[ "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" == "" ]] && return 1

    shift 5
    TARGET_OUTPUT_REL=$(marsh_normalize_internal_path "${TARGET_OUTPUT_REL}") || return 1
    [[ "${TARGET_SOURCE_ROOT}" != "" ]] || return 0
    MARKDOWN_DOCUMENT_EXTENSIONS_REGEX="${MARKDOWN_DOCUMENT_EXTENSIONS_CSV//,/|}"

    # scope matching runs against the current target root, not the site root
    REQUESTED_TARGET_REL="${TARGET#./}"
    if [[ "${TARGET_OUTPUT_REL}" != "." ]]; then
        if [[ "${REQUESTED_TARGET_REL}" == "${TARGET_OUTPUT_REL}" ]]; then
            REQUESTED_TARGET_REL='.'
        elif [[ "${REQUESTED_TARGET_REL}" == "${TARGET_OUTPUT_REL}/"* ]]; then
            REQUESTED_TARGET_REL="${REQUESTED_TARGET_REL#${TARGET_OUTPUT_REL}/}"
        fi
    fi

    # directory scopes include descendants while file scopes match exactly
    TARGET_IS_DIRECTORY_SCOPE=false
    if [[ -d "${SITE_OUTPUT_ROOT}/${TARGET}" ]]; then
        TARGET_IS_DIRECTORY_SCOPE=true
    elif [[ "${REQUESTED_TARGET_REL}" != "*" ]] && [[ "${REQUESTED_TARGET_REL}" != "." ]] && [[ "${REQUESTED_TARGET_REL}" != "" ]] && [[ -d "${TARGET_SOURCE_ROOT}/${REQUESTED_TARGET_REL}" ]]; then
        TARGET_IS_DIRECTORY_SCOPE=true
    fi

    # emit document plan records using shell-safe fields
    while [[ "${#@}" -gt 0 ]]; do
        DOCUMENT_ID="${1:-}"
        shift 1
        [[ "${DOCUMENT_ID}" == "" ]] && continue
        DOCUMENT_ID="${DOCUMENT_ID#./}"
        if [[ "${REQUESTED_TARGET_REL}" != "*" ]] && [[ "${REQUESTED_TARGET_REL}" != "." ]] && [[ "${REQUESTED_TARGET_REL}" != "" ]]; then
            SOURCE_MATCHES_TARGET=false
            if [[ "${TARGET_IS_DIRECTORY_SCOPE}" == true ]]; then
                if [[ "${DOCUMENT_ID}" == "${REQUESTED_TARGET_REL}" ]] || [[ "${DOCUMENT_ID}" == "${REQUESTED_TARGET_REL}/"* ]]; then
                    SOURCE_MATCHES_TARGET=true
                fi
            elif [[ "${DOCUMENT_ID}" == "${REQUESTED_TARGET_REL}" ]]; then
                SOURCE_MATCHES_TARGET=true
            fi
            [[ "${SOURCE_MATCHES_TARGET}" == true ]] || continue
        fi
        [[ "${DOCUMENT_ID}" =~ (${MARKDOWN_DOCUMENT_EXTENSIONS_REGEX})$ ]] || continue
        marsh_validate_record_fields "document record" "${DOCUMENT_ID}" "${DOCUMENT_ID}" "${TARGET_OUTPUT_REL}" "${TARGET_SOURCE_ROOT}" || return 1
        printf '%s\037%s\037%s\037%s\n' "${DOCUMENT_ID}" "${DOCUMENT_ID}" "${TARGET_OUTPUT_REL}" "${TARGET_SOURCE_ROOT}"
    done
}

# adds multi-resolution srcset attributes for responsive images to img tags in html content
# based on a provided list of responsive image paths separated by ASCII file record separator (\034)
# img tags must not span multiple lines, img tags with existing srcset attributes are passed through unmodified
function marsh_process_responsive_images_tags {  # marsh_process_responsive_images_tags responsive_paths_frsv
    local RESPONSIVE_PATHS_FRSV

    RESPONSIVE_PATHS_FRSV="${1:-}"
    [[ "${RESPONSIVE_PATHS_FRSV}" != "" ]] || cat

    awk -v responsive_paths="${RESPONSIVE_PATHS_FRSV//\\/\\\\}" \
    '
    BEGIN {
        # build hash index of responsive paths rp_index[]
        # track which base names exist in rp_bases[]
        # track variants per base name in rp_variant_list[]
        n_rp = split(responsive_paths, rp_lines, "\034");
        for (i = 1; i <= n_rp; i++) {
            rp_path = rp_lines[i];
            if (rp_path == "") continue;

            # extract base name without extension from path
            match(rp_path, /\.[^.]+$/);
            if (RSTART > 0) {
                rp_base = substr(rp_path, 1, RSTART - 1);
            } else {
                rp_base = rp_path;
            }

            # extract variant
            match(rp_base, /[@_-][0-9]+((\.[0-9]+)?x|w)$/);
            if (RSTART <= 0) continue;  # skip paths without variant
            rp_variant = substr(rp_base, RSTART + 1);
            rp_base = substr(rp_base, 1, RSTART - 1);

            # store in hash index
            rp_index[rp_base, rp_variant] = rp_path;

            # track variants for iteration
            if (rp_base in rp_variant_list) {
                rp_variant_list[rp_base] = rp_variant_list[rp_base] "\n" rp_variant;
            } else {
                rp_variant_list[rp_base] = rp_variant;
            }
            rp_bases[rp_base] = 1;
        }
    }
    {
        # process lines containing img tags with src attributes
        if ($0 ~ /<img [^>]*src="[^"]*"[^>]*>/)
        {
            result = "";
            rest_of_line = $0;

            # process img tags on the same line sequentially
            while (match(rest_of_line, /<img [^>]*src="[^"]*"[^>]*>/)) {
                # extract img tag
                result = result substr(rest_of_line, 1, RSTART - 1);
                img_tag = substr(rest_of_line, RSTART, RLENGTH);
                rest_of_line = substr(rest_of_line, RSTART + RLENGTH);

                # do not process img tags that already have srcset attribute
                if (img_tag ~ /srcset=/) {
                    result = result img_tag;
                    continue;
                }

                # extract source path from img tag
                match(img_tag, /src="[^"]*"/);
                source = substr(img_tag, RSTART + 5, RLENGTH - 6);
                rest_of_tag = substr(img_tag, RSTART + RLENGTH);

                # extract base name, variant, and variant type from source path
                base = source;
                match(source, /\.[^.]+$/);
                if (RSTART > 0) {
                    base = substr(source, 1, RSTART - 1);
                }
                match(base, /[@_-][0-9]+((\.[0-9]+)?x|w)$/);
                if (RSTART > 0) {
                    variant = substr(base, RSTART + 1);
                    base = substr(base, 1, RSTART - 1);
                } else {
                    variant = "1x";
                }
                variant_type = substr(variant, length(variant), 1);

                # build srcset starting with original source
                srcset_count = 0;
                #delete srcset_parts;  # count logic makes clearing the array unnecessary
                srcset_parts[++srcset_count] = source " " variant;

                # look up candidates in hash index
                if (base in rp_bases) {
                    # iterate through newline-separated variant list
                    n_variants = split(rp_variant_list[base], variants_array, "\n");
                    for (i = 1; i <= n_variants; i++) {
                        candidate_variant = variants_array[i];

                        # only include candidate variants that differ from the original image variant
                        if (candidate_variant == variant) continue;

                        # do not mix density (x) and width (w) variants in the same srcset
                        candidate_variant_type = substr(candidate_variant, length(candidate_variant), 1);
                        if (variant_type != candidate_variant_type) continue;

                        # add valid candidate to srcset
                        # rp_index[base, candidate_variant] is the full path
                        srcset_parts[++srcset_count] = rp_index[base, candidate_variant] " " candidate_variant;
                    }
                }

                # only add srcset to img tag if valid variants were found
                if (srcset_count > 1) {
                    # join srcset parts
                    srcset = srcset_parts[1];  # original source is always first in srcset
                    for (i = 2; i <= srcset_count; i++) {
                        srcset = srcset ", " srcset_parts[i];
                    }

                    # build new img tag with srcset attribute
                    result = result "<img src=\"" source "\" srcset=\"" srcset "\"" rest_of_tag;
                } else {
                    # only the original source is valid, keep img tag unchanged
                    result = result img_tag;
                }
            }
            print result rest_of_line;
        } else {
            print $0;
        }
    }'
}

# publishes a completed processed output file to its final destination
function marsh_publish_processed_output {  # marsh_publish_processed_output source_file dest_file
    local SOURCE_FILE DEST_FILE DEST_DIR

    SOURCE_FILE="${1:-}"
    DEST_FILE="${2:-}"
    [[ "${SOURCE_FILE}" == "" ]] && return 1
    [[ "${DEST_FILE}" == "" ]] && return 1
    [[ -f "${SOURCE_FILE}" ]] && [[ -r "${SOURCE_FILE}" ]] || return 1

    DEST_DIR="${DEST_FILE%/*}"
    [[ "${DEST_DIR}" == "${DEST_FILE}" ]] && DEST_DIR='.'
    mkdir -p "${DEST_DIR}" >/dev/null 2>&1 || {
        echo "Unable to create published output path: ${DEST_DIR}" >&2
        return 1
    }
    rm -f "${DEST_FILE}" >/dev/null 2>&1 || {
        echo "Unable to replace published output path: ${DEST_FILE}" >&2
        return 1
    }
    cp "${SOURCE_FILE}" "${DEST_FILE}" >/dev/null 2>&1 || {
        echo "Unable to publish processed output: ${SOURCE_FILE} -> ${DEST_FILE}" >&2
        return 1
    }
}

# writes the document content and metadata artifacts for one target build context
function marsh_write_document_artifacts {  # marsh_write_document_artifacts target_output_root document source_file
    local TARGET_OUTPUT_ROOT DOCUMENT SOURCE_FILE
    local DOCUMENT_ARTIFACT_ROOT DOCUMENT_ARTIFACT_CONTENT DOCUMENT_ARTIFACT_IS_RENDERED_FILE DOCUMENT_ARTIFACT_META_YAML DOCUMENT_ARTIFACT_META
    local SOURCE_HAS_FRONTMATTER

    TARGET_OUTPUT_ROOT="${1:-}"
    DOCUMENT="${2:-}"
    SOURCE_FILE="${3:-}"
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${DOCUMENT}" == "" ]] && return 1
    [[ "${SOURCE_FILE}" == "" ]] && return 1
    [[ -f "${SOURCE_FILE}" ]] && [[ -r "${SOURCE_FILE}" ]] || return 1

    marsh_get_document_artifacts "${TARGET_OUTPUT_ROOT}" "${DOCUMENT}" "DOCUMENT_ARTIFACT_ROOT" "DOCUMENT_ARTIFACT_CONTENT" "DOCUMENT_ARTIFACT_META_YAML" "DOCUMENT_ARTIFACT_META" || return 1
    DOCUMENT_ARTIFACT_IS_RENDERED_FILE=$(marsh_get_document_temp_path "${TARGET_OUTPUT_ROOT}" "${DOCUMENT}" "is-rendered") || return 1

    mkdir -p "${DOCUMENT_ARTIFACT_ROOT}" >/dev/null 2>&1 || return 1

    SOURCE_HAS_FRONTMATTER=false
    if marsh_has_frontmatter "${SOURCE_FILE}"; then
        SOURCE_HAS_FRONTMATTER=true
    fi

    # reuse the current build artifacts when the expected set already exists
    if [[ "${SOURCE_HAS_FRONTMATTER}" == true ]]; then
        if [[ -f "${DOCUMENT_ARTIFACT_CONTENT}" ]] \
        && [[ -r "${DOCUMENT_ARTIFACT_CONTENT}" ]] \
        && [[ -f "${DOCUMENT_ARTIFACT_META_YAML}" ]] \
        && [[ -r "${DOCUMENT_ARTIFACT_META_YAML}" ]]; then
            if [[ ! -f "${DOCUMENT_ARTIFACT_META}" ]] || [[ ! -r "${DOCUMENT_ARTIFACT_META}" ]]; then
                marsh_get_document_metadata "${DOCUMENT_ARTIFACT_META_YAML}" "" >/dev/null || return 1
            fi
            return 0
        fi
    elif [[ -f "${DOCUMENT_ARTIFACT_CONTENT}" ]] \
        && [[ -r "${DOCUMENT_ARTIFACT_CONTENT}" ]] \
        && [[ ! -e "${DOCUMENT_ARTIFACT_META_YAML}" ]] \
        && [[ ! -e "${DOCUMENT_ARTIFACT_META}" ]]; then
        return 0
    fi

    # rebuild the artifact set when any expected file is missing
    rm -f "${DOCUMENT_ARTIFACT_CONTENT}" "${DOCUMENT_ARTIFACT_IS_RENDERED_FILE}" "${DOCUMENT_ARTIFACT_META_YAML}" "${DOCUMENT_ARTIFACT_META}"
    if [[ "${SOURCE_HAS_FRONTMATTER}" == true ]]; then
        marsh_extract_frontmatter "${SOURCE_FILE}" "${DOCUMENT_ARTIFACT_META_YAML}" "${DOCUMENT_ARTIFACT_CONTENT}" || return 1
        marsh_get_document_metadata "${DOCUMENT_ARTIFACT_META_YAML}" "" >/dev/null || return 1
        return 0
    fi

    cp "${SOURCE_FILE}" "${DOCUMENT_ARTIFACT_CONTENT}" || return 1
}

# writes only the document metadata artifacts for one target build context
function marsh_write_document_metadata_artifacts {  # marsh_write_document_metadata_artifacts target_output_root document source_file
    local TARGET_OUTPUT_ROOT DOCUMENT SOURCE_FILE
    local DOCUMENT_ARTIFACT_ROOT DOCUMENT_ARTIFACT_CONTENT DOCUMENT_ARTIFACT_META_YAML DOCUMENT_ARTIFACT_META
    local DOCUMENT_META_TEMP_CONTENT

    TARGET_OUTPUT_ROOT="${1:-}"
    DOCUMENT="${2:-}"
    SOURCE_FILE="${3:-}"
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${DOCUMENT}" == "" ]] && return 1
    [[ "${SOURCE_FILE}" == "" ]] && return 1
    [[ -f "${SOURCE_FILE}" ]] && [[ -r "${SOURCE_FILE}" ]] || return 1
    marsh_has_frontmatter "${SOURCE_FILE}" || return 1

    marsh_get_document_artifacts "${TARGET_OUTPUT_ROOT}" "${DOCUMENT}" "DOCUMENT_ARTIFACT_ROOT" "DOCUMENT_ARTIFACT_CONTENT" "DOCUMENT_ARTIFACT_META_YAML" "DOCUMENT_ARTIFACT_META" || return 1

    mkdir -p "${DOCUMENT_ARTIFACT_ROOT}" >/dev/null 2>&1 || return 1

    if [[ -f "${DOCUMENT_ARTIFACT_META_YAML}" ]] && [[ -r "${DOCUMENT_ARTIFACT_META_YAML}" ]]; then
        if [[ -f "${DOCUMENT_ARTIFACT_META}" ]] && [[ -r "${DOCUMENT_ARTIFACT_META}" ]]; then
            return 0
        fi
        marsh_get_document_metadata "${DOCUMENT_ARTIFACT_META_YAML}" "" >/dev/null || return 1
        return 0
    fi

    rm -f "${DOCUMENT_ARTIFACT_META_YAML}" "${DOCUMENT_ARTIFACT_META}"
    DOCUMENT_META_TEMP_CONTENT=$(mktemp "${MARSH_TEMP}/document-meta-content-XXXXXX") || return 1
    marsh_extract_frontmatter "${SOURCE_FILE}" "${DOCUMENT_ARTIFACT_META_YAML}" "${DOCUMENT_META_TEMP_CONTENT}" || {
        rm -f "${DOCUMENT_ARTIFACT_META_YAML}" "${DOCUMENT_ARTIFACT_META}" "${DOCUMENT_META_TEMP_CONTENT}"
        return 1
    }
    rm -f "${DOCUMENT_META_TEMP_CONTENT}"
    marsh_get_document_metadata "${DOCUMENT_ARTIFACT_META_YAML}" "" >/dev/null || {
        rm -f "${DOCUMENT_ARTIFACT_META_YAML}" "${DOCUMENT_ARTIFACT_META}"
        return 1
    }
}

#
# Archives
#

# builds an archive of directory contents from a prepared manifest, sorted by descending date
function marsh_build_archive {  # marsh_build_archive target_output_root markdown_document_extensions_replacement remove_link_filenames_csv encoding archive_source archive_title language langcode count page_size #types[@] types[@] #excluded_states[@] excluded_states[@] archive_manifest archive_root_path
    local ENCODING TARGET_OUTPUT_ROOT MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT REMOVE_LINK_FILENAMES_CSV ARCHIVE_SOURCE_REL ARCHIVE_TITLE LANGUAGE LANGCODE
    local COUNT PAGE_SIZE NUM_TYPES NUM_EXCLUDED_STATES
    local VALID DOCUMENT TYPE E
    local ARCHIVE_MANIFEST MANIFEST_RECORD MANIFEST_FIELD_COUNT MANIFEST_STATE_COUNT EXPECTED_MANIFEST_FIELD_COUNT MANIFEST_STATE_INDEX
    local URI ABSPATH
    local PAGINATED PAGE_TOTAL PAGE PAGE_START PAGE_END PAGE_INDEX PAGE_SUBDOCUMENTS_TOTAL
    local ARCHIVE_SUBDOCUMENTS_TOTAL
    local PAGE_ARCHIVE_SOURCE_REL PAGE_ALIAS_ARCHIVE_SOURCE_REL PAGE_ROOT
    local PAGE_URI PAGE_CANONICAL_URI PAGE_FIRST_URI PAGE_PREV_URI PAGE_NEXT_URI PAGE_LAST_URI
    local PAGE_HREF PAGE_CANONICAL_HREF PAGE_FIRST_HREF PAGE_PREV_HREF PAGE_NEXT_HREF PAGE_LAST_HREF
    local PAGE_PREV_ARCHIVE_SOURCE_REL PAGE_NEXT_ARCHIVE_SOURCE_REL PAGE_LAST_ARCHIVE_SOURCE_REL
    local PAGE_OUTPUT_PATH PAGE_CANONICAL_OUTPUT_PATH PAGE_FIRST_OUTPUT_PATH PAGE_PREV_OUTPUT_PATH PAGE_NEXT_OUTPUT_PATH PAGE_LAST_OUTPUT_PATH PAGE_BASE_PATH
    local ARCHIVE_ROOT_PATH PAGE_ARCHIVE_ROOT_HREF
    local -a TYPES EXCLUDED_STATES STATE VALID_DOCUMENTS VALID_DOCUMENT_URIS VALID_DOCUMENT_ABSPATHS MANIFEST_FIELDS
    local -a ARCHIVE_PAGES PAGE_DOCUMENTS PAGE_DOCUMENT_URIS PAGE_DOCUMENT_ABSPATHS

    # init
    TARGET_OUTPUT_ROOT="${1:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT="${2:-}"
    REMOVE_LINK_FILENAMES_CSV="${3:-}"
    ENCODING="${4:-}"
    ARCHIVE_SOURCE_REL="${5:-}"
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${ENCODING}" != "html" ]] && [[ "${ENCODING}" != "json" ]] && [[ "${ENCODING}" != "atom" ]] && {
        echo "Unsupported archive encoding: ${ENCODING}" >&2
        return 1
    }
    [[ "${ARCHIVE_SOURCE_REL}" == "" ]] && return 1
    shift 5
    ARCHIVE_TITLE="${1:-}"
    LANGUAGE="${2:-}"
    LANGCODE="${3:-}"
    shift 3
    COUNT="${1:-}"
    PAGE_SIZE="${2:-}"
    shift 2
    NUM_TYPES="${1:-0}"
    shift 1
    TYPES=()
    while [[ "${NUM_TYPES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        TYPES+=("${1}")
        NUM_TYPES=$((NUM_TYPES - 1 ))
        shift
    done
    NUM_EXCLUDED_STATES="${1:-0}"
    shift 1
    EXCLUDED_STATES=()
    while [[ "${NUM_EXCLUDED_STATES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        EXCLUDED_STATES+=("${1}")
        NUM_EXCLUDED_STATES=$((NUM_EXCLUDED_STATES - 1 ))
        shift
    done
    ARCHIVE_MANIFEST="${1:-}"
    ARCHIVE_ROOT_PATH="${2:-}"
    [[ "${ARCHIVE_MANIFEST}" == "" ]] && return 1

    if [[ "${ARCHIVE_ROOT_PATH}" == "" ]]; then
        ARCHIVE_ROOT_PATH=$(marsh_get_archive_root_path "${ARCHIVE_SOURCE_REL}") || return 1
    else
        ARCHIVE_ROOT_PATH=$(marsh_normalize_path "${ARCHIVE_ROOT_PATH}" "directory") || return 1
    fi

    # sanity check archive count
    if [[ "${COUNT}" != "" ]] && [[ ! "${COUNT}" =~ ^[0-9]+$ ]]; then
        echo "Invalid archive count: ${COUNT}" >&2
        return 1
    fi

    # sanity check; only html archives may be paginated
    PAGINATED=false
    if [[ "${ENCODING}" == "html" ]] && [[ "${PAGE_SIZE}" =~ ^[0-9]+$ ]] && [[ "${PAGE_SIZE}" -gt 0 ]]; then
        PAGINATED=true
        PAGE_ROOT=$(marsh_get_archive_page_root "${ARCHIVE_SOURCE_REL}") || return 1
        rm -rf "${TARGET_OUTPUT_ROOT}/${PAGE_ROOT}" >/dev/null 2>&1 || {
            echo "Unable to clean paginated archive path: ${TARGET_OUTPUT_ROOT}/${PAGE_ROOT}" >&2
            return 1
        }
    else
        PAGE_SIZE=""
    fi

    # sanity check manifest
    [[ -f "${ARCHIVE_MANIFEST}" ]] && [[ -r "${ARCHIVE_MANIFEST}" ]] || {
        echo "Archive manifest not found: ${ARCHIVE_MANIFEST}" >&2
        return 1
    }

    # complete document set before pagination
    VALID=0
    VALID_DOCUMENTS=()
    VALID_DOCUMENT_URIS=()
    VALID_DOCUMENT_ABSPATHS=()
    while IFS= read -r MANIFEST_RECORD; do
        [[ "${MANIFEST_RECORD}" == "" ]] && continue
        MANIFEST_FIELDS=()
        IFS=$'\037' read -r -a MANIFEST_FIELDS <<< "${MANIFEST_RECORD}"
        MANIFEST_FIELD_COUNT="${#MANIFEST_FIELDS[@]}"
        marsh_validate_record_field_count "${MANIFEST_FIELD_COUNT}" 5 99 'archive manifest record' || return 1
        DOCUMENT="${MANIFEST_FIELDS[0]:-}"
        TYPE="${MANIFEST_FIELDS[1]:-}"
        URI="${MANIFEST_FIELDS[2]:-}"
        ABSPATH="${MANIFEST_FIELDS[3]:-}"
        MANIFEST_STATE_COUNT="${MANIFEST_FIELDS[4]:-}"
        [[ "${DOCUMENT}" != "" ]] || return 1
        [[ "${TYPE}" != "" ]] || return 1
        [[ "${URI}" != "" ]] || return 1
        [[ "${MANIFEST_STATE_COUNT}" =~ ^[0-9]+$ ]] || {
            echo "Malformed archive manifest state count: ${ARCHIVE_MANIFEST}" >&2
            return 1
        }
        EXPECTED_MANIFEST_FIELD_COUNT=$((5 + MANIFEST_STATE_COUNT))
        if [[ "${MANIFEST_FIELD_COUNT}" -ne "${EXPECTED_MANIFEST_FIELD_COUNT}" ]]; then
            echo "Malformed archive manifest state count: ${ARCHIVE_MANIFEST}" >&2
            return 1
        fi
        STATE=()
        for ((MANIFEST_STATE_INDEX=0; MANIFEST_STATE_INDEX<MANIFEST_STATE_COUNT; MANIFEST_STATE_INDEX++)); do
            STATE+=("${MANIFEST_FIELDS[$((5 + MANIFEST_STATE_INDEX))]:-}")
        done
        if [[ "${COUNT}" != "" ]] && [[ "${VALID}" -ge "${COUNT}" ]]; then
            break
        fi
        if [[ "${TYPE%%-*}" == "archive" ]]; then
            continue
        fi
        if [[ "${#TYPES[@]}" -gt 0 ]] && ! marsh_in_array "${TYPE}" "${TYPES[@]}"; then
            continue
        fi
        if [[ "${#EXCLUDED_STATES[@]}" -gt 0 ]]; then
            for E in "${EXCLUDED_STATES[@]}"; do
                if marsh_in_array "${E}" "${STATE[@]}"; then
                    continue 2
                fi
            done
        fi
        VALID=$((VALID + 1))
        VALID_DOCUMENTS+=("${DOCUMENT}")
        VALID_DOCUMENT_URIS+=("${URI:-}")
        VALID_DOCUMENT_ABSPATHS+=("${ABSPATH:-}")
    done < "${ARCHIVE_MANIFEST}"

    # create page set for paginated html archives
    # create at least one page even where there are no subdocuments
    ARCHIVE_PAGES=()
    ARCHIVE_SUBDOCUMENTS_TOTAL="${#VALID_DOCUMENTS[@]}"
    PAGE_TOTAL=1
    if [[ "${PAGINATED}" == true ]]; then
        PAGE_TOTAL=$(( (ARCHIVE_SUBDOCUMENTS_TOTAL + PAGE_SIZE - 1) / PAGE_SIZE ))
        [[ "${PAGE_TOTAL}" -lt 1 ]] && PAGE_TOTAL=1
    fi
    PAGE_CANONICAL_URI=$(marsh_get_archive_page_uri "${TARGET_OUTPUT_ROOT}" "${ARCHIVE_SOURCE_REL}" "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
    PAGE_FIRST_URI="${PAGE_CANONICAL_URI}"
    PAGE_CANONICAL_OUTPUT_PATH="${ARCHIVE_SOURCE_REL%.*}${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}"
    PAGE_FIRST_OUTPUT_PATH="${PAGE_CANONICAL_OUTPUT_PATH}"
    if [[ "${PAGINATED}" == true ]] && [[ "${PAGE_TOTAL}" -gt 1 ]]; then
        PAGE_LAST_ARCHIVE_SOURCE_REL=$(marsh_get_archive_page_source "${ARCHIVE_SOURCE_REL}" "${PAGE_TOTAL}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
        PAGE_LAST_URI=$(marsh_get_archive_page_uri "${TARGET_OUTPUT_ROOT}" "${PAGE_LAST_ARCHIVE_SOURCE_REL}" "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
        PAGE_LAST_OUTPUT_PATH="${PAGE_LAST_ARCHIVE_SOURCE_REL%.*}${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}"
    else
        PAGE_LAST_URI="${PAGE_CANONICAL_URI}"
        PAGE_LAST_OUTPUT_PATH="${PAGE_CANONICAL_OUTPUT_PATH}"
    fi
    for ((PAGE=1; PAGE<=PAGE_TOTAL; PAGE++)); do
        PAGE_DOCUMENTS=()
        PAGE_DOCUMENT_URIS=()
        PAGE_DOCUMENT_ABSPATHS=()
        if [[ "${PAGINATED}" == true ]]; then
            PAGE_START=$(( (PAGE - 1) * PAGE_SIZE ))
            PAGE_END=$(( PAGE_START + PAGE_SIZE - 1 ))
        else
            PAGE_START=0
            PAGE_END=$(( ARCHIVE_SUBDOCUMENTS_TOTAL - 1 ))
        fi
        for ((PAGE_INDEX=PAGE_START; PAGE_INDEX<=PAGE_END; PAGE_INDEX++)); do
            if [[ "${PAGE_INDEX}" -lt 0 ]] || [[ "${PAGE_INDEX}" -ge "${ARCHIVE_SUBDOCUMENTS_TOTAL}" ]]; then
                continue
            fi
            PAGE_DOCUMENTS+=("${VALID_DOCUMENTS[$PAGE_INDEX]}")
            PAGE_DOCUMENT_URIS+=("${VALID_DOCUMENT_URIS[$PAGE_INDEX]}")
            PAGE_DOCUMENT_ABSPATHS+=("${VALID_DOCUMENT_ABSPATHS[$PAGE_INDEX]}")
        done
        PAGE_SUBDOCUMENTS_TOTAL="${#PAGE_DOCUMENTS[@]}"

        if [[ "${PAGINATED}" == true ]] && [[ "${PAGE}" -gt 1 ]]; then
            PAGE_ARCHIVE_SOURCE_REL=$(marsh_get_archive_page_source "${ARCHIVE_SOURCE_REL}" "${PAGE}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
        else
            PAGE_ARCHIVE_SOURCE_REL="${ARCHIVE_SOURCE_REL}"
        fi
        PAGE_URI=$(marsh_get_archive_page_uri "${TARGET_OUTPUT_ROOT}" "${PAGE_ARCHIVE_SOURCE_REL}" "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
        PAGE_OUTPUT_PATH="${PAGE_ARCHIVE_SOURCE_REL%.*}${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}"
        PAGE_BASE_PATH="./${PAGE_OUTPUT_PATH}"
        PAGE_BASE_PATH="${PAGE_BASE_PATH%/*}"
        PAGE_BASE_PATH="${PAGE_BASE_PATH#./}"
        PAGE_BASE_PATH="${PAGE_BASE_PATH:-.}"
        PAGE_BASE_PATH=$(marsh_normalize_path "${PAGE_BASE_PATH}" "directory") || return 1
        PAGE_PREV_URI=""
        PAGE_NEXT_URI=""
        PAGE_PREV_OUTPUT_PATH=""
        PAGE_NEXT_OUTPUT_PATH=""
        if [[ "${PAGE}" -gt 1 ]]; then
            if [[ "${PAGE}" -eq 2 ]]; then
                PAGE_PREV_ARCHIVE_SOURCE_REL="${ARCHIVE_SOURCE_REL}"
            else
                PAGE_PREV_ARCHIVE_SOURCE_REL=$(marsh_get_archive_page_source "${ARCHIVE_SOURCE_REL}" "$((PAGE - 1))" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
            fi
            PAGE_PREV_URI=$(marsh_get_archive_page_uri "${TARGET_OUTPUT_ROOT}" "${PAGE_PREV_ARCHIVE_SOURCE_REL}" "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
            PAGE_PREV_OUTPUT_PATH="${PAGE_PREV_ARCHIVE_SOURCE_REL%.*}${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}"
        fi
        if [[ "${PAGE}" -lt "${PAGE_TOTAL}" ]]; then
            PAGE_NEXT_ARCHIVE_SOURCE_REL=$(marsh_get_archive_page_source "${ARCHIVE_SOURCE_REL}" "$((PAGE + 1))" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
            PAGE_NEXT_URI=$(marsh_get_archive_page_uri "${TARGET_OUTPUT_ROOT}" "${PAGE_NEXT_ARCHIVE_SOURCE_REL}" "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
            PAGE_NEXT_OUTPUT_PATH="${PAGE_NEXT_ARCHIVE_SOURCE_REL%.*}${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}"
        fi
        PAGE_HREF=$(marsh_get_relative_path "${PAGE_BASE_PATH}" "${PAGE_OUTPUT_PATH}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
        PAGE_CANONICAL_HREF=$(marsh_get_relative_path "${PAGE_BASE_PATH}" "${PAGE_CANONICAL_OUTPUT_PATH}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
        PAGE_FIRST_HREF=$(marsh_get_relative_path "${PAGE_BASE_PATH}" "${PAGE_FIRST_OUTPUT_PATH}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
        PAGE_PREV_HREF=""
        [[ "${PAGE_PREV_OUTPUT_PATH}" != "" ]] && PAGE_PREV_HREF=$(marsh_get_relative_path "${PAGE_BASE_PATH}" "${PAGE_PREV_OUTPUT_PATH}" "${REMOVE_LINK_FILENAMES_CSV}") || true
        PAGE_NEXT_HREF=""
        [[ "${PAGE_NEXT_OUTPUT_PATH}" != "" ]] && PAGE_NEXT_HREF=$(marsh_get_relative_path "${PAGE_BASE_PATH}" "${PAGE_NEXT_OUTPUT_PATH}" "${REMOVE_LINK_FILENAMES_CSV}") || true
        PAGE_LAST_HREF=$(marsh_get_relative_path "${PAGE_BASE_PATH}" "${PAGE_LAST_OUTPUT_PATH}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
        PAGE_ARCHIVE_ROOT_HREF=$(marsh_get_relative_path "${PAGE_BASE_PATH}" "${ARCHIVE_ROOT_PATH}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1

        marsh_write_archive_page \
            "${ENCODING}" \
            "${TARGET_OUTPUT_ROOT}" \
            "${PAGE_ARCHIVE_SOURCE_REL}" \
            "${ARCHIVE_TITLE}" \
            "${LANGUAGE}" \
            "${LANGCODE}" \
            "${PAGINATED}" \
            "${PAGE}" \
            "${PAGE_TOTAL}" \
            "${PAGE_SIZE}" \
            "${PAGE_SUBDOCUMENTS_TOTAL}" \
            "${ARCHIVE_SUBDOCUMENTS_TOTAL}" \
            "${PAGE_URI}" \
            "${PAGE_CANONICAL_URI}" \
            "${PAGE_FIRST_URI}" \
            "${PAGE_PREV_URI}" \
            "${PAGE_NEXT_URI}" \
            "${PAGE_LAST_URI}" \
            "${PAGE_HREF}" \
            "${PAGE_CANONICAL_HREF}" \
            "${PAGE_FIRST_HREF}" \
            "${PAGE_PREV_HREF}" \
            "${PAGE_NEXT_HREF}" \
            "${PAGE_LAST_HREF}" \
            "${ARCHIVE_ROOT_PATH}" \
            "${PAGE_ARCHIVE_ROOT_HREF}" \
            "${#PAGE_DOCUMENTS[@]}" \
            "${PAGE_DOCUMENTS[@]}" \
            "${PAGE_DOCUMENT_URIS[@]}" \
            "${PAGE_DOCUMENT_ABSPATHS[@]}" || return 1
        ARCHIVE_PAGES+=("${PAGE_ARCHIVE_SOURCE_REL}")

        if [[ "${PAGINATED}" == true ]] && [[ "${PAGE}" -eq 1 ]]; then
            PAGE_ALIAS_ARCHIVE_SOURCE_REL=$(marsh_get_archive_page_source "${ARCHIVE_SOURCE_REL}" '1' "${REMOVE_LINK_FILENAMES_CSV}") || return 1
            PAGE_URI=$(marsh_get_archive_page_uri "${TARGET_OUTPUT_ROOT}" "${PAGE_ALIAS_ARCHIVE_SOURCE_REL}" "${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
            PAGE_OUTPUT_PATH="${PAGE_ALIAS_ARCHIVE_SOURCE_REL%.*}${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}"
            PAGE_BASE_PATH="./${PAGE_OUTPUT_PATH}"
            PAGE_BASE_PATH="${PAGE_BASE_PATH%/*}"
            PAGE_BASE_PATH="${PAGE_BASE_PATH#./}"
            PAGE_BASE_PATH="${PAGE_BASE_PATH:-.}"
            PAGE_BASE_PATH=$(marsh_normalize_path "${PAGE_BASE_PATH}" "directory") || return 1
            PAGE_HREF=$(marsh_get_relative_path "${PAGE_BASE_PATH}" "${PAGE_OUTPUT_PATH}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
            PAGE_CANONICAL_HREF=$(marsh_get_relative_path "${PAGE_BASE_PATH}" "${PAGE_CANONICAL_OUTPUT_PATH}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
            PAGE_FIRST_HREF=$(marsh_get_relative_path "${PAGE_BASE_PATH}" "${PAGE_FIRST_OUTPUT_PATH}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
            PAGE_NEXT_HREF=""
            [[ "${PAGE_NEXT_OUTPUT_PATH}" != "" ]] && PAGE_NEXT_HREF=$(marsh_get_relative_path "${PAGE_BASE_PATH}" "${PAGE_NEXT_OUTPUT_PATH}" "${REMOVE_LINK_FILENAMES_CSV}") || true
            PAGE_LAST_HREF=$(marsh_get_relative_path "${PAGE_BASE_PATH}" "${PAGE_LAST_OUTPUT_PATH}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
            PAGE_ARCHIVE_ROOT_HREF=$(marsh_get_relative_path "${PAGE_BASE_PATH}" "${ARCHIVE_ROOT_PATH}" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
            marsh_write_archive_page \
                "${ENCODING}" \
                "${TARGET_OUTPUT_ROOT}" \
                "${PAGE_ALIAS_ARCHIVE_SOURCE_REL}" \
                "${ARCHIVE_TITLE}" \
                "${LANGUAGE}" \
                "${LANGCODE}" \
                "${PAGINATED}" \
                '1' \
                "${PAGE_TOTAL}" \
                "${PAGE_SIZE}" \
                "${PAGE_SUBDOCUMENTS_TOTAL}" \
                "${ARCHIVE_SUBDOCUMENTS_TOTAL}" \
                "${PAGE_URI}" \
                "${PAGE_CANONICAL_URI}" \
                "${PAGE_FIRST_URI}" \
                '' \
                "${PAGE_NEXT_URI}" \
                "${PAGE_LAST_URI}" \
                "${PAGE_HREF}" \
                "${PAGE_CANONICAL_HREF}" \
                "${PAGE_FIRST_HREF}" \
                '' \
                "${PAGE_NEXT_HREF}" \
                "${PAGE_LAST_HREF}" \
                "${ARCHIVE_ROOT_PATH}" \
                "${PAGE_ARCHIVE_ROOT_HREF}" \
                "${#PAGE_DOCUMENTS[@]}" \
                "${PAGE_DOCUMENTS[@]}" \
                "${PAGE_DOCUMENT_URIS[@]}" \
                "${PAGE_DOCUMENT_ABSPATHS[@]}" || return 1
            ARCHIVE_PAGES+=("${PAGE_ALIAS_ARCHIVE_SOURCE_REL}")
        fi
    done

    printf '%s\n' "${ARCHIVE_PAGES[@]}"
    return 0
}

# loads cached archive metadata for a document
function marsh_get_archive_metadata {  # marsh_get_archive_metadata target_output_root document markdown_document_extensions_replacement [remove_link_filenames_csv]
    local TARGET_OUTPUT_ROOT DOCUMENT MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT REMOVE_LINK_FILENAMES_CSV
    local META META_CACHE DOCUMENT_SITE_REL TARGET_OUTPUT_REL
    local TYPE URI ABSPATH STATE_TEXT STATE_VALUE
    local -a STATE

    # init
    TARGET_OUTPUT_ROOT="${1:-}"
    DOCUMENT="${2:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT="${3:-}"
    REMOVE_LINK_FILENAMES_CSV="${4:-}"
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${DOCUMENT}" == "" ]] && return 1
    TARGET_OUTPUT_ROOT=$(marsh_get_target_directory_path "${TARGET_OUTPUT_ROOT}") || return 1
    DOCUMENT_SITE_REL=$(marsh_normalize_internal_path "${DOCUMENT}" 2>/dev/null) || return 1
    [[ "${DOCUMENT_SITE_REL}" == "." ]] && return 1

    # get archive metadata from the document metadata
    META=$(marsh_get_document_temp_path "${TARGET_OUTPUT_ROOT}" "${DOCUMENT_SITE_REL}" "meta-yaml" 2>/dev/null) || META=""
    META_CACHE=$(marsh_get_document_temp_path "${TARGET_OUTPUT_ROOT}" "${DOCUMENT_SITE_REL}" "meta" 2>/dev/null) || META_CACHE=""
    [[ -f "${META}" ]] && [[ -r "${META}" ]] || return 1

    # ensure the cache exists before loading it
    marsh_get_document_metadata "${META}" "" >/dev/null || return 1
    marsh_load_archive_document_metadata "${META_CACHE}" "TYPE" "STATE_TEXT" || return 1

    # keep only the metadata that archive generation actually needs
    # reconstruct public paths here so archive generation does not need to repeat it
    TARGET_OUTPUT_REL=$(marsh_get_target_output_path "${TARGET_OUTPUT_ROOT}") || return 1
    if [[ "${TARGET_OUTPUT_REL}" == "." ]]; then
        URI="${DOCUMENT_SITE_REL}"
    else
        URI="${TARGET_OUTPUT_REL}/${DOCUMENT_SITE_REL}"
    fi
    URI="${URI%.markdown}${MARKDOWN_DOCUMENT_EXTENSIONS_REPLACEMENT}"
    URI=$(marsh_get_absolute_output_path "${URI}" "document" "${REMOVE_LINK_FILENAMES_CSV}") || return 1
    ABSPATH=""
    [[ "${URI}" =~ / ]] && ABSPATH="${URI%/*}"

    # reconstruct state array
    STATE=()
    while IFS= read -r STATE_VALUE; do
        [[ "${STATE_VALUE}" != "" ]] || continue
        STATE+=("${STATE_VALUE}")
    done <<< "${STATE_TEXT}"

    # emit archive metadata as a single plaintext record
    marsh_validate_record_fields "archive metadata record" "${TYPE}" "${URI}" "${ABSPATH}" "${#STATE[@]}" "${STATE[@]}" || return 1
    printf '%s\037%s\037%s\037%s' "${TYPE}" "${URI}" "${ABSPATH}" "${#STATE[@]}"
    for STATE_VALUE in "${STATE[@]}"; do
        printf '\037%s' "${STATE_VALUE}"
    done
    printf '\n'

    return 0
}

# returns paginated archive root for an archive source path
