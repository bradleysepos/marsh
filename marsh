# resolves a custom document tag from loaded document metadata state
function marsh_resolve_loaded_document_metadata_tag {  # marsh_resolve_loaded_document_metadata_tag tag_name prefix out_type_var out_value_var
    local TAG_NAME PREFIX OUT_TYPE_VAR OUT_VALUE_VAR
    local STATE_PREFIX_VAR STATE_COUNT_VAR LOOKUP_KEY LOOKUP_TYPE LOOKUP_VALUE

    TAG_NAME="${1:-}"
    PREFIX="${2:-}"
    OUT_TYPE_VAR="${3:-}"
    OUT_VALUE_VAR="${4:-}"
    [[ "${TAG_NAME}" != "" ]] || return 1
    [[ "${PREFIX}" != "" ]] || return 1
    [[ "${OUT_TYPE_VAR}" != "" ]] || return 1
    [[ "${OUT_VALUE_VAR}" != "" ]] || return 1
    [[ "${TAG_NAME#document.}" != "${TAG_NAME}" ]] || return 1

    STATE_PREFIX_VAR="${PREFIX}METADATA_STATE_PREFIX"
    STATE_COUNT_VAR="${PREFIX}METADATA_STATE_COUNT"
    [[ "${!STATE_PREFIX_VAR:-}" != "" ]] || return 1
    [[ "${!STATE_COUNT_VAR:-}" =~ ^[0-9]+$ ]] || return 1

    LOOKUP_KEY=""
    LOOKUP_TYPE=""
    LOOKUP_VALUE=""
    marsh_lookup_document_metadata_state "${!STATE_PREFIX_VAR}" "${!STATE_COUNT_VAR}" "${TAG_NAME}" "LOOKUP_KEY" "LOOKUP_TYPE" "LOOKUP_VALUE" || return 1

    case "${LOOKUP_TYPE}" in
        value)
            printf -v "${OUT_TYPE_VAR}" '%s' 'string'
            ;;
        list)
            printf -v "${OUT_TYPE_VAR}" '%s' 'list'
            ;;
        *)
            return 1
            ;;
    esac
    printf -v "${OUT_VALUE_VAR}" '%s' "${LOOKUP_VALUE}"
    return 0
}

# resolves a template tag for render-time consumers without rescanning loaded document metadata
function marsh_resolve_render_template_tag {  # marsh_resolve_render_template_tag tag_name prefix metadata_vars out_var_var out_type_var out_value_var
    local TAG_NAME PREFIX METADATA_VARS OUT_VAR_VAR OUT_TYPE_VAR OUT_VALUE_VAR
    local RESOLVED_VAR RESOLVED_TYPE RESOLVED_VALUE STATE_PREFIX_VAR STATE_COUNT_VAR

    TAG_NAME="${1:-}"
    PREFIX="${2:-}"
    METADATA_VARS="${3:-}"
    OUT_VAR_VAR="${4:-}"
    OUT_TYPE_VAR="${5:-}"
    OUT_VALUE_VAR="${6:-}"
    [[ "${TAG_NAME}" != "" ]] || return 1
    [[ "${PREFIX}" != "" ]] || return 1
    [[ "${OUT_VAR_VAR}" != "" ]] || return 1
    [[ "${OUT_TYPE_VAR}" != "" ]] || return 1
    [[ "${OUT_VALUE_VAR}" != "" ]] || return 1

    printf -v "${OUT_VAR_VAR}" '%s' ''
    printf -v "${OUT_TYPE_VAR}" '%s' ''
    printf -v "${OUT_VALUE_VAR}" '%s' ''
    RESOLVED_VAR=""
    RESOLVED_TYPE=""
    RESOLVED_VALUE=""
    STATE_PREFIX_VAR="${PREFIX}METADATA_STATE_PREFIX"
    STATE_COUNT_VAR="${PREFIX}METADATA_STATE_COUNT"

    marsh_resolve_template_tag_metadata "${TAG_NAME}" "${PREFIX}" "" "RESOLVED_VAR" "RESOLVED_TYPE" 2>/dev/null || true
    if [[ "${RESOLVED_VAR}" == "" ]] && [[ "${RESOLVED_TYPE}" == "" ]] && [[ "${!STATE_PREFIX_VAR:-}" != "" ]] && [[ "${!STATE_COUNT_VAR:-}" =~ ^[0-9]+$ ]]; then
        marsh_resolve_loaded_document_metadata_tag "${TAG_NAME}" "${PREFIX}" "RESOLVED_TYPE" "RESOLVED_VALUE" 2>/dev/null || true
    fi
    if [[ "${RESOLVED_VAR}" == "" ]] && [[ "${RESOLVED_TYPE}" == "" ]] && [[ "${METADATA_VARS}" != "" ]]; then
        marsh_resolve_template_tag_metadata "${TAG_NAME}" "${PREFIX}" "${METADATA_VARS}" "RESOLVED_VAR" "RESOLVED_TYPE" 2>/dev/null || true
    fi

    if [[ "${RESOLVED_TYPE}" == "shell-array" ]]; then
        marsh_resolve_render_shell_array_tag "${RESOLVED_VAR}" "RESOLVED_VALUE" || return 1
        RESOLVED_TYPE="list"
        RESOLVED_VAR=""
    fi

    [[ "${RESOLVED_TYPE}" != "" ]] || return 1
    printf -v "${OUT_VAR_VAR}" '%s' "${RESOLVED_VAR}"
    printf -v "${OUT_TYPE_VAR}" '%s' "${RESOLVED_TYPE}"
    printf -v "${OUT_VALUE_VAR}" '%s' "${RESOLVED_VALUE}"
    return 0
}

# resolves a template asset output path relative to the target root and rejects traversal beyond the site root
function marsh_resolve_template_asset_output_path {  # marsh_resolve_template_asset_output_path target_output_rel asset_path [template_assets_path]
    local TARGET_OUTPUT_REL ASSET_PATH TEMPLATE_ASSETS_PATH COMBINED_PATH ASSET_OUTPUT_REL

    TARGET_OUTPUT_REL="${1:-}"
    ASSET_PATH="${2:-}"
    TEMPLATE_ASSETS_PATH="${3:-}"
    [[ "${TARGET_OUTPUT_REL}" == "" ]] && return 1
    [[ "${ASSET_PATH}" == "" ]] && return 1
    [[ "${ASSET_PATH}" != /* ]] || return 1
    [[ "${TEMPLATE_ASSETS_PATH}" != /* ]] || return 1

    TARGET_OUTPUT_REL=$(marsh_normalize_internal_path "${TARGET_OUTPUT_REL}" "directory") || return 1
    COMBINED_PATH="${ASSET_PATH}"
    if [[ "${TEMPLATE_ASSETS_PATH}" != "" ]]; then
        COMBINED_PATH="${TEMPLATE_ASSETS_PATH%/}/${ASSET_PATH}"
    fi
    ASSET_OUTPUT_REL=$(marsh_resolve_relative_path "${TARGET_OUTPUT_REL}" "${COMBINED_PATH}") || return 1
    case "${ASSET_OUTPUT_REL}" in
        ..|../*)
            return 1
            ;;
    esac

    printf '%s\n' "${ASSET_OUTPUT_REL}"
}

# resolves a template tag into caller-owned outputs
function marsh_resolve_template_tag_metadata {  # marsh_resolve_template_tag_metadata tag_name prefix metadata_vars tag_var_out tag_type_out
    local TAG_NAME PREFIX METADATA_VARS TAG_VAR_OUTPUT TAG_TYPE_OUTPUT RESOLVED_TAG_VAR RESOLVED_TAG_TYPE
    local META_VAR NORMALIZED_TAG NORMALIZED_META MATCH_VAR MATCH_COUNT
    local -a META_VARS_ARRAY

    # init
    TAG_NAME="${1:-}"
    PREFIX="${2:-}"
    METADATA_VARS="${3:-}"
    [[ "${TAG_NAME}" == "" ]] && return 1
    shift 3
    TAG_VAR_OUTPUT="${1:-}"
    TAG_TYPE_OUTPUT="${2:-}"
    [[ "${TAG_VAR_OUTPUT}" != "" ]] && printf -v "${TAG_VAR_OUTPUT}" '%s' ''
    [[ "${TAG_TYPE_OUTPUT}" != "" ]] && printf -v "${TAG_TYPE_OUTPUT}" '%s' ''
    [[ "${TAG_VAR_OUTPUT}" == "" ]] && return 1
    [[ "${TAG_TYPE_OUTPUT}" == "" ]] && return 1

    # handle known metadata tags
    # keep resolved names separate from output variable names
    RESOLVED_TAG_VAR=""
    RESOLVED_TAG_TYPE=""
    case "${TAG_NAME}" in
        site.rootpath)
            RESOLVED_TAG_VAR="SITE_ROOTPATH"
            RESOLVED_TAG_TYPE="string"
            ;;
        site.abspath)
            RESOLVED_TAG_VAR="SITE_ABSPATH"
            RESOLVED_TAG_TYPE="string"
            ;;
        target.rootpath)
            RESOLVED_TAG_VAR="TARGET_ROOTPATH"
            RESOLVED_TAG_TYPE="string"
            ;;
        target.abspath)
            RESOLVED_TAG_VAR="TARGET_ABSPATH"
            RESOLVED_TAG_TYPE="string"
            ;;
        archive.rootpath)
            RESOLVED_TAG_VAR="ARCHIVE_ROOTPATH"
            RESOLVED_TAG_TYPE="string"
            ;;
        archive.abspath)
            RESOLVED_TAG_VAR="ARCHIVE_ABSPATH"
            RESOLVED_TAG_TYPE="string"
            ;;
        target.sitemap)
            RESOLVED_TAG_VAR="TARGET_SITEMAP"
            RESOLVED_TAG_TYPE="string"
            ;;
        template.assets.fonts)
            RESOLVED_TAG_VAR="TEMPLATE_TAG_ASSETS_FONTS"
            RESOLVED_TAG_TYPE="shell-array"
            ;;
        template.assets.styles)
            RESOLVED_TAG_VAR="TEMPLATE_TAG_ASSETS_STYLES"
            RESOLVED_TAG_TYPE="shell-array"
            ;;
        template.assets.scripts)
            RESOLVED_TAG_VAR="TEMPLATE_TAG_ASSETS_SCRIPTS"
            RESOLVED_TAG_TYPE="shell-array"
            ;;
        template.assets.images)
            RESOLVED_TAG_VAR="TEMPLATE_TAG_ASSETS_IMAGES"
            RESOLVED_TAG_TYPE="shell-array"
            ;;
        template.assets.audio)
            RESOLVED_TAG_VAR="TEMPLATE_TAG_ASSETS_AUDIO"
            RESOLVED_TAG_TYPE="shell-array"
            ;;
        template.assets.video)
            RESOLVED_TAG_VAR="TEMPLATE_TAG_ASSETS_VIDEO"
            RESOLVED_TAG_TYPE="shell-array"
            ;;
        template.assets.documents)
            RESOLVED_TAG_VAR="TEMPLATE_TAG_ASSETS_DOCUMENTS"
            RESOLVED_TAG_TYPE="shell-array"
            ;;
        template.assets.binaries)
            RESOLVED_TAG_VAR="TEMPLATE_TAG_ASSETS_BINARIES"
            RESOLVED_TAG_TYPE="shell-array"
            ;;
        template.assets.other)
            RESOLVED_TAG_VAR="TEMPLATE_TAG_ASSETS_OTHER"
            RESOLVED_TAG_TYPE="shell-array"
            ;;
        document.href)
            RESOLVED_TAG_VAR="${PREFIX}HREF"
            RESOLVED_TAG_TYPE="string"
            ;;
        document.uri)
            RESOLVED_TAG_VAR="${PREFIX}URI"
            RESOLVED_TAG_TYPE="string"
            ;;
        document.content)
            RESOLVED_TAG_VAR="${PREFIX}CONTENT"
            RESOLVED_TAG_TYPE="file"
            ;;
        document.authors)
            RESOLVED_TAG_VAR="${PREFIX}Authors_"
            RESOLVED_TAG_TYPE="array"
            ;;
        document.copyright)
            RESOLVED_TAG_VAR="${PREFIX}Copyright"
            RESOLVED_TAG_TYPE="string"
            ;;
        document.credits-url)
            RESOLVED_TAG_VAR="${PREFIX}Credits_URL"
            RESOLVED_TAG_TYPE="string"
            ;;
        document.date)
            RESOLVED_TAG_VAR="${PREFIX}Date"
            RESOLVED_TAG_TYPE="string"
            ;;
        document.language)
            RESOLVED_TAG_VAR="${PREFIX}Language"
            RESOLVED_TAG_TYPE="string"
            ;;
        document.language-code)
            RESOLVED_TAG_VAR="${PREFIX}Language_Code"
            RESOLVED_TAG_TYPE="string"
            ;;
        document.license)
            RESOLVED_TAG_VAR="${PREFIX}License"
            RESOLVED_TAG_TYPE="string"
            ;;
        document.license-abbr)
            RESOLVED_TAG_VAR="${PREFIX}License_Abbr"
            RESOLVED_TAG_TYPE="string"
            ;;
        document.license-url)
            RESOLVED_TAG_VAR="${PREFIX}License_URL"
            RESOLVED_TAG_TYPE="string"
            ;;
        document.project)
            RESOLVED_TAG_VAR="${PREFIX}Project"
            RESOLVED_TAG_TYPE="string"
            ;;
        document.project-version)
            RESOLVED_TAG_VAR="${PREFIX}Project_Version"
            RESOLVED_TAG_TYPE="string"
            ;;
        document.project-url)
            RESOLVED_TAG_VAR="${PREFIX}Project_URL"
            RESOLVED_TAG_TYPE="string"
            ;;
        document.redirect-url)
            RESOLVED_TAG_VAR="${PREFIX}Redirect_URL"
            RESOLVED_TAG_TYPE="string"
            ;;
        document.state)
            RESOLVED_TAG_VAR="${PREFIX}State_"
            RESOLVED_TAG_TYPE="array"
            ;;
        document.title)
            RESOLVED_TAG_VAR="${PREFIX}Title"
            RESOLVED_TAG_TYPE="string"
            ;;
        document.type)
            RESOLVED_TAG_VAR="${PREFIX}Type"
            RESOLVED_TAG_TYPE="string"
            ;;
        util.json-separator)
            RESOLVED_TAG_VAR="UTIL_JSON_SEPARATOR"
            RESOLVED_TAG_TYPE="string"
            ;;
        *)
            ;;
    esac

    # handle all other metadata tags, only string values are supported
    # tag names begin with 'document.' and a list of metadata variables must be provided to match against
    # normalization follows the output pattern of converting to lowercase and replacing underscores with dashes
    if [[ "${RESOLVED_TAG_VAR}" == "" ]] && [[ "${RESOLVED_TAG_TYPE}" == "" ]]; then
        [[ "${TAG_NAME#document.}" != "${TAG_NAME}" ]] || return 1
        [[ "${METADATA_VARS}" != "" ]] || return 1
        NORMALIZED_TAG="${TAG_NAME#document.}"
        NORMALIZED_TAG=$(printf '%s' "${NORMALIZED_TAG}" | awk '{ print tolower($0) }')
        MATCH_VAR=""
        MATCH_COUNT=0
        OIFS="${IFS}"
        IFS=$'\n'
        METADATA_VARS_ARRAY=(${METADATA_VARS})
        for META_VAR in "${METADATA_VARS_ARRAY[@]}"; do
            [[ "${META_VAR}" == "${PREFIX}"* ]] || continue
            NORMALIZED_META="${META_VAR#${PREFIX}}"
            NORMALIZED_META=$(printf '%s' "${NORMALIZED_META}" | awk '{ print tolower($0) }')
            NORMALIZED_META="${NORMALIZED_META//_/-}"
            [[ "${NORMALIZED_META}" == "${NORMALIZED_TAG}" ]] || continue
            MATCH_VAR="${META_VAR}"
            MATCH_COUNT=$((MATCH_COUNT + 1))
        done
        IFS="${OIFS}"
        [[ "${MATCH_COUNT}" -eq 1 ]] || return 1
        RESOLVED_TAG_VAR="${MATCH_VAR}"
        RESOLVED_TAG_TYPE="string"
    fi

    printf -v "${TAG_VAR_OUTPUT}" '%s' "${RESOLVED_TAG_VAR}"
    printf -v "${TAG_TYPE_OUTPUT}" '%s' "${RESOLVED_TAG_TYPE}"
    return 0
}

