    ARCHIVE_PAGE_SIZE="${SOURCE_PREFIX}Archives_${II}_Page_Size"
    ARCHIVE_CONTENT="${SOURCE_PREFIX}Archives_${II}_Content"
    while [[ "${!ARCHIVE:-}" != "" ]]; do
        echo "${PREFIX}ARCHIVES+=(\"${!ARCHIVE//\"/\\\"}\")"
        echo "${PREFIX}ARCHIVES_ENCODING+=(\"${!ARCHIVE_ENCODING//\"/\\\"}\")"
