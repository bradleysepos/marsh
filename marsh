# checks for required external tools
function marsh_check_dependencies {  # marsh_check_dependencies $DEP1 $DEP2 ...
    local DEPS_EACH FOUND DEP
    local -a DEPS ERRORS DEPS_MULTI
    DEPS=("${@}");
    ERRORS=()
    for DEPS_EACH in "${DEPS[@]}"; do
        DEPS_MULTI=(${DEPS_EACH//|/ })
        FOUND=false
        for DEP in "${DEPS_MULTI[@]}"; do
            if [[ "${DEP}" == */* ]]; then
                if [[ -x "${DEP}" ]]; then
                    FOUND=true
                fi
                break
            elif command -v "${DEP}" >/dev/null 2>&1; then
                FOUND=true
                break
            fi
        done
        if [[ "${FOUND}" == false ]]; then
            ERRORS+=("${DEPS_EACH}")
        fi
    done
    if [[ "${#ERRORS[@]}" -ne 0 ]]; then
        echo "dependencies: ${DEPS[@]}" >&2
        echo "unable to find command(s): ${ERRORS[*]}" >&2
        return 1
    fi
}

# copies files from local sources
function marsh_copy_files {  # marsh_copy_files source dest force
    local SOURCE DEST FORCE
    local SOURCE_DIR FILES_LIST FILE

    # init
    SOURCE="${1:-}"
    DEST="${2:-}"
    if [[ "${SOURCE}" == "" ]]; then
        echo "Internal error copying files: source empty" >&2
        return 1
    elif [[ "${DEST}" == "" ]]; then
        echo "Internal error copying files: destination empty" >&2
        return 1
    fi
    SOURCE_DIR="${SOURCE%/*}"
    SOURCE_DIR="${SOURCE_DIR:-.}"
    FORCE="${3:-}"

    # select files for copy
    if [[ -d "${SOURCE}" ]]; then
        FILES_LIST="${SOURCE#$SOURCE_DIR/}"
        DEST="${DEST%/$FILES_LIST}"
    else
        FILES_LIST=$(cd "${SOURCE_DIR}" >/dev/null 2>&1 && find . -maxdepth 1 -name "${SOURCE##*/}" | sed -e 's/^\.\///' -e 's/^\.$//')
        if [[ $? -ne 0 ]]; then
            echo "Unable to change into directory: ${SOURCE_DIR}" >&2
            return 1
        fi
    fi

    while IFS= read -r FILE; do
        [[ "${FILE}" == "" ]] && continue
        # sanity
        if [[ "${SOURCE_DIR}/${FILE}" == "${DEST%/}/${FILE}" ]]; then
            # same source and destination
            echo "Source and destination paths are equal: ${DEST}" >&2
            return 1
        fi
        if [[ -e "${DEST%/}/${FILE}" ]] && [[ "${FORCE}" != true ]]; then
            # path exists
            echo "Path exists (--force to overwrite): ${DEST%/}/${FILE}" >&2
            return 1
        fi
        # create path
        DEST="${DEST%/.}"
        if ! mkdir -p "${DEST}"; then
            echo "Unable to create path: ${DEST}" >&2
            return 1
        fi
        # clean destination
        if ! rm -rf "${DEST%/}/${FILE}"; then
            echo "Unable to replace path: ${DEST}" >&2
            return 1
        fi
        # copy
        if ! cp -R "${SOURCE_DIR}/${FILE}" "${DEST%/}/${FILE}"; then
            echo "Unable to copy file: ${SOURCE_DIR}/${FILE} -> ${DEST%/}/${FILE}" >&2
            return 1
        fi
    done <<< "${FILES_LIST}"
    return 0
}

# escapes text for safe sed replacement, trimming trailing newlines to match shell command substitution behavior
function marsh_escape_substitution {  # marsh_escape_substitution
    sed -e ':a' -e '$!{N' -e 'ba' -e '}' -e 's/\n*$//' -e 's/[&/\]/\\&/g' -e 's/\n/\\&/g'
}

# formats elapsed seconds as XmY.ZZZs
function marsh_format_elapsed_time {  # marsh_format_elapsed_time elapsed_seconds
    local ELAPSED_SECONDS

    ELAPSED_SECONDS="${1:-}"
    [[ "${ELAPSED_SECONDS}" == "" ]] && return 1
    awk -v elapsed_seconds="${ELAPSED_SECONDS}" '
    BEGIN {
        elapsed = elapsed_seconds + 0
        if (elapsed < 0) {
            elapsed = 0
        }
        elapsed_millis = int((elapsed * 1000) + 0.5)
        minutes = int(elapsed_millis / 60000)
        seconds = (elapsed_millis % 60000) / 1000
        printf "%dm%.3fs\n", minutes, seconds
    }
    '
}

# builds a cache file path from one or more key parts
function marsh_get_cache_path {  # marsh_get_cache_path cache_root suffix key_part [key_part...]
    local CACHE_ROOT SUFFIX KEY

    # init
    CACHE_ROOT="${1:-}"
    SUFFIX="${2:-}"
    [[ "${CACHE_ROOT}" == "" ]] && return 1
    shift 2
    [[ "${#@}" -gt 0 ]] || return 1

    KEY=$(printf "%s\n" "${@}" | marsh_text_transform hash:md5) || return 1
    printf '%s\n' "${CACHE_ROOT}/${KEY}${SUFFIX}"
}

# returns the extension for a given file path or url including the leading dot
# only returns the last extension where multiple exist, e.g., "archive.tar.gz" returns ".gz"
function marsh_get_extension {  # marsh_get_extension path_or_url
    local PATH_OR_URL NAME EXT

    # init
    PATH_OR_URL="${1:-}"
    [[ "${PATH_OR_URL}" == "" ]] && return 0

    NAME="${PATH_OR_URL##*/}"
    if [[ "${NAME}" == *.* ]]; then
        EXT="${NAME##*.}"
        printf '%s\n' ".${EXT}"
    fi
    return 0
}

# emits values from flat indexed variables one per line
# TEST_0="foo"; TEST_1="bar"; TEST_2="baz"
# marsh_get_flatarray_values "TEST_"  # loops over TEST_{0..2} and prints foo\nbar\nbaz
function marsh_get_flatarray_values {  # marsh_get_flatarray_values variable_prefix
    local PREFIX INDEX ITEM_NAME ITEM_VALUE
    PREFIX="${1:-}"
    [[ "${PREFIX}" == "" ]] && return 1
    INDEX=0
    ITEM_NAME="${PREFIX}${INDEX}"
    while [[ -n "${!ITEM_NAME+isset}" ]]; do
        ITEM_VALUE="${!ITEM_NAME}"
        printf '%s\n' "${ITEM_VALUE}"
        INDEX=$((INDEX + 1))
        ITEM_NAME="${PREFIX}${INDEX}"
    done
    return 0
}

# prints local declarations for the given list of variable names, one per line
function marsh_get_local_declarations {  # marsh_get_local_declarations variables_string
    sed -n -E -e '/^$/d' -e 's/^/local /p'
}

# returns a shell-native timestamp for elapsed-time measurement
function marsh_get_shell_timestamp {  # marsh_get_shell_timestamp
    local NOW

    if [[ "${EPOCHREALTIME:-}" != "" ]]; then
        printf '%s\n' "${EPOCHREALTIME}"
        return 0
    fi

    NOW="${SECONDS:-0}"
    printf '%s.000\n' "${NOW}"
}

# prints a unique list of variables given assignment commands, defaulting to last-occurrence order
function marsh_get_variables {  # marsh_get_variables [occurrence_order]
    local OCCURRENCE_ORDER VARIABLE_NAMES_CAPTURE_REGEX

    OCCURRENCE_ORDER="${1:-last}"
    [[ "${OCCURRENCE_ORDER}" != "first" ]] && [[ "${OCCURRENCE_ORDER}" != "last" ]] && return 1

    # captures variable name from simple assignments, e.g., VAR=value becomes VAR
    VARIABLE_NAMES_CAPTURE_REGEX='s/^([^=]+[^+])[+]?=.*/\1/'

    # deduplicate variable names, keeping either first or last occurrence
    if [[ "${OCCURRENCE_ORDER}" == "first" ]]; then
        sed -E -e "${VARIABLE_NAMES_CAPTURE_REGEX}" | awk '!seen[$0]++'
        return 0
    fi
    sed -E -e "${VARIABLE_NAMES_CAPTURE_REGEX}" | awk '
    {
        if (!($0 in first_index)) {
            ordered_names[++ordered_count] = $0
        }
        last_index[$0] = NR
    }
    END {
        for (i = 1; i <= ordered_count; i++) {
            name = ordered_names[i]
            names_by_position[last_index[name]] = name
        }
        for (i = 1; i <= NR; i++) {
            if (names_by_position[i] != "") {
                print names_by_position[i]
            }
        }
    }'
}

# formats a count plus a simple singular or plural label derived from the input
# not a true inflector, but useful for simple cases like "1 plan" vs "2 plans"
function marsh_inflect {  # marsh_inflect string count
    local STRING_VALUE COUNT_VALUE LABEL

    STRING_VALUE="${1:-}"
    COUNT_VALUE="${2:-0}"
    [[ "${STRING_VALUE}" == "" ]] && return 1
    [[ "${COUNT_VALUE}" =~ ^[0-9]+$ ]] || return 1

    LABEL="${STRING_VALUE}"
    if [[ "${COUNT_VALUE}" -ne 1 ]]; then
        LABEL="${LABEL}s"
    fi

    printf '%s %s\n' "${COUNT_VALUE}" "${LABEL}"
}

# tests whether a string is an exact match for an array item
function marsh_in_array {  # marsh_in_array needle haystack[@]
    local e
    for e in "${@:2}"; do
        [[ "${e}" == "${1}" ]] && return 0;
    done
    return 1
}

# returns success when file extension is a markdown file extension
function marsh_is_markdown_extension {  # marsh_is_markdown_extension file_ext markdown_document_extensions_csv
    local FILE_EXT MARKDOWN_DOCUMENT_EXTENSIONS_CSV MD_EXT
    local -a MD_EXTS

    FILE_EXT="${1:-}"
    MARKDOWN_DOCUMENT_EXTENSIONS_CSV="${2:-}"
    [[ "${FILE_EXT}" == "" ]] && return 1
    [[ "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}" == "" ]] && return 1
    FILE_EXT=$(printf '%s' "${FILE_EXT}" | awk '{ print tolower($0) }')
    IFS=',' read -r -a MD_EXTS <<< "${MARKDOWN_DOCUMENT_EXTENSIONS_CSV}"
    for MD_EXT in "${MD_EXTS[@]}"; do
        [[ "${FILE_EXT}" == "${MD_EXT}" ]] && return 0
    done
    return 1
}

# loads marsh_parse_yaml assignment output without evaluating shell code
function marsh_load_parsed_yaml_assignments {  # marsh_load_parsed_yaml_assignments parsed_yaml_assignments
    local PARSED_YAML_ASSIGNMENTS ASSIGNMENT_LINE PARSED_ASSIGNMENT_NAME PARSED_ASSIGNMENT_VALUE

    PARSED_YAML_ASSIGNMENTS="${1:-}"
    [[ "${PARSED_YAML_ASSIGNMENTS}" == "" ]] && return 0

    while IFS= read -r ASSIGNMENT_LINE || [[ "${ASSIGNMENT_LINE}" != "" ]]; do
        [[ "${ASSIGNMENT_LINE}" == "" ]] && continue
        marsh_parse_internal_assignment "${ASSIGNMENT_LINE}" "PARSED_ASSIGNMENT_NAME" "PARSED_ASSIGNMENT_VALUE" "parsed yaml" || return 1
        printf -v "${PARSED_ASSIGNMENT_NAME}" '%s' "${PARSED_ASSIGNMENT_VALUE}"
    done <<< "${PARSED_YAML_ASSIGNMENTS}"
}

# loads marsh-owned parsed yaml assignments into caller-owned flat state
function marsh_load_parsed_yaml_state {  # marsh_load_parsed_yaml_state parsed_yaml_assignments state_prefix out_count_var
    local PARSED_YAML_ASSIGNMENTS STATE_PREFIX OUT_COUNT_VAR ASSIGNMENT_LINE
    local PARSED_ASSIGNMENT_NAME PARSED_ASSIGNMENT_VALUE STATE_ENTRY_COUNT

    PARSED_YAML_ASSIGNMENTS="${1:-}"
    STATE_PREFIX="${2:-}"
    OUT_COUNT_VAR="${3:-}"
    [[ "${STATE_PREFIX}" != "" ]] || return 1
    [[ "${OUT_COUNT_VAR}" != "" ]] || return 1
    [[ "${STATE_PREFIX}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || return 1
    [[ "${OUT_COUNT_VAR}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || return 1

    STATE_ENTRY_COUNT=0
    while IFS= read -r ASSIGNMENT_LINE || [[ "${ASSIGNMENT_LINE}" != "" ]]; do
        [[ "${ASSIGNMENT_LINE}" == "" ]] && continue
        marsh_parse_parsed_yaml_assignment "${ASSIGNMENT_LINE}" "PARSED_ASSIGNMENT_NAME" "PARSED_ASSIGNMENT_VALUE" || return 1
        printf -v "${STATE_PREFIX}KEY_${STATE_ENTRY_COUNT}" '%s' "${PARSED_ASSIGNMENT_NAME}"
        printf -v "${STATE_PREFIX}VALUE_${STATE_ENTRY_COUNT}" '%s' "${PARSED_ASSIGNMENT_VALUE}"
        STATE_ENTRY_COUNT=$((STATE_ENTRY_COUNT + 1))
    done <<< "${PARSED_YAML_ASSIGNMENTS}"

    printf -v "${OUT_COUNT_VAR}" '%s' "${STATE_ENTRY_COUNT}"
}

# looks up one marsh-owned parsed yaml assignment value from loaded state using last-write-wins semantics
function marsh_lookup_parsed_yaml_state {  # marsh_lookup_parsed_yaml_state state_prefix state_count key out_value_var
    local STATE_PREFIX STATE_COUNT KEY_NAME OUT_VALUE_VAR
    local STATE_INDEX STATE_KEY_VAR STATE_VALUE_VAR

    STATE_PREFIX="${1:-}"
    STATE_COUNT="${2:-}"
    KEY_NAME="${3:-}"
    OUT_VALUE_VAR="${4:-}"
    [[ "${STATE_PREFIX}" != "" ]] || return 1
    [[ "${STATE_COUNT}" =~ ^[0-9]+$ ]] || return 1
    [[ "${KEY_NAME}" != "" ]] || return 1
    [[ "${OUT_VALUE_VAR}" != "" ]] || return 1

    STATE_INDEX=$((STATE_COUNT - 1))
    while [[ "${STATE_INDEX}" -ge 0 ]]; do
        STATE_KEY_VAR="${STATE_PREFIX}KEY_${STATE_INDEX}"
        if [[ "${!STATE_KEY_VAR}" == "${KEY_NAME}" ]]; then
            STATE_VALUE_VAR="${STATE_PREFIX}VALUE_${STATE_INDEX}"
            printf -v "${OUT_VALUE_VAR}" '%s' "${!STATE_VALUE_VAR}"
            return 0
        fi
        STATE_INDEX=$((STATE_INDEX - 1))
    done
    return 1
}

# parses one marsh-owned parsed-yaml assignment line without evaluating shell code
function marsh_parse_parsed_yaml_assignment {  # marsh_parse_parsed_yaml_assignment assignment_line out_name_var out_value_var
    local ASSIGNMENT_LINE OUT_NAME_VAR OUT_VALUE_VAR
    local ASSIGNMENT_NAME ASSIGNMENT_VALUE

    ASSIGNMENT_LINE="${1:-}"
    OUT_NAME_VAR="${2:-}"
    OUT_VALUE_VAR="${3:-}"
    [[ "${ASSIGNMENT_LINE}" != "" ]] || return 1
    [[ "${OUT_NAME_VAR}" != "" ]] || return 1
    [[ "${OUT_VALUE_VAR}" != "" ]] || return 1

    if [[ "${ASSIGNMENT_LINE}" == *$'\n'* ]] || [[ "${ASSIGNMENT_LINE}" == *$'\r'* ]]; then
        echo "Unsupported parsed yaml multiline value" >&2
        return 1
    fi
    [[ "${ASSIGNMENT_LINE}" == *=* ]] || {
        echo "Malformed parsed yaml assignment line: ${ASSIGNMENT_LINE}" >&2
        return 1
    }

    ASSIGNMENT_NAME="${ASSIGNMENT_LINE%%=*}"
    ASSIGNMENT_VALUE="${ASSIGNMENT_LINE#*=}"
    [[ "${ASSIGNMENT_NAME}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || {
        echo "Invalid parsed yaml assignment name: ${ASSIGNMENT_NAME}" >&2
        return 1
    }

    if [[ "${ASSIGNMENT_VALUE}" == true ]] || [[ "${ASSIGNMENT_VALUE}" == false ]]; then
        printf -v "${OUT_NAME_VAR}" '%s' "${ASSIGNMENT_NAME}"
        printf -v "${OUT_VALUE_VAR}" '%s' "${ASSIGNMENT_VALUE}"
        return 0
    fi

    if [[ ! "${ASSIGNMENT_VALUE}" == '"'*'"' ]]; then
        echo "Unsupported parsed yaml assignment value: ${ASSIGNMENT_LINE}" >&2
        return 1
    fi

    ASSIGNMENT_VALUE="${ASSIGNMENT_VALUE#\"}"
    ASSIGNMENT_VALUE="${ASSIGNMENT_VALUE%\"}"
    ASSIGNMENT_VALUE="${ASSIGNMENT_VALUE//\\\"/\"}"
    printf -v "${OUT_NAME_VAR}" '%s' "${ASSIGNMENT_NAME}"
    printf -v "${OUT_VALUE_VAR}" '%s' "${ASSIGNMENT_VALUE}"
}

# parses one marsh-owned assignment line without evaluating shell code
function marsh_parse_internal_assignment {  # marsh_parse_internal_assignment assignment_line out_name_var out_value_var error_context
    local ASSIGNMENT_LINE OUT_NAME_VAR OUT_VALUE_VAR ERROR_CONTEXT
    local INTERNAL_ASSIGNMENT_NAME INTERNAL_ASSIGNMENT_VALUE INTERNAL_ASSIGNMENT_CURSOR INTERNAL_ASSIGNMENT_NEXT_CHAR

    ASSIGNMENT_LINE="${1:-}"
    OUT_NAME_VAR="${2:-}"
    OUT_VALUE_VAR="${3:-}"
    ERROR_CONTEXT="${4:-}"
    [[ "${ASSIGNMENT_LINE}" != "" ]] || return 1
    [[ "${ERROR_CONTEXT}" != "" ]] || return 1
    [[ "${OUT_NAME_VAR}" != "" ]] || return 1
    [[ "${OUT_VALUE_VAR}" != "" ]] || return 1

    if [[ "${ASSIGNMENT_LINE}" == *$'\n'* ]] || [[ "${ASSIGNMENT_LINE}" == *$'\r'* ]]; then
        echo "Unsupported ${ERROR_CONTEXT} multiline value" >&2
        return 1
    fi
    [[ "${ASSIGNMENT_LINE}" == *=* ]] || {
        echo "Malformed ${ERROR_CONTEXT} assignment line: ${ASSIGNMENT_LINE}" >&2
        return 1
    }

    INTERNAL_ASSIGNMENT_NAME="${ASSIGNMENT_LINE%%=*}"
    INTERNAL_ASSIGNMENT_VALUE="${ASSIGNMENT_LINE#*=}"

    # restrict assignment names to plain shell variable form
    [[ "${INTERNAL_ASSIGNMENT_NAME}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || {
        echo "Invalid ${ERROR_CONTEXT} assignment name: ${INTERNAL_ASSIGNMENT_NAME}" >&2
        return 1
    }

    if [[ "${INTERNAL_ASSIGNMENT_VALUE}" == true ]] || [[ "${INTERNAL_ASSIGNMENT_VALUE}" == false ]]; then
        printf -v "${OUT_NAME_VAR}" '%s' "${INTERNAL_ASSIGNMENT_NAME}"
        printf -v "${OUT_VALUE_VAR}" '%s' "${INTERNAL_ASSIGNMENT_VALUE}"
        return 0
    fi

    if [[ ! "${INTERNAL_ASSIGNMENT_VALUE}" == '"'*'"' ]]; then
        echo "Unsupported ${ERROR_CONTEXT} assignment value: ${ASSIGNMENT_LINE}" >&2
        return 1
    fi

    INTERNAL_ASSIGNMENT_VALUE="${INTERNAL_ASSIGNMENT_VALUE#\"}"
    INTERNAL_ASSIGNMENT_VALUE="${INTERNAL_ASSIGNMENT_VALUE%\"}"

    # accept only the backslash-quote form emitted by marsh-owned assignment writers
    INTERNAL_ASSIGNMENT_CURSOR=0
    while [[ "${INTERNAL_ASSIGNMENT_CURSOR}" -lt "${#INTERNAL_ASSIGNMENT_VALUE}" ]]; do
        if [[ "${INTERNAL_ASSIGNMENT_VALUE:${INTERNAL_ASSIGNMENT_CURSOR}:1}" == $'\\' ]]; then
            INTERNAL_ASSIGNMENT_NEXT_CHAR="${INTERNAL_ASSIGNMENT_VALUE:$((INTERNAL_ASSIGNMENT_CURSOR + 1)):1}"
            if [[ "${INTERNAL_ASSIGNMENT_NEXT_CHAR}" != '"' ]]; then
                echo "Unsupported ${ERROR_CONTEXT} backslash form: ${ASSIGNMENT_LINE}" >&2
                return 1
            fi
            INTERNAL_ASSIGNMENT_CURSOR=$((INTERNAL_ASSIGNMENT_CURSOR + 2))
            continue
        fi
        INTERNAL_ASSIGNMENT_CURSOR=$((INTERNAL_ASSIGNMENT_CURSOR + 1))
    done

    INTERNAL_ASSIGNMENT_VALUE="${INTERNAL_ASSIGNMENT_VALUE//\\\"/\"}"
    printf -v "${OUT_NAME_VAR}" '%s' "${INTERNAL_ASSIGNMENT_NAME}"
    printf -v "${OUT_VALUE_VAR}" '%s' "${INTERNAL_ASSIGNMENT_VALUE}"
}

# creates bash variables from yaml records
# extended to support arrays, empty values, and more
# https://gist.github.com/DinoChiesa/3e3c3866b51290f31243
# https://gist.github.com/pkuczynski/8665367
function marsh_parse_yaml {  # marsh_parse_yaml variables_prefix spaces_per_indentation
    local PREFIX INDENT
    PREFIX="${1:-}"
    INDENT="${2:-}"
    if [[ "${PREFIX}" != "" ]] && [[ ! "${PREFIX}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
        return 1
    fi
    if [[ ! "${INDENT}" =~ ^[0-9]+$ ]] || [[ "${INDENT}" -eq 0 ]]; then
        INDENT=2
    fi
    sed -En \
        -e 's|^(([[:space:]]*)(-) ){1}([[:space:]]*)([a-zA-Z0-9_]*)[[:space:]]*:[[:space:]]*(".*")[[:space:]]*$|\3\x1f\2  \4\x1f\5\x1f\6|p' \
        -e 's|^(([[:space:]]*)(-) ){1}([[:space:]]*)([a-zA-Z0-9_]*)[[:space:]]*:[[:space:]]*(.*)[[:space:]]*$|\3\x1f\2  \4\x1f\5\x1f\6|p' \
        -e 's|^(([[:space:]]*)(-) ){1}([[:space:]]*)(".*")[[:space:]]*$|\3\x1f\2  \4\x1f\x1f\5|p' \
        -e 's|^(([[:space:]]*)(-) ){1}([[:space:]]*)([^:].*)[[:space:]]*$|\3\x1f\2  \4\x1f\x1f\5|p' \
        -e 's|^([[:space:]]*)([a-zA-Z0-9_]*)[[:space:]]*:[[:space:]]*(".*")[[:space:]]*$|\x1f\1\x1f\2\x1f\3|p' \
        -e 's|^([[:space:]]*)([a-zA-Z0-9_]*)[[:space:]]*:[[:space:]]*(.*)[[:space:]]*$|\x1f\1\x1f\2\x1f\3|p' |
    awk -F$'\x1f' -v field_sep=$'\x1f' -v prefix="${PREFIX}" -v indent="${INDENT}" \
        '#
        # parse_csv, public domain, http://lorance.freeshell.org/csv/
        #**************************************************************************
        #
        # This file is in the public domain.
        #
        # For more information email LoranceStinson+csv@gmail.com.
        # Or see http://lorance.freeshell.org/csv/
        #
        # Parse a CSV string into an array.
        # The number of fields found is returned.
        # In the event of an error a negative value is returned and csverr is set to
        # the error. See below for the error values.
        #
        # Parameters:
        # string  = The string to parse.
        # csv     = The array to parse the fields into.
        # sep     = The field separator character. Normally ,
        # quote   = The string quote character. Normally "
        # escape  = The quote escape character. Normally "
        # newline = Handle embedded newlines. Provide either a newline or the
        #           string to use in place of a newline. If left empty embedded
        #           newlines cause an error.
        # trim    = When true spaces around the separator are removed.
        #           This affects parsing. Without this a space between the
        #           separator and quote result in the quote being ignored.
        #
        # These variables are private:
        # fields  = The number of fields found thus far.
        # pos     = Where to pull a field from the string.
        # strtrim = True when a string is found so we know to remove the quotes.
        #
        # Error conditions:
        # -1  = Unable to read the next line.
        # -2  = Missing end quote.
        # -3  = Missing separator.
        #
        # Notes:
        # The code assumes that every field is preceded by a separator, even the
        # first field. This makes the logic much simpler, but also requires a
        # separator be prepended to the string before parsing.
        function parse_csv(string,csv,sep,quote,escape,newline,trim, fields,pos,strtrim) {
            # Make sure there is something to parse.
            if (length(string) == 0) return 0;
            string = sep string; # The code below assumes ,FIELD.
            fields = 0; # The number of fields found thus far.
            while (length(string) > 0) {
                # Remove spaces after the separator if requested.
                if (trim && substr(string, 2, 1) == " ") {
                    if (length(string) == 1) return fields;
                    string = substr(string, 2);
                    continue;
                }
                strtrim = 0; # Used to trim quotes off strings.
                # Handle a quoted field.
                if (substr(string, 2, 1) == quote) {
                    pos = 2;
                    do {
                        pos++
                        if (pos != length(string) &&
                            substr(string, pos, 1) == escape &&
                            (substr(string, pos + 1, 1) == quote ||
                             substr(string, pos + 1, 1) == escape)) {
                            # Remove escaped quote characters.
                            string = substr(string, 1, pos - 1) substr(string, pos + 1);
                        } else if (substr(string, pos, 1) == quote) {
                            # Found the end of the string.
                            strtrim = 1;
                        } else if (newline && pos >= length(string)) {
                            # Handle embedded newlines if requested.
                            if (getline == -1) {
                                csverr = "Unable to read the next line.";
                                return -1;
                            }
                            string = string newline $0;
                        }
                    } while (pos < length(string) && strtrim == 0)
                    if (strtrim == 0) {
                        csverr = "Missing end quote.";
                        return -2;
                    }
                } else {
                    # Handle an empty field.
                    if (length(string) == 1 || substr(string, 2, 1) == sep) {
                        csv[fields] = "";
                        fields++;
                        if (length(string) == 1)
                            return fields;
                        string = substr(string, 2);
                        continue;
                    }
                    # Search for a separator.
                    pos = index(substr(string, 2), sep);
                    # If there is no separator the rest of the string is a field.
                    if (pos == 0) {
                        csv[fields] = substr(string, 2);
                        fields++;
                        return fields;
                    }
                }
                # Remove spaces after the separator if requested.
                if (trim && pos != length(string) && substr(string, pos + strtrim, 1) == " ") {
                    trim = strtrim
                    # Count the number fo spaces found.
                    while (pos < length(string) && substr(string, pos + trim, 1) == " ") {
                        trim++
                    }
                    # Remove them from the string.
                    string = substr(string, 1, pos + strtrim - 1) substr(string,  pos + trim);
                    # Adjust pos with the trimmed spaces if a quotes string was not found.
                    if (!strtrim) {
                        pos -= trim;
                    }
                }
                # Make sure we are at the end of the string or there is a separator.
                if ((pos != length(string) && substr(string, pos + 1, 1) != sep)) {
                    csverr = "Missing separator.";
                    return -3;
                }
                # Gather the field.
                csv[fields] = substr(string, 2 + strtrim, pos - (1 + strtrim * 2));
                fields++;
                # Remove the field from the string for the next pass.
                string = substr(string, pos + 1);
            }
            return fields;
        }
        BEGIN { prev_level = 0; }
        {
            type  = $1;
            level = length($2)/indent;
            key   = $3;
            val   = $4;
            out   = "";
            array = 0;
            num_vals = 0;
            if (level < prev_level) { adepth[prev_level] = -1; }
            if (adepth[level] == "") { adepth[level] = -1; }
            if (type == "-") { adepth[level]++; }
            vname[level] = key;
            for (i in vname) {
                if (i > (level)) { vname[i] = ""; }
            }
            for (i = 0; i < level; i++) {
                if (out != "") { out = out "_" }
                if (vname[i] != "") {
                    out = out vname[i];
                    if (adepth[i] > -1 && adepth[i+1] > -1) { out = out adepth[i+1]; }
                } else {
                    out = out adepth[i+1];
                }
            }
            if (substr(val,1,1) == "[" && substr(val,length(val),1) == "]") {
                array = 1;
                gsub(/^\[[ ]*/, "", val);
                gsub(/[ ]*\]$/, "", val);
                num_vals = parse_csv(val, vals, ",", "\"", "\"", "\\n", 1);
                if (num_vals < 0) {
                    # Error parsing inline array
                    exit 1;
                }
            } else {
                if (substr(val,1,1) == "\"" && substr(val,length(val),1) == "\"") {
                    num_vals = parse_csv(val, vals, field_sep, "\"", "\"", "\\n", 0);
                    if (num_vals < 0) {
                        # Error parsing
                        exit 1;
                    }
                } else {
                    num_vals = 1;
                    vals[0] = val;
                }
            }
            if (key != "") {
                if (out != "") { out = out "_" }
                out = out key;
            }
            if (prefix != "") {
                out = prefix "_" out;
            }
            gsub(/__/, "_", out);
            gsub(/_=/, "", out);
            for (i = 0; i < num_vals; i++) {
                gsub(/"/, "\\\"", vals[i]);
                if (vals[i] != "true" && vals[i] != "false") {
                    vals[i]="\"" vals[i] "\""
                }
                if (array == 1) {
                    print out "_" i "=" vals[i];
                } else {
                    print out "=" vals[i];
                }
            }
            for (i = 0; i < num_vals; i++) {
                delete vals[i];
            }
            prev_level = level;
        }'
}

# prints a single build artifact output path formatted for verbose mode
function marsh_print_verbose_output_path {  # marsh_print_verbose_output_path output_path
    local OUTPUT_PATH

    OUTPUT_PATH="${1:-}"
