            TEMPLATE_HEADER_TEMPLATE=$(<"${TEMPLATE_Template_Partials_Header}")
        fi
        TEMPLATE_FOOTER_TEMPLATE=""
        if [[ -f "${TEMPLATE_Template_Partials_Footer}" ]] && [[ -r "${TEMPLATE_Template_Partials_Footer}" ]]; then
            TEMPLATE_FOOTER_TEMPLATE=$(<"${TEMPLATE_Template_Partials_Footer}")
        fi
        TEMPLATE_NAV_TEMPLATE=""
        if [[ -f "${TEMPLATE_Template_Partials_Nav}" ]] && [[ -r "${TEMPLATE_Template_Partials_Nav}" ]]; then
