# processes markdown from stdin using explicit runtime configuration
function marsh_process_markdown {  # marsh_process_markdown markdown_command markdown_options_csv [args...]
    local MARKDOWN_COMMAND MARKDOWN_OPTIONS_CSV OIFS I
    local -a MARKDOWN_OPTIONS MARKDOWN_OPTIONS_CLIARGS

    MARKDOWN_COMMAND="${1:-}"
    MARKDOWN_OPTIONS_CSV="${2:-}"
    [[ "${MARKDOWN_COMMAND}" == "" ]] && return 1
    shift 2

    MARKDOWN_OPTIONS=()
    MARKDOWN_OPTIONS_CLIARGS=()
    if [[ "${MARKDOWN_OPTIONS_CSV}" != "" ]]; then
        OIFS="${IFS}"
        IFS=$'\n'
        MARKDOWN_OPTIONS=(${MARKDOWN_OPTIONS_CSV//,/$IFS})
        IFS="${OIFS}"
        for I in "${!MARKDOWN_OPTIONS[@]}"; do
            MARKDOWN_OPTIONS_CLIARGS+=("-f${MARKDOWN_OPTIONS[$I]}")
        done
    fi

    # normalize known output quirks of discount markdown
    # remove invalid re[lv]="footnote" attributes
    # fix rendering of backslash-escaped literal angle brackets
    {
        if [[ "${#MARKDOWN_OPTIONS_CLIARGS[@]}" -gt 0 ]]; then
            "${MARKDOWN_COMMAND}" "${MARKDOWN_OPTIONS_CLIARGS[@]}" "$@"
        else
            "${MARKDOWN_COMMAND}" "$@"
        fi
    } | sed -E \
        -e '/<a href="#[a-z]+:[^"]+" re[lv]="footnote">/s/ re[lv]="footnote"//g' \
        -e 's/\\&lt;/\&lt;/g' \
        -e 's/\\&gt;/\&gt;/g' \
        -e 's/\\</\&lt;/g' \
        -e 's/\\>/\&gt;/g' \
        -e 's/(&lt;[^<>]+)>/\1\&gt;/g'
}

# returns success when the requested log level is included by the active log level
function marsh_should_log {  # marsh_should_log requested_log_level active_log_level all_log_levels_csv
    local REQUESTED_LOG_LEVEL ACTIVE_LOG_LEVEL ALL_LOG_LEVELS_CSV
    local ALL_LOG_LEVELS REQUESTED_LOG_LEVEL_INDEX ACTIVE_LOG_LEVEL_INDEX LOG_LEVEL

    # init
    REQUESTED_LOG_LEVEL="${1:-}"
    ACTIVE_LOG_LEVEL="${2:-}"
    ALL_LOG_LEVELS_CSV="${3:-}"
    [[ "${REQUESTED_LOG_LEVEL}" == "" ]] && return 1
    [[ "${ACTIVE_LOG_LEVEL}" == "" ]] && return 1
    [[ "${ALL_LOG_LEVELS_CSV}" == "" ]] && return 1
    OIFS="${IFS}"
    IFS=$'\n'
    ALL_LOG_LEVELS=(${ALL_LOG_LEVELS_CSV//,/$IFS})
    IFS="${OIFS}"

    # exact match fast path
    if [[ "${REQUESTED_LOG_LEVEL}" == "${ACTIVE_LOG_LEVEL}" ]] \
        && marsh_in_array "${REQUESTED_LOG_LEVEL}" "${ALL_LOG_LEVELS[@]}"; then
        return 0
    fi

    # find the indexes of the requested log level and active log level
    REQUESTED_LOG_LEVEL_INDEX=-1
    ACTIVE_LOG_LEVEL_INDEX=-1
    for LOG_LEVEL in "${!ALL_LOG_LEVELS[@]}"; do
        if [[ "${REQUESTED_LOG_LEVEL}" == "${ALL_LOG_LEVELS[LOG_LEVEL]}" ]]; then
            REQUESTED_LOG_LEVEL_INDEX="${LOG_LEVEL}"
        fi
        if [[ "${ACTIVE_LOG_LEVEL}" == "${ALL_LOG_LEVELS[LOG_LEVEL]}" ]]; then
            ACTIVE_LOG_LEVEL_INDEX="${LOG_LEVEL}"
        fi
        if [[ "${REQUESTED_LOG_LEVEL_INDEX}" -ne -1 ]] && [[ "${ACTIVE_LOG_LEVEL_INDEX}" -ne -1 ]]; then
            break
        fi
    done

    # if the requested log level is at a lower array index than the active log level
    # then it is included by the active log level
    if [[ "${REQUESTED_LOG_LEVEL_INDEX}" -ne -1 ]] \
        && [[ "${ACTIVE_LOG_LEVEL_INDEX}" -ne -1 ]] \
        && [[ "${REQUESTED_LOG_LEVEL_INDEX}" -lt "${ACTIVE_LOG_LEVEL_INDEX}" ]]; then
        return 0
    fi
    return 1
}

# transforms a string
function marsh_text_transform {  # marsh_text_transform transform [transform...]
    local TRANSFORM OIFS STATUS
    local IFS="${IFS}"
    local -a PIPE_STATUS
    TRANSFORM="${1:-}"
    OIFS="${IFS}"
    IFS=$'\n'
    if [[ "${#@}" -gt 1 ]]; then
        shift 1
        marsh_text_transform "${TRANSFORM}" | marsh_text_transform "${@}"
        IFS="${OIFS}"
        PIPE_STATUS=(${PIPESTATUS[@]})
        for STATUS in "${PIPE_STATUS[@]}"; do
            [[ "${STATUS}" -ne 0 ]] && return "${STATUS}"
        done
        return 0
    fi
    local OPTIONS_STRING OPTION_CURRENT OPTION_INDEX OPTION_CHAR OPTION_NEXT
    local -a OPTIONS
    OPTIONS=()
    OPTIONS_STRING="${TRANSFORM#*:}"
    if [[ "${OPTIONS_STRING}" == "${TRANSFORM}" ]]; then
        :
    elif [[ "${OPTIONS_STRING}" != *\\* ]]; then
        OPTIONS=(${OPTIONS_STRING//:/$'\n'})
    else
        OPTION_CURRENT=""
        OPTION_INDEX=0
        while [[ "${OPTION_INDEX}" -lt "${#OPTIONS_STRING}" ]]; do
            OPTION_CHAR="${OPTIONS_STRING:${OPTION_INDEX}:1}"
            if [[ "${OPTION_CHAR}" == '\' ]]; then
                OPTION_INDEX=$((OPTION_INDEX + 1))
                if [[ "${OPTION_INDEX}" -ge "${#OPTIONS_STRING}" ]]; then
                    OPTION_CURRENT+='\'
                    break
                fi
                OPTION_NEXT="${OPTIONS_STRING:${OPTION_INDEX}:1}"
                if [[ "${OPTION_NEXT}" == ':' ]]; then
                    OPTION_CURRENT+=':'
                elif [[ "${OPTION_NEXT}" == '\' ]]; then
                    OPTION_CURRENT+='\'
                else
                    OPTION_CURRENT+='\'
                    OPTION_CURRENT+="${OPTION_NEXT}"
                fi
            elif [[ "${OPTION_CHAR}" == ':' ]]; then
                OPTIONS+=("${OPTION_CURRENT}")
                OPTION_CURRENT=""
            else
                OPTION_CURRENT+="${OPTION_CHAR}"
            fi
            OPTION_INDEX=$((OPTION_INDEX + 1))
        done
        OPTIONS+=("${OPTION_CURRENT}")
    fi
    IFS="${OIFS}"
    local TRAILING_PUNCTUATION APPEND DATE_FORMAT MAX_CHARS MAX_PARAS MARKDOWN_EXTS PROTOCOL_SEP WRAP_START WRAP_END
    local COUNT DELIM1 DELIM2 DELIM3 END I ITEM_KEY PREPEND REPLACE_EXT START XML_TAG XML_TAG_CLOSE XML_TAG_OPEN
    TRAILING_PUNCTUATION=',.:;?!'
    case "${TRANSFORM}" in
        append:*)
            APPEND="${OPTIONS[0]:-}"
            if [[ "${APPEND}" != "" ]]; then
                APPEND="${APPEND//\\/\\\\}"
                awk -v APPEND="${APPEND}" 'NR > 1 { printf("%s\n", PREV) } { PREV = $0 } END { printf("%s%s\n", PREV, APPEND) }'
            else
                cat
            fi
            ;;
        append-type:block:*)
            APPEND="${OPTIONS[1]:-}"
            if [[ "${APPEND}" != "" ]]; then
                while IFS= read -r LINE || [[ -n "${LINE:-}" ]]; do
                    printf '%s\n' "${LINE}"
                done
                printf "\n%s\n" "${APPEND}"
            else
                cat
            fi
            ;;
        case:lower)
            awk '{ print tolower($0) }'
            ;;
        case:upper)
            awk '{ print toupper($0) }'
            ;;
        case:sentence)
            awk '{
                if (length($0) > 0) {
                    $1 = toupper(substr($1, 1, 1)) substr($1, 2)
                }
                print
            }'
            ;;
        case:title)
            awk '{
                for (i = 1; i <= NF; i++) {
                    $i = toupper(substr($i, 1, 1)) substr($i, 2)
                }
                print
            }'
            ;;
        date:*)
            DATE_FORMAT="${OPTIONS[0]:-}"
            for ((I = 1; I < "${#OPTIONS[@]}"; I++)); do
                DATE_FORMAT+=":${OPTIONS[$I]}"
            done
            if [[ "${DATE_FORMAT}" == "" ]]; then
                cat
            elif [[ "${SYS_NAME}" =~ bsd|darwin ]]; then
                sed -E -e 's/^([0-9]{4}-[0-9]{2}-[0-9]{2})$/\1 00:00:00/' | TZ=UTC date -jf '%Y-%m-%d %H:%M:%S' "$(</dev/stdin)" "+${DATE_FORMAT}" 2>/dev/null
            else
                sed -E -e 's/^([0-9]{4}-[0-9]{2}-[0-9]{2})$/\1 00:00:00/' | TZ=UTC date "+${DATE_FORMAT}" -d "$(</dev/stdin)" 2>/dev/null
            fi
            ;;
        date)
            marsh_text_transform date-type:y-m-d
            ;;
        date-type:rfc2822)
            if [[ "${SYS_NAME}" =~ bsd|darwin ]]; then
                sed -E -e 's/^([0-9]{4}-[0-9]{2}-[0-9]{2})$/\1 00:00:00/' | TZ=UTC date -jf '%Y-%m-%d %H:%M:%S' -R "$(</dev/stdin)" 2>/dev/null
            else
                sed -E -e 's/^([0-9]{4}-[0-9]{2}-[0-9]{2})$/\1 00:00:00/' | TZ=UTC date --rfc-2822 -d "$(</dev/stdin)" 2>/dev/null
            fi
            ;;
        date-type:rfc3339)
            if [[ "${SYS_NAME}" =~ bsd|darwin ]]; then
                sed -E -e 's/^([0-9]{4}-[0-9]{2}-[0-9]{2})$/\1 00:00:00/' | TZ=UTC date -jf '%Y-%m-%d %H:%M:%S' '+%Y-%m-%dT%T%z' "$(</dev/stdin)" 2>/dev/null | sed -E -e 's/([0-9]{2})([0-9]{2})$/\1:\2/'
            else
                sed -E -e 's/^([0-9]{4}-[0-9]{2}-[0-9]{2})$/\1 00:00:00/' | TZ=UTC date --rfc-3339=seconds -d "$(</dev/stdin)" 2>/dev/null | sed -E -e 's/([0-9-]{10}) /\1T/'
            fi
            ;;
        date-type:y-m-d)
            if [[ "${SYS_NAME}" =~ bsd|darwin ]]; then
                sed -E -e 's/^([0-9]{4}-[0-9]{2}-[0-9]{2})$/\1 00:00:00/' | TZ=UTC date -jf '%Y-%m-%d %H:%M:%S' '+%Y-%m-%d' "$(</dev/stdin)" 2>/dev/null
            else
                sed -E -e 's/^([0-9]{4}-[0-9]{2}-[0-9]{2})$/\1 00:00:00/' | TZ=UTC date '+%Y-%m-%d' -d "$(</dev/stdin)" 2>/dev/null
            fi
