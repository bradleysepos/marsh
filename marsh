        if [[ -f "${TEMPLATE_Template_Partials_Notice}" ]] && [[ -r "${TEMPLATE_Template_Partials_Notice}" ]]; then
            TEMPLATE_NOTICE_TEMPLATE=$(<"${TEMPLATE_Template_Partials_Notice}")
