            ;;
        items:last)
            awk -v RS='\n' 'END { print }'
            ;;
        items:prepend:*)
            PREPEND="${OPTIONS[1]:-}"
            PREPEND="${PREPEND//\\/\\\\}"
            awk -v PREPEND="${PREPEND}" '{ print PREPEND $0 }'
