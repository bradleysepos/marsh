# loads and validates persisted archive-plan context for queue and plan executors
function marsh_load_archive_plan_build_context {  # marsh_load_archive_plan_build_context archive_plan_root build_context_target_output_rel_var build_context_source_root_var target_sitemap_var target_sitemap_search_var templates_dir_var template_var template_assets_path_var template_overrides_text_var
    local ARCHIVE_PLAN_ROOT BUILD_CONTEXT_TARGET_OUTPUT_REL_VAR BUILD_CONTEXT_SOURCE_ROOT_VAR TARGET_SITEMAP_VAR TARGET_SITEMAP_SEARCH_VAR TEMPLATES_DIR_VAR TEMPLATE_VAR TEMPLATE_ASSETS_PATH_VAR TEMPLATE_OVERRIDES_TEXT_VAR
    local CONTEXT_FILE CONTEXT_LINE CONTEXT_KEY CONTEXT_VALUE
    local BUILD_CONTEXT_TARGET_OUTPUT_REL_VALUE BUILD_CONTEXT_SOURCE_ROOT_VALUE TARGET_SITEMAP_VALUE TARGET_SITEMAP_SEARCH_VALUE TEMPLATES_DIR_VALUE TEMPLATE_VALUE TEMPLATE_ASSETS_PATH_VALUE
    local HAS_BUILD_CONTEXT_TARGET_OUTPUT_REL HAS_BUILD_CONTEXT_SOURCE_ROOT TEMPLATE_OVERRIDES_JOINED OIFS
    local -a TEMPLATE_OVERRIDE_VALUES

    ARCHIVE_PLAN_ROOT="${1:-}"
    BUILD_CONTEXT_TARGET_OUTPUT_REL_VAR="${2:-}"
    BUILD_CONTEXT_SOURCE_ROOT_VAR="${3:-}"
    TARGET_SITEMAP_VAR="${4:-}"
    TARGET_SITEMAP_SEARCH_VAR="${5:-}"
    TEMPLATES_DIR_VAR="${6:-}"
    TEMPLATE_VAR="${7:-}"
    TEMPLATE_ASSETS_PATH_VAR="${8:-}"
    TEMPLATE_OVERRIDES_TEXT_VAR="${9:-}"
    [[ "${ARCHIVE_PLAN_ROOT}" == "" ]] && return 1
    [[ "${BUILD_CONTEXT_TARGET_OUTPUT_REL_VAR}" == "" ]] && return 1
    [[ "${BUILD_CONTEXT_SOURCE_ROOT_VAR}" == "" ]] && return 1
    [[ "${TARGET_SITEMAP_VAR}" == "" ]] && return 1
    [[ "${TARGET_SITEMAP_SEARCH_VAR}" == "" ]] && return 1
    [[ "${TEMPLATES_DIR_VAR}" == "" ]] && return 1
    [[ "${TEMPLATE_VAR}" == "" ]] && return 1
    [[ "${TEMPLATE_ASSETS_PATH_VAR}" == "" ]] && return 1
    [[ "${TEMPLATE_OVERRIDES_TEXT_VAR}" == "" ]] && return 1

    CONTEXT_FILE="${ARCHIVE_PLAN_ROOT}/context"
    [[ -f "${CONTEXT_FILE}" ]] && [[ -r "${CONTEXT_FILE}" ]] || {
        echo "Archive plan context file not found: ${CONTEXT_FILE}" >&2
        return 1
    }

    BUILD_CONTEXT_TARGET_OUTPUT_REL_VALUE=""
    BUILD_CONTEXT_SOURCE_ROOT_VALUE=""
    TARGET_SITEMAP_VALUE=""
    TARGET_SITEMAP_SEARCH_VALUE="false"
    TEMPLATES_DIR_VALUE=""
    TEMPLATE_VALUE=""
    TEMPLATE_ASSETS_PATH_VALUE=""
    HAS_BUILD_CONTEXT_TARGET_OUTPUT_REL=false
    HAS_BUILD_CONTEXT_SOURCE_ROOT=false
    TEMPLATE_OVERRIDE_VALUES=()

    # read the fixed-shape context once and rebuild only the fields archive execution uses
    while IFS= read -r CONTEXT_LINE || [[ "${CONTEXT_LINE}" != "" ]]; do
        [[ "${CONTEXT_LINE}" == "" ]] && continue
        case "${CONTEXT_LINE}" in
            *$'\t'*)
                CONTEXT_KEY="${CONTEXT_LINE%%$'\t'*}"
                CONTEXT_VALUE="${CONTEXT_LINE#*$'\t'}"
                ;;
            *)
                echo "Malformed archive plan context line: ${CONTEXT_FILE}" >&2
                return 1
                ;;
        esac
        case "${CONTEXT_KEY}" in
            BUILD_CONTEXT_TARGET_OUTPUT_REL)
                BUILD_CONTEXT_TARGET_OUTPUT_REL_VALUE="${CONTEXT_VALUE}"
                HAS_BUILD_CONTEXT_TARGET_OUTPUT_REL=true
                ;;
            BUILD_CONTEXT_SOURCE_ROOT)
                BUILD_CONTEXT_SOURCE_ROOT_VALUE="${CONTEXT_VALUE}"
                HAS_BUILD_CONTEXT_SOURCE_ROOT=true
                ;;
            TARGET_SITEMAP)
                TARGET_SITEMAP_VALUE="${CONTEXT_VALUE}"
                ;;
            TARGET_SITEMAP_SEARCH)
                [[ "${CONTEXT_VALUE}" == true ]] || [[ "${CONTEXT_VALUE}" == false ]] || {
                    echo "Archive plan context has invalid TARGET_SITEMAP_SEARCH: ${CONTEXT_FILE}" >&2
                    return 1
                }
                TARGET_SITEMAP_SEARCH_VALUE="${CONTEXT_VALUE}"
                ;;
            TEMPLATES_DIR)
                TEMPLATES_DIR_VALUE="${CONTEXT_VALUE}"
                ;;
            TEMPLATE)
                TEMPLATE_VALUE="${CONTEXT_VALUE}"
                ;;
            TEMPLATE_ASSETS_PATH)
                TEMPLATE_ASSETS_PATH_VALUE="${CONTEXT_VALUE}"
                ;;
            TEMPLATE_OVERRIDE)
                TEMPLATE_OVERRIDE_VALUES+=("${CONTEXT_VALUE}")
                ;;
            *)
                echo "Archive plan context has unsupported field ${CONTEXT_KEY}: ${CONTEXT_FILE}" >&2
                return 1
                ;;
        esac
    done < "${CONTEXT_FILE}" || {
        echo "Unable to read archive plan context file: ${CONTEXT_FILE}" >&2
        return 1
    }

    [[ "${HAS_BUILD_CONTEXT_TARGET_OUTPUT_REL}" == true ]] || {
        echo "Archive plan context missing BUILD_CONTEXT_TARGET_OUTPUT_REL: ${CONTEXT_FILE}" >&2
        return 1
    }
    [[ "${HAS_BUILD_CONTEXT_SOURCE_ROOT}" == true ]] || {
        echo "Archive plan context missing BUILD_CONTEXT_SOURCE_ROOT: ${CONTEXT_FILE}" >&2
        return 1
    }

    printf -v "${BUILD_CONTEXT_TARGET_OUTPUT_REL_VAR}" '%s' "${BUILD_CONTEXT_TARGET_OUTPUT_REL_VALUE}"
    printf -v "${BUILD_CONTEXT_SOURCE_ROOT_VAR}" '%s' "${BUILD_CONTEXT_SOURCE_ROOT_VALUE}"
    printf -v "${TARGET_SITEMAP_VAR}" '%s' "${TARGET_SITEMAP_VALUE}"
    printf -v "${TARGET_SITEMAP_SEARCH_VAR}" '%s' "${TARGET_SITEMAP_SEARCH_VALUE}"
    printf -v "${TEMPLATES_DIR_VAR}" '%s' "${TEMPLATES_DIR_VALUE}"
    printf -v "${TEMPLATE_VAR}" '%s' "${TEMPLATE_VALUE}"
    printf -v "${TEMPLATE_ASSETS_PATH_VAR}" '%s' "${TEMPLATE_ASSETS_PATH_VALUE}"
    TEMPLATE_OVERRIDES_JOINED=""
    if [[ "${#TEMPLATE_OVERRIDE_VALUES[@]}" -gt 0 ]]; then
        OIFS="${IFS}"
        IFS=$'\n'
        TEMPLATE_OVERRIDES_JOINED="${TEMPLATE_OVERRIDE_VALUES[*]}"
        IFS="${OIFS}"
    fi
    printf -v "${TEMPLATE_OVERRIDES_TEXT_VAR}" '%s' "${TEMPLATE_OVERRIDES_JOINED}"
}

# reads aggregate archive-queue records from the target plan root
function marsh_read_target_archive_queue_records {  # marsh_read_target_archive_queue_records target_plan_root
    local TARGET_PLAN_ROOT TARGET_ARCHIVE_QUEUE_RECORDS_FILE

    TARGET_PLAN_ROOT="${1:-}"
    [[ "${TARGET_PLAN_ROOT}" == "" ]] && return 1

    TARGET_ARCHIVE_QUEUE_RECORDS_FILE=$(marsh_get_target_archive_queue_records_path "${TARGET_PLAN_ROOT}") || return 1
    [[ -f "${TARGET_ARCHIVE_QUEUE_RECORDS_FILE}" ]] && [[ -r "${TARGET_ARCHIVE_QUEUE_RECORDS_FILE}" ]] || return 1
    cat "${TARGET_ARCHIVE_QUEUE_RECORDS_FILE}"
}

# writes persisted archive-plan context for later archive execution
function marsh_write_archive_plan_context {  # marsh_write_archive_plan_context context_file build_context_target_output_rel build_context_source_root target_sitemap target_sitemap_search templates_dir template #template_overrides[@] template_overrides[@] template_assets_path
    local CONTEXT_FILE BUILD_CONTEXT_TARGET_OUTPUT_REL BUILD_CONTEXT_SOURCE_ROOT TARGET_SITEMAP TARGET_SITEMAP_SEARCH TEMPLATES_DIR TEMPLATE
    local NUM_TEMPLATE_OVERRIDES TEMPLATE_ASSETS_PATH CONTEXT_TEMP TEMPLATE_OVERRIDE
    local -a TEMPLATE_OVERRIDES

    CONTEXT_FILE="${1:-}"
    BUILD_CONTEXT_TARGET_OUTPUT_REL="${2:-}"
    BUILD_CONTEXT_SOURCE_ROOT="${3:-}"
    TARGET_SITEMAP="${4:-}"
    TARGET_SITEMAP_SEARCH="${5:-false}"
    TEMPLATES_DIR="${6:-}"
    TEMPLATE="${7:-}"
    [[ "${CONTEXT_FILE}" == "" ]] && return 1
    [[ "${BUILD_CONTEXT_TARGET_OUTPUT_REL}" == "" ]] && return 1
    shift 7
    NUM_TEMPLATE_OVERRIDES="${1:-0}"
    shift 1
    TEMPLATE_OVERRIDES=()
    while [[ "${NUM_TEMPLATE_OVERRIDES}" -gt 0 ]] && [[ "${#@}" -gt 0 ]]; do
        TEMPLATE_OVERRIDES+=("${1}")
        NUM_TEMPLATE_OVERRIDES=$((NUM_TEMPLATE_OVERRIDES - 1))
        shift 1
    done
    TEMPLATE_ASSETS_PATH="${1:-}"

    CONTEXT_TEMP=$(mktemp "${CONTEXT_FILE%/*}/context-XXXXXX") || return 1
    {
        # persist archive build context as fixed-shape key/value records
        printf 'BUILD_CONTEXT_TARGET_OUTPUT_REL\t%s\n' "${BUILD_CONTEXT_TARGET_OUTPUT_REL}"
        printf 'BUILD_CONTEXT_SOURCE_ROOT\t%s\n' "${BUILD_CONTEXT_SOURCE_ROOT}"
        printf 'TARGET_SITEMAP\t%s\n' "${TARGET_SITEMAP}"
        printf 'TARGET_SITEMAP_SEARCH\t%s\n' "${TARGET_SITEMAP_SEARCH}"
        printf 'TEMPLATES_DIR\t%s\n' "${TEMPLATES_DIR}"
        printf 'TEMPLATE\t%s\n' "${TEMPLATE}"
        printf 'TEMPLATE_ASSETS_PATH\t%s\n' "${TEMPLATE_ASSETS_PATH}"
        for TEMPLATE_OVERRIDE in "${TEMPLATE_OVERRIDES[@]}"; do
            printf 'TEMPLATE_OVERRIDE\t%s\n' "${TEMPLATE_OVERRIDE}"
        done
    } > "${CONTEXT_TEMP}" || {
        rm -f "${CONTEXT_TEMP}"
        return 1
    }
    mv "${CONTEXT_TEMP}" "${CONTEXT_FILE}" 2>/dev/null || {
        rm -f "${CONTEXT_TEMP}"
        return 1
    }
}

# writes one aggregate archive queue from the provided archive plan roots
function marsh_write_target_archive_queue_from_archive_plans {  # marsh_write_target_archive_queue_from_archive_plans target_plan_root archive_plan_roots[@]
    local TARGET_PLAN_ROOT ARCHIVE_PLAN_ROOT ARCHIVE_PLAN_DOCUMENTS_FILE DOCUMENT_RECORD QUEUE_RECORD
    local -a QUEUE_RECORDS

    TARGET_PLAN_ROOT="${1:-}"
    shift 1
    [[ "${TARGET_PLAN_ROOT}" == "" ]] && return 1

    QUEUE_RECORDS=()
    while [[ "${#@}" -gt 0 ]]; do
        ARCHIVE_PLAN_ROOT="${1:-}"
        shift 1
        [[ "${ARCHIVE_PLAN_ROOT}" == "" ]] && continue
        ARCHIVE_PLAN_DOCUMENTS_FILE="${ARCHIVE_PLAN_ROOT}/documents"
        [[ -f "${ARCHIVE_PLAN_DOCUMENTS_FILE}" ]] && [[ -r "${ARCHIVE_PLAN_DOCUMENTS_FILE}" ]] || {
            echo "Archive plan documents file not found: ${ARCHIVE_PLAN_DOCUMENTS_FILE}" >&2
            return 1
        }

        # keep the queue order aligned with archive plan order and persisted document order
        while IFS= read -r DOCUMENT_RECORD; do
            [[ "${DOCUMENT_RECORD}" == "" ]] && continue
            QUEUE_RECORD=$(marsh_build_target_archive_queue_record "${ARCHIVE_PLAN_ROOT}" "${DOCUMENT_RECORD}") || return 1
            QUEUE_RECORDS+=("${QUEUE_RECORD}")
        done < "${ARCHIVE_PLAN_DOCUMENTS_FILE}"
    done

    marsh_write_target_archive_queue_records "${TARGET_PLAN_ROOT}" "${QUEUE_RECORDS[@]}"
}

# writes aggregate archive-queue records under the target plan root
function marsh_write_target_archive_queue_records {  # marsh_write_target_archive_queue_records target_plan_root records[@]
    local TARGET_PLAN_ROOT TARGET_ARCHIVE_QUEUE_ROOT TARGET_ARCHIVE_QUEUE_RECORDS_FILE TARGET_ARCHIVE_QUEUE_RECORDS_TEMP RECORD

    TARGET_PLAN_ROOT="${1:-}"
    shift 1
    [[ "${TARGET_PLAN_ROOT}" == "" ]] && return 1

    TARGET_ARCHIVE_QUEUE_ROOT=$(marsh_get_target_archive_queue_root "${TARGET_PLAN_ROOT}") || return 1
    TARGET_ARCHIVE_QUEUE_RECORDS_FILE=$(marsh_get_target_archive_queue_records_path "${TARGET_PLAN_ROOT}") || return 1
    mkdir -p "${TARGET_ARCHIVE_QUEUE_ROOT}" >/dev/null 2>&1 || {
        echo "Unable to create target archive queue path: ${TARGET_ARCHIVE_QUEUE_ROOT}" >&2
        return 1
    }
    TARGET_ARCHIVE_QUEUE_RECORDS_TEMP=$(mktemp "${TARGET_ARCHIVE_QUEUE_ROOT}/records-XXXXXX" 2>/dev/null) || {
        echo "Unable to write target archive queue temporary file: ${TARGET_ARCHIVE_QUEUE_ROOT}/records-XXXXXX" >&2
        return 1
    }

    while [[ "${#@}" -gt 0 ]]; do
        RECORD="${1:-}"
        shift 1
        [[ "${RECORD}" == "" ]] && continue
        printf '%s\n' "${RECORD}"
    done > "${TARGET_ARCHIVE_QUEUE_RECORDS_TEMP}" || {
        echo "Unable to write target archive queue temporary file: ${TARGET_ARCHIVE_QUEUE_RECORDS_TEMP}" >&2
        rm -f "${TARGET_ARCHIVE_QUEUE_RECORDS_TEMP}"
        return 1
    }
    mv "${TARGET_ARCHIVE_QUEUE_RECORDS_TEMP}" "${TARGET_ARCHIVE_QUEUE_RECORDS_FILE}" 2>/dev/null || {
        echo "Unable to write target archive queue file: ${TARGET_ARCHIVE_QUEUE_RECORDS_FILE}" >&2
        rm -f "${TARGET_ARCHIVE_QUEUE_RECORDS_TEMP}"
        return 1
    }
}

#
# Command line interface dispatch
#

# run only when executed, not when sourced
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    marsh_cli "$@"
fi
