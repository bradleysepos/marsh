    local ARCHIVE_PATH_NAME ARCHIVE_ENCODING_NAME ARCHIVE_NAME_NAME ARCHIVE_LANGUAGE_NAME ARCHIVE_LANGUAGE_CODE_NAME ARCHIVE_ROOT_PATH_NAME
    local ARCHIVE_COUNT_NAME ARCHIVE_PAGE_SIZE_NAME ARCHIVE_CONTENT_NAME ARCHIVE_TEMPLATE_SOURCE_NAME ARCHIVE_TEMPLATE_ASSETS_PATH_NAME
