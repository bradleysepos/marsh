                XML_TAG_CLOSE+="</${OPTIONS[$I]}>"
            done
            awk -v XML_TAG="${XML_TAG}" -v XML_TAG_OPEN="${XML_TAG_OPEN}" -v XML_TAG_CLOSE="${XML_TAG_CLOSE}" '
            function xml_escape(value) {
                gsub(/&/, "\\&amp;", value)
                gsub(/</, "\\&lt;", value)
                gsub(/>/, "\\&gt;", value)
                return value
            }
            BEGIN {
                tag = XML_TAG
            }
            {
                if ($0 == "") {
                    next
                }
                value_escaped = xml_escape($0)
                printf "%s<%s>%s</%s>%s", XML_TAG_OPEN, tag, value_escaped, tag, XML_TAG_CLOSE
                emitted = 1
            }
            END {
                if (emitted) {
                    printf "\n"
                }
            }
            '
            ;;
        links:replace-ext:*)
            # convert relative links with markdown file extensions to html
            # examples:
            # [foo](foo.md)               ->  [foo](foo.html)
            # [foo](foo.md "title")       ->  [foo](foo.html "title")
            # [![image](image.jpg)](imagepage.md)                  ->  [![image](image.jpg)](imagepage.html)
            # [![image](image.jpg) "title"](imagepage.md)          ->  [![image](image.jpg) "title"](imagepage.html)
            # [![image](image.jpg)](imagepage.md "title")          ->  [![image](image.jpg)](imagepage.html "title")
            # [![image](image.jpg) "title"](imagepage.md "title")  ->  [![image](image.jpg) "title"](imagepage.html "title")
            # [1]: reference1.md          ->  [1]: reference1.html
            # [1]: reference1.md "title"  ->  [1]: reference1.html "title"
            MD_EXT_REGEX="${OPTIONS[1]:-}"
            REPLACE_EXT="${OPTIONS[2]:-}"
            REPLACE_EXT="${REPLACE_EXT:+.${REPLACE_EXT}}"
            REPLACE_EXT=$(printf '%s' "${REPLACE_EXT}" | marsh_escape_substitution)
            PROTOCOL_SEP=':'  # to avoid matching protocol in absolute URLs, e.g. https://example.com/foo.md
            if [[ "${MD_EXT_REGEX}" != "" ]]; then
                MD_EXT_REGEX="\\.${MD_EXT_REGEX//,/|\\.}"
                sed -E -e 's~(\[[^][]+\]|\[!\[[^][]+\]\([^)(]+\)([^]]+)?\])(\([^ #?:]+)('"${MD_EXT_REGEX}"')([#?][^ )]+)?([^]]+)?(\))~\1\3'"${REPLACE_EXT}"'\5\6\7~g' | sed -E -e 's~^( *\[[^][]+\]: +<?[^ #?'"${PROTOCOL_SEP}"']+)('"${MD_EXT_REGEX}"')(>)?([#?][^ ]+)?(.*)$~\1'"${REPLACE_EXT}"'\3\4\5~g'
            else
                cat
            fi
            ;;
        newlines:reduce:*)
            COUNT="${OPTIONS[1]:-2}"
            awk -v COUNT="${COUNT}" '
            {
                if ($0 == "") {
                    blank_lines++
                    if (blank_lines < COUNT) {
                        print
                    }
                } else {
                    blank_lines = 0
                    print
                }
            }
            '
            ;;
        newlines:remove)
            tr -d '\n'
            ;;
        newlines:tospaces)
            tr '\n' ' ' | sed -E -e 's/[[:space:]]+$//'
            ;;
        newlines:trim)
            sed -e '/./,$!d'
            ;;
        plaintext)
            # ':a;s/<[^>]*>//g;/</{;$!{N;ba;};}' strips html tags and works across multiple lines (better version of 's/<[^>]*>//g')
            # '/./,/^$/!d' deletes blank lines at start and collapses consecutive blank lines into one, leaving up to one blank line at end
            sed -e ':a' -e 's/<[^>]*>//g' -e '/</{' -e '$!{N' -e 'ba' -e '}' -e '}' | sed '/./,/^$/!d' | marsh_text_filter decode:entities
            ;;
        prepend:*)
            PREPEND="${OPTIONS[0]:-}"
            PREPEND=$(printf '%s' "${PREPEND}" | marsh_escape_substitution)
            sed -e '1 s/^/'"${PREPEND}"'/'
            ;;
        prepend-type:block:*)
            PREPEND="${OPTIONS[1]:-}"
            PREPEND="${PREPEND//\\/\\\\}"
            awk -v PREPEND="${PREPEND}" 'NR==1 { print PREPEND } { print }'
            ;;
        slug)
            head -n 1 | sed -E -e 's/[ _]+/-/g' -e 's/[^-a-zA-Z0-9.]//g' -e 's/(^-+)|(-+$)//' | awk '{ print tolower($0) }'
            ;;
        trim)
            sed -e ':a' -e '$!{N' -e 'ba' -e '}' -e 's/^[ '$'\t'']*//' -e 's/[ '$'\t'']*$//'
            ;;
        wrap:*)
            WRAP_START="${OPTIONS[0]:-}"
            WRAP_END="${OPTIONS[1]:-${WRAP_START}}"
            WRAP_START=$(printf '%s' "${WRAP_START}" | marsh_escape_substitution)
            WRAP_END=$(printf '%s' "${WRAP_END}" | marsh_escape_substitution)
            if [[ "${WRAP_START}" != "" ]]; then
                sed -e '1 s/^/'"${WRAP_START}"'/' -e '$ s/$/'"${WRAP_END}"'/'
            else
                cat
            fi
            ;;
        wrap-type:block:*)
            WRAP_START="${OPTIONS[1]:-}"
            WRAP_END="${OPTIONS[2]:-${WRAP_START}}"
            WRAP_START="${WRAP_START//\\/\\\\}"
            WRAP_END="${WRAP_END//\\/\\\\}"
            if [[ "${WRAP_START}" != "" ]]; then
                awk -v WRAP_START="${WRAP_START}" -v WRAP_END="${WRAP_END}" 'NR==1 { print WRAP_START; printf "\n" } { print $0 } END { printf "\n"; print WRAP_END }'
            else
                cat
            fi
            ;;
        wrap-type:special-comment:*)
            WRAP_START="${OPTIONS[1]:-}"
            WRAP_END="${WRAP_START}"
            WRAP_START="${WRAP_START//\\/\\\\}"
            WRAP_END="${WRAP_END//\\/\\\\}"
            if [[ "${WRAP_START}" != "" ]]; then
                awk -v WRAP_START="<!-- ${WRAP_START} -->" -v WRAP_END="<!-- /${WRAP_END} -->" 'NR==1 { print WRAP_START; printf "\n" } { print $0 } END { printf "\n"; print WRAP_END }'
            else
                cat
            fi
            ;;
        *)
            cat
            ;;
    esac
}
