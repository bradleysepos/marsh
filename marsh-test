NAME="marsh-test"
SELF="${BASH_SOURCE[0]}"
SELF_DIR=$(cd $(dirname "${BASH_SOURCE[0]}") && pwd -P)
SELF_DIR="${SELF_DIR:-$(pwd)}"
SELF_NAME=$(basename "${SELF}")
SYS_NAME=$(uname | awk '{ print tolower($0)}')
HELP="\
usage: ${SELF_NAME} [-h | --help]
       ${SELF_NAME} [--marsh marsh] [test_name[,...]]
where:
  -h, --help
        display this help text
  --marsh
        path to marsh
        default: marsh (system PATH)"

# args
MARSH=""
OPTIND=1
OPTSPEC=":-:h"
OPTARRAY=('-h' '--help' '--marsh')  # all short and long options
while getopts "${OPTSPEC}" OPT; do
    case "${OPT}" in
        -)
            case "${OPTARG}" in
                help)
                    # Print help and exit
                    echo -e "${HELP}"
                    exit 0
                    ;;
                help=*)
                    # Print help and exit
                    echo -e "${HELP}"
                    exit 0
                    ;;
                marsh)
                    if [[ -z ${!OPTIND+isset} ]]; then
                        # Option without required argument
                        echo "Option --${OPTARG} requires a value" >&2
                        echo -e "${HELP}"
                        exit 1
                    fi
                    MARSH="${!OPTIND}"
                    OPTIND=$((OPTIND + 1))
                    ;;
                marsh=*)
                    MARSH="${OPTARG#*=}"
                    ;;
                *)
                    if [[ "${OPTERR}" == 1 ]]; then
                        # Invalid option specified
                        echo "Invalid option: --${OPTARG}" >&2
                        echo -e "${HELP}"
                        exit 1
                    fi
                    ;;
            esac
            ;;
        h)
            # Print help and exit
            echo -e "${HELP}"
            exit 0
            ;;
        :)
            # Option without required value
            echo "Option -${OPTARG} requires a value" >&2
            echo -e "${HELP}"
            exit 1
            ;;
        \?)
            # Invalid option specified
            echo "Invalid option: -${OPTARG}" >&2
            echo -e "${HELP}"
            exit 1
            ;;
    esac
done
shift $((OPTIND - 1))

# dependencies
if [[ "${MARSH}" != "" ]] && [[ "${MARSH#\/}" == "${MARSH}" ]]; then
    MARSH="$(pwd -P)/${MARSH}"
fi
MARSH="${MARSH:-marsh}"
MARSH_FOUND=false
if echo "${MARSH}" | grep '/' >/dev/null 2>&1; then
    if [[ -x "${MARSH}" ]]; then
        MARSH_FOUND=true
    fi
elif command -v "${MARSH}" >/dev/null 2>&1; then
    MARSH_FOUND=true
fi
if [[ "${MARSH_FOUND}" == false ]]; then
    echo "Error: marsh not found at '${MARSH}'" >&2
    exit 1
fi
MD5_FOUND=false
if command -v md5 >/dev/null 2>&1 || command -v md5sum >/dev/null 2>&1; then
    MD5_FOUND=true
fi
if [[ "${MD5_FOUND}" == false ]]; then
    echo "Error: md5|md5sum not found" >&2
    exit 1
fi

# temp dir
TEMP_DIR="${TMPDIR:-/tmp}"
TEMP_DIR="${TEMP_DIR%/}"
MARSH_TEST_TEMP=$(mktemp -d "${TEMP_DIR}/marsh-test-XXXXXX" 2>/dev/null)
if [[ ! -d "${MARSH_TEST_TEMP}" ]]; then
    echo "Error: unable to create test temporary directory" >&2
    exit 1
fi
function marsh_test_cleanup {
    rm -rf "${MARSH_TEST_TEMP}"
}
trap marsh_test_cleanup EXIT

function marsh_test_markdown_command {
    if [[ "$#" -gt 0 ]]; then
        printf '%s\n' "$@"
    fi
    cat
}

function marsh_test_get_physical_path {
    local TARGET_PATH TARGET_DIR TARGET_NAME

    TARGET_PATH="${1:-}"
    [[ "${TARGET_PATH}" == "" ]] && return 1
    if [[ -d "${TARGET_PATH}" ]]; then
        cd "${TARGET_PATH}" && (pwd -P . 2>/dev/null || command pwd)
        return $?
    fi
    TARGET_DIR="${TARGET_PATH%/*}"
    TARGET_NAME="${TARGET_PATH##*/}"
    TARGET_DIR="${TARGET_DIR:-.}"
    [[ -d "${TARGET_DIR}" ]] || return 1
    TARGET_DIR=$(cd "${TARGET_DIR}" && (pwd -P . 2>/dev/null || command pwd)) || return 1
    printf '%s\n' "${TARGET_DIR}/${TARGET_NAME}"
}

function marsh_test_create_archive_document {
    local TARGET_OUTPUT_ROOT DOCUMENT TYPE TITLE DATE_VALUE STATE_VALUE

    TARGET_OUTPUT_ROOT="${1:-}"
    DOCUMENT="${2:-}"
    TYPE="${3:-}"
    TITLE="${4:-}"
    DATE_VALUE="${5:-}"
    STATE_VALUE="${6:-}"
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${DOCUMENT}" == "" ]] && return 1
    mkdir -p "${TARGET_OUTPUT_ROOT}/${DOCUMENT%/*}" || return 1
    marsh_test_write_document_artifacts "${TARGET_OUTPUT_ROOT}" "${DOCUMENT}" "content" "# ${TITLE}" || return 1
    if [[ "${STATE_VALUE}" != "" ]]; then
        marsh_test_write_document_artifacts "${TARGET_OUTPUT_ROOT}" "${DOCUMENT}" "meta-yaml" \
            '---' \
            "Type: ${TYPE}" \
            "Title: ${TITLE}" \
            "Date: ${DATE_VALUE}" \
            'State:' \
            "  - ${STATE_VALUE}" \
            '...' || return 1
    else
        marsh_test_write_document_artifacts "${TARGET_OUTPUT_ROOT}" "${DOCUMENT}" "meta-yaml" \
            '---' \
            "Type: ${TYPE}" \
            "Title: ${TITLE}" \
            "Date: ${DATE_VALUE}" \
            '...' || return 1
    fi
}

function marsh_test_create_minimal_template {
    local TEMPLATES_DIR TEMPLATE_NAME

    TEMPLATES_DIR="${1:-}"
    TEMPLATE_NAME="${2:-}"
    [[ "${TEMPLATES_DIR}" == "" ]] && return 1
    [[ "${TEMPLATE_NAME}" == "" ]] && return 1
    mkdir -p "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials" || return 1
    mkdir -p "${TEMPLATES_DIR}/${TEMPLATE_NAME}/css" || return 1
    mkdir -p "${TEMPLATES_DIR}/${TEMPLATE_NAME}/js" || return 1
    mkdir -p "${TEMPLATES_DIR}/${TEMPLATE_NAME}/images" || return 1
    printf '%s\n' \
        '---' \
        'Template:' \
        '  Partials:' \
        '    Base: partials/base.html' \
        '    Head: partials/head.html' \
        '    Body: partials/body.html' \
        '  Assets:' \
        '    Styles:' \
        '      - css/site.css' \
        '      - css/print.css' \
        '    Scripts:' \
        '      - js/site.js' \
        '    Images:' \
        '      - images/logo.png' \
        '...' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/template.yaml" || return 1
    printf '%s\n' '<!DOCTYPE html>'$'\n''<html><head>{{ template.head }}</head><body>{{ template.body }}</body></html>' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/base.html" || return 1
    printf '%s\n' '<title>{{ document.title }}</title>{{ template.assets.styles }}' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/head.html" || return 1
    printf '%s\n' '{{ document.content }}' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/body.html" || return 1
    printf '%s\n' 'body { color: black; }' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/css/site.css" || return 1
    printf '%s\n' 'console.log("sample");' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/js/site.js" || return 1
    printf '%s\n' 'logo' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/images/logo.png" || return 1
}

function marsh_test_create_archive_template {
    local TEMPLATES_DIR TEMPLATE_NAME ENCODING INCLUDE_ARCHIVE_PARTIALS

    TEMPLATES_DIR="${1:-}"
    TEMPLATE_NAME="${2:-}"
    ENCODING="${3:-html}"
    INCLUDE_ARCHIVE_PARTIALS="${4:-true}"
    [[ "${TEMPLATES_DIR}" == "" ]] && return 1
    [[ "${TEMPLATE_NAME}" == "" ]] && return 1
    mkdir -p "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials" || return 1
    if [[ "${ENCODING}" == "atom" ]]; then
        printf '%s\n' \
            '---' \
            'Template:' \
            '  Partials:' \
            '    Archive:' \
            '      Atom:' \
            '        Base: partials/archive-base.xml' \
            '        Body: partials/archive-body.xml' \
            '        Document: partials/archive-document.xml' \
            '...' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/template.yaml" || return 1
        printf '%s\n' '<?xml version="1.0" encoding="utf-8"?>'$'\n''<feed>atom-base{{ template.body }}</feed>' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/archive-base.xml" || return 1
        printf '%s\n' '<tag>atom-body</tag>'$'\n''{{ subdocuments }}' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/archive-body.xml" || return 1
        printf '%s\n' '<entry>{{ document.title }}</entry>' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/archive-document.xml" || return 1
    elif [[ "${ENCODING}" == "json" ]]; then
        printf '%s\n' \
            '---' \
            'Template:' \
            '  Partials:' \
            '    Archive:' \
            '      JSON:' \
            '        Base: partials/archive-base.json' \
            '        Body: partials/archive-body.json' \
            '        Document: partials/archive-document.json' \
            '...' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/template.yaml" || return 1
        printf '%s\n' '{"base":"json-base","items":[{{ template.body }}]}' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/archive-base.json" || return 1
        printf '%s\n' '"json-body",{{ subdocuments }}' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/archive-body.json" || return 1
        printf '%s\n' '"{{ document.title }}"{{ util.json-separator }}' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/archive-document.json" || return 1
    elif [[ "${ENCODING}" == "html" ]]; then
        printf '%s\n' \
            '---' \
            'Template:' \
            '  Partials:' \
            '    Base: partials/base.html' \
            '    Head: partials/head.html' \
            '    Body: partials/body.html' \
            '    Document: partials/document.html' \
            '    Header: partials/header.html' \
            '    Footer: partials/footer.html' \
            '    Nav: partials/nav.html' \
            '    Notice: partials/notice.html' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/template.yaml" || return 1
        if [[ "${INCLUDE_ARCHIVE_PARTIALS}" == true ]]; then
            printf '%s\n' \
                '    Archive:' \
                '      HTML:' \
                '        Base: partials/archive-base.html' \
                '        Head: partials/archive-head.html' \
                '        Body: partials/archive-body.html' \
                '        Document: partials/archive-document.html' \
                '        Header: partials/archive-header.html' \
                '        Footer: partials/archive-footer.html' \
                '        Nav: partials/archive-nav.html' \
                '        Notice: partials/archive-notice.html' \
                '...' >> "${TEMPLATES_DIR}/${TEMPLATE_NAME}/template.yaml" || return 1
            printf '%s\n' '<!DOCTYPE html>' \
                '<html>' \
                '<head>' \
                '    {{ template.head }}' \
                '</head>' \
                '<body>' \
                '    archive-base' \
                '    {{ template.header }}' \
                '    {{ template.nav }}' \
                '    {{ template.notice }}' \
                '    {{ template.body }}' \
                '    {{ template.footer }}' \
                '</body>' \
                '</html>' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/archive-base.html" || return 1
            printf '%s\n' '<meta name="template-head" content="archive" />' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/archive-head.html" || return 1
            printf '%s\n' 'archive-body'$'\n''{{ subdocuments }}' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/archive-body.html" || return 1
            printf '%s\n' 'archive-document'$'\n''{{ document.content }}' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/archive-document.html" || return 1
            printf '%s\n' '<header>archive-header</header>' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/archive-header.html" || return 1
            printf '%s\n' '<footer>archive-footer</footer>' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/archive-footer.html" || return 1
            printf '%s\n' '<nav>archive-nav</nav>' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/archive-nav.html" || return 1
            printf '%s\n' '<aside>archive-notice</aside>' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/archive-notice.html" || return 1
        fi
        printf '%s\n' \
            '  Assets:' \
            '    Styles:' \
            '      - css/site.css' \
            '      - css/print.css' \
            '    Scripts:' \
            '      - js/site.js' >> "${TEMPLATES_DIR}/${TEMPLATE_NAME}/template.yaml" || return 1
        printf '%s\n' \
            '...' >> "${TEMPLATES_DIR}/${TEMPLATE_NAME}/template.yaml" || return 1
        printf '%s\n' '<!DOCTYPE html>' \
            '<html>' \
            '<head>' \
            '    {{ template.head }}' \
            '</head>' \
            '<body>' \
            '    target-base' \
            '    {{ template.header }}' \
            '    {{ template.nav }}' \
            '    {{ template.notice }}' \
            '    {{ template.body }}' \
            '    {{ template.footer }}' \
            '</body>' \
            '</html>' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/base.html" || return 1
        printf '%s\n' '<meta name="template-head" content="fallback" />' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/head.html" || return 1
        printf '%s\n' 'target-body'$'\n''{{ subdocuments }}' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/body.html" || return 1
        printf '%s\n' 'target-document'$'\n''{{ document.content }}' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/document.html" || return 1
        printf '%s\n' '<header>target-header</header>' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/header.html" || return 1
        printf '%s\n' '<footer>target-footer</footer>' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/footer.html" || return 1
        printf '%s\n' '<nav>target-nav</nav>' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/nav.html" || return 1
        printf '%s\n' '<aside>target-notice</aside>' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/notice.html" || return 1
        mkdir -p "${TEMPLATES_DIR}/${TEMPLATE_NAME}/css" "${TEMPLATES_DIR}/${TEMPLATE_NAME}/js" || return 1
        printf '%s\n' 'body { color: black; }' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/css/site.css" || return 1
        printf '%s\n' 'console.log("sample");' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/js/site.js" || return 1
    fi
}

function marsh_test_write_document_artifacts {
    local TARGET_OUTPUT_ROOT DOCUMENT ARTIFACT FILE

    TARGET_OUTPUT_ROOT="${1:-}"
    DOCUMENT="${2:-}"
    ARTIFACT="${3:-}"
    [[ "${TARGET_OUTPUT_ROOT}" == "" ]] && return 1
    [[ "${DOCUMENT}" == "" ]] && return 1
    [[ "${ARTIFACT}" == "archive-yaml" ]] && ARTIFACT="archive-meta"
    if [[ "${ARTIFACT}" != "content" ]] \
        && [[ "${ARTIFACT}" != "meta-yaml" ]] \
        && [[ "${ARTIFACT}" != "meta" ]] \
        && [[ "${ARTIFACT}" != "archive-meta" ]]; then
        return 1
    fi
    shift 3

    FILE=$(marsh_get_document_temp_path "${TARGET_OUTPUT_ROOT}" "${DOCUMENT}" "${ARTIFACT}") || return 1
    mkdir -p "${FILE%/*}" || return 1
    printf '%s\n' "$@" > "${FILE}" || return 1
}

function marsh_test_set_env {
    MARSH_OTEMP="${MARSH_TEMP:-}"
    MARSH_OCONFIG_PATH="${MARSH_CONFIG_PATH:-}"
    MARSH_OCONFIG_URL="${MARSH_CONFIG_URL:-}"

    MARSH_TEMP="${MARSH_TEST_TEMP}"
    MARSH_CONFIG_PATH="${MARSH_TEST_TEMP}"
    MARSH_CONFIG_URL="https://example.test"
}

function marsh_test_restore_env {
    MARSH_TEMP="${MARSH_OTEMP}"
    [[ "${MARSH_TEMP}" == "" ]] && unset MARSH_TEMP
    MARSH_CONFIG_PATH="${MARSH_OCONFIG_PATH}"
    [[ "${MARSH_CONFIG_PATH}" == "" ]] && unset MARSH_CONFIG_PATH
    MARSH_CONFIG_URL="${MARSH_OCONFIG_URL}"
    [[ "${MARSH_CONFIG_URL}" == "" ]] && unset MARSH_CONFIG_URL
}

function marsh_test_reset_temp {
    [[ "${MARSH_TEST_TEMP:-}" == "" ]] && return 0
    [[ -d "${MARSH_TEST_TEMP}" ]] || return 0

    find "${MARSH_TEST_TEMP}" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + || return 1
}

function marsh_test_group {
    local FUNCTION_NAME="${1}" ERRORS TEST_ID RES
    ERRORS=0
    for TEST_ID in $(seq 0 99); do
        marsh_test "${FUNCTION_NAME}:${TEST_ID}"
        RES=$?
        if [[ "${RES}" -eq 1 ]]; then
            ERRORS=$((ERRORS + 1))
        elif [[ "${RES}" -eq 2 ]]; then
            break
        fi
    done
    return "${ERRORS}"
}

function marsh_test {
    local TEST_NAME EXISTS EXPECTED ACTUAL ASSERTION RES TEST_TEMP_PREFIX

    # init
    TEST_NAME="${1:-}"
    [[ "${TEST_NAME}" == "" ]] && return 1
    EXISTS=true
    EXPECTED=""
    ACTUAL=""
    ASSERTION=""
    RES="[FAIL]"
    TEST_TEMP_PREFIX="${MARSH_TEST_TEMP}/${TEST_NAME//[:]/-}"

    # variables used in test cases
    local SOURCE_FILE META_FILE CONTENT_FILE TARGET_OUTPUT_ROOT HASH ARCHIVE_HASH SEP MANIFEST_FILE
    local INDEX_FILE CACHE_FILE TEMPLATE_DIR TEMPLATE_OVERRIDE_FILE MARSH_OTEMP MARSH_OCONFIG_PATH MARSH_OCONFIG_URL
    local SOURCE_ROOT SITE_OUTPUT_ROOT SOURCE_SCOPE EXPECTED_SOURCE_ROOT
    local TARGET_PLAN_ROOT ARCHIVE_PLAN_ROOT ARCHIVE_PLAN_OUTPUT ARCHIVE_SOURCE_FILE ARCHIVE_MANIFEST
    local FIRST_TARGET_OUTPUT_ROOT SECOND_TARGET_OUTPUT_ROOT ACTUAL_SECOND INVALID_DOCUMENT_RECORD
    local DOCUMENT_ARTIFACT_ROOT DOCUMENT_ARTIFACT_CONTENT DOCUMENT_ARTIFACT_META_YAML DOCUMENT_ARTIFACT_META
    local BASE_URI CANONICAL_META ALIAS_META ALIAS_FILE PAGE_META FIRST_STATE
    local SITE_SOURCE_ROOT TARGET_SITEMAP_PATH TARGET_SITEMAP_SEARCH TARGET_SOURCE_ROOT
    local TEAM_RENDER NEWS_RENDER SITEMAP_RENDER SITEMAP_RENDER_FILE TARGET_TEMP_ROOT RENDER_ROOT
    local EXPLICIT_TARGET_OUTPUT_ROOT EXPLICIT_SOURCE_ROOT EXPLICIT_CONTENT_FILE EXPLICIT_META_FILE
    local PREFERRED_TARGET_OUTPUT_ROOT PREFERRED_SOURCE_ROOT PREFERRED_CONTENT_FILE PREFERRED_META_FILE
    local MISSING_TARGET_OUTPUT_ROOT MISSING_CONTENT_FILE
    local STATUS DOCUMENTS_ACTUAL SOURCE_ASSETS_ACTUAL SOURCE_INVENTORY_ACTUAL SITEMAPS_ACTUAL
    local TARGET_SITEMAP_RECORD SOURCE_ASSET_RECORD DOCUMENT_RECORD
    local DOCUMENT_ID_ESC SOURCE_RELPATH_ESC TARGET_OUTPUT_REL_ESC SOURCE_ROOT_ESC ASSET_RELPATH_ESC
    local RENDER_FILE RENDER_CONTENT FINAL_CONTENT
    local -a TARGET_TEMPLATE_OVERRIDES TARGET_ARCHIVES TARGET_ARCHIVES_ENCODING TARGET_ARCHIVES_NAME
    local -a TARGET_ARCHIVES_LANGUAGE TARGET_ARCHIVES_LANGUAGE_CODE TARGET_ARCHIVES_ROOT_PATH TARGET_ARCHIVES_COUNT TARGET_ARCHIVES_PAGE_SIZE
    local -a TARGET_ARCHIVES_TYPES TARGET_ARCHIVES_EXCLUDED_STATES
    local -a TARGET_ARCHIVES_TEMPLATE_SOURCE TARGET_ARCHIVES_TEMPLATE_ASSETS_PATH TARGET_ARCHIVES_TEMPLATE_OVERRIDES TARGET_ARCHIVES_TEMPLATE
    local -a TARGET_SITEMAP_RECORDS DOCUMENT_RECORDS SOURCE_ASSET_RECORDS ARCHIVE_PLAN_ROOTS

    marsh_test_set_env
    if marsh_test_reset_temp; then
    case "${TEST_NAME}" in
        marsh_build_archive:0)
            TEST_NAME+=":html_pagination"
            TARGET_OUTPUT_ROOT="${TEST_TEMP_PREFIX}.target"
            marsh_test_create_archive_document "${TARGET_OUTPUT_ROOT}" "news/2026/01/04/04-fourth.markdown" "post" "Fourth" "2026-01-04"
            marsh_test_create_archive_document "${TARGET_OUTPUT_ROOT}" "news/2026/01/03/03-third.markdown" "post" "Third" "2026-01-03"
            marsh_test_create_archive_document "${TARGET_OUTPUT_ROOT}" "news/2026/01/02/02-second.markdown" "post" "Second" "2026-01-02"
            marsh_test_create_archive_document "${TARGET_OUTPUT_ROOT}" "news/2026/01/01/01-first.markdown" "post" "First" "2026-01-01"
            ACTUAL=$(marsh_build_archive "html" "${TARGET_OUTPUT_ROOT}" "index.markdown" "Archive" "English" "en" "3" "2" "1" "post" "0")
            EXPECTED=$(printf '%s\n' \
                'index.markdown' \
                'page/1/index.markdown' \
                'page/2/index.markdown')
            ASSERTION="equals"
            BASE_URI="https://example.test/$(basename "${TARGET_OUTPUT_ROOT}")"
            SOURCE_FILE=$(marsh_get_archive_temp_path "${TARGET_OUTPUT_ROOT}" "index.markdown" "source")
            META_FILE=$(marsh_get_archive_temp_path "${TARGET_OUTPUT_ROOT}" "page/1/index.markdown" "source")
            CONTENT_FILE=$(marsh_get_archive_temp_path "${TARGET_OUTPUT_ROOT}" "page/2/index.markdown" "source")
            CANONICAL_META=$(sed -n -e '/^Page:/p' -e '/^Page_Total:/p' -e '/^Page_Size:/p' -e '/^Page_Subdocuments_Total:/p' -e '/^Archive_Subdocuments_Total:/p' -e '/^Page_URI:/p' -e '/^Page_Canonical_URI:/p' -e '/^Page_Next_URI:/p' -e '/^Page_Last_URI:/p' -e '/^Page_Href:/p' -e '/^Page_Canonical_Href:/p' -e '/^Page_Next_Href:/p' -e '/^Page_Last_Href:/p' "${SOURCE_FILE}")
            ALIAS_META=$(sed -n -e '/^Page:/p' -e '/^Page_URI:/p' -e '/^Page_Canonical_URI:/p' -e '/^Page_Next_URI:/p' -e '/^Page_Href:/p' -e '/^Page_Canonical_Href:/p' -e '/^Page_Next_Href:/p' -e '/^Page_Last_Href:/p' "${META_FILE}")
            PAGE_META=$(sed -n -e '/^Page:/p' -e '/^Page_Total:/p' -e '/^Page_Subdocuments_Total:/p' -e '/^Archive_Subdocuments_Total:/p' -e '/^Page_Prev_URI:/p' -e '/^Page_Last_URI:/p' -e '/^Page_Href:/p' -e '/^Page_Prev_Href:/p' -e '/^Page_Last_Href:/p' "${CONTENT_FILE}")
            if [[ "${ACTUAL}" == "${EXPECTED}" ]]; then
                ACTUAL="${CANONICAL_META}"
                EXPECTED=$(printf '%s\n' \
                    'Page: 1' \
                    'Page_Total: 2' \
                    'Page_Size: 2' \
                    'Page_Subdocuments_Total: 2' \
                    'Archive_Subdocuments_Total: 3' \
                    "Page_URI: ${BASE_URI}/" \
                    "Page_Canonical_URI: ${BASE_URI}/" \
                    "Page_Next_URI: ${BASE_URI}/page/2/" \
                    "Page_Last_URI: ${BASE_URI}/page/2/" \
                    'Page_Href: ./' \
                    'Page_Canonical_Href: ./' \
                    'Page_Next_Href: page/2/' \
                    'Page_Last_Href: page/2/')
                ASSERTION="equals"
                if [[ "${ACTUAL}" == "${EXPECTED}" ]]; then
                    ACTUAL="${ALIAS_META}"
                    EXPECTED=$(printf '%s\n' \
                        'Page: 1' \
                        "Page_URI: ${BASE_URI}/page/1/" \
                        "Page_Canonical_URI: ${BASE_URI}/" \
                        "Page_Next_URI: ${BASE_URI}/page/2/" \
                        'Page_Href: ./' \
                        'Page_Canonical_Href: ../../' \
                        'Page_Next_Href: ../2/' \
                        'Page_Last_Href: ../2/')
                    ASSERTION="equals"
                    if [[ "${ACTUAL}" == "${EXPECTED}" ]]; then
                        ACTUAL="${PAGE_META}"
                        EXPECTED=$(printf '%s\n' \
                            'Page: 2' \
                            'Page_Total: 2' \
                            'Page_Subdocuments_Total: 1' \
                            'Archive_Subdocuments_Total: 3' \
                            "Page_Prev_URI: ${BASE_URI}/" \
                            "Page_Last_URI: ${BASE_URI}/page/2/" \
                            'Page_Href: ./' \
                            'Page_Prev_Href: ../../' \
                            'Page_Last_Href: ./')
                        ASSERTION="equals"
                        if [[ "${ACTUAL}" == "${EXPECTED}" ]]; then
                            {
                                [[ -e "${SOURCE_FILE}" ]] \
                                    && [[ -e "${META_FILE}" ]] \
