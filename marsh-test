NAME="marsh-test"
SELF="${BASH_SOURCE[0]}"
SELF_DIR=$(cd $(dirname "${BASH_SOURCE[0]}") && pwd -P)
SELF_DIR="${SELF_DIR:-$(pwd)}"
SELF_NAME=$(basename "${SELF}")
SYS_NAME=$(uname | awk '{ print tolower($0)}')
HELP="\
usage: ${SELF_NAME} [-h | --help]
       ${SELF_NAME} [--marsh marsh] [test_name[,...]]
where:
  -h, --help
        display this help text
  --marsh
        path to marsh
        default: marsh (system PATH)"

# args
MARSH=""
OPTIND=1
OPTSPEC=":-:h"
OPTARRAY=('-h' '--help' '--marsh')  # all short and long options
while getopts "${OPTSPEC}" OPT; do
    case "${OPT}" in
        -)
            case "${OPTARG}" in
                help)
                    # Print help and exit
                    echo -e "${HELP}"
                    exit 0
                    ;;
                help=*)
                    # Print help and exit
                    echo -e "${HELP}"
                    exit 0
                    ;;
                marsh)
                    if [[ -z ${!OPTIND+isset} ]]; then
                        # Option without required argument
                        echo "Option --${OPTARG} requires a value" >&2
                        echo -e "${HELP}"
                        exit 1
                    fi
                    MARSH="${!OPTIND}"
                    OPTIND=$((OPTIND + 1))
                    ;;
                marsh=*)
                    MARSH="${OPTARG#*=}"
                    ;;
                *)
                    if [[ "${OPTERR}" == 1 ]]; then
                        # Invalid option specified
                        echo "Invalid option: --${OPTARG}" >&2
                        echo -e "${HELP}"
                        exit 1
                    fi
                    ;;
            esac
            ;;
        h)
            # Print help and exit
            echo -e "${HELP}"
            exit 0
            ;;
        :)
            # Option without required value
            echo "Option -${OPTARG} requires a value" >&2
            echo -e "${HELP}"
            exit 1
            ;;
        \?)
            # Invalid option specified
            echo "Invalid option: -${OPTARG}" >&2
            echo -e "${HELP}"
            exit 1
            ;;
    esac
done
shift $((OPTIND - 1))

# dependencies
if [[ "${MARSH}" != "" ]] && [[ "${MARSH#\/}" == "${MARSH}" ]]; then
    MARSH="$(pwd -P)/${MARSH}"
fi
MARSH="${MARSH:-marsh}"
MARSH_FOUND=false
if echo "${MARSH}" | grep '/' >/dev/null 2>&1; then
    if [[ -x "${MARSH}" ]]; then
        MARSH_FOUND=true
    fi
elif hash "${MARSH}" >/dev/null 2>&1; then
    MARSH_FOUND=true
fi
if [[ "${MARSH_FOUND}" == false ]]; then
    echo "Error: marsh not found at '${MARSH}'" >&2
    exit 1
fi

# temp dir
TEMP_DIR="${TMPDIR:-/tmp}"
TEMP_DIR="${TEMP_DIR%/}"
MARSH_TEST_TEMP=$(mktemp -d "${TEMP_DIR}/marsh-test-XXXXXX" 2>/dev/null)
if [[ ! -d "${MARSH_TEST_TEMP}" ]]; then
    echo "Error: unable to create test temporary directory" >&2
    exit 1
fi
function marsh_test_cleanup {
    rm -rf "${MARSH_TEST_TEMP}"
}
trap marsh_test_cleanup EXIT

function marsh_test_markdown_command {
    if [[ "$#" -gt 0 ]]; then
        printf '%s\n' "$@"
    fi
    cat
}

function marsh_test_create_archive_document {
    local TARGET_DIR DOCUMENT RUN_UID TYPE TITLE DATE_VALUE STATE_VALUE

    TARGET_DIR="${1:-}"
    DOCUMENT="${2:-}"
    RUN_UID="${3:-}"
    TYPE="${4:-}"
    TITLE="${5:-}"
    DATE_VALUE="${6:-}"
    STATE_VALUE="${7:-}"
    [[ "${TARGET_DIR}" == "" ]] && return 1
    [[ "${DOCUMENT}" == "" ]] && return 1
    [[ "${RUN_UID}" == "" ]] && return 1
    mkdir -p "${TARGET_DIR}/${DOCUMENT%/*}" || return 1
    printf '%s\n' "# ${TITLE}" > "${TARGET_DIR}/${DOCUMENT}.${RUN_UID}.document" || return 1
    if [[ "${STATE_VALUE}" != "" ]]; then
        printf '%s\n' \
            '---' \
            "Type: ${TYPE}" \
            "Title: ${TITLE}" \
            "Date: ${DATE_VALUE}" \
            'State:' \
            "  - ${STATE_VALUE}" \
            '...' > "${TARGET_DIR}/${DOCUMENT}.${RUN_UID}.meta.yaml" || return 1
    else
        printf '%s\n' \
            '---' \
            "Type: ${TYPE}" \
            "Title: ${TITLE}" \
            "Date: ${DATE_VALUE}" \
            '...' > "${TARGET_DIR}/${DOCUMENT}.${RUN_UID}.meta.yaml" || return 1
    fi
}

function marsh_test_create_minimal_template {
    local TEMPLATES_DIR TEMPLATE_NAME

    TEMPLATES_DIR="${1:-}"
    TEMPLATE_NAME="${2:-}"
    [[ "${TEMPLATES_DIR}" == "" ]] && return 1
    [[ "${TEMPLATE_NAME}" == "" ]] && return 1
    mkdir -p "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials" "${TEMPLATES_DIR}/${TEMPLATE_NAME}/css" || return 1
    printf '%s\n' \
        '---' \
        'Template:' \
        '  Partials:' \
        '    Base: partials/base.html' \
        '    Body: partials/body.html' \
        '  Assets:' \
        '    Styles:' \
        '      - css/site.css' \
        '...' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/template.yaml" || return 1
    printf '%s\n' '<!DOCTYPE html>' '<html><head>{{ template.styles }}</head><body>{{ template.body }}</body></html>' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/base.html" || return 1
    printf '%s\n' '{{ document }}' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/body.html" || return 1
    printf '%s\n' 'body { color: black; }' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/css/site.css" || return 1
}

function marsh_test_create_archive_template {
    local TEMPLATES_DIR TEMPLATE_NAME

    TEMPLATES_DIR="${1:-}"
    TEMPLATE_NAME="${2:-}"
    [[ "${TEMPLATES_DIR}" == "" ]] && return 1
    [[ "${TEMPLATE_NAME}" == "" ]] && return 1
    mkdir -p "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials" || return 1
    printf '%s\n' \
        '---' \
        'Template:' \
        '  Partials:' \
        '    Base: partials/base.html' \
        '    Archive_HTML_Body: partials/archive-body.html' \
        '    Archive_HTML_Document: partials/archive-document.html' \
        '...' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/template.yaml" || return 1
    printf '%s\n' '<!DOCTYPE html>' '<html><body>{{ template.body }}</body></html>' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/base.html" || return 1
    printf '%s\n' '{{ subdocuments }}' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/archive-body.html" || return 1
    printf '%s\n' '{{ document }}' > "${TEMPLATES_DIR}/${TEMPLATE_NAME}/partials/archive-document.html" || return 1
}

function marsh_test_group {
    local FUNCTION_NAME="${1}" ERRORS TEST_ID RES
    ERRORS=0
    for TEST_ID in $(seq 0 99); do
        marsh_test "${FUNCTION_NAME}:${TEST_ID}"
        RES=$?
        if [[ "${RES}" -eq 1 ]]; then
            ERRORS=$((ERRORS + 1))
        elif [[ "${RES}" -eq 2 ]]; then
            break
        fi
    done
    return "${ERRORS}"
}

function marsh_test {
    local TEST_NAME="${1}" EXISTS TEST EXPECTED RES
    local TEST_TEMP_PREFIX SOURCE_FILE META_FILE CONTENT_FILE DOCUMENT_FILE MARSH_OUID TARGET_DIR HASH SEP
    local INDEX_FILE MARSH_OCONFIG_PATH MARSH_OCONFIG_URL TEMPLATE_DIR TEMPLATE_OVERRIDE_FILE MARSH_OTEMP
    local ARCHIVE_PAGES BASE_URI CANONICAL_META ALIAS_META PAGE_META TARGET_DIR_TWO
    EXISTS=true
    TEST=""
    EXPECTED=""
    RES="[FAIL]"
    TEST_TEMP_PREFIX="${MARSH_TEST_TEMP}/${TEST_NAME//[:]/-}"
    case "${TEST_NAME}" in
        marsh_check_dependencies:0)
            TEST_NAME+=":found"
            $(marsh_check_dependencies bash)
            TEST=$?
            EXPECTED=0
            if [[ "${TEST}" -eq "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_check_dependencies:1)
            TEST_NAME+=":missing"
            $(marsh_check_dependencies definitely_missing_command_xyz 2>/dev/null)
            TEST=$?
            EXPECTED=1
            if [[ "${TEST}" -eq "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_check_dependencies:2)
            TEST_NAME+=":alternative_found"
            $(marsh_check_dependencies definitely_missing_command_xyz\|bash)
            TEST=$?
            EXPECTED=0
            if [[ "${TEST}" -eq "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_clean_target:0)
            TEST_NAME+=":matching"
            TARGET_DIR="${TEST_TEMP_PREFIX}.target"
            MARSH_OUID="${MARSH_UID:-}"
            MARSH_UID="cleantest"
            mkdir -p "${TARGET_DIR}"
            : > "${TARGET_DIR}/post.${MARSH_UID}.markdown"
            : > "${TARGET_DIR}/note.${MARSH_UID}.md"
            : > "${TARGET_DIR}/image.${MARSH_UID}.jpg"
            : > "${TARGET_DIR}/keep.markdown"
            : > "${TARGET_DIR}/keep.jpg"
            marsh_clean_target "${TARGET_DIR}" "markdown,md"
            TEST="$([[ ! -e "${TARGET_DIR}/post.${MARSH_UID}.markdown" ]] && [[ ! -e "${TARGET_DIR}/note.${MARSH_UID}.md" ]] && [[ ! -e "${TARGET_DIR}/image.${MARSH_UID}.jpg" ]] && [[ ! -e "${TARGET_DIR}/keep.markdown" ]] && [[ -e "${TARGET_DIR}/keep.jpg" ]]; printf '%s' "$?")"
            EXPECTED="0"
            rm -rf "${TARGET_DIR}"
            MARSH_UID="${MARSH_OUID}"
            [[ "${MARSH_UID}" == "" ]] && unset MARSH_UID
            if [[ "${TEST}" == "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_clean_target:1)
            TEST_NAME+=":nested"
            TARGET_DIR="${TEST_TEMP_PREFIX}.target"
            MARSH_OUID="${MARSH_UID:-}"
            MARSH_UID="cleantest"
            mkdir -p "${TARGET_DIR}/nested/deeper"
            : > "${TARGET_DIR}/nested/article.markdown"
            : > "${TARGET_DIR}/nested/deeper/nav.${MARSH_UID}.advanced-nav.html"
            : > "${TARGET_DIR}/nested/deeper/keep.png"
            marsh_clean_target "${TARGET_DIR}" "markdown,md"
            TEST="$([[ ! -e "${TARGET_DIR}/nested/article.markdown" ]] && [[ ! -e "${TARGET_DIR}/nested/deeper/nav.${MARSH_UID}.advanced-nav.html" ]] && [[ -e "${TARGET_DIR}/nested/deeper/keep.png" ]]; printf '%s' "$?")"
            EXPECTED="0"
            rm -rf "${TARGET_DIR}"
            MARSH_UID="${MARSH_OUID}"
            [[ "${MARSH_UID}" == "" ]] && unset MARSH_UID
            if [[ "${TEST}" == "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_clean_target:2)
            TEST_NAME+=":case_insensitive"
            TARGET_DIR="${TEST_TEMP_PREFIX}.target"
            mkdir -p "${TARGET_DIR}"
            : > "${TARGET_DIR}/UPPER.MD"
            : > "${TARGET_DIR}/Mixed.MarkDown"
            : > "${TARGET_DIR}/keep.txt"
            marsh_clean_target "${TARGET_DIR}" "markdown,md"
            TEST="$([[ ! -e "${TARGET_DIR}/UPPER.MD" ]] && [[ ! -e "${TARGET_DIR}/Mixed.MarkDown" ]] && [[ -e "${TARGET_DIR}/keep.txt" ]]; printf '%s' "$?")"
            EXPECTED="0"
            rm -rf "${TARGET_DIR}"
            if [[ "${TEST}" == "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_clean_target:3)
            TEST_NAME+=":missing_target"
            $(marsh_clean_target "" "markdown,md" 2>/dev/null)
            TEST=$?
            EXPECTED=1
            if [[ "${TEST}" -eq "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_clean_target:4)
            TEST_NAME+=":missing_extensions"
            TARGET_DIR="${TEST_TEMP_PREFIX}.target"
            mkdir -p "${TARGET_DIR}"
            $(marsh_clean_target "${TARGET_DIR}" "" 2>/dev/null)
            TEST=$?
            EXPECTED=1
            rm -rf "${TARGET_DIR}"
            if [[ "${TEST}" -eq "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_escape_substitution:0)
            TEST_NAME+=":plain"
            TEST=$(printf 'foo' | marsh_escape_substitution)
            EXPECTED="foo"
            if [[ "${TEST}" == "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_escape_substitution:1)
            TEST_NAME+=":special"
            TEST=$(printf '%s' '&/\\' | marsh_escape_substitution)
            EXPECTED='\&\/\\\\'
            if [[ "${TEST}" == "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_escape_substitution:2)
            TEST_NAME+=":multiline_trailing_newlines"
            TEST=$(printf 'foo\nbar\n\n' | marsh_escape_substitution)
            EXPECTED="foo\\"$'\n'"bar"
            if [[ "${TEST}" == "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_extract_frontmatter:0)
            TEST_NAME+=":success"
            SOURCE_FILE="${TEST_TEMP_PREFIX}.source.markdown"
            META_FILE="${TEST_TEMP_PREFIX}.meta.yaml"
            CONTENT_FILE="${TEST_TEMP_PREFIX}.content.markdown"
            printf '%s\n' \
                '---' \
                'Title: Example' \
                'Tags: [one, two]' \
                '---' \
                '' \
                'Body text' > "${SOURCE_FILE}"
            marsh_extract_frontmatter "${SOURCE_FILE}" "${META_FILE}" "${CONTENT_FILE}"
            TEST="$?"
            EXPECTED="0"
            if [[ "${TEST}" -eq "${EXPECTED}" ]]; then
                TEST="$(<"${META_FILE}")"$'\001'"$(<"${CONTENT_FILE}")"
                EXPECTED='---'$'\n''Title: Example'$'\n''Tags: [one, two]'$'\n''...'$'\001'$'\n''Body text'
            fi
            rm -f "${SOURCE_FILE}" "${META_FILE}" "${CONTENT_FILE}"
            if [[ "${TEST}" == "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_extract_frontmatter:1)
            TEST_NAME+=":empty_body"
            SOURCE_FILE="${TEST_TEMP_PREFIX}.source.markdown"
            META_FILE="${TEST_TEMP_PREFIX}.meta.yaml"
            CONTENT_FILE="${TEST_TEMP_PREFIX}.content.markdown"
            printf '%s\n' '---'$'\n''Title: Example'$'\n''---' > "${SOURCE_FILE}"
            marsh_extract_frontmatter "${SOURCE_FILE}" "${META_FILE}" "${CONTENT_FILE}"
            TEST="$?"
            EXPECTED="0"
            if [[ "${TEST}" -eq "${EXPECTED}" ]]; then
                TEST="$(<"${META_FILE}")"$'\001'"$(<"${CONTENT_FILE}")"
                EXPECTED='---'$'\n''Title: Example'$'\n''...'$'\001'
            fi
            rm -f "${SOURCE_FILE}" "${META_FILE}" "${CONTENT_FILE}"
            if [[ "${TEST}" == "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_extract_frontmatter:2)
            TEST_NAME+=":missing"
            SOURCE_FILE="${TEST_TEMP_PREFIX}.source.markdown"
            META_FILE="${TEST_TEMP_PREFIX}.meta.yaml"
            CONTENT_FILE="${TEST_TEMP_PREFIX}.content.markdown"
            printf '%s\n' 'Title: Example'$'\n\n''Body text' > "${SOURCE_FILE}"
            marsh_extract_frontmatter "${SOURCE_FILE}" "${META_FILE}" "${CONTENT_FILE}"
            TEST="$?"
            EXPECTED="1"
            rm -f "${SOURCE_FILE}" "${META_FILE}" "${CONTENT_FILE}"
            if [[ "${TEST}" -eq "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_find_advanced_nav:0)
            TEST_NAME+=":same_dir"
            TARGET_DIR="${TEST_TEMP_PREFIX}.target"
            MARSH_OUID="${MARSH_UID:-}"
            MARSH_UID="navtest"
            mkdir -p "${TARGET_DIR}/news"
            : > "${TARGET_DIR}/news/nav.html.${MARSH_UID}.advanced-nav.html"
            TEST=$(marsh_find_advanced_nav "${TARGET_DIR}" "news/article.markdown" "nav.html")
            EXPECTED="news/nav.html.${MARSH_UID}.advanced-nav.html"
            rm -rf "${TARGET_DIR}"
            MARSH_UID="${MARSH_OUID}"
            [[ "${MARSH_UID}" == "" ]] && unset MARSH_UID
            if [[ "${TEST}" == "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_find_advanced_nav:1)
            TEST_NAME+=":parent_dir"
            TARGET_DIR="${TEST_TEMP_PREFIX}.target"
            MARSH_OUID="${MARSH_UID:-}"
            MARSH_UID="navtest"
            mkdir -p "${TARGET_DIR}/news/world"
            : > "${TARGET_DIR}/nav.html.${MARSH_UID}.advanced-nav.html"
            TEST=$(marsh_find_advanced_nav "${TARGET_DIR}" "news/world/article.markdown" "nav.html")
            EXPECTED="nav.html.${MARSH_UID}.advanced-nav.html"
            rm -rf "${TARGET_DIR}"
            MARSH_UID="${MARSH_OUID}"
            [[ "${MARSH_UID}" == "" ]] && unset MARSH_UID
            if [[ "${TEST}" == "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_find_advanced_nav:2)
            TEST_NAME+=":missing"
            TARGET_DIR="${TEST_TEMP_PREFIX}.target"
            MARSH_OUID="${MARSH_UID:-}"
            MARSH_UID="navtest"
            mkdir -p "${TARGET_DIR}/news"
            TEST=$(marsh_find_advanced_nav "${TARGET_DIR}" "news/article.markdown" "nav.html" 2>/dev/null)
            TEST=$?
            EXPECTED=1
            rm -rf "${TARGET_DIR}"
            MARSH_UID="${MARSH_OUID}"
            [[ "${MARSH_UID}" == "" ]] && unset MARSH_UID
            if [[ "${TEST}" -eq "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_flat_to_array:0)
            TEST_NAME+=":nested"
            TEST=$(FOOBAR_0="foo" FOOBAR_1="bar" FOOBAR_X="x" marsh_flat_to_array "ARRAY" "FOOBAR_")
            EXPECTED="ARRAY=()"$'\n'"ARRAY+=(\"foo\")"$'\n'"ARRAY+=(\"bar\")"
            if [[ "${TEST}" == "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_get_archive_manifest:0)
            TEST_NAME+=":built"
            TARGET_DIR="${TEST_TEMP_PREFIX}.target"
            MARSH_OUID="${MARSH_UID:-}"
            MARSH_UID="archiveuid"
            MARSH_OTEMP="${MARSH_TEMP:-}"
            MARSH_TEMP="${MARSH_TEST_TEMP}"
            MARSH_OCONFIG_PATH="${MARSH_CONFIG_PATH:-}"
            MARSH_CONFIG_PATH="${MARSH_TEST_TEMP}"
            MARSH_OCONFIG_URL="${MARSH_CONFIG_URL:-}"
            MARSH_CONFIG_URL="https://example.test"
            marsh_test_create_archive_document "${TARGET_DIR}" "news/2026/01/02/02-second.markdown" "${MARSH_UID}" "post" "Second" "2026-01-02" "published"
            TEST=$(marsh_get_archive_manifest "${TARGET_DIR}")
            EXPECTED="${MARSH_TEST_TEMP}/archive-manifest-cache/$(printf '%s\034%s\n' "${TARGET_DIR}" "${MARSH_UID}" | marsh_text_filter hash:md5).manifest"
            if [[ "${TEST}" == "${EXPECTED}" ]] && [[ -f "${TEST}" ]]; then
                TEST="0"
            else
                TEST="1"
            fi
            rm -rf "${TARGET_DIR}"
            MARSH_UID="${MARSH_OUID}"
            [[ "${MARSH_UID}" == "" ]] && unset MARSH_UID
            MARSH_TEMP="${MARSH_OTEMP}"
            [[ "${MARSH_TEMP}" == "" ]] && unset MARSH_TEMP
            MARSH_CONFIG_PATH="${MARSH_OCONFIG_PATH}"
            [[ "${MARSH_CONFIG_PATH}" == "" ]] && unset MARSH_CONFIG_PATH
            MARSH_CONFIG_URL="${MARSH_OCONFIG_URL}"
            [[ "${MARSH_CONFIG_URL}" == "" ]] && unset MARSH_CONFIG_URL
            EXPECTED="0"
            if [[ "${TEST}" == "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_get_archive_manifest:1)
            TEST_NAME+=":cached"
            TARGET_DIR="${TEST_TEMP_PREFIX}.target"
            MARSH_OUID="${MARSH_UID:-}"
            MARSH_UID="archiveuid"
            MARSH_OTEMP="${MARSH_TEMP:-}"
            MARSH_TEMP="${MARSH_TEST_TEMP}"
            MARSH_OCONFIG_PATH="${MARSH_CONFIG_PATH:-}"
            MARSH_CONFIG_PATH="${MARSH_TEST_TEMP}"
            MARSH_OCONFIG_URL="${MARSH_CONFIG_URL:-}"
            MARSH_CONFIG_URL="https://example.test"
            marsh_test_create_archive_document "${TARGET_DIR}" "news/2026/01/02/02-second.markdown" "${MARSH_UID}" "post" "Second" "2026-01-02" "published"
            INDEX_FILE=$(marsh_get_archive_manifest "${TARGET_DIR}")
            printf '%s\n' 'sentinel' > "${INDEX_FILE}"
            TEST=$(marsh_get_archive_manifest "${TARGET_DIR}")
            if [[ "${TEST}" == "${INDEX_FILE}" ]] && [[ "$(<"${TEST}")" == 'sentinel' ]]; then
                TEST="0"
            else
                TEST="1"
            fi
            rm -rf "${TARGET_DIR}"
            MARSH_UID="${MARSH_OUID}"
            [[ "${MARSH_UID}" == "" ]] && unset MARSH_UID
            MARSH_TEMP="${MARSH_OTEMP}"
            [[ "${MARSH_TEMP}" == "" ]] && unset MARSH_TEMP
            MARSH_CONFIG_PATH="${MARSH_OCONFIG_PATH}"
            [[ "${MARSH_CONFIG_PATH}" == "" ]] && unset MARSH_CONFIG_PATH
            MARSH_CONFIG_URL="${MARSH_OCONFIG_URL}"
            [[ "${MARSH_CONFIG_URL}" == "" ]] && unset MARSH_CONFIG_URL
            EXPECTED="0"
            if [[ "${TEST}" == "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_get_archive_metadata:0)
            TEST_NAME+=":parsed"
            TARGET_DIR="${TEST_TEMP_PREFIX}.target"
            MARSH_OUID="${MARSH_UID:-}"
            MARSH_OCONFIG_PATH="${MARSH_CONFIG_PATH:-}"
            MARSH_OCONFIG_URL="${MARSH_CONFIG_URL:-}"
            MARSH_UID="archiveuid"
            MARSH_CONFIG_PATH="${MARSH_TEST_TEMP}"
            MARSH_CONFIG_URL="https://example.test"
            META_FILE="${TARGET_DIR}/news/article.markdown.${MARSH_UID}.meta.yaml"
            mkdir -p "${TARGET_DIR}/news"
            printf '%s\n' \
                '---' \
                'Type: post' \
                'Title: Hello World' \
                'Date: 2024-01-02' \
                'State:' \
                '  - published' \
                '  - featured' \
                '...' > "${META_FILE}"
            TEST=$(marsh_get_archive_metadata "${TARGET_DIR}" "news/article.markdown.${MARSH_UID}.document")
            EXPECTED="TYPE=post"$'\n'"URI=https://example.test/$(basename "${TARGET_DIR}")/news/article.html"$'\n'"ABSPATH=https://example.test/$(basename "${TARGET_DIR}")/news"$'\n'"STATE=()"$'\n'"STATE+=(published)"$'\n'"STATE+=(featured)"
            rm -rf "${TARGET_DIR}"
            MARSH_UID="${MARSH_OUID}"
            [[ "${MARSH_UID}" == "" ]] && unset MARSH_UID
            MARSH_CONFIG_PATH="${MARSH_OCONFIG_PATH}"
            [[ "${MARSH_CONFIG_PATH}" == "" ]] && unset MARSH_CONFIG_PATH
            MARSH_CONFIG_URL="${MARSH_OCONFIG_URL}"
            [[ "${MARSH_CONFIG_URL}" == "" ]] && unset MARSH_CONFIG_URL
            if [[ "${TEST}" == "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_get_archive_metadata:1)
            TEST_NAME+=":cache"
            TARGET_DIR="${TEST_TEMP_PREFIX}.target"
            MARSH_OUID="${MARSH_UID:-}"
            MARSH_UID="archiveuid"
            INDEX_FILE="${TARGET_DIR}/news/article.markdown.${MARSH_UID}.archive-meta"
            mkdir -p "${TARGET_DIR}/news"
            printf '%s\n' \
                'TYPE=cached' \
                'TITLE=Cached\ Title' \
                'DATE=2024-05-06' \
                'URI=https://cached.example/article.html' \
                'ABSPATH=https://cached.example' \
                'STATE=()' \
                'STATE+=(cached)' > "${INDEX_FILE}"
            TEST=$(marsh_get_archive_metadata "${TARGET_DIR}" "news/article.markdown.${MARSH_UID}.document")
            EXPECTED="TYPE=cached"$'\n'"TITLE=Cached\ Title"$'\n'"DATE=2024-05-06"$'\n'"URI=https://cached.example/article.html"$'\n'"ABSPATH=https://cached.example"$'\n'"STATE=()"$'\n'"STATE+=(cached)"
            rm -rf "${TARGET_DIR}"
            MARSH_UID="${MARSH_OUID}"
            [[ "${MARSH_UID}" == "" ]] && unset MARSH_UID
            if [[ "${TEST}" == "${EXPECTED}" ]]; then
                RES="[PASS]"
            fi
            ;;
        marsh_get_archive_metadata:2)
            TEST_NAME+=":missing"
            TARGET_DIR="${TEST_TEMP_PREFIX}.target"
            MARSH_OUID="${MARSH_UID:-}"
