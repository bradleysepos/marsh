                '' \
                'Paragraph' | marsh_text_filter_headings push)
            EXPECTED='## Heading 1'$'\n\n''**Heading 6**'$'\n\n''Paragraph'
            if [[ "${TEST}" == "${EXPECTED}" ]]; then
