    if [[ "${FUNCNAME[1]}" == "marsh_test_group" ]] && [[ "${EXISTS}" != true ]]; then
        return 2
    fi
    echo -n "${RES}"$'\t'"${TEST_NAME}"
    if [[ "${EXISTS}" == true ]]; then
        if [[ "${RES}" == "[FAIL]" ]]; then
            echo $'\t'"Expected: \`${EXPECTED//$'\n'/\\n}\` Actual: \`${TEST//$'\n'/\\n}\`"
            return 1
        fi
        echo ""
        return 0
    fi
    echo $'\t'"Test not found"
    return 1
}

source "${MARSH}"
KNOWN_FUNCTIONS=(
    marsh_build_archive
    marsh_build_archive_manifest
    marsh_build_target
    marsh_build_template
    marsh_check_dependencies
    marsh_clean_target
    marsh_escape_substitution
    marsh_extract_frontmatter
    marsh_find_advanced_nav
    marsh_flat_to_array
    marsh_get_archive_manifest
    marsh_get_archive_metadata
    marsh_get_files
    marsh_get_local_declarations
    marsh_get_subdocuments
    marsh_get_target_metadata
    marsh_get_template_metadata
    marsh_get_variables
    marsh_has_frontmatter
    marsh_in_array
    marsh_is_markdown_extension
    marsh_parse_template_metadata
    marsh_parse_yaml
    marsh_process_markdown
    marsh_resolve_tag_metadata
    marsh_text_filter
    marsh_text_filter_headings
)
FUNCTIONS=("${@}")
if [[ "${FUNCTIONS[*]}" == "" ]]; then
    FUNCTIONS=("${KNOWN_FUNCTIONS[@]}")
fi
echo "Running tests: ${FUNCTIONS[*]}"
ERRORS=false
for FUNCTION in "${FUNCTIONS[@]}"; do
    if [[ " ${KNOWN_FUNCTIONS[*]} " =~ " ${FUNCTION//:*/} " ]]; then
        if [[ "${FUNCTION}" == "${FUNCTION//:*/}" ]]; then
            marsh_test_group "${FUNCTION}" || ERRORS=true
        else
            marsh_test "${FUNCTION}" || ERRORS=true
        fi
    else
        echo "[FAIL]"$'\t'"${FUNCTION}"$'\t'"Function for test not found" && ERRORS=true
    fi
done
if [[ "${ERRORS}" == true ]]; then
    echo "Some tests are failing."
    exit 1
fi
echo "All tests are passing."
exit 0
