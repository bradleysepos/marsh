    {
      "id": "{{ document.uri }}",
      "url": "{{ document.uri }}",
      "date_published": "{{ document.date | date:rfc3339 }}",
      "date_modified": "{{ document.date | date:rfc3339 }}",
      "_rights": {
        "copyright": "Copyright {{ document.copyright | decode:entities }}"
      },
      "language": "{{ document.language-code }}",
      "title": "{{ document.title | decode:entities }}",
      "author": {
        "name": "{{ document.authors | email:remove-angle-addr | decode:entities | items:join-type:oxford }}"
      },
      "authors": [ {{ document.authors | email:remove-angle-addr | decode:entities | items:json-array:name }} ],
      "summary": "{{ document.content | excerpt:100:1 | decode:entities | escape:json-val }}",
      "content_html": "{{ document.content | headings:shift | escape:json-val }}"
    }{{ util.json-separator }}